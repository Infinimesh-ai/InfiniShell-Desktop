        },
        {
          "line": 232,
          "text": ""
        },
        {
          "line": 233,
          "text": "/// Per-server tool-list change push. Emitted by [`crate::session::acp_session::AcpSession`] on the post-handshake, auth-recovery, and toggle-tool paths."
        },
        {
          "line": 234,
          "text": "/// The `session_id` field lets the pager route the push to the owning agent via `find_session_match`. Falling back to `app.active_view` was a latent multi-agent bug."
        },
        {
          "line": 235,
          "text": "#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]"
        },
        {
          "line": 236,
          "text": "#[serde(rename_all = \"camelCase\")]"
        },
        {
          "line": 237,
          "text": "pub struct McpToolsChanged {"
        },
        {
          "line": 238,
          "text": "    /// Session that owns this push."
        },
        {
          "line": 239,
          "text": "    /// The pager routes via `find_session_match` so a background-agent push does not land on the foregrounded agent's modal."
        },
        {
          "line": 240,
          "text": "    pub session_id: String,"
        },
        {
          "line": 241,
          "text": "    /// MCP server whose tool list changed. Currently unread by the pager. The pager treats every `tools_changed` push as a trigger to schedule a debounced `mcp/list` refetch and re-reads the full catalog."
        },
        {
          "line": 242,
          "text": "    /// The toggle-tool path therefore leaves this empty for forward-compat. A future field-aware pager optimization would need to special-case empty as \"not scoped to one server\"; no consumer reads that today."
        },
        {
          "line": 243,
          "text": "    #[serde(default, skip_serializing_if = \"String::is_empty\")]"
        },
        {
          "line": 287,
          "text": ""
        },
        {
          "line": 288,
          "text": "/// Push the full MCP catalog to the client."
        },
        {
          "line": 289,
          "text": "/// Called in the background after launch-dir MCP discovery so `initialize()` isn't blocked by config walks."
        },
        {
          "line": 290,
          "text": "pub async fn notify_servers_updated("
        },
        {
          "line": 291,
          "text": "    gateway: &xai_acp_lib::AcpAgentGatewaySender,"
        },
        {
          "line": 292,
          "text": "    local_servers: &[acp::McpServer],"
        },
        {
          "line": 293,
          "text": ") {"
        },
        {
          "line": 294,
          "text": "    let catalog = build_mcp_catalog(local_servers);"
        },
        {
          "line": 295,
          "text": "    let payload = McpServersUpdated {"
        },
        {
          "line": 296,
          "text": "        mcp_servers: catalog,"
        },
        {
          "line": 297,
          "text": "    };"
        },
        {
          "line": 298,
          "text": "    if let Ok(params) = serde_json::value::to_raw_value(&payload) {"
        },
        {
          "line": 299,
          "text": "        let notification = acp::ExtNotification::new(mcp_methods::SERVERS_UPDATED, params.into());"
        },
        {
          "line": 300,
          "text": "        let _ = gateway.ext_notification(notification).await;"
        },
        {
          "line": 301,
          "text": "        tracing::info!(\"Sent x.ai/mcp/servers_updated notification to client\");"
        },
        {
          "line": 302,
          "text": "    }"
        }
      ]
