#!/usr/bin/env bash

# The action ("remove" or "purge") is passed as the first argument to the
# postrm script.
action="$1"

# 链接名必须与 postinst 一致，只清理仍指向本包的入口。
case "$action" in
  remove|purge)
    if [ -L "/usr/bin/@@BINARY_NAME@@" ] && \
       [ "$(readlink "/usr/bin/@@BINARY_NAME@@")" = "@@OPTDIR@@/@@BINARY_NAME@@" ]; then
      rm -f "/usr/bin/@@BINARY_NAME@@"
    fi
    ;;
esac
