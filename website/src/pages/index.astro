---
import LandingLayout from '../layouts/LandingLayout.astro';

const repo = 'https://github.com/Infinimesh-ai/InfiniShell-Desktop';

// 文案集中管理,避免双语 data-lang 标签散落各处
const t = {
  hero: {
    badge:  { en: 'v0 · Open source',     zh: 'v0 · 开源版' },
    h1a:    { en: 'The terminal,',         zh: '把终端,' },
    h1b:    { en: 'rebuilt around you.',   zh: '重新交还给你。' },
    lede:   {
      en: 'InfiniShell is a derivative product built on Warp — a fully open, local-first take on the agentic terminal. Settings and conversation history are stored locally by default; AI requests go to your configured provider. Bring your own provider, your own keys, your own rules.',
      zh: 'InfiniShell 是基于 Warp 的衍生产品 — 完全开放、本地优先的 agentic 终端。设置与会话历史默认保存在本地;AI 请求发送给你配置的提供商。自带服务商、自带密钥、自带规则。',
    },
    primary:   { en: 'Install InfiniShell',     zh: '安装 InfiniShell' },
    secondary: { en: 'View on GitHub',  zh: '在 GitHub 查看' },
  },
  logos: {
    title: {
      en: 'Native protocols — bring any provider',
      zh: '原生协议 — 自带任意服务商',
    },
  },
  feat1: {
    eyebrow: { en: 'TERMINAL',    zh: '终端' },
    h:       { en: 'A real terminal, with an AI you actually own.',  zh: '一个真正的终端,搭配你自己掌控的 AI。' },
    p:       {
      en: 'Every Block — cwd, env, exit code — feeds an AI conversation you can swap, replay or kill at any time. Telemetry is disabled by default; provider and remote-host connections remain under your control.',
      zh: '每一个 Block(工作目录、环境变量、退出码)都为 AI 会话提供上下文,而对话本身可以随时替换、重放、终止。遥测默认关闭;提供商与远端主机连接由你配置。',
    },
    more: { en: 'Read the docs →', zh: '查看文档 →' },
  },
  feat2: {
    eyebrow: { en: 'PROVIDERS',   zh: '服务商' },
    h:       { en: 'Six native protocols. Hundreds of presets. Your keys.', zh: '6 种原生协议,数百个预设,你的密钥。' },
    p:       {
      en: 'Pick from a directory of 250+ providers — OpenAI-compatible, Anthropic, Gemini, Ollama, DeepSeek, OpenAI-Response — or wire your own endpoint in one paste. Keys live in the OS keychain.',
      zh: '从内置 250+ 服务商目录中挑选 — OpenAI 兼容、Anthropic、Gemini、Ollama、DeepSeek、OpenAI-Response — 也可一键粘贴你自己的端点。密钥仅保存在系统密钥库。',
    },
    more: { en: 'See provider list →', zh: '查看服务商列表 →' },
  },
  feat3: {
    eyebrow: { en: 'LOCALIZED',   zh: '本地化' },
    h:       { en: 'Localized end-to-end. Not just labels.',  zh: '端到端本地化,不只是标签翻译。' },
    p:       {
      en: 'The desktop interface supports English and Simplified Chinese, with the language preference stored locally.',
      zh: '桌面界面支持英文与简体中文,语言偏好保存在本地。',
    },
    more: { en: 'Switch language ↑', zh: '切换语言 ↑' },
  },
  quote: {
    text: {
      en: 'The terminal was always a local tool. InfiniShell keeps it that way — even when the AI joins.',
      zh: '终端从来都是本地工具。即便引入 AI,InfiniShell 也让它继续如此。',
    },
    cite: { en: 'Project ethos', zh: '项目理念' },
  },
  install: {
    eyebrow: { en: 'INSTALL',    zh: '安装' },
    h:       { en: 'Download, or build from source.', zh: '下载安装包,或从源码构建。' },
    p:       {
      en: 'Desktop packages are available for macOS Apple Silicon, Windows x64 and Linux x86_64. Check the release notes for signing status and known limits, or use the source-build steps below.',
      zh: '提供 macOS Apple Silicon、Windows x64 与 Linux x86_64 桌面包。签名状态与已知限制请参见发布说明,也可按以下步骤从源码构建。',
    },
    tabMac: 'macOS', tabLinux: 'Linux', tabWin: 'Windows',
  },
  cta: {
    h:       { en: 'Your terminal. Your keys.',  zh: '你的终端。你的密钥。' },
    p:       { en: 'Source-available · Self-hostable · Built with Rust', zh: '源码公开 · 可自托管 · 基于 Rust 构建' },
    primary: { en: 'Quickstart',  zh: '快速开始' },
    secondary: { en: 'Read the changelog', zh: '查看更新日志' },
  },
};

// 提供商示例(对应仿真 2 的 chip-grid)
const providerChips = ['302.AI (97)', 'Abacus (65)', 'abliteration.ai (1)', 'AIHubMix (50)', 'Alibaba (48)', 'Alibaba (China) (80)', 'Alibaba Coding (9)', 'Together (16)'];

// Logos(信赖墙)— 我们没有真实合作伙伴,改成"原生支持的协议名"
const protocols = ['OpenAI', 'Anthropic', 'Gemini', 'Ollama', 'DeepSeek', 'OpenAI-Response'];

// Hero 装饰性均衡器条 — 纯视觉,数值确定性生成(避免 hydration 不一致)
const eqColors = ['var(--grad-1)', 'var(--grad-2)', 'var(--grad-3)', 'var(--grad-4)'];
function makeEqBars(count: number, seed: number) {
  return Array.from({ length: count }, (_, i) => {
    const h = 22 + Math.round(Math.abs(Math.sin(i * 0.7 + seed)) * 70);
    const d = (i * 0.09 + seed * 0.13) % 1.6;
    const c = eqColors[(i + seed) % eqColors.length];
    return { h, d: d.toFixed(2), c };
  });
}
const eqLeft = makeEqBars(16, 0);
const eqRight = makeEqBars(16, 2);
---
<LandingLayout>
  <!-- ============== HERO ============== -->
  <section class="hero">
    <div class="hero-eq" aria-hidden="true">
      <div class="col left">
        {eqLeft.map((b) => (
          <span class="bar" style={`--bar-h:${b.h}%; --bar-d:${b.d}s; --bar-c:${b.c};`}></span>
        ))}
      </div>
      <div class="col right">
        {eqRight.map((b) => (
          <span class="bar" style={`--bar-h:${b.h}%; --bar-d:${b.d}s; --bar-c:${b.c};`}></span>
        ))}
      </div>
    </div>
    <div class="wrap hero-grid">
      <div class="fade-in" data-stagger>
        <span class="hero-badge stagger-item"><span class="pulse-dot"></span>
          <span data-lang="en">{t.hero.badge.en}</span><span data-lang="zh">{t.hero.badge.zh}</span>
        </span>
        <h1 class="stagger-item">
          <span data-lang="en">{t.hero.h1a.en}<br/><span class="em">{t.hero.h1b.en}</span></span>
          <span data-lang="zh">{t.hero.h1a.zh}<br/><span class="em">{t.hero.h1b.zh}</span></span>
        </h1>
        <p class="lede stagger-item" data-lang="en">{t.hero.lede.en}</p>
        <p class="lede stagger-item" data-lang="zh">{t.hero.lede.zh}</p>
        <div class="hero-cta stagger-item">
          <a class="btn" href="#install">
            <span data-lang="en">{t.hero.primary.en}</span><span data-lang="zh">{t.hero.primary.zh}</span>
            <span class="arr">→</span>
          </a>
          <a class="btn alt" href={repo} target="_blank" rel="noopener">
            <span data-lang="en">{t.hero.secondary.en}</span><span data-lang="zh">{t.hero.secondary.zh}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Hero 下方:仿真终端窗口(横向全宽,左提示卡 + 右终端区) -->
    <div class="wrap">
      <div class="hero-art fade-in delay-1" aria-hidden="true">
        <div class="app-window mock-terminal hero-window">
          <div class="app-titlebar">
            <div class="tb-icon" title="sidebar">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M6 3v10"/></svg>
            </div>
            <div class="app-tabs">
              <div class="app-tab active"><span>~ - fish</span></div>
              <div class="app-tab add">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 3v10M3 8h10"/></svg>
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" style="width:9px;height:9px;opacity:.6"><path d="M3 4l3 4 3-4"/></svg>
              </div>
            </div>
            <div class="app-controls">
              <div class="tb-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 9l5-5 5 5M8 4v9"/></svg></div>
              <div class="tb-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2.5" y="3" width="11" height="8" rx="1"/><path d="M2.5 7h11"/></svg></div>
              <button class="tb-icon tb-theme" type="button" data-theme-toggle title="Toggle theme" aria-label="Toggle color theme">
                <svg class="tb-theme-svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <g class="tb-sun">
                    <circle cx="8" cy="8" r="3"/>
                    <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.2 3.2l1.4 1.4M11.4 11.4l1.4 1.4M3.2 12.8l1.4-1.4M11.4 4.6l1.4-1.4"/>
                  </g>
                  <path class="tb-moon" d="M14 9.5A6 6 0 1 1 6.5 2a5 5 0 0 0 7.5 7.5z"/>
                </svg>
              </button>
              <div class="tb-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 8h10"/></svg></div>
              <div class="tb-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="10" height="10" rx="1"/></svg></div>
              <div class="tb-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 4l8 8M12 4l-8 8"/></svg></div>
            </div>
          </div>
          <div class="app-body">
            <!-- 单栏 Block 时间线:终端输出 + AI 对话 + 可交互输入 -->
            <div class="hero-main">
              <div class="term-stage"></div>
              <div class="term-input live">
                <div class="ti-fakeshell">
                  <span class="ps1">~ $</span>
                  <input
                    id="hero-shell-input"
                    type="text"
                    autocomplete="off"
                    spellcheck="false"
                    data-lang="en"
                    placeholder="Try: help, ls, agent fix the linker error, provider list"
                  />
                  <input
                    type="text"
                    autocomplete="off"
                    spellcheck="false"
                    data-lang="zh"
                    placeholder="试试:help、ls、agent 修复链接错误、provider list"
                  />
                </div>
                <div class="ti-help">
                  <span data-lang="en">Type <code>help</code> for commands · <code>↑</code>/<code>↓</code> history · <code>clear</code> reset</span>
                  <span data-lang="zh"><code>help</code> 查看命令 · <code>↑</code>/<code>↓</code> 历史 · <code>clear</code> 清屏</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== LOGOS / PROTOCOLS ============== -->
  <div class="logos fade-in" data-stagger>
    <p class="logos-title stagger-item">
      <span data-lang="en">{t.logos.title.en}</span><span data-lang="zh">{t.logos.title.zh}</span>
    </p>
    <div class="logos-track">
      {protocols.map((p) => <span class="item stagger-item">{p}</span>)}
    </div>
  </div>

  <!-- ============== FEAT 1: 终端 ============== -->
  <section class="section" id="how">
    <div class="wrap">
      <article class="feat-card fade-in slide-l">
        <div class="feat-text">
          <div class="feat-eyebrow">
            <span data-lang="en">{t.feat1.eyebrow.en}</span><span data-lang="zh">{t.feat1.eyebrow.zh}</span>
          </div>
          <h3 data-lang="en">{t.feat1.h.en}</h3>
          <h3 data-lang="zh">{t.feat1.h.zh}</h3>
          <p data-lang="en">{t.feat1.p.en}</p>
          <p data-lang="zh">{t.feat1.p.zh}</p>
          <a class="more" href="/docs/quickstart">
            <span data-lang="en">{t.feat1.more.en}</span><span data-lang="zh">{t.feat1.more.zh}</span>
          </a>
        </div>
        <div class="feat-vis">
          <div class="app-window mock-terminal" style="min-height:340px">
            <div class="app-titlebar">
              <div class="tb-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M6 3v10"/></svg></div>
              <div class="app-tabs">
                <div class="app-tab active">~/infinishell - fish</div>
                <div class="app-tab add">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 3v10M3 8h10"/></svg>
                </div>
              </div>
            </div>
            <div class="app-body">
              <div class="term-stage">
                <div class="typing-line"><span class="p">$</span> cargo build --release</div>
                <div class="typing-line dim">   Compiling infinishell v0.1.0</div>
                <div class="typing-line dim">   Compiling warp_terminal v0.1.0</div>
                <div class="typing-line"><span class="ok">✓</span> <span class="dim">Finished in 12.4s</span></div>
              </div>
              <div class="term-input" style="margin-top:auto">
                <span class="ti-chip">block · cwd · env · exit</span>
                <div class="ti-prompt" data-lang="en">▌ Why did the linker fail on this target?</div>
                <div class="ti-prompt" data-lang="zh">▌ 这个 target 链接为什么失败?</div>
                <div class="ti-meta">
                  <span style="font-family: 'JetBrains Mono', monospace; color: var(--accent)">/agent</span>
                  <span data-lang="en">Anthropic · claude-opus-4-7</span><span data-lang="zh">Anthropic · claude-opus-4-7</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ============== FEAT 2: 服务商(reverse 布局) ============== -->
  <section class="section" id="adapt">
    <div class="wrap">
      <article class="feat-card reverse fade-in slide-r">
        <div class="feat-text">
          <div class="feat-eyebrow">
            <span data-lang="en">{t.feat2.eyebrow.en}</span><span data-lang="zh">{t.feat2.eyebrow.zh}</span>
          </div>
          <h3 data-lang="en">{t.feat2.h.en}</h3>
          <h3 data-lang="zh">{t.feat2.h.zh}</h3>
          <p data-lang="en">{t.feat2.p.en}</p>
          <p data-lang="zh">{t.feat2.p.zh}</p>
          <a class="more" href={repo} target="_blank" rel="noopener">
            <span data-lang="en">{t.feat2.more.en}</span><span data-lang="zh">{t.feat2.more.zh}</span>
          </a>
        </div>
        <div class="feat-vis">
          <div class="app-window mock-settings">
            <div class="app-titlebar">
              <div class="tb-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M6 3v10"/></svg></div>
              <div class="app-tabs">
                <div class="app-tab">~ - fish</div>
                <div class="app-tab active">
                  <span data-lang="en">Settings</span><span data-lang="zh">设置</span>
                </div>
                <div class="app-tab add">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 3v10M3 8h10"/></svg>
                </div>
              </div>
            </div>
            <div class="app-body">
              <!-- 左 sidebar -->
              <div class="set-sidebar">
                <div class="ss-search">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="7" cy="7" r="4.5"/><path d="M14 14l-3.5-3.5"/></svg>
                  <span data-lang="en">Search</span><span data-lang="zh">搜索</span>
                </div>
                <div class="ss-group">
                  <span>Agents</span><span class="chev">▾</span>
                </div>
                <a class="ss-item" data-lang="en">InfiniShell agent</a><a class="ss-item" data-lang="zh">InfiniShell 智能体</a>
                <a class="ss-item" data-lang="en">Config</a><a class="ss-item" data-lang="zh">配置</a>
                <a class="ss-item active" data-lang="en">Providers</a><a class="ss-item active" data-lang="zh">提供商</a>
                <a class="ss-item" data-lang="en">MCP servers</a><a class="ss-item" data-lang="zh">MCP 服务器</a>
                <a class="ss-item">Rules</a>
                <a class="ss-top muted" data-lang="en">Code</a><a class="ss-top muted" data-lang="zh">代码</a>
                <a class="ss-top muted" data-lang="en">Appearance</a><a class="ss-top muted" data-lang="zh">外观</a>
                <a class="ss-top muted" data-lang="en">Features</a><a class="ss-top muted" data-lang="zh">功能</a>
              </div>

              <!-- 右内容 -->
              <div class="set-content">
                <div class="sc-head">
                  <h4 class="sc-h3">
                    <span data-lang="en">Agent providers</span><span data-lang="zh">Agent 提供商</span>
                  </h4>
                  <button class="sc-add" type="button">+ <span data-lang="en">Add</span><span data-lang="zh">添加提供商</span></button>
                </div>
                <p class="sc-desc">
                  <span data-lang="en">Configure any OpenAI-compatible / Anthropic / Gemini / Ollama / DeepSeek endpoint. Keys are stored in the OS keychain.</span>
                  <span data-lang="zh">配置任意 OpenAI 兼容 / Anthropic / Gemini / Ollama / DeepSeek 端点。密钥保存在系统密钥库。</span>
                </p>

                <div class="sc-quickadd">
                  <div class="qa-head">
                    <span data-lang="en">Quick add</span><span data-lang="zh">快速添加</span>
                    <span class="qa-search" data-lang="en">Search providers…</span><span class="qa-search" data-lang="zh">搜索提供商…</span>
                  </div>
                  <div class="chip-grid">
                    {providerChips.map((p) => (
                      <span class="pchip"><span class="plus">+</span>{p}</span>
                    ))}
                    <span class="pchip more">+ 247 more ▾</span>
                  </div>
                </div>

                <div class="set-form">
                  <div class="sf-row">
                    <div class="sf-label">
                      <span data-lang="en">Name</span><span data-lang="zh">名称</span>
                    </div>
                    <div class="sf-val">Anthropic</div>
                  </div>
                  <div class="sf-row">
                    <div class="sf-label">API <span data-lang="en">protocol</span><span data-lang="zh">协议</span></div>
                    <div class="sf-protocols">
                      <span class="ptab">OpenAI</span>
                      <span class="ptab">OpenAI-Response</span>
                      <span class="ptab">Gemini</span>
                      <span class="ptab active">Anthropic</span>
                      <span class="ptab">Ollama</span>
                      <span class="ptab">DeepSeek</span>
                    </div>
                  </div>
                  <div class="sf-actions">
                    <button class="sf-btn" type="button" data-lang="en">+ Add model</button><button class="sf-btn" type="button" data-lang="zh">+ 添加模型</button>
                    <button class="sf-btn primary" type="button" data-lang="en">Save</button><button class="sf-btn primary" type="button" data-lang="zh">保存</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ============== FEAT 3: 本地化 ============== -->
  <section class="section" id="privacy">
    <div class="wrap">
      <article class="feat-card fade-in slide-l">
        <div class="feat-text">
          <div class="feat-eyebrow">
            <span data-lang="en">{t.feat3.eyebrow.en}</span><span data-lang="zh">{t.feat3.eyebrow.zh}</span>
          </div>
          <h3 data-lang="en">{t.feat3.h.en}</h3>
          <h3 data-lang="zh">{t.feat3.h.zh}</h3>
          <p data-lang="en">{t.feat3.p.en}</p>
          <p data-lang="zh">{t.feat3.p.zh}</p>
        </div>
        <div class="feat-vis">
          <div class="app-window mock-language">
            <div class="app-titlebar">
              <div class="tb-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M6 3v10"/></svg></div>
              <div class="app-tabs">
                <div class="app-tab active">
                  <span data-lang="en">Settings · Appearance</span><span data-lang="zh">设置 · 外观</span>
                </div>
                <div class="app-tab add">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 3v10M3 8h10"/></svg>
                </div>
              </div>
            </div>
            <div class="app-body">
              <div class="lang-block">
                <div class="lb-h" data-lang="en">Language</div><div class="lb-h" data-lang="zh">语言</div>
                <div class="lb-row">
                  <div class="lb-text">
                    <div class="t" data-lang="en">Language</div><div class="t" data-lang="zh">语言</div>
                    <div class="d" data-lang="en">Restart InfiniShell to fully apply this change.</div>
                    <div class="d" data-lang="zh">重启 InfiniShell 以让此更改完全生效。</div>
                  </div>
                  <div class="lb-select" id="hero-lang-select">
                    <span class="lb-current" data-locale-current="en">System default</span>
                    <span class="lb-current" data-locale-current="zh">系统默认</span>
                    <div class="lang-dropdown">
                      <button class="ldi" type="button" data-mock-lang="system">
                        <span data-lang="en">System default</span><span data-lang="zh">系统默认</span>
                      </button>
                      <button class="ldi" type="button" data-mock-lang="en">English</button>
                      <button class="ldi" type="button" data-mock-lang="zh">简体中文</button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="lang-block">
                <div class="lb-h" data-lang="en">Window</div><div class="lb-h" data-lang="zh">窗口</div>
