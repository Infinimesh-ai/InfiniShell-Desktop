  <!-- 终端打字行(只渲染一次,LandingLayout 的 IntersectionObserver 触发 .in 后 typing-fade 启动) -->
  <!-- 实际的 typing 内容已经在 mock-terminal 的 .term-stage 内填充 -->
</LandingLayout>

<script>
  // ============================================================
  // Hero 仿真终端:可执行的 fake shell
  // - 预设几个命令(help / ls / pwd / clear / agent / provider / theme / whoami / echo)
  // - 响应按当前 locale 切换双语
  // - 上/下箭头可走历史
  // ============================================================
  (function () {
    const stage = document.querySelector('.hero-art .term-stage') as HTMLElement | null;
    if (!stage) return;

    // 初始动画行(页面刚加载时) — 按当前 locale 渲染
    // 命令本身保留英文(真实 shell 也是英文),只本地化人类语言部分
    // 叙事:构建失败 → AI 用 block 上下文(cwd/exit code)诊断并给出修复建议
    // 呼应 feat1 文案 "Every Block — cwd, env, exit code — feeds an AI conversation"
    const initLinesByLocale: Record<'en' | 'zh', string[]> = {
      en: [
        `<span class="p">$</span> cargo build --release`,
        `<span class="dim">   Compiling infinishell v0.1.0</span>`,
        `<span class="err">error[E0433]: failed to resolve: use of undeclared crate \`openssl\`</span>`,
        `<span class="err">  --&gt; src/tls.rs:4:5</span>`,
        `<div class="stage-turn">
          <div class="st-chip">block · cwd ~/infinishell · exit 101</div>
          <div class="st-prompt">▌ Why did this fail?</div>
          <div class="st-think">Reading block context <span class="dots"><span></span><span></span><span></span></span></div>
          <div class="st-answer"><code>openssl</code> isn't in Cargo.toml. Run <code>cargo add openssl --features vendored</code>, then rebuild.</div>
          <div class="st-meta"><span class="ok">anthropic / claude-opus-4-7</span><span>local · no telemetry</span></div>
        </div>`,
      ],
      zh: [
        `<span class="p">$</span> cargo build --release`,
        `<span class="dim">   正在编译 infinishell v0.1.0</span>`,
        `<span class="err">error[E0433]: 无法解析:未声明的 crate \`openssl\`</span>`,
        `<span class="err">  --&gt; src/tls.rs:4:5</span>`,
        `<div class="stage-turn">
          <div class="st-chip">block · cwd ~/infinishell · exit 101</div>
          <div class="st-prompt">▌ 为什么会失败?</div>
          <div class="st-think">正在读取 block 上下文 <span class="dots"><span></span><span></span><span></span></span></div>
          <div class="st-answer">Cargo.toml 里没有 <code>openssl</code>。运行 <code>cargo add openssl --features vendored</code> 后重新构建即可。</div>
          <div class="st-meta"><span class="ok">anthropic / claude-opus-4-7</span><span>本地 · 无遥测</span></div>
        </div>`,
      ],
    };
    function renderInitLines() {
      stage.innerHTML = initLinesByLocale[locale()]
        .map((l) => `<div class="typing-line">${l}</div>`)
        .join('');
    }

    const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('.ti-fakeshell input'));
    if (!inputs.length) {
      // 即便没有输入框,也至少把初始动画行渲染出来
      renderInitLines();
      return;
    }
    const history: string[] = [];
    let histIdx = -1;

    function locale(): 'en' | 'zh' {
      const l = document.body.dataset.locale || document.documentElement.getAttribute('data-locale') || 'en';
      if (l === 'zh') return l;
      return 'en';
    }

    // 首次渲染初始动画行
    renderInitLines();

    function pickInput(): HTMLInputElement | null {
      const lc = locale();
      return inputs.find((el) => el.dataset.lang === lc) || inputs[0] || null;
    }
    function escape(s: string) {
      return s.replace(/&/g, '&amp;').replace(/[<]/g, '&lt;').replace(/[>]/g, '&gt;');
    }
    function printRaw(html: string, cls = '') {
      const div = document.createElement('div');
      div.className = 'out-line' + (cls ? ' ' + cls : '');
      div.innerHTML = html;
      stage.appendChild(div);
      stage.scrollTop = stage.scrollHeight;
    }
    function printLines(lines: string[], cls = '') {
      lines.forEach((l, i) => {
        setTimeout(() => printRaw(l, cls), i * 60);
      });
    }

    // 多语响应表
    const responses: Record<string, Record<'en' | 'zh', string[]>> = {
      help: {
        en: [
          'Available commands:',
          '  help               show this list',
          '  ls                 list current directory',
          '  pwd                print working directory',
          '  whoami             print current user',
          '  echo &lt;text&gt;        print text back',
          '  agent &lt;prompt&gt;     send a prompt to the local AI agent',
          '  provider list      list configured AI providers',
          '  theme              toggle dark / light',
          '  clear              clear the screen',
        ],
        zh: [
          '可用命令:',
          '  help               显示本列表',
          '  ls                 列出当前目录',
          '  pwd                输出当前路径',
          '  whoami             输出当前用户',
          '  echo &lt;文本&gt;        原样输出文本',
          '  agent &lt;prompt&gt;     向本地 AI 代理发送提示',
          '  provider list      列出已配置的服务商',
          '  theme              切换深/浅色主题',
          '  clear              清屏',
        ],
      },
      ls: {
        en: ['Cargo.toml  CHANGELOG.md  README.md  app/  crates/  docs/  scripts/  website/'],
        zh: ['Cargo.toml  CHANGELOG.md  README.md  app/  crates/  docs/  scripts/  website/'],
      },
      pwd: { en: ['/home/you/infinishell'], zh: ['/home/you/infinishell'] },
      whoami: { en: ['you'], zh: ['you'] },
      providerList: {
        en: [
          '<span class="k">PROTOCOL</span>           <span class="k">NAME</span>          <span class="k">STATUS</span>',
          'openai            anthropic     <span class="s">ready</span>',
          'anthropic         claude-4-7    <span class="s">ready</span>',
          'deepseek          deepseek-v4   <span class="s">ready</span>',
          'ollama            local         <span class="s">ready</span>',
        ],
        zh: [
          '<span class="k">协议</span>             <span class="k">名称</span>          <span class="k">状态</span>',
          'openai            anthropic     <span class="s">就绪</span>',
          'anthropic         claude-4-7    <span class="s">就绪</span>',
          'deepseek          deepseek-v4   <span class="s">就绪</span>',
          'ollama            local         <span class="s">就绪</span>',
        ],
      },
    };

    function agentResponse(prompt: string): string[] {
      const lc = locale();
      const cleaned = prompt.trim() || (lc === 'zh' ? '没有输入提示' : 'no prompt');
      if (lc === 'zh') {
        return [
          `<span class="k">[agent]</span> <span class="dim">路由至</span> anthropic/claude-4-7`,
          `<span class="k">[agent]</span> <span class="dim">提示</span>: ${escape(cleaned)}`,
          `<span class="dim">思考中...</span>`,
          `<span class="s">→</span> 这是一个仿真响应。实际使用时会在本地调用你配置的服务商。`,
          `<span class="dim">请求时会向配置的提供商端点发送凭据和所选上下文。</span>`,
        ];
      }
      return [
        `<span class="k">[agent]</span> <span class="dim">routing to</span> anthropic/claude-4-7`,
        `<span class="k">[agent]</span> <span class="dim">prompt</span>: ${escape(cleaned)}`,
        `<span class="dim">thinking...</span>`,
        `<span class="s">→</span> This is a simulated response. In real InfiniShell this would call your configured provider locally.`,
        `<span class="dim">Requests send credentials and the selected context to your configured provider endpoint.</span>`,
      ];
    }

    function run(raw: string) {
      const cmd = raw.trim();
      if (!cmd) return;
      history.push(cmd);
      histIdx = history.length;

      // 回显命令
      printRaw(`<span class="p">$</span> ${escape(cmd)}`);

      const lc = locale();
      const lower = cmd.toLowerCase();
      const head = cmd.split(/\s+/)[0].toLowerCase();
      const rest = cmd.slice(head.length).trim();

      if (lower === 'clear' || lower === 'cls') {
        setTimeout(() => { stage.innerHTML = ''; }, 80);
        return;
      }
      if (head === 'help') { printLines(responses.help[lc], 'dim'); return; }
      if (head === 'ls')   { printLines(responses.ls[lc]); return; }
      if (head === 'pwd')  { printLines(responses.pwd[lc]); return; }
      if (head === 'whoami') { printLines(responses.whoami[lc]); return; }
      if (head === 'echo') { printRaw(escape(rest)); return; }
      if (head === 'theme') {
        const cur = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('infinishell:theme', next); } catch (_) {}
        const themeName = lc === 'zh'
          ? (next === 'dark' ? '深色' : '浅色')
          : next;
        const msg = lc === 'zh'
          ? `已切换至${themeName}主题`
          : `Theme switched to ${themeName}`;
        printRaw(msg, 'ok');
        return;
      }
      if (head === 'provider' && rest === 'list') {
        printLines(responses.providerList[lc]);
        return;
      }
      if (head === 'agent') { printLines(agentResponse(rest)); return; }

      // 未知命令
      const errMsg = lc === 'zh'
        ? `infinishell: 未知命令: ${escape(head)}。输入 <span class="s">help</span> 查看可用命令。`
        : `infinishell: command not found: ${escape(head)}. Type <span class="s">help</span> to list commands.`;
      printRaw(errMsg, 'err');
    }

    inputs.forEach((input) => {
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const val = input.value;
          input.value = '';
          run(val);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (history.length === 0) return;
          histIdx = Math.max(0, histIdx - 1);
          input.value = history[histIdx] || '';
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (histIdx < history.length - 1) {
            histIdx += 1;
            input.value = history[histIdx] || '';
          } else {
            histIdx = history.length;
            input.value = '';
          }
        }
      });
    });

    // 仿真窗口里的"语言"下拉 — 点击后同步全站 locale,对齐 nav 里的语言菜单。
    // 这里重用 LandingLayout 中已有的 setLocale 逻辑:直接写 localStorage + body.dataset.locale +
    // applyLocale 生效。为避免重写,使用同一 storage key 与同一套选择器。
    function setLocaleAcrossSite(lc) {
      const supported = ['en', 'zh'];
      let actual = lc;
      if (lc === 'system') {
        const nav = (navigator.language || 'en').toLowerCase();
        actual = nav.startsWith('zh') ? 'zh' : 'en';
      }
      if (!supported.includes(actual)) actual = 'en';
      // 1. body.dataset.locale 控制 [data-lang] 的可见性
      document.body.dataset.locale = actual;
      // 2. <html> lang 属性
      document.documentElement.lang = actual === 'zh' ? 'zh-CN' : actual;
      // 3. <html> data-locale(供 CSS 其他场景使用)
      document.documentElement.setAttribute('data-locale', actual);
      // 4. 持久化 — 所以下一次打开也记住
      try { localStorage.setItem('infinishell:locale', actual); } catch (_) {}
      // 5. 同步更新 nav lang 下拉中的 active 状态
      document.querySelectorAll('[data-set-lang]').forEach((opt) => {
        const active = opt.getAttribute('data-set-lang') === actual;
        opt.classList.toggle('active', active);
        opt.setAttribute('aria-selected', String(active));
      });
      // 6. 同步 mock dropdown 里的 active(高亮当前选项)
      document.querySelectorAll('[data-mock-lang]').forEach((opt) => {
        const v = opt.getAttribute('data-mock-lang');
        opt.classList.toggle('active', v === actual || (v === 'system' && !(localStorage.getItem('infinishell:locale') || localStorage.getItem('zap:locale'))));
      });
    }
    document.querySelectorAll('[data-mock-lang]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const target = btn.getAttribute('data-mock-lang') || 'en';
        setLocaleAcrossSite(target);
      });
    });
    // 页面载入后同步一次初始高亮
    document.querySelectorAll('[data-mock-lang]').forEach((opt) => {
      const v = opt.getAttribute('data-mock-lang');
      const cur = document.body.dataset.locale || 'en';
      opt.classList.toggle('active', v === cur);
    });

    // 监听全站 locale 变化 (无论是导航栏、mock dropdown 还是其他入口触发)
    // 切换后清空仿真终端并重新打印初始动画行，让 demo 会“跟随语言”
    let lastLocale = locale();
    const localeObserver = new MutationObserver(() => {
      const cur = locale();
      if (cur === lastLocale) return;
      lastLocale = cur;
      renderInitLines();
    });
    localeObserver.observe(document.body, { attributes: true, attributeFilter: ['data-locale'] });
  })();
</script>

<script>
  // Hero 装饰性均衡器条 — 轻量视差(仅位移,GPU 合成,不触发 layout)
  (function () {
    const eq = document.querySelector<HTMLElement>('.hero-eq');
    if (!eq) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;
    const cols = Array.from(eq.querySelectorAll<HTMLElement>('.col'));
    let ticking = false;
    function apply() {
      const y = window.scrollY;
      const heroH = (eq.closest('.hero') as HTMLElement | null)?.offsetHeight || 800;
      const progress = Math.min(y / heroH, 1);
      cols.forEach((col, i) => {
        const dir = i % 2 === 0 ? 1 : -1;
        col.style.transform = `translateY(${progress * 40 * dir}px)`;
      });
      ticking = false;
    }
    document.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(apply);
          ticking = true;
        }
      },
      { passive: true },
    );
    apply();
  })();
</script>
