+#[tokio::test]
+async fn terminal_bridge_completed_descendant_spawn_cannot_bypass_parent_lease() {
+    let (mut coordinator, _sender, admissions, _admission_rx) = fixture();
+    insert_child(&mut coordinator, admissions, "child", "parent");
+    finish_child(&mut coordinator, "child");
+    let (respond_to, response) = oneshot::channel();
+    coordinator.acquire_idle_admission("parent".to_owned(), respond_to);
+    let lease = response.await.unwrap().unwrap();
+    let mut nested = request("grandchild", true);
+    nested.parent_session_id = "child".to_owned();
+    let (result_tx, _result_rx) = oneshot::channel();
+    coordinator.handle_spawn(SubagentSpawnRequest {
+        request: Box::new(nested),
+        result_tx,
+        registered_tx: None,
+    });
+    assert!(!coordinator.pending.contains_key("grandchild"));
+    assert_eq!(coordinator.idle_admission_holds["parent"].deferred.len(), 1);
+    drop(lease);
+    let parent =
+        std::future::poll_fn(|cx| poll_released(&mut coordinator.idle_admission_holds, cx)).await;
+    coordinator.release_idle_admission(&parent);
+    assert!(coordinator.pending.contains_key("grandchild"));
+}
