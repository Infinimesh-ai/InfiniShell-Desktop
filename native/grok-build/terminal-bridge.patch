+//! 专用提交接口的原生持久化证明；普通回合完成和本地乐观显示均不构成证明。
+
+use agent_client_protocol as acp;
+use serde_json::Value;
+
+fn matching_proof<'a>(
+    value: &'a Value,
+    session_id: &str,
+    message_id: &str,
+    prompt_id: &str,
+) -> Option<&'a Value> {
+    let proof = value.get("infinishellTerminalBridge")?;
+    (proof.get("protocolVersion").and_then(Value::as_u64) == Some(1)
+        && proof.get("sessionId").and_then(Value::as_str) == Some(session_id)
+        && proof.get("messageId").and_then(Value::as_str) == Some(message_id)
+        && proof.get("promptId").and_then(Value::as_str) == Some(prompt_id))
+    .then_some(proof)
+}
+
+pub(crate) fn committed(
+    response: &acp::PromptResponse,
+    session_id: &str,
+    message_id: &str,
+    prompt_id: &str,
+) -> bool {
+    let Some(meta) = &response.meta else {
+        return false;
+    };
+    if meta.get("sessionId").and_then(Value::as_str) != Some(session_id)
+        || meta.get("promptId").and_then(Value::as_str) != Some(prompt_id)
+    {
+        return false;
+    }
+    committed_proof(
+        &Value::Object(meta.clone()),
+        session_id,
+        message_id,
+        prompt_id,
+    )
+}
+
+/// 只读收据接口返回原始证明对象，不伪造成普通回合完成响应。
+pub(crate) fn committed_proof(
+    value: &Value,
+    session_id: &str,
+    message_id: &str,
+    prompt_id: &str,
+) -> bool {
+    matching_proof(value, session_id, message_id, prompt_id).is_some_and(|proof| {
+        proof.get("admitted").and_then(Value::as_bool) == Some(true)
+            && proof.get("admissionState").and_then(Value::as_str) == Some("committed")
+    })
+}
+
+pub(crate) fn rejected(
+    error: &acp::Error,
+    session_id: &str,
+    message_id: &str,
+    prompt_id: &str,
+) -> bool {
+    if error.code != acp::ErrorCode::from(-32071) {
+        return false;
+    }
+    error
+        .data
+        .as_ref()
+        .and_then(|data| matching_proof(data, session_id, message_id, prompt_id))
+        .is_some_and(|proof| proof.get("admitted").and_then(Value::as_bool) == Some(false))
+}
