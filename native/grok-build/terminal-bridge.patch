+#[test]
+fn terminal_bridge_windows_empty_directory_and_ancestors_stay_bound_until_drop() {
+    let temporary = private_test_directory();
+    let owner = UserIdentity::current().unwrap();
+    let root = Directory::open(temporary.path(), &owner).unwrap();
+    let child = root.create_child("empty").unwrap();
+    let original = child.path().to_owned();
+    let renamed = temporary.path().join("renamed");
+    let renamed_root = temporary.path().with_file_name("renamed-root");
+    let expected = child.identity();
+    drop(root);
+
+    // 不放置文件，确保拒绝来自目录句柄，而不是非空目录或文件句柄的副作用。
+    assert!(fs::read_dir(&original).unwrap().next().is_none());
+    assert!(fs::rename(&original, &renamed).is_err());
+    assert!(fs::remove_dir(&original).is_err());
+    assert!(fs::rename(temporary.path(), &renamed_root).is_err());
+    child.validate().unwrap();
+    drop(child);
+
+    fs::rename(&original, &renamed).unwrap();
+    let reopened = Directory::open(&renamed, &owner).unwrap();
+    assert_eq!(reopened.identity(), expected);
+    drop(reopened);
+    fs::remove_dir(&renamed).unwrap();
+    fs::rename(temporary.path(), &renamed_root).unwrap();
+    fs::remove_dir(&renamed_root).unwrap();
+}
