+fn setup() -> (tempfile::TempDir, TerminalBridge, AppView) {
+    let directory = tempfile::tempdir().unwrap();
+    let mut bridge = TerminalBridge::new("test-instance".into(), directory.path().into()).unwrap();
+    bridge.set_native_capability(true);
+    let mut app = test_app_with_agent();
+    app.agents.get_mut(&AgentId(0)).unwrap().active_pane = ActivePane::Prompt;
+    (directory, bridge, app)
