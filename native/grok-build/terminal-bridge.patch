+//! 普通 TUI 的显式私有 IPC；只有事件循环可以读取或改变界面状态。
+
+use std::fs::{self, DirBuilder, Metadata, OpenOptions};
+use std::io::{self, Write};
+use std::os::unix::fs::{DirBuilderExt, FileTypeExt, MetadataExt, OpenOptionsExt, PermissionsExt};
+use std::path::{Component, Path, PathBuf};
+use std::sync::Arc;
+use std::time::Duration;
+
+use serde::{Deserialize, Serialize};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{UnixListener, UnixStream};
+use tokio::sync::{Semaphore, mpsc, oneshot};
+use tokio::task::{JoinHandle, JoinSet};
+use uuid::Uuid;
+
+use super::terminal_bridge::{Request, Response};
+
+#[cfg(target_os = "linux")]
+#[path = "terminal_bridge_peer_linux.rs"]
+mod peer_linux;
+
+pub(crate) const BRIDGE_DIR_ENV: &str = "GROK_TERMINAL_BRIDGE_DIR";
+const PROTOCOL_VERSION: u32 = 1;
+const MAX_FRAME_BYTES: usize = 256 * 1024;
+const MAX_CONNECTIONS: usize = 8;
+const READ_TIMEOUT: Duration = Duration::from_secs(5);
+const REPLY_TIMEOUT: Duration = Duration::from_secs(30);
+
+pub(crate) struct BridgeRequest {
+    pub(crate) request: Request,
+    pub(crate) reply: oneshot::Sender<Response>,
+}
+
+/// 不实现 Debug，避免发现凭据被日志或崩溃上下文展开。
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {
+    token: String,
+    request: Request,
+}
+
+#[derive(Serialize, Deserialize)]
+struct Manifest {
+    protocol_version: u32,
+    native_pid: u32,
+    instance_id: String,
+    socket: PathBuf,
+    token: String,
+}
+
+#[derive(Clone, Copy)]
+struct Identity {
+    device: u64,
+    inode: u64,
+}
+
+impl Identity {
+    fn of(metadata: &Metadata) -> Self {
+        Self {
+            device: metadata.dev(),
+            inode: metadata.ino(),
+        }
+    }
+
+    fn matches(self, metadata: &Metadata) -> bool {
+        self.device == metadata.dev() && self.inode == metadata.ino()
+    }
+}
+
+struct Endpoint {
+    root: PathBuf,
+    root_identity: Identity,
+    directory: PathBuf,
+    directory_identity: Identity,
+    socket: PathBuf,
+    socket_identity: Option<Identity>,
+    manifest: PathBuf,
+    manifest_identity: Option<Identity>,
+    owner: u32,
+}
+
+impl Endpoint {
+    fn validate(&self) -> io::Result<()> {
+        validate_ancestors(&self.root, self.owner)?;
+        let root = private_directory(&self.root, self.owner)?;
+        let directory = private_directory(&self.directory, self.owner)?;
+        if !self.root_identity.matches(&root) || !self.directory_identity.matches(&directory) {
+            return Err(invalid("bridge directory identity changed"));
+        }
+        if let Some(identity) = self.socket_identity {
+            let metadata = fs::symlink_metadata(&self.socket)?;
+            if !identity.matches(&metadata)
+                || !metadata.file_type().is_socket()
+                || !private_file(&metadata, self.owner)
+            {
+                return Err(invalid("bridge socket identity changed"));
+            }
+        }
+        if let Some(identity) = self.manifest_identity {
+            let metadata = fs::symlink_metadata(&self.manifest)?;
+            if !identity.matches(&metadata)
+                || !metadata.is_file()
+                || !private_file(&metadata, self.owner)
+            {
+                return Err(invalid("bridge manifest identity changed"));
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Drop for Endpoint {
+    fn drop(&mut self) {
+        // 不递归清理：账本可能是 ACK 丢失后唯一的投递证据。
+        if self.validate().is_err() {
+            return;
+        }
+        if self.socket_identity.is_some() {
+            let _ = fs::remove_file(&self.socket);
+        }
+        if self.manifest_identity.is_some() {
+            let _ = fs::remove_file(&self.manifest);
+        }
+    }
+}
+
+pub(crate) struct BridgeIo {
+    pub(crate) instance_id: String,
+    pub(crate) instance_dir: PathBuf,
+    pub(crate) requests: mpsc::Receiver<BridgeRequest>,
+    listener_task: JoinHandle<()>,
+}
+
+impl BridgeIo {
+    pub(crate) fn start_from_env() -> io::Result<Option<Self>> {
+        let Some(root) = std::env::var_os(BRIDGE_DIR_ENV) else {
+            return Ok(None);
+        };
+        Self::start(Path::new(&root)).map(Some)
+    }
+
+    fn start(root: &Path) -> io::Result<Self> {
+        // geteuid 无输入参数；身份只用于同用户私有目录和 Unix 对端验证。
+        let owner = unsafe { libc::geteuid() };
+        validate_ancestors(root, owner)?;
+        let root_metadata = private_directory(root, owner)?;
+        let instance = Uuid::new_v4();
+        let instance_id = instance.to_string();
+        let directory = root.join(format!("t-{}", instance.simple()));
+        DirBuilder::new().mode(0o700).create(&directory)?;
+        let directory_metadata = private_directory(&directory, owner)?;
+        if directory_metadata.dev() != root_metadata.dev() {
+            return Err(invalid("bridge directory must stay on its root device"));
+        }
+        let socket = directory.join("control.sock");
+        let mut endpoint = Endpoint {
+            root: root.to_owned(),
+            root_identity: Identity::of(&root_metadata),
+            directory: directory.clone(),
+            directory_identity: Identity::of(&directory_metadata),
+            socket: socket.clone(),
+            socket_identity: None,
+            manifest: directory.join("manifest.json"),
+            manifest_identity: None,
+            owner,
+        };
+        endpoint.validate()?;
+        let listener = UnixListener::bind(&socket)?;
+        fs::set_permissions(&socket, fs::Permissions::from_mode(0o600))?;
+        endpoint.socket_identity = Some(Identity::of(&fs::symlink_metadata(&socket)?));
+        let token = format!("{}{}", Uuid::new_v4().simple(), Uuid::new_v4().simple());
+        let manifest = Manifest {
+            protocol_version: PROTOCOL_VERSION,
+            native_pid: std::process::id(),
+            instance_id: instance_id.clone(),
+            socket,
+            token: token.clone(),
+        };
+        let mut file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW)
+            .open(&endpoint.manifest)?;
+        endpoint.manifest_identity = Some(Identity::of(&file.metadata()?));
+        file.write_all(&serde_json::to_vec(&manifest)?)?;
+        file.sync_all()?;
+        endpoint.validate()?;
+        let endpoint = Arc::new(endpoint);
+        let (sender, requests) = mpsc::channel(MAX_CONNECTIONS);
+        let listener_task = tokio::spawn(serve(listener, endpoint, token, sender));
+        Ok(Self {
+            instance_id,
+            instance_dir: directory,
+            requests,
+            listener_task,
+        })
+    }
+}
+
+impl Drop for BridgeIo {
+    fn drop(&mut self) {
+        // JoinSet 随监听任务销毁，会取消未完成连接；已经交给事件循环的事务靠账本查询。
+        self.listener_task.abort();
+    }
+}
+
+async fn serve(
+    listener: UnixListener,
+    endpoint: Arc<Endpoint>,
+    token: String,
+    sender: mpsc::Sender<BridgeRequest>,
+) {
+    let permits = Arc::new(Semaphore::new(MAX_CONNECTIONS));
+    let mut connections = JoinSet::new();
+    loop {
+        tokio::select! {
+            result = listener.accept() => {
+                let Ok((stream, _address)) = result else { break; };
+                let Ok(permit) = permits.clone().try_acquire_owned() else { continue; };
+                let endpoint = endpoint.clone();
+                let token = token.clone();
+                let sender = sender.clone();
+                connections.spawn(async move {
+                    let _permit = permit;
+                    // 不记录请求、token 或输入正文，失败连接直接关闭。
+                    let _ = exchange(stream, endpoint, token, sender).await;
+                });
+            }
+            _ = connections.join_next(), if !connections.is_empty() => {}
+        }
+    }
+}
+
+async fn exchange(
+    mut stream: UnixStream,
+    endpoint: Arc<Endpoint>,
+    token: String,
+    sender: mpsc::Sender<BridgeRequest>,
+) -> io::Result<()> {
+    endpoint.validate()?;
+    let credentials = stream.peer_cred()?;
+    if credentials.uid() != endpoint.owner {
+        return Err(invalid("bridge peer owner mismatch"));
+    }
+    let envelope = tokio::time::timeout(READ_TIMEOUT, async {
+        // Linux 身份前导与请求共用期限；前导不是输入接收回执，不进入事件循环。
+        #[cfg(target_os = "linux")]
+        peer_linux::send_identity(&stream).await?;
+        read_envelope(&mut stream).await
+    })
+    .await
+    .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "bridge frame timed out"))??;
+    if !token_matches(&token, &envelope.token) {
+        return Err(invalid("bridge authentication failed"));
+    }
+    endpoint.validate()?;
+    let (reply, response) = oneshot::channel();
+    sender
+        .try_send(BridgeRequest {
+            request: envelope.request,
+            reply,
+        })
+        .map_err(|_| invalid("bridge event loop unavailable"))?;
+    // 超时不能推断未投递，客户端只能用同一 message_id 查询原生账本。
+    let response = tokio::time::timeout(REPLY_TIMEOUT, response)
+        .await
+        .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "bridge reply timed out"))?
+        .map_err(|_| invalid("bridge event loop stopped"))?;
+    let bytes = serde_json::to_vec(&response)?;
+    if bytes.is_empty() || bytes.len() > MAX_FRAME_BYTES {
+        return Err(invalid("bridge response frame size invalid"));
+    }
+    tokio::time::timeout(READ_TIMEOUT, async {
+        stream.write_u32(bytes.len() as u32).await?;
+        stream.write_all(&bytes).await?;
+        stream.shutdown().await
+    })
+    .await
+    .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "bridge write timed out"))?
+}
+
+async fn read_envelope(stream: &mut UnixStream) -> io::Result<Envelope> {
+    let length = stream.read_u32().await? as usize;
+    if length == 0 || length > MAX_FRAME_BYTES {
+        return Err(invalid("bridge request frame size invalid"));
+    }
+    let mut bytes = vec![0; length];
+    stream.read_exact(&mut bytes).await?;
+    serde_json::from_slice(&bytes).map_err(|_| invalid("bridge request malformed"))
+}
+
+fn token_matches(expected: &str, actual: &str) -> bool {
+    if expected.len() != actual.len() {
+        return false;
+    }
+    expected
+        .bytes()
+        .zip(actual.bytes())
+        .fold(0, |difference, (left, right)| difference | (left ^ right))
+        == 0
+}
+
+fn private_file(metadata: &Metadata, owner: u32) -> bool {
+    metadata.uid() == owner && metadata.mode() & 0o777 == 0o600 && metadata.nlink() == 1
+}
+
+fn private_directory(path: &Path, owner: u32) -> io::Result<Metadata> {
+    let metadata = fs::symlink_metadata(path)?;
+    if !metadata.is_dir() || metadata.uid() != owner || metadata.mode() & 0o777 != 0o700 {
+        return Err(invalid(
+            "bridge directory must be an owner-private real directory",
+        ));
+    }
+    Ok(metadata)
+}
+
+fn validate_ancestors(root: &Path, owner: u32) -> io::Result<()> {
+    if !root.is_absolute()
+        || root
+            .components()
+            .any(|component| !matches!(component, Component::RootDir | Component::Normal(_)))
+        || fs::canonicalize(root)? != root
+    {
+        return Err(invalid(
+            "bridge root must be an absolute canonical directory",
+        ));
+    }
+    for ancestor in root.ancestors() {
+        let metadata = fs::symlink_metadata(ancestor)?;
+        if !metadata.is_dir()
+            || (metadata.uid() != owner && metadata.uid() != 0)
+            || metadata.mode() & 0o022 != 0
+        {
+            return Err(invalid("bridge root has an unsafe ancestor"));
+        }
+    }
+    Ok(())
+}
+
+fn invalid(message: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::PermissionDenied, message)
+}
