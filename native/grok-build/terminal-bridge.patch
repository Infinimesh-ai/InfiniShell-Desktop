+/// 空闲准入的短期独占凭据；超时、取消或正常离开作用域都会释放。
+#[derive(Debug)]
+pub struct SubagentIdleAdmissionLease {
+    release: Option<oneshot::Sender<()>>,
+}
+
+impl SubagentIdleAdmissionLease {
+    pub(crate) fn new(release: oneshot::Sender<()>) -> Self {
+        Self { release: Some(release) }
+    }
+}
+
+impl Drop for SubagentIdleAdmissionLease {
+    fn drop(&mut self) {
+        if let Some(release) = self.release.take() {
+            let _ = release.send(());
+        }
+    }
+}
