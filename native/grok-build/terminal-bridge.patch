+fn parse_dependency_paths<'a>(
+    output: &'a str,
+    descriptor_path: &Path,
+) -> anyhow::Result<Vec<&'a str>> {
+    let descriptor_path = descriptor_path
+        .to_str()
+        .context("descriptor path not UTF-8")?;
+    let prefix = format!("{descriptor_path}:");
+    // protoc 原样写出唯一目标；精确剥离前缀，不能按盘符冒号或路径空格分词。
+    let dependencies = output.strip_prefix(&prefix).with_context(|| {
+        format!("protoc dependency manifest must start with {prefix:?}: {output:?}")
+    })?;
+    anyhow::ensure!(
+        !dependencies.is_empty(),
+        "protoc dependency manifest is empty"
+    );
+    dependencies
+        .lines()
+        .map(|line| {
+            let line = line.trim();
+            let line = line.strip_suffix('\\').unwrap_or(line).trim_end();
+            anyhow::ensure!(!line.is_empty(), "protoc dependency path is empty");
+            Ok(line)
+        })
+        .collect()
+}
