+            unsafe {
+                SetFileSecurityW(
+                    path.as_ptr(),
+                    DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+                    invalid_acl.attributes().lpSecurityDescriptor,
+                )
+            },
+            0
+        );
+        move || {
+            assert_ne!(
+                unsafe {
+                    SetFileSecurityW(
+                        path.as_ptr(),
+                        DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+                        restore.attributes().lpSecurityDescriptor,
+                    )
+                },
+                0
+            );
+        }
+    };
+    let request = submission(&lease, "不得发送");
+    let (response, effects) = bridge.handle(request.clone(), &mut app);
+    assert_eq!(receipt(response).state, ReceiptState::Unknown);
+    assert!(effects.is_empty());
+    let (response, effects) = bridge.handle(request, &mut app);
+    assert_eq!(receipt(response).state, ReceiptState::Unknown);
+    assert!(effects.is_empty());
+    assert!(bridge.journal_failed);
+    #[cfg(windows)]
+    restore_directory_acl();
+}
+
+#[test]
+fn unknown_query_and_wrong_instance_cannot_submit() {
+    let (_directory, mut bridge, mut app) = setup();
+    let (response, effects) = bridge.handle(
+        Request::QueryReceipt {
+            instance_id: "test-instance".into(),
+            message_id: "unseen".into(),
+        },
+        &mut app,
+    );
+    assert!(matches!(response, Response::Unknown { message_id } if message_id == "unseen"));
+    assert!(effects.is_empty());
+    let lease = lease(&mut bridge, &mut app);
+    let mut request = submission(&lease, "不得发送");
+    if let Request::SubmitIfIdle { instance_id, .. } = &mut request {
+        *instance_id = "old-instance".into();
+    }
+    let (response, effects) = bridge.handle(request, &mut app);
+    assert!(matches!(response, Response::Rejected { reason } if reason == "instance_mismatch"));
+    assert!(effects.is_empty());
+}
