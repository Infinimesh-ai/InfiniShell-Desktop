+use super::*;
+
+use serde_json::json;
+use std::os::unix::fs::symlink;
+
+fn private_root() -> tempfile::TempDir {
+    let root = tempfile::Builder::new().prefix("b-").tempdir().unwrap();
+    fs::set_permissions(root.path(), fs::Permissions::from_mode(0o700)).unwrap();
+    root
+}
+
+fn manifest(bridge: &BridgeIo) -> Manifest {
+    serde_json::from_slice(&fs::read(bridge.instance_dir.join("manifest.json")).unwrap()).unwrap()
+}
+
+async fn connect_client(manifest: &Manifest) -> UnixStream {
+    let stream = UnixStream::connect(&manifest.socket).await.unwrap();
+    #[cfg(target_os = "linux")]
+    {
+        // 原生显式携带凭据；本测试在读取前导前启用接收，不把前导当作事务回包。
+        peer_linux::tests::enable_credentials(&stream);
+        let _descriptor = peer_linux::tests::receive_identity(&stream).await;
+    }
+    stream
+}
+
+async fn request(stream: &mut UnixStream, manifest: &Manifest, token: &str) {
+    let bytes = serde_json::to_vec(&json!({
+        "token": token,
+        "request": { "operation": "state", "instance_id": manifest.instance_id },
+    }))
+    .unwrap();
+    stream.write_u32(bytes.len() as u32).await.unwrap();
+    stream.write_all(&bytes).await.unwrap();
+}
+
+#[tokio::test]
+async fn private_endpoint_delivers_authenticated_request_to_event_loop() {
+    let root = private_root();
+    let mut bridge = BridgeIo::start(root.path()).unwrap();
+    let manifest = manifest(&bridge);
+    assert_eq!(manifest.protocol_version, 1);
+    assert_eq!(manifest.native_pid, std::process::id());
+    assert_eq!(manifest.instance_id, bridge.instance_id);
+    assert_eq!(manifest.token.len(), 64);
+    assert_eq!(
+        fs::metadata(&manifest.socket).unwrap().mode() & 0o777,
+        0o600
+    );
+    assert_eq!(
+        fs::metadata(bridge.instance_dir.join("manifest.json"))
+            .unwrap()
+            .mode()
+            & 0o777,
+        0o600
+    );
+    let mut client = connect_client(&manifest).await;
+    assert!(matches!(
+        bridge.requests.try_recv(),
+        Err(mpsc::error::TryRecvError::Empty)
+    ));
+    request(&mut client, &manifest, &manifest.token).await;
+    let call = bridge.requests.recv().await.unwrap();
+    match call.request {
+        Request::State { instance_id } => assert_eq!(instance_id, bridge.instance_id),
+        Request::PrepareSessionIfIdle { .. }
+        | Request::SubmitIfIdle { .. }
+        | Request::QueryReceipt { .. } => panic!("错误事务类型"),
+    }
+    call.reply
+        .send(Response::Rejected {
+            reason: "fixture_reply".to_owned(),
+        })
+        .ok()
+        .unwrap();
+    let length = client.read_u32().await.unwrap() as usize;
+    let mut bytes = vec![0; length];
+    client.read_exact(&mut bytes).await.unwrap();
+    let response: serde_json::Value = serde_json::from_slice(&bytes).unwrap();
+    assert_eq!(
+        response,
+        json!({"status": "rejected", "reason": "fixture_reply"})
+    );
+}
+
+#[tokio::test]
+async fn wrong_token_never_reaches_event_loop() {
+    let root = private_root();
+    let mut bridge = BridgeIo::start(root.path()).unwrap();
+    let manifest = manifest(&bridge);
+    let mut client = connect_client(&manifest).await;
+    request(&mut client, &manifest, &"0".repeat(64)).await;
+    let mut output = Vec::new();
+    client.read_to_end(&mut output).await.unwrap();
+    assert!(output.is_empty());
+    assert!(matches!(
+        bridge.requests.try_recv(),
+        Err(mpsc::error::TryRecvError::Empty)
+    ));
+}
+
+#[tokio::test]
+async fn oversized_frame_is_rejected_before_allocating_body() {
+    let (mut client, mut server) = UnixStream::pair().unwrap();
+    client.write_u32(MAX_FRAME_BYTES as u32 + 1).await.unwrap();
+    assert!(read_envelope(&mut server).await.is_err());
+}
+
+#[tokio::test]
+async fn envelope_rejects_unknown_fields() {
+    let (mut client, mut server) = UnixStream::pair().unwrap();
+    let bytes = serde_json::to_vec(&json!({
+        "token": "fixture",
+        "request": { "operation": "state", "instance_id": "fixture" },
+        "leader_socket": "/unexpected",
+    }))
+    .unwrap();
+    client.write_u32(bytes.len() as u32).await.unwrap();
+    client.write_all(&bytes).await.unwrap();
+    assert!(read_envelope(&mut server).await.is_err());
+}
+
+#[tokio::test]
+async fn permissive_or_symlink_root_is_rejected_without_fixing_permissions() {
+    let root = private_root();
+    fs::set_permissions(root.path(), fs::Permissions::from_mode(0o750)).unwrap();
+    assert!(BridgeIo::start(root.path()).is_err());
+    assert_eq!(fs::metadata(root.path()).unwrap().mode() & 0o777, 0o750);
+    fs::set_permissions(root.path(), fs::Permissions::from_mode(0o700)).unwrap();
+    let link = root.path().join("alias");
+    symlink(root.path(), &link).unwrap();
+    assert!(BridgeIo::start(&link).is_err());
+}
+
+#[tokio::test]
+async fn drop_preserves_receipt_and_removes_only_owned_discovery_files() {
+    let root = private_root();
+    let bridge = BridgeIo::start(root.path()).unwrap();
+    let directory = bridge.instance_dir.clone();
+    let manifest = manifest(&bridge);
+    fs::write(directory.join("receipts.jsonl"), "fixture receipt\n").unwrap();
+    drop(bridge);
+    // abort 在执行器再次调度任务时释放 Endpoint。
+    tokio::task::yield_now().await;
+    assert!(!manifest.socket.exists());
+    assert!(!directory.join("manifest.json").exists());
+    assert_eq!(
+        fs::read_to_string(directory.join("receipts.jsonl")).unwrap(),
+        "fixture receipt\n"
+    );
+}
+
+#[tokio::test]
+async fn replaced_manifest_prevents_cleanup_of_other_identity() {
+    let root = private_root();
+    let bridge = BridgeIo::start(root.path()).unwrap();
+    let directory = bridge.instance_dir.clone();
+    let manifest_path = directory.join("manifest.json");
+    let old_manifest = directory.join("original.json");
+    fs::rename(&manifest_path, &old_manifest).unwrap();
+    fs::write(&manifest_path, "replacement").unwrap();
+    fs::set_permissions(&manifest_path, fs::Permissions::from_mode(0o600)).unwrap();
+    drop(bridge);
+    tokio::task::yield_now().await;
+    assert_eq!(fs::read_to_string(&manifest_path).unwrap(), "replacement");
+    assert!(old_manifest.exists());
+}
