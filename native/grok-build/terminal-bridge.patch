+        ))
+    );
+    let mut client = ClientOptions::new().open(&manifest.socket).unwrap();
+    send(&mut client, state(&manifest, &manifest.token)).await;
+    let call = tokio::time::timeout(Duration::from_secs(2), bridge.requests.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        matches!(call.request, Request::State { instance_id } if instance_id == bridge.instance_id)
+    );
+    call.reply
+        .send(Response::Rejected {
+            reason: "fixture".into(),
+        })
+        .unwrap();
+    // 客户端延迟读取时，服务端必须保留响应，收到完整帧确认后才关闭。
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    let length = client.read_u32().await.unwrap();
+    let mut bytes = vec![0; length as usize];
