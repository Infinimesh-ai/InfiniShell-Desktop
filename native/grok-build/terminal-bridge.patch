+#[tokio::test]
+async fn terminal_bridge_windows_kernel_pipe_token_must_match_the_exact_logon() {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    use tokio::net::windows::named_pipe::{ClientOptions, ServerOptions};
+    let pipe = format!(
+        r"\\.\pipe\infinishell-bridge-token-test-{}",
+        uuid::Uuid::new_v4()
+    );
+    let mut server = ServerOptions::new()
+        .first_pipe_instance(true)
+        .reject_remote_clients(true)
+        .create(&pipe)
+        .unwrap();
+    let mut client = ClientOptions::new().open(&pipe).unwrap();
+    server.connect().await.unwrap();
+    client.write_all(b"authenticate").await.unwrap();
+    let mut bytes = [0u8; 12];
+    server.read_exact(&mut bytes).await.unwrap();
+    let owner = UserIdentity::current().unwrap();
+    owner.verify_pipe_client(server.as_raw_handle()).unwrap();
+    let mut other = owner.clone();
+    other.authentication.0 = other.authentication.0.wrapping_add(1);
+    assert!(other.verify_pipe_client(server.as_raw_handle()).is_err());
+    other = owner.clone();
+    other.session = other.session.wrapping_add(1);
+    assert!(other.verify_pipe_client(server.as_raw_handle()).is_err());
+    // 两次失败后当前线程必须已恢复自身令牌，不能把模拟身份留给后续任务。
+    owner.verify_pipe_client(server.as_raw_handle()).unwrap();
+}
