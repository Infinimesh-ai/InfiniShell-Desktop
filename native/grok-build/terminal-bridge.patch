+        let (_directory, mut bridge, mut app) = setup();
+        let lease = lease(&mut bridge, &mut app);
+        let agent = app.agents.get_mut(&AgentId(0)).unwrap();
+        match mode {
+            "draft" => agent.prompt.set_text("保留原草稿"),
+            "permission" => agent
+                .permission_queue
+                .push_back(make_followup_permission_state()),
+            "plan" => agent.plan_approval_view = Some(make_plan_approval_view_state()),
+            "paste" => agent.paste_probe_in_flight = 1,
+            other => panic!("未知测试情形：{other}"),
+        }
+        let (response, effects) = bridge.handle(submission(&lease, "不得发送"), &mut app);
+        assert!(matches!(response, Response::Rejected { reason } if reason == "editor_not_ready"));
+        assert!(effects.is_empty());
+        assert!(bridge.receipts.is_empty());
+        let agent = app.active_agent().unwrap();
+        match mode {
+            "draft" => assert_eq!(agent.prompt.text(), "保留原草稿"),
+            "permission" => assert_eq!(agent.permission_queue.len(), 1),
+            "plan" => assert!(agent.plan_approval_view.is_some()),
+            "paste" => assert_eq!(agent.paste_probe_in_flight, 1),
+            other => panic!("未知测试情形：{other}"),
+        }
+    }
+}
