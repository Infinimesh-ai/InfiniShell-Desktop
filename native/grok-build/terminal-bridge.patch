@@ -0,0 +1,741 @@
+//! 普通 TUI 的外部输入事务；所有状态检查与提交均由原生事件循环串行调用。
+
+use std::collections::HashMap;
+#[cfg(unix)]
+use std::fs::{File, OpenOptions};
+use std::io::{self, Write};
+#[cfg(unix)]
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::PathBuf;
+use std::time::{Duration, Instant};
+
+use serde::{Deserialize, Serialize};
+
+use super::actions::{Action, Effect};
+use super::agent::{AgentId, BgTaskStatus, GoalDisplayStatus};
+use super::agent_view::{AgentView, ExternalPromptEditorAccess};
+use super::app_view::{ActiveView, AppView, VoiceState};
+use super::dispatch::{dispatch, dispatch_terminal_bridge_prompt};
+
+const LEASE_LIFETIME: Duration = Duration::from_secs(5);
+const MAX_TEXT_BYTES: usize = 128 * 1024;
+const MAX_RECEIPTS: usize = 4096;
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(tag = "operation", rename_all = "snake_case", deny_unknown_fields)]
+pub(crate) enum Request {
+    State {
+        instance_id: String,
+    },
+    PrepareSessionIfIdle {
+        instance_id: String,
+        input_epoch: u64,
+    },
+    SubmitIfIdle {
+        instance_id: String,
+        lease_id: String,
+        session_id: String,
+        binding_epoch: u32,
+        input_epoch: u64,
+        message_id: String,
+        prompt_id: String,
+        text: String,
+    },
+    QueryReceipt {
+        instance_id: String,
+        message_id: String,
+    },
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub(crate) struct Lease {
+    pub lease_id: String,
+    pub agent_id: usize,
+    pub session_id: String,
+    pub binding_epoch: u32,
+    pub input_epoch: u64,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum ReceiptState {
+    Claimed,
+    Dispatched,
+    NativeAcknowledged,
+    NativeRejected,
+    Unknown,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub(crate) struct Receipt {
+    pub message_id: String,
+    pub prompt_id: String,
+    pub session_id: String,
+    pub payload_digest: String,
+    pub state: ReceiptState,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(tag = "status", rename_all = "snake_case")]
+pub(crate) enum Response {
+    State {
+        instance_id: String,
+        input_epoch: u64,
+        ready: bool,
+        reason: Option<String>,
+        lease: Option<Lease>,
+    },
+    Prepared {
+        instance_id: String,
+        input_epoch: u64,
+        agent_id: usize,
+        expected_binding_epoch: u32,
+        expected_session_id: String,
+    },
+    NotReady {
+        reason: String,
+    },
+    Receipt {
+        receipt: Receipt,
+    },
+    Unknown {
+        message_id: String,
+    },
+    Rejected {
+        reason: String,
+    },
+}
+
+pub(crate) struct TerminalBridge {
+    instance_id: String,
+    input_epoch: u64,
+    lease: Option<(Lease, Instant)>,
+    receipts: HashMap<String, Receipt>,
+    #[cfg(unix)]
+    journal: File,
+    #[cfg(windows)]
+    journal: super::terminal_bridge_windows::Journal,
+    journal_failed: bool,
+    native_available: bool,
+}
+
+/// 只证明同一次纯显示 tick 前后的目标身份；不能用最终空草稿替代输入事件撤销。
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct AnimationInputIdentity {
+    input_epoch: u64,
+    active_view: ActiveView,
+    home_agent: Option<AgentId>,
+    binding: Option<(AgentId, u32, String)>,
+}
+
+impl TerminalBridge {
+    pub(crate) fn new(instance_id: String, instance_dir: PathBuf) -> io::Result<Self> {
+        // 每次 TUI 启动使用新实例目录；旧账本只读保留，绝不载入为可重发队列。
+        #[cfg(unix)]
+        let journal = {
+            let journal = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(instance_dir.join("receipts.jsonl"))?;
+            journal.sync_all()?;
+            File::open(instance_dir)?.sync_all()?;
+            journal
+        };
+        #[cfg(windows)]
+        let journal = super::terminal_bridge_windows::Journal::new(&instance_dir)?;
+        Ok(Self {
+            instance_id,
+            input_epoch: 0,
+            lease: None,
+            receipts: HashMap::new(),
+            journal,
+            journal_failed: false,
+            native_available: false,
+        })
+    }
+
+    /// 原生连接必须明确确认专用原子准入能力；变更连接能力会撤销此前租约。
+    pub(crate) fn set_native_capability(&mut self, available: bool) {
+        if self.native_available != available {
+            self.native_available = available;
+            self.invalidate();
+        }
+    }
+
+    pub(crate) fn native_available(&self) -> bool {
+        self.native_available
+    }
+
+    /// 仅在所有可能改输入的 tick 路径都不可达时，允许显示动画保留观察代际。
+    pub(crate) fn display_only_animation_identity(
+        &self,
+        app: &AppView,
+    ) -> Option<AnimationInputIdentity> {
+        let target = match app.active_view {
+            ActiveView::Welcome => {
+                self.home_ready(app).ok()?;
+                app.home_session()
+            }
+            ActiveView::Agent(_) => {
+                self.ready(app).ok()?;
+                app.active_agent()
+            }
+            ActiveView::AgentDashboard => return None,
+        };
+        if app.scroll_state.has_active_stream()
+            || !app.pending_image_notices.is_empty()
+            || app.deferred_notification.is_some()
+            || !app.pending_running_adoptions.is_empty()
+            || !app.terminal_bridge_status_tick_is_passive()
+        {
+            return None;
+        }
+        // 恢复函数即使返回 None 也可能清理旧标记；必须在调用前排除全部根会话。
+        if app.agents.values().any(|agent| {
+            agent.pending_cancel_resend.is_some()
+                || agent.prompt_ack.is_some()
+                || agent.pending_turn_end_reconcile.is_some()
+                || !agent.subagent_views.is_empty()
+                || !agent.pending_effects.is_empty()
+                || agent.edit_hl_needs_tick()
+        }) {
+            return None;
+        }
+        if let Some(agent) = target {
+            // 这些轮询可能打开输入视图、替换选择或同步命令；不能当作动画放行。
+            if agent.prompt.file_search.context().is_some()
+                || agent.prompt.history_search.is_active()
+                || agent.scrollback_search.is_some()
+                // 首页 tick 不同步隐藏会话命令；官方 reveal 才消费这个代际差异。
+                || (matches!(app.active_view, ActiveView::Agent(_))
+                    && agent.acp_synced_generation != agent.session.available_commands_generation)
+                || agent.prompt.pending_viewer_request.is_some()
+                || agent.prompt.textarea.selection_range().is_some()
+                || agent.image_load_rx.is_some()
+                || agent.video_load_rx.is_some()
+                || agent.image_viewer.is_some()
+                || agent.video_viewer.is_some()
+                || agent.inline_video.is_some()
+                || agent.block_viewer.is_some()
+                || agent.gboom.is_some()
+                || agent.mermaid_needs_tick()
+                || agent.pending_text_drag.is_some()
+                || agent.pending_block_drag.is_some()
+                || agent.drag_selection.is_some()
+                || agent.block_drag_selection.is_some()
+                || agent.deferred_text_press.is_some()
+                || agent.persistent_text_selection.is_some()
+                || agent.selection_created_at.is_some()
+                || agent.has_drag_autoscroll()
+                || agent.left_mouse_down
+                || agent.plan_prompt_mouse_drag
+                || agent.wake_turn_active()
+            {
+                return None;
+            }
+        }
+        // 余下只有 shimmer、toast、提示淡出、完成闪光、计数、链接高亮和通知输出。
+        Some(AnimationInputIdentity {
+            input_epoch: self.input_epoch,
+            active_view: app.active_view,
+            home_agent: app.home_session_agent,
+            binding: target.map(|agent| {
+                (
+                    agent.session.id,
+                    agent.session_binding_epoch,
+                    agent
+                        .session
+                        .session_id
+                        .as_ref()
+                        .expect("已通过会话守卫")
+                        .0
+                        .to_string(),
+                )
+            }),
+        })
+    }
+
+    /// 事件循环须在每次输入、ACP、任务、进度或配置状态变化前调用，防止编辑后还原的 ABA。
+    pub(crate) fn invalidate(&mut self) {
+        self.lease = None;
+        match self.input_epoch.checked_add(1) {
+            Some(epoch) => self.input_epoch = epoch,
+            None => self.journal_failed = true,
+        }
+    }
+
+    pub(crate) fn handle(
+        &mut self,
+        request: Request,
+        app: &mut AppView,
+    ) -> (Response, Vec<Effect>) {
+        match request {
+            Request::PrepareSessionIfIdle {
+                instance_id,
+                input_epoch,
+            } => {
+                if instance_id != self.instance_id {
+                    return rejected("instance_mismatch");
+                }
+                if input_epoch != self.input_epoch || input_epoch == u64::MAX {
+                    return rejected("stale_epoch");
+                }
+                if !matches!(app.active_view, ActiveView::Welcome) {
+                    return rejected("not_on_home");
+                }
+                if let Err(reason) = self.home_ready(app) {
+                    return (
+                        Response::NotReady {
+                            reason: reason.into(),
+                        },
+                        vec![],
+                    );
+                }
+                // 明确准备请求只消费首页状态并走原生 Enter 路径；不领取正文、不生成 ACK。
+                // 先推进 epoch，同一请求断连重试也不能第二次创建或切换会话。
+                self.invalidate();
+                let effects = dispatch(Action::LeaveHome, app);
+                let Some(agent) = app.active_agent() else {
+                    // 官方路径可能打开工作区确认；保留其正常交互，绝不代用户回答。
+                    return (
+                        Response::NotReady {
+                            reason: "session_not_prepared".into(),
+                        },
+                        effects,
+                    );
+                };
+                let expected_binding_epoch = if agent.session.session_id.is_some() {
+                    agent.session_binding_epoch
+                } else {
+                    let Some(epoch) = agent.session_binding_epoch.checked_add(1) else {
+                        return (
+                            Response::NotReady {
+                                reason: "binding_epoch_exhausted".into(),
+                            },
+                            effects,
+                        );
+                    };
+                    // 新建会话仅允许 SessionCreated 首次绑定的那一次 epoch 变化。
+                    epoch
+                };
+                let Some(expected_session_id) = agent
+                    .session
+                    .session_id
+                    .as_ref()
+                    .or(agent.pending_session_id.as_ref())
+                else {
+                    return (
+                        Response::NotReady {
+                            reason: "session_unbound".into(),
+                        },
+                        effects,
+                    );
+                };
+                (
+                    Response::Prepared {
+                        instance_id: self.instance_id.clone(),
+                        input_epoch: self.input_epoch,
+                        agent_id: agent.session.id.0,
+                        expected_binding_epoch,
+                        expected_session_id: expected_session_id.0.to_string(),
+                    },
+                    effects,
+                )
+            }
+            Request::State { instance_id } => {
+                if instance_id != self.instance_id {
+                    return rejected("instance_mismatch");
+                }
+                let reason = self.ready(app).err();
+                let lease = if reason.is_none() {
+                    let agent = app.active_agent().expect("已通过活动会话守卫");
+                    Some(Lease {
+                        lease_id: uuid::Uuid::new_v4().to_string(),
+                        agent_id: agent.session.id.0,
+                        session_id: agent
+                            .session
+                            .session_id
+                            .as_ref()
+                            .expect("已通过会话身份守卫")
+                            .0
+                            .to_string(),
+                        binding_epoch: agent.session_binding_epoch,
+                        input_epoch: self.input_epoch,
+                    })
+                } else {
+                    None
+                };
+                self.lease = lease.clone().map(|lease| (lease, Instant::now()));
+                (
+                    Response::State {
+                        instance_id: self.instance_id.clone(),
+                        input_epoch: self.input_epoch,
+                        ready: reason.is_none(),
+                        reason: reason.map(str::to_owned),
+                        lease,
+                    },
+                    vec![],
+                )
+            }
+            Request::QueryReceipt {
+                instance_id,
+                message_id,
+            } => {
+                if instance_id != self.instance_id {
+                    return rejected("instance_mismatch");
+                }
+                let response = match self.receipts.get(&message_id) {
+                    Some(receipt) => Response::Receipt {
+                        receipt: receipt.clone(),
+                    },
+                    None => Response::Unknown { message_id },
+                };
+                (response, vec![])
+            }
+            Request::SubmitIfIdle {
+                instance_id,
+                lease_id,
+                session_id,
+                binding_epoch,
+                input_epoch,
+                message_id,
+                prompt_id,
+                text,
+            } => {
+                if instance_id != self.instance_id {
+                    return rejected("instance_mismatch");
+                }
+                if message_id != prompt_id
+                    || !uuid::Uuid::parse_str(&message_id)
+                        .is_ok_and(|id| !id.is_nil() && id.to_string() == message_id)
+                    || text.trim().is_empty()
+                    || text.len() > MAX_TEXT_BYTES
+                {
+                    return rejected("invalid_submission");
+                }
+                let payload_digest = format!("blake3:{}", blake3::hash(text.as_bytes()).to_hex());
+                // 查重先于租约判断：断连后的相同请求只返回原账本，不生成第二个 Effect。
+                if let Some(receipt) = self.receipts.get(&message_id) {
+                    if receipt.prompt_id != prompt_id
+                        || receipt.session_id != session_id
+                        || receipt.payload_digest != payload_digest
+                    {
+                        return rejected("message_id_conflict");
+                    }
+                    return (
+                        Response::Receipt {
+                            receipt: receipt.clone(),
+                        },
+                        vec![],
+                    );
+                }
+                if self.receipts.len() >= MAX_RECEIPTS {
+                    return rejected("receipt_capacity");
+                }
+                let valid_lease = self.lease.as_ref().is_some_and(|(lease, issued)| {
+                    lease.lease_id == lease_id
+                        && lease.session_id == session_id
+                        && lease.binding_epoch == binding_epoch
+                        && lease.input_epoch == input_epoch
+                        && issued.elapsed() <= LEASE_LIFETIME
+                        && input_epoch == self.input_epoch
+                });
+                if !valid_lease {
+                    return rejected("stale_lease");
+                }
+                if let Err(reason) = self.ready(app) {
+                    self.lease = None;
+                    return rejected(reason);
+                }
+                let agent = app.active_agent().expect("已通过活动会话守卫");
+                if self.lease.as_ref().map(|(lease, _)| lease.agent_id) != Some(agent.session.id.0)
+                    || agent.session_binding_epoch != binding_epoch
+                    || agent.session.session_id.as_ref().map(|id| id.0.as_ref())
+                        != Some(session_id.as_str())
+                {
+                    self.lease = None;
+                    return rejected("session_mismatch");
+                }
+                self.invalidate();
+                let mut receipt = Receipt {
+                    message_id: message_id.clone(),
+                    prompt_id: prompt_id.clone(),
+                    session_id,
+                    payload_digest,
+                    state: ReceiptState::Claimed,
+                };
+                // 在任何原生发送之前落盘领取；崩溃后只能查询，宿主不得将未知结果重投。
+                self.receipts.insert(message_id.clone(), receipt.clone());
+                if self.append(&receipt).is_err() {
+                    receipt.state = ReceiptState::Unknown;
+                    self.receipts.insert(message_id, receipt.clone());
+                    return (Response::Receipt { receipt }, vec![]);
+                }
+                let effects =
+                    dispatch_terminal_bridge_prompt(app, text, message_id.clone(), prompt_id);
+                receipt.state = if effects.is_empty() {
+                    ReceiptState::Unknown
+                } else {
+                    ReceiptState::Dispatched
+                };
+                if self.append(&receipt).is_err() {
+                    receipt.state = ReceiptState::Unknown;
+                }
+                self.receipts.insert(message_id, receipt.clone());
+                (Response::Receipt { receipt }, effects)
+            }
+        }
+    }
+
+    /// 只能从带精确会话与 prompt ID 的真实原生接收证据调用，不能从乐观显示行调用。
+    pub(crate) fn observe_native_ack(
+        &mut self,
+        session_id: &str,
+        prompt_id: &str,
+    ) -> io::Result<()> {
+        self.observe_native_state(session_id, prompt_id, ReceiptState::NativeAcknowledged)
+    }
+
+    /// 仅用于原生原子准入的明确拒绝；RPC 超时、断连与普通错误不证明没有提交。
+    pub(crate) fn observe_native_rejection(
+        &mut self,
+        session_id: &str,
+        prompt_id: &str,
+    ) -> io::Result<()> {
+        self.observe_native_state(session_id, prompt_id, ReceiptState::NativeRejected)
+    }
+
+    fn observe_native_state(
+        &mut self,
+        session_id: &str,
+        prompt_id: &str,
+        state: ReceiptState,
+    ) -> io::Result<()> {
+        let Some(mut receipt) = self
+            .receipts
+            .values()
+            .find(|receipt| receipt.session_id == session_id && receipt.prompt_id == prompt_id)
+            .cloned()
+        else {
+            return Ok(());
+        };
+        if receipt.state == state {
+            return Ok(());
+        }
+        if matches!(
+            receipt.state,
+            ReceiptState::NativeAcknowledged | ReceiptState::NativeRejected
+        ) {
+            return Err(io::Error::other(
+                "terminal_bridge.conflicting_native_receipt",
+            ));
+        }
+        receipt.state = state;
+        let result = self.append(&receipt);
+        if result.is_err() {
+            receipt.state = ReceiptState::Unknown;
+        }
+        self.receipts.insert(receipt.message_id.clone(), receipt);
+        result
+    }
+
+    fn append(&mut self, receipt: &Receipt) -> io::Result<()> {
+        let result = (|| {
+            let mut bytes = serde_json::to_vec(receipt)?;
+            bytes.push(b'\n');
+            self.journal.write_all(&bytes)?;
+            self.journal.sync_all()
+        })();
+        if result.is_err() {
+            self.journal_failed = true;
+        }
+        result
+    }
+
+    fn application_ready(&self, app: &AppView) -> Result<(), &'static str> {
+        if !self.native_available {
+            return Err("native_bridge_unavailable");
+        }
+        if self.journal_failed {
+            return Err("journal_unavailable");
+        }
+        if !app.session_startup_allowed() || app.is_access_blocked() || app.is_zdr_blocked() {
+            return Err("access_blocked");
+        }
+        if app.reconnect_pending || app.relaunch.is_some() || app.quit_for_update {
+            return Err("connection_transition");
+        }
+        if app.tutorial.is_some()
+            || app.import_claude_modal.is_some()
+            || app.welcome_doc_viewer.is_some()
+            || app.pending_editor.is_some()
+            || app.pending_pager_path.is_some()
+            || app.pending_screen_mode_switch.is_some()
+            || app.pending_action.is_some()
+            || app.exit_session_pending.is_some()
+            || !matches!(app.voice_state, VoiceState::Idle)
+            || !app.pending_effects.is_empty()
+            || app.gate.is_some()
+        {
+            return Err("application_owns_input");
+        }
+        Ok(())
+    }
+
+    fn home_ready(&self, app: &AppView) -> Result<(), &'static str> {
+        self.application_ready(app)?;
+        if !app.only_unused_home_or_empty() || !app.deferred_startup.is_empty() {
+            return Err("home_session_transition");
+        }
+        if app.new_worktree_dialog.is_some()
+            || app.session_picker_entries.is_some()
+            || app.session_picker_loading
+            || app.session_picker_content_loading
+            || app.session_picker_pending_delete.is_some()
+        {
+            return Err("application_owns_input");
+        }
+        #[cfg(feature = "local-workspace")]
+        if app.welcome_local_workspace_ack_pending {
+            return Err("application_owns_input");
+        }
+        if !app.welcome_prompt_focused
+            || app.welcome_menu_index.is_some()
+            || app.welcome_on_auth_url
+            || app.welcome_on_changelog_cta
+            || app.welcome_on_privacy_banner
+            || app.welcome_on_upgrade_cta
+            || app.welcome_consent_hover_link.is_some()
+            || !app.welcome_prompt.text().is_empty()
+            || !app.welcome_prompt.is_effectively_empty()
+            || !app.welcome_prompt.textarea.elements().is_empty()
+            || !app.welcome_prompt.images.is_empty()
+            || app.welcome_prompt.textarea.selection_range().is_some()
+            || app.welcome_prompt.any_dropdown_open()
+            || app.welcome_prompt.history_search.is_active()
+            || app.welcome_prompt.pending_viewer_request.is_some()
+        {
+            return Err("editor_not_ready");
+        }
+        #[cfg(feature = "local-workspace")]
+        if app.welcome_on_workspace_mode {
+            return Err("editor_not_ready");
+        }
+        // 只允许首页自己预创建的空闲会话；其他隐藏会话不能借准备请求获得焦点。
+        if let Some(agent) = app.home_session() {
+            self.agent_ready(app, agent)?;
+        }
+        Ok(())
+    }
+
+    fn ready(&self, app: &AppView) -> Result<(), &'static str> {
+        self.application_ready(app)?;
+        let agent = app.active_agent().ok_or("no_active_agent")?;
+        self.agent_ready(app, agent)
+    }
+
+    fn agent_ready(&self, app: &AppView, agent: &AgentView) -> Result<(), &'static str> {
+        let session_id = agent.session.session_id.as_ref().ok_or("session_unbound")?;
+        if agent.session.loading_replay
+            || agent.session.prompt_history_loading
+            || agent.session_reload.is_some()
+            || agent.pending_session_id.is_some()
+            || agent.loading_placeholder_id.is_some()
+            || agent.pending_first_prompt.is_some()
+            || agent.session.model_switch_pending
+            || agent.session.deferred_model_switch.is_some()
+            || agent.plan_mode_pending.is_some()
+            || agent.session_mode_pending.is_some()
+        {
+            return Err("session_loading");
+        }
+        if !agent.session.state.is_idle()
+            || agent.session.current_prompt_id.is_some()
+            || agent.session.in_flight_prompt.is_some()
+            || agent.prompt_ack.is_some()
+            || agent.pending_turn_end_reconcile.is_some()
+            || agent.pending_cancel_resend.is_some()
+            || agent.execute_plan.is_some()
+            || agent.pending_post_turn_commit.is_some()
+            || agent
+                .session
+                .bg_tasks
+                .values()
+                .any(|task| matches!(task.status, BgTaskStatus::Running))
+            || !agent.session.scheduled_tasks.is_empty()
+            || agent
+                .goal_state
+                .as_ref()
+                .is_some_and(|goal| goal.status == GoalDisplayStatus::Active)
+            || agent
+                .subagent_views
+                .values()
+                .any(|child| !child.session.state.is_idle())
+        {
+            return Err("session_busy");
+        }
+        if !agent.session.pending_prompts.is_empty()
+            || !agent.shared_queue.is_empty()
+            || !agent.queue.entry_ids().is_empty()
+            || !agent.optimistic_queue_ids.is_empty()
+            || agent.send_now_awaiting_confirm.is_some()
+            || !agent.send_now_echo_pending.is_empty()
+            || !agent.pending_effects.is_empty()
+            || app
+                .pending_running_adoptions
+                .contains_key(&agent.session.id)
+            || app
+                .shared_prompt_queues
+                .get(session_id.0.as_ref())
+                .is_some_and(|queue| !queue.is_empty())
+            || app
+                .optimistic_prompt_echoes
+                .get(session_id.0.as_ref())
+                .is_some_and(|queue| !queue.is_empty())
+        {
+            return Err("queue_pending");
+        }
+        if agent.external_prompt_editor_access() != ExternalPromptEditorAccess::Ready
+            || !agent.is_empty_focused_prompt()
+            || !agent.prompt.is_effectively_empty()
+            || agent.btw_state.is_some()
+            || agent.show_workflows
+            || !agent.permission_queue.is_empty()
+            || agent.permission_stashed_prompt.is_some()
+            || agent.permission_pattern_edit.is_some()
+            || agent.pending_elicitation.is_some()
+            || agent.stashed_prompt.is_some()
+            || agent.casual_stashed_prompt.is_some()
+            || agent.credit_limit_stashed_prompt.is_some()
+            || agent.reauth_stashed_prompt.is_some()
+            || agent.session.hook_block_hold
+            || agent.session.blocked_prompt.is_some()
+        {
+            return Err("editor_not_ready");
+        }
+        if self.receipts.values().any(|receipt| {
+            receipt.session_id == session_id.0.as_ref()
+                && matches!(
+                    receipt.state,
+                    ReceiptState::Claimed | ReceiptState::Dispatched | ReceiptState::Unknown
+                )
+        }) {
+            return Err("receipt_pending");
+        }
+        Ok(())
+    }
+}
+
+fn rejected(reason: &str) -> (Response, Vec<Effect>) {
+    (
+        Response::Rejected {
+            reason: reason.to_owned(),
+        },
+        vec![],
+    )
+}
