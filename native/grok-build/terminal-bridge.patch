+//! 将私有 IPC 事务串行接入普通 TUI，不把本地派发升级为原生回执。
+
+use super::super::actions::{Effect, TaskResult};
+use super::super::app_view::AppView;
+use super::super::terminal_bridge::{Receipt, ReceiptState, Request, Response, TerminalBridge};
+use super::super::terminal_bridge_io::{BridgeIo, BridgeRequest};
+use super::super::terminal_bridge_receipt;
+use agent_client_protocol as acp;
+use std::collections::HashMap;
+use std::time::Duration;
+use tokio::sync::oneshot;
+use tokio::task::JoinHandle;
+use xai_acp_lib::{AcpAgentTx, acp_send};
+
+const MAX_RECEIPT_QUERIES: usize = 8;
+const RECEIPT_QUERY_TIMEOUT: Duration = Duration::from_secs(5);
+
+struct PendingReceiptQuery {
+    expected: Receipt,
+    result: oneshot::Receiver<bool>,
+    task: JoinHandle<()>,
+}
+
+/// 查询身份只来自本地已领取账本；此集合从不持有正文或生成提交请求。
+#[derive(Default)]
+struct ReceiptQueries(HashMap<String, PendingReceiptQuery>);
+
+impl ReceiptQueries {
+    fn start(&mut self, tx: &AcpAgentTx, receipt: Receipt) {
+        if !matches!(
+            receipt.state,
+            ReceiptState::Claimed | ReceiptState::Dispatched | ReceiptState::Unknown
+        ) || self.0.contains_key(&receipt.message_id)
+            || self.0.len() >= MAX_RECEIPT_QUERIES
+        {
+            return;
+        }
+        let tx = tx.clone();
+        let expected = receipt.clone();
+        let (sender, result) = oneshot::channel();
+        let task = tokio::spawn(async move {
+            let request = acp::ExtRequest::new(
+                "infinishell/session/receipt",
+                serde_json::value::to_raw_value(&serde_json::json!({
+                    "protocolVersion": 1,
+                    "sessionId": expected.session_id,
+                    "promptId": expected.prompt_id,
+                    "messageId": expected.message_id,
+                }))
+                .expect("序列化只读收据查询")
+                .into(),
+            );
+            let committed =
+                match tokio::time::timeout(RECEIPT_QUERY_TIMEOUT, acp_send(request, &tx)).await {
+                    Ok(Ok(response)) => serde_json::from_str::<serde_json::Value>(response.0.get())
+                        .is_ok_and(|proof| {
+                            terminal_bridge_receipt::committed_proof(
+                                &proof,
+                                &expected.session_id,
+                                &expected.message_id,
+                                &expected.prompt_id,
+                            )
+                        }),
+                    Ok(Err(_)) | Err(_) => false,
+                };
+            let _ = sender.send(committed);
+        });
+        self.0.insert(
+            receipt.message_id.clone(),
+            PendingReceiptQuery {
+                expected: receipt,
+                result,
+                task,
+            },
+        );
+    }
+
+    fn drain(&mut self, state: &mut TerminalBridge) {
+        self.0.retain(|_, query| {
+            match query.result.try_recv() {
+                Ok(true) => {
+                    // 只有原生事件循环能把证明持久写入账本；后台任务只返回核验结果。
+                    if let Err(error) = state.observe_native_ack(
+                        &query.expected.session_id,
+                        &query.expected.prompt_id,
+                    ) {
+                        tracing::warn!(kind = ?error.kind(), "terminal_bridge.receipt_write_failed");
+                    }
+                }
+                Ok(false) | Err(oneshot::error::TryRecvError::Closed) => {}
+                Err(oneshot::error::TryRecvError::Empty) => return true,
+            }
+            false
+        });
+    }
+
+    fn clear(&mut self) {
+        for (_, query) in self.0.drain() {
+            query.task.abort();
+        }
+    }
+}
+
+impl Drop for ReceiptQueries {
+    fn drop(&mut self) {
+        self.clear();
+    }
+}
+
+pub(super) struct Connection {
+    pub(super) io: BridgeIo,
+    pub(super) state: TerminalBridge,
+    capability: Option<(oneshot::Receiver<bool>, JoinHandle<()>)>,
+    receipt_queries: ReceiptQueries,
+}
+
+pub(super) fn open(tx: &AcpAgentTx) -> Option<Connection> {
+    let io = match BridgeIo::start_from_env() {
+        Ok(io) => io?,
+        Err(error) => {
+            tracing::warn!(kind = ?error.kind(), "terminal_bridge.transport_disabled");
+            return None;
+        }
+    };
+    let state = match TerminalBridge::new(io.instance_id.clone(), io.instance_dir.clone()) {
+        Ok(state) => state,
+        Err(error) => {
+            tracing::warn!(kind = ?error.kind(), "terminal_bridge.receipts_unavailable");
+            return None;
+        }
+    };
+    let mut connection = Connection {
+        io,
+        state,
+        capability: None,
+        receipt_queries: ReceiptQueries::default(),
+    };
+    connection.check_capability(tx);
+    Some(connection)
+}
+
+impl Connection {
+    pub(super) fn suspend(&mut self) {
+        self.state.set_native_capability(false);
+        self.receipt_queries.clear();
+        if let Some((_, task)) = self.capability.take() {
+            task.abort();
+        }
+    }
+
+    pub(super) fn check_capability(&mut self, tx: &AcpAgentTx) {
+        self.suspend();
+        let tx = tx.clone();
+        let (sender, receiver) = oneshot::channel();
+        let task = tokio::spawn(async move {
+            let request = acp::ExtRequest::new(
+                "infinishell/terminal_bridge/capabilities",
+                serde_json::value::to_raw_value(&serde_json::json!({}))
+                    .expect("序列化能力查询")
+                    .into(),
+            );
+            let supported =
+                match tokio::time::timeout(Duration::from_secs(5), acp_send(request, &tx)).await {
+                    Ok(Ok(response)) => serde_json::from_str::<serde_json::Value>(response.0.get())
+                        .is_ok_and(|value| {
+                            value.get("protocolVersion").and_then(|v| v.as_u64()) == Some(1)
+                                && value.get("submitIfIdle").and_then(|v| v.as_bool()) == Some(true)
+                                && value.get("durableReceipts").and_then(|v| v.as_bool())
+                                    == Some(true)
+                        }),
+                    Ok(Err(_)) | Err(_) => false,
+                };
+            let _ = sender.send(supported);
+        });
+        self.capability = Some((receiver, task));
+    }
+
+    pub(super) fn handle(&mut self, request: BridgeRequest, app: &mut AppView) -> Vec<Effect> {
+        if let Some((receiver, _)) = self.capability.as_mut() {
+            match receiver.try_recv() {
+                Ok(supported) => {
+                    self.state.set_native_capability(supported);
+                    self.capability = None;
+                }
+                Err(oneshot::error::TryRecvError::Empty) => {}
+                Err(oneshot::error::TryRecvError::Closed) => {
+                    self.state.set_native_capability(false);
+                    self.capability = None;
+                }
+            }
+        }
+        self.receipt_queries.drain(&mut self.state);
+        let query_receipt = matches!(&request.request, Request::QueryReceipt { .. });
+        let (response, effects) = self.state.handle(request.request, app);
+        let recover = if query_receipt && self.state.native_available() {
+            match &response {
+                Response::Receipt { receipt } => Some(receipt.clone()),
+                Response::State { .. }
+                | Response::Prepared { .. }
+                | Response::NotReady { .. }
+                | Response::Unknown { .. }
+                | Response::Rejected { .. } => None,
+            }
+        } else {
+            None
+        };
+        // 客户端离线不能撤销已经领取的事务；重连只能按消息 ID 查询收据。
+        let _ = request.reply.send(response);
+        if let Some(receipt) = recover {
+            self.receipt_queries.start(&app.acp_tx, receipt);
+        }
+        effects
+    }
+
+    pub(super) fn observe_result(&mut self, result: &TaskResult) {
+        let TaskResult::TerminalBridgeResponse {
+            session_id,
+            message_id,
+            result,
+            prompt_id: Some(expected_prompt_id),
+            native_rejected,
+            ..
+        } = result
+        else {
+            return;
+        };
+        let persisted = match result {
+            Ok(response)
+                if super::super::terminal_bridge_receipt::committed(
+                    response,
+                    session_id,
+                    message_id,
+                    expected_prompt_id,
+                ) =>
+            {
+                self.state
+                    .observe_native_ack(session_id, expected_prompt_id)
+            }
+            Err(_) if *native_rejected => self
+                .state
+                .observe_native_rejection(session_id, expected_prompt_id),
+            Ok(_) | Err(_) => return,
+        };
+        if let Err(error) = persisted {
+            tracing::warn!(kind = ?error.kind(), "terminal_bridge.receipt_write_failed");
+        }
+    }
+}
+
+impl Drop for Connection {
+    fn drop(&mut self) {
+        self.suspend();
+    }
+}
