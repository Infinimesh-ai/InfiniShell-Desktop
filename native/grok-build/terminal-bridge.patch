+//! 普通终端桥的会话级空闲检查与一次接收。
+
+use super::*;
+use crate::extensions::terminal_bridge::{busy_error, duplicate_error};
+use crate::session::message_delivery::HumanPromptContent;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use xai_grok_tools::implementations::grok_build::task::types::{
+    SubagentEvent, SubagentIdleAdmissionLease,
+};
+
+const IDLE_INSPECTION_BUDGET: Duration = Duration::from_secs(2);
+
+impl SessionActor {
+    pub(super) async fn mark_terminal_bridge_committed(&self, prompt_id: &str) {
+        if let Some(committed) = self
+            .state
+            .lock()
+            .await
+            .terminal_bridge_messages
+            .get_mut(prompt_id)
+        {
+            *committed = true;
+        }
+    }
+
+    async fn terminal_bridge_idle_lease(
+        &self,
+    ) -> Result<
+        (
+            Option<SubagentIdleAdmissionLease>,
+            tokio::sync::OwnedMutexGuard<()>,
+        ),
+        (),
+    > {
+        let lease = if let Some(sender) = &self.tool_context.subagent_event_tx {
+            let (respond_to, response) = oneshot::channel();
+            sender
+                .send(SubagentEvent::IdleAdmissionCheck {
+                    parent_session_id: self.session_info.id.to_string(),
+                    respond_to,
+                })
+                .map_err(|_| ())?;
+            Some(response.await.map_err(|_| ())?.ok_or(())?)
+        } else {
+            None
+        };
+        let tasks = self
+            .tool_bridge_handle()
+            .list_tasks_for_idle_admission()
+            .await
+            .ok_or(())?;
+        if tasks.iter().any(|task| !task.completed) {
+            return Err(());
+        }
+        let piped = crate::terminal::acquire_piped_command_idle(self.session_info.id.0.as_ref())
+            .await
+            .ok_or(())?;
+        Ok((lease, piped))
+    }
+
+    pub(super) async fn admit_terminal_bridge(
+        &self,
+        prompt_id: String,
+        content: HumanPromptContent,
+    ) -> bool {
+        self.ensure_prefix_ready().await;
+        let mut state = self.state.lock().await;
+        if state.terminal_bridge_messages.contains_key(&prompt_id) {
+            let _ = content.respond_to.send(Err(duplicate_error(
+                &self.session_info.id.to_string(),
+                &prompt_id,
+            )));
+            return false;
+        }
+        if state_is_busy(&state) || state.hook_block_held() || !state.edit_holds.is_empty() {
+            let _ = content.respond_to.send(Err(busy_error(
+                &self.session_info.id.to_string(),
+                &prompt_id,
+            )));
+            return false;
+        }
+        // 任务枚举期间保持调度状态锁；其他客户不能在检查后插入或启动一轮。
+        let lease =
+            match tokio::time::timeout(IDLE_INSPECTION_BUDGET, self.terminal_bridge_idle_lease())
+                .await
+            {
+                Ok(Ok(lease)) => lease,
+                Ok(Err(())) | Err(_) => {
+                    let _ = content.respond_to.send(Err(busy_error(
+                        &self.session_info.id.to_string(),
+                        &prompt_id,
+                    )));
+                    return false;
+                }
+            };
+        // 最后一次 await 之后才检查审批与活动工作，随后同锁内立即接收。
+        let pending = self
+            .pending_interactions
+            .lock()
+            .unwrap_or_else(|e| e.into_inner());
+        if !pending.is_empty()
+            || self.active_work.load(Ordering::Acquire) != 0
+            || !state.pending_notifications.is_empty()
+        {
+            let _ = content.respond_to.send(Err(busy_error(
+                &self.session_info.id.to_string(),
+                &prompt_id,
+            )));
+            return false;
+        }
+        let HumanPromptContent {
+            prompt_blocks,
+            prompt_mode,
+            artifact_upload_ctx,
+            client_identifier,
+            screen_mode,
+            verbatim,
+            traceparent,
+            json_schema,
+            tool_overrides_update,
+            respond_to,
+            parsed_prompt_tx,
+        } = content;
+        let text = Self::queue_text_from_blocks(&prompt_blocks);
+        let (trace_gcs_config, artifact_tracker) = match artifact_upload_ctx {
+            Some(context) => (Some(context.gcs_config), Some(context.artifact_tracker)),
+            None => (None, None),
+        };
+        let item = InputItem {
+            prompt_id: prompt_id.clone(),
+            prompt_blocks,
+            prompt_mode,
+            trace_gcs_config,
+            artifact_tracker,
+            client_identifier: client_identifier.clone(),
+            screen_mode,
+            verbatim,
+            json_schema,
+            input_origin: InputOrigin::from_prompt_id(&prompt_id),
+            task_wake_fallback: None,
+            tool_overrides_update,
+            respond_to,
+            persist_ack: None,
+            parsed_prompt_tx,
+            initial_child_prompt_ready: None,
+            queue_meta: Some(crate::session::prompt_queue::QueueEntryMeta {
+                id: prompt_id.clone(),
+                version: 0,
+                owner: client_identifier,
+                last_editor: None,
+                kind: "terminal_bridge".to_owned(),
+                text: text.clone(),
+                combined_texts: None,
+            }),
+            // 已原子接收的原文不能再被另一个客户合并、编辑或变成插话。
+            queue_mutation_policy: QueueMutationPolicy::new(true, false),
+            send_now: false,
+            traceparent,
+        };
+        state.terminal_bridge_messages.insert(prompt_id, false);
+        state.notifications_suppressed = false;
+        state.pending_inputs.push_back(item);
+        // 同锁内完成接收后才能恢复子任务启动，失败路径由 RAII 自动释放。
+        drop(lease);
+        self.invalidate_side_calls_for_new_prompt();
+        self.user_input_generation.fetch_add(1, Ordering::AcqRel);
+        if let Some(gate) = &self.tool_context.task_wake_suppressed {
+            gate.set(false);
+        }
+        drop(pending);
+        self.broadcast_queue_changed(&state);
+        drop(state);
+        // 历史只记录已接收输入；被拒绝的请求不产生历史或权限变化。
+        if !text.is_empty() && !self.startup_hints.is_subagent {
+            crate::session::prompt_history::append_prompt_async(
+                self.session_info.cwd.clone(),
+                crate::session::prompt_history::PromptEntry {
+                    timestamp: chrono::Utc::now(),
+                    session_id: self.session_info.id.to_string(),
+                    prompt: text,
+                    is_bash: false,
+                },
+            )
+            .await;
+        }
+        true
+    }
+}
