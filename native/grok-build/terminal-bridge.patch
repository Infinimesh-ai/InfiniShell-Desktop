+#[test]
+fn token_comparison_requires_exact_value_and_length() {
+    assert!(token_matches("abcdef", "abcdef"));
+    assert!(!token_matches("abcdef", "abcdeg"));
+    assert!(!token_matches("abcdef", "abcde"));
+}
