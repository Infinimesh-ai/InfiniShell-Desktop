+#[test]
+fn raw_query_proof_requires_commit_and_exact_identity_without_a_prompt_response() {
+    let proof = json!({
+        "infinishellTerminalBridge": {
+            "protocolVersion": 1, "sessionId": "session-1",
+            "messageId": "message-1", "promptId": "message-1",
+            "admissionState": "committed", "admitted": true,
+        },
+    });
+    assert!(committed_proof(
+        &proof,
+        "session-1",
+        "message-1",
+        "message-1"
+    ));
+    for (key, value) in [
+        ("protocolVersion", json!(2)),
+        ("sessionId", json!("other-session")),
+        ("messageId", json!("other-message")),
+        ("promptId", json!("other-prompt")),
+        ("admissionState", json!("unknown")),
+        ("admitted", Value::Null),
+        ("admitted", json!(false)),
+    ] {
+        let mut changed = proof.clone();
+        changed
+            .get_mut("infinishellTerminalBridge")
+            .unwrap()
+            .as_object_mut()
+            .unwrap()
+            .insert(key.into(), value);
+        assert!(!committed_proof(
+            &changed,
+            "session-1",
+            "message-1",
+            "message-1"
+        ));
+    }
+    assert!(!committed_proof(
+        &json!({"result": proof}),
+        "session-1",
+        "message-1",
+        "message-1",
+    ));
+}
