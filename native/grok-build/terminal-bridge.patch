+#[test]
+fn exact_native_ack_is_required_and_receipt_queries_never_dispatch() {
+    let (directory, mut bridge, mut app) = setup();
+    let lease = lease(&mut bridge, &mut app);
+    let (response, _) = bridge.handle(submission(&lease, "正文"), &mut app);
+    let dispatched = receipt(response);
+    bridge
+        .observe_native_ack("wrong-session", &dispatched.prompt_id)
+        .unwrap();
+    bridge
+        .observe_native_ack(&dispatched.session_id, "wrong-prompt")
+        .unwrap();
+    let query = Request::QueryReceipt {
+        instance_id: "test-instance".into(),
+        message_id: dispatched.message_id.clone(),
+    };
+    let (response, effects) = bridge.handle(query.clone(), &mut app);
+    assert_eq!(receipt(response).state, ReceiptState::Dispatched);
+    assert!(effects.is_empty());
+    bridge
+        .observe_native_ack(&dispatched.session_id, &dispatched.prompt_id)
+        .unwrap();
+    let (response, effects) = bridge.handle(query, &mut app);
+    assert_eq!(receipt(response).state, ReceiptState::NativeAcknowledged);
+    assert!(effects.is_empty());
+    let journal = std::fs::read_to_string(directory.path().join("receipts.jsonl")).unwrap();
+    assert_eq!(
+        serde_json::from_str::<Receipt>(journal.lines().last().unwrap())
