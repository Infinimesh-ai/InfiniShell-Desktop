+//! 在会话检查空闲与接收输入之间，暂缓同一父会话的子任务启动和恢复。
+
+use std::collections::{HashMap, VecDeque};
+use std::future::Future;
+use std::pin::Pin;
+use std::task::{Context, Poll};
+
+use tokio::sync::oneshot;
+
+use super::agent_quotas::{ActiveMessageQuotaAdmission, TargetIncarnationKey};
+use super::wake::WakeAuthorization;
+use super::{ChildRunner, SubagentCoordinator};
+use crate::implementations::grok_build::task::active_message::ActiveMessageIngress;
+use crate::implementations::grok_build::task::types::{
+    ActiveMessageRoute, SubagentIdleAdmissionLease, SubagentRequest, SubagentSpawnRequest,
+};
+
+pub(super) struct IdleAdmissionHold {
+    release: oneshot::Receiver<()>,
+    pub(super) deferred: VecDeque<DeferredAdmission>,
+}
+
+pub(super) enum DeferredAdmission {
+    Spawn(SubagentSpawnRequest),
+    Wake {
+        subagent_id: String,
+        route: ActiveMessageRoute,
+        target: TargetIncarnationKey,
+        authorization: WakeAuthorization,
+        quota_admission: Option<ActiveMessageQuotaAdmission>,
+        ingress: ActiveMessageIngress,
+    },
+}
+
+pub(super) fn poll_released(
+    holds: &mut HashMap<String, IdleAdmissionHold>,
+    cx: &mut Context<'_>,
+) -> Poll<String> {
+    for (parent, hold) in holds {
+        if Pin::new(&mut hold.release).poll(cx).is_ready() {
+            return Poll::Ready(parent.clone());
+        }
+    }
+    Poll::Pending
+}
+
+impl<R: ChildRunner> SubagentCoordinator<R> {
+    pub(super) fn idle_admission_parent_for_request(
+        &self,
+        request: &SubagentRequest,
+    ) -> Option<String> {
+        self.idle_admission_parent_for_session(&request.parent_session_id)
+    }
+
+    fn idle_admission_parent_for_session(&self, session_id: &str) -> Option<String> {
+        self.idle_admission_holds
+            .keys()
+            .find(|parent| {
+                session_id == parent.as_str()
+                    || self.graph.is_reachable_from(session_id, parent)
+                    || self.active.values().any(|child| {
+                        child.child_session_id == session_id
+                            && self.graph.is_reachable_from(&child.request.id, parent)
+                    })
+                    || self.completed.values().any(|child| {
+                        child.child_session_id == session_id
+                            && self.graph.is_reachable_from(&child.request.id, parent)
+                    })
+            })
+            .cloned()
+    }
+
+    pub(super) fn idle_admission_parent_for_child(&self, child_id: &str) -> Option<String> {
+        self.idle_admission_holds
+            .keys()
+            .find(|parent| self.graph.is_reachable_from(child_id, parent))
+            .cloned()
+    }
+
+    pub(super) fn acquire_idle_admission(
+        &mut self,
+        parent: String,
+        respond_to: oneshot::Sender<Option<SubagentIdleAdmissionLease>>,
+    ) {
+        let busy = self.idle_admission_parent_for_session(&parent).is_some()
+            || self
+                .pending
+                .values()
+                .map(|child| &child.request)
+                .chain(self.active.values().map(|child| &child.request))
+                .chain(self.queued.iter().map(|child| child.request.as_ref()))
+                .any(|request| {
+                    request.parent_session_id == parent
+                        || self.graph.is_reachable_from(&request.id, &parent)
+                });
+        if busy {
+            let _ = respond_to.send(None);
+            return;
+        }
+        let (release, released) = oneshot::channel();
+        self.idle_admission_holds.insert(
+            parent,
+            IdleAdmissionHold {
+                release: released,
+                deferred: VecDeque::new(),
+            },
+        );
+        // 接收方超时或消失时，未送达的凭据随发送错误一起销毁并释放。
+        let _ = respond_to.send(Some(SubagentIdleAdmissionLease::new(release)));
+    }
+
+    pub(super) fn release_idle_admission(&mut self, parent: &str) {
+        let Some(hold) = self.idle_admission_holds.remove(parent) else {
+            return;
+        };
+        // 原事件及应答通道完整保留；重新走原入口的取消、身份、权限和并发限制。
+        for deferred in hold.deferred {
+            match deferred {
+                DeferredAdmission::Spawn(command) => self.handle_spawn(command),
+                DeferredAdmission::Wake {
+                    subagent_id,
+                    route,
+                    target,
+                    authorization,
+                    quota_admission,
+                    ingress,
+                } => self.wake_completed_child(
+                    subagent_id,
+                    route,
+                    target,
+                    authorization,
+                    quota_admission,
+                    ingress,
+                ),
+            }
+        }
+    }
+}
