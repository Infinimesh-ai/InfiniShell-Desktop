+use super::support::*;
+use super::*;
+use crate::session::message_delivery::HumanPromptContent;
+use crate::session::pending_interaction::PendingKind;
+use std::sync::atomic::Ordering;
+use xai_grok_tools::implementations::grok_build::task::types::SubagentEvent;
+
+fn content() -> (HumanPromptContent, oneshot::Receiver<PromptTurnResult>) {
+    let (respond_to, response) = oneshot::channel();
+    (
+        HumanPromptContent {
+            prompt_blocks: vec![acp::ContentBlock::from("中文第一行\n第二行")],
+            prompt_mode: Default::default(),
+            artifact_upload_ctx: None,
+            client_identifier: Some("test-bridge".to_owned()),
+            screen_mode: None,
+            verbatim: true,
+            traceparent: None,
+            json_schema: None,
+            tool_overrides_update: None,
+            respond_to,
+            parsed_prompt_tx: None,
+        },
+        response,
+    )
+}
+
+async fn actor() -> SessionActor {
+    let mut actor = plain_actor().await;
+    // 本组只验证真实调度入口，不向用户的快速提示历史写入测试文本。
+    actor.startup_hints.is_subagent = true;
+    actor
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn competing_bridge_requests_admit_exactly_one_and_remain_uncommitted() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            let actor = actor().await;
+            let (first, first_response) = content();
+            let (second, second_response) = content();
+            let (first_admitted, second_admitted) = futures::join!(
+                actor.admit_terminal_bridge("first".to_owned(), first),
+                actor.admit_terminal_bridge("second".to_owned(), second),
+            );
+            assert_ne!(first_admitted, second_admitted);
+            let rejected = if first_admitted {
+                second_response
+            } else {
+                first_response
+            };
+            assert_eq!(
+                serde_json::to_value(rejected.await.unwrap().unwrap_err().code).unwrap(),
+                -32071
+            );
+            let state = actor.state.lock().await;
+            assert_eq!(state.pending_inputs.len(), 1);
+            assert_eq!(state.terminal_bridge_messages.len(), 1);
+            assert!(
+                state
+                    .terminal_bridge_messages
+                    .values()
+                    .all(|committed| !committed)
+            );
+            let item = state.pending_inputs.front().unwrap();
+            assert!(item.verbatim);
+            assert!(item.is_queue_protected());
+            assert_eq!(item.queue_meta.as_ref().unwrap().kind, "terminal_bridge");
+            assert!(!item.send_now);
+            assert!(item.tool_overrides_update.is_none());
+        })
+        .await;
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn ordinary_queue_running_turn_and_edit_hold_are_never_displaced() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            for busy in ["queued", "running", "editing"] {
+                let actor = actor().await;
+                {
+                    let mut state = actor.state.lock().await;
+                    match busy {
+                        "queued" => state
+                            .pending_inputs
+                            .push_back(user_item("ordinary", "client")),
+                        "running" => state.running_task = Some(running_task_stub("ordinary")),
+                        "editing" => {
+                            state
+                                .edit_holds
+                                .insert("ordinary".to_owned(), std::time::Instant::now());
+                        }
+                        _ => unreachable!(),
+                    }
+                }
+                let (content, response) = content();
+                assert!(
+                    !actor
+                        .admit_terminal_bridge("bridge".to_owned(), content)
+                        .await
+                );
+                assert!(response.await.unwrap().is_err());
+                let state = actor.state.lock().await;
+                assert!(state.terminal_bridge_messages.is_empty());
+                if busy == "queued" {
+                    assert_eq!(state.pending_inputs.front().unwrap().prompt_id, "ordinary");
+                }
+            }
+        })
+        .await;
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn pending_permission_and_work_block_without_recording_a_message() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            for pending_permission in [true, false] {
+                let actor = actor().await;
+                if pending_permission {
+                    actor
+                        .pending_interactions
+                        .lock()
+                        .unwrap()
+                        .insert("permission".to_owned(), PendingKind::Permission);
+                } else {
+                    actor.active_work.store(1, Ordering::Release);
+                }
+                let (content, response) = content();
+                assert!(
+                    !actor
+                        .admit_terminal_bridge("bridge".to_owned(), content)
+                        .await
+                );
+                assert!(response.await.unwrap().is_err());
+                let state = actor.state.lock().await;
+                assert!(state.pending_inputs.is_empty());
+                assert!(state.terminal_bridge_messages.is_empty());
+            }
+        })
+        .await;
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn child_work_and_unavailable_coordinator_cannot_look_idle() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            for answer_busy in [true, false] {
+                let mut actor = actor().await;
+                let (sender, mut commands) = tokio::sync::mpsc::unbounded_channel();
+                actor.tool_context.subagent_event_tx = Some(sender);
+                let (content, response) = content();
+                let query = async {
+                    let command = commands.recv().await.unwrap();
+                    let SubagentEvent::IdleAdmissionCheck {
+                        parent_session_id,
+                        respond_to,
+                    } = command
+                    else {
+                        panic!("错误的查询类型")
+                    };
+                    assert_eq!(parent_session_id, actor.session_info.id.to_string());
+                    if answer_busy {
+                        let _ = respond_to.send(None);
+                    }
+                };
+                let (admitted, ()) = futures::join!(
+                    actor.admit_terminal_bridge("bridge".to_owned(), content),
+                    query
+                );
+                assert!(!admitted);
+                assert!(response.await.unwrap().is_err());
+                assert!(actor.state.lock().await.pending_inputs.is_empty());
+            }
+        })
+        .await;
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn duplicate_after_queue_removal_is_unknown_and_cannot_be_resubmitted() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            let actor = actor().await;
+            let (first, _first_response) = content();
+            assert!(
+                actor
+                    .admit_terminal_bridge("bridge".to_owned(), first)
+                    .await
+            );
+            actor.state.lock().await.pending_inputs.clear();
+            let (duplicate, response) = content();
+            assert!(
+                !actor
+                    .admit_terminal_bridge("bridge".to_owned(), duplicate)
+                    .await
+            );
+            assert_eq!(
+                serde_json::to_value(response.await.unwrap().unwrap_err().code).unwrap(),
+                -32072
+            );
+            assert!(actor.state.lock().await.pending_inputs.is_empty());
+            assert_eq!(
+                actor
+                    .state
+                    .lock()
+                    .await
+                    .terminal_bridge_messages
+                    .get("bridge"),
+                Some(&false)
+            );
+            actor.mark_terminal_bridge_committed("ordinary").await;
+            assert!(
+                !actor
+                    .state
+                    .lock()
+                    .await
+                    .terminal_bridge_messages
+                    .contains_key("ordinary")
+            );
+        })
+        .await;
+}
