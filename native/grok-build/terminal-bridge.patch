+#[test]
+fn adopted_bridge_hook_denied_never_requeues_under_a_new_identity() {
+    for own in [true, false] {
+        let mut app = adopted_bridge(own);
+        let mut response = acp::PromptResponse::new(acp::StopReason::Cancelled);
+        response.meta = Some(
+            serde_json::json!({
+                "promptId": PROMPT_ID,
+                "cancellationCategory": "HookDenied",
+            })
+            .as_object()
+            .unwrap()
+            .clone(),
+        );
+        assert_no_submit(&bridge_response(&mut app, Ok(response), None));
+        assert!(test_agent(&app, AgentId(0)).session.hook_block_hold);
+        assert_no_retry_state(&app);
+        let agent = app.agents.get_mut(&AgentId(0)).unwrap();
+        agent.release_hook_block_hold();
+        let drain = super::super::queue::maybe_drain_queue(agent, &mut app.pending_image_notices);
+        assert_no_submit(&drain.effects);
+        assert_no_retry_state(&app);
+        assert_literal_user_block(&app);
+    }
+}
+
+#[test]
+fn adopted_bridge_cancel_keeps_draft_and_never_restores_bridge_text() {
+    for own in [true, false] {
+        for draft in ["", "用户的新草稿"] {
+            let mut app = adopted_bridge(own);
+            test_agent_mut(&mut app, AgentId(0)).prompt.set_text(draft);
+            let effects = dispatch(Action::CancelTurn, &mut app);
+            assert_no_submit(&effects);
+            assert!(effects.iter().any(|effect| matches!(
+                effect,
+                Effect::CancelTurn {
+                    rewind_prompt_id: None,
+                    ..
+                }
+            )));
+            assert_eq!(test_agent(&app, AgentId(0)).prompt.text(), draft);
+            assert_no_retry_state(&app);
+            assert_literal_user_block(&app);
+        }
+    }
+}
