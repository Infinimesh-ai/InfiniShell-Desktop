+use super::*;
+use std::task::Poll;
+use tokio::sync::mpsc;
+use xai_grok_paths::AbsPathBuf;
+
+struct ReadyNotifier(mpsc::UnboundedSender<()>);
+
+#[async_trait::async_trait]
+impl SessionNotificationSender for ReadyNotifier {
+    async fn session_notification(
+        &self,
+        notification: acp::SessionNotification,
+    ) -> Result<(), acp::Error> {
+        if matches!(notification.update, acp::SessionUpdate::ToolCallUpdate(_)) {
+            let _ = self.0.send(());
+        }
+        Ok(())
+    }
+}
+
+fn session_id() -> String {
+    format!("bridge-{}", uuid::Uuid::now_v7())
+}
+
+fn request(tool_call_id: &str, command: String) -> TerminalRunRequest {
+    TerminalRunRequest {
+        tool_call_id: acp::ToolCallId::new(tool_call_id),
+        command,
+        cwd: AbsPathBuf::new(std::env::current_dir().unwrap()).unwrap(),
+        env: HashMap::new(),
+        timeout: Duration::from_secs(30),
+        output_byte_limit: 1024,
+        stream: true,
+        output_file: None,
+    }
+}
+
+#[tokio::test]
+async fn terminal_bridge_backgrounded_bash_command_stays_busy_after_turn_returns() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            let session = session_id();
+            let tool_id = "bash-mode-background";
+            let (notify, mut ready) = mpsc::unbounded_channel();
+            let runner = StreamingLocalTerminalRunner {
+                notifier: Arc::new(ReadyNotifier(notify)),
+                session_id: acp::SessionId::new(session.clone()),
+            };
+            let running = tokio::task::spawn_local(async move {
+                runner.run(request(tool_id, "sleep 30".to_owned())).await
+            });
+            tokio::time::timeout(Duration::from_secs(2), ready.recv())
+                .await
+                .unwrap()
+                .unwrap();
+            background_terminal(&session, tool_id).await;
+            let result = tokio::time::timeout(Duration::from_secs(2), running)
+                .await
+                .unwrap()
+                .unwrap()
+                .unwrap();
+            assert_eq!(result.signal.as_deref(), Some("backgrounded"));
+            assert!(acquire_piped_command_idle(&session).await.is_none());
+            release_terminal(&session, tool_id).await;
+            assert!(acquire_piped_command_idle(&session).await.is_some());
+        })
+        .await;
+}
+
+#[tokio::test]
+async fn terminal_bridge_idle_guard_blocks_external_create_before_process_spawn() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            let session = session_id();
+            let directory = tempfile::tempdir().unwrap();
+            let marker = directory.path().join("started");
+            let lease = acquire_piped_command_idle(&session).await.unwrap();
+            let args = vec![
+                "-c".to_owned(),
+                "printf started > \"$1\"; sleep 30".to_owned(),
+                "bridge".to_owned(),
+                marker.to_string_lossy().into_owned(),
+            ];
+            let mut creating = Box::pin(create_terminal(
+                &session,
+                "sh",
+                &args,
+                HashMap::new(),
+                None,
+                None,
+            ));
+            assert!(matches!(futures::poll!(&mut creating), Poll::Pending));
+            tokio::time::sleep(Duration::from_millis(50)).await;
+            assert!(!marker.exists());
+            drop(lease);
+            let terminal = creating.await.unwrap();
+            tokio::time::timeout(Duration::from_secs(2), async {
+                while !marker.exists() {
+                    tokio::time::sleep(Duration::from_millis(5)).await;
+                }
+            })
+            .await
+            .unwrap();
+            assert!(acquire_piped_command_idle(&session).await.is_none());
+            release_terminal(&session, &terminal).await;
+        })
+        .await;
+}
+
+#[tokio::test]
+async fn terminal_bridge_idle_guard_blocks_streaming_bash_before_process_spawn() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            let session = session_id();
+            let directory = tempfile::tempdir().unwrap();
+            let marker = directory.path().join("started");
+            let command = format!(
+                "printf started > {}",
+                shlex::try_quote(marker.to_str().unwrap()).unwrap()
+            );
+            let lease = acquire_piped_command_idle(&session).await.unwrap();
+            let (notify, _ready) = mpsc::unbounded_channel();
+            let runner = StreamingLocalTerminalRunner {
+                notifier: Arc::new(ReadyNotifier(notify)),
+                session_id: acp::SessionId::new(session.clone()),
+            };
+            let mut running = Box::pin(runner.run(request("bash-mode-guard", command)));
+            assert!(matches!(futures::poll!(&mut running), Poll::Pending));
+            tokio::time::sleep(Duration::from_millis(50)).await;
+            assert!(!marker.exists());
+            drop(lease);
+            assert_eq!(running.await.unwrap().exit_code, Some(0));
+            assert!(marker.exists());
+            assert!(acquire_piped_command_idle(&session).await.is_some());
+        })
+        .await;
+}
+
+#[tokio::test]
+async fn terminal_bridge_cancelled_release_keeps_live_process_visible_to_guard() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            let session = session_id();
+            let terminal = create_terminal(
+                &session,
+                "sleep",
+                &["30".to_owned()],
+                HashMap::new(),
+                None,
+                None,
+            )
+            .await
+            .unwrap();
+            let entry = get_entry(&session, &terminal).await.unwrap();
+            let child = entry.child.lock().await;
+            let mut releasing = Box::pin(release_terminal(&session, &terminal));
+            assert!(matches!(futures::poll!(&mut releasing), Poll::Pending));
+            drop(releasing);
+            drop(child);
+            assert!(get_entry(&session, &terminal).await.is_none());
+            assert!(acquire_piped_command_idle(&session).await.is_none());
+            let mut child = entry.child.lock().await;
+            child.start_kill().unwrap();
+            tokio::time::timeout(Duration::from_secs(2), child.wait())
+                .await
+                .unwrap()
+                .unwrap();
+            drop(child);
+            assert!(acquire_piped_command_idle(&session).await.is_some());
+        })
+        .await;
+}
