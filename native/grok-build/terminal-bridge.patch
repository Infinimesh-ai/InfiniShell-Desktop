+use super::*;
+use serde_json::json;
+
+fn response() -> acp::PromptResponse {
+    acp::PromptResponse::new(acp::StopReason::EndTurn).meta(
+        json!({
+            "sessionId": "session-1", "promptId": "message-1",
+            "infinishellTerminalBridge": {
+                "protocolVersion": 1, "sessionId": "session-1",
+                "messageId": "message-1", "promptId": "message-1",
+                "admissionState": "committed", "admitted": true,
+            },
+        })
+        .as_object()
+        .cloned(),
+    )
+}
+
+#[test]
+fn ordinary_completion_and_hook_refusal_are_not_durable_receipts() {
+    let ordinary = acp::PromptResponse::new(acp::StopReason::EndTurn).meta(
+        json!({
+            "sessionId":"session-1", "promptId":"message-1",
+        })
+        .as_object()
+        .cloned(),
+    );
+    assert!(!committed(&ordinary, "session-1", "message-1", "message-1"));
+    let blocked = acp::PromptResponse::new(acp::StopReason::Cancelled).meta(
+        json!({
+            "sessionId":"session-1", "promptId":"message-1", "cancellationCategory":"HookDenied",
+            "infinishellTerminalBridge": {
+                "protocolVersion":1, "sessionId":"session-1", "messageId":"message-1",
+                "promptId":"message-1", "admissionState":"unknown", "admitted":null,
+            },
+        })
+        .as_object()
+        .cloned(),
+    );
+    assert!(!committed(&blocked, "session-1", "message-1", "message-1"));
+}
+
+#[test]
+fn committed_receipt_binds_both_response_and_native_proof_identity() {
+    let mut value = response();
+    assert!(committed(&value, "session-1", "message-1", "message-1"));
+    assert!(!committed(&value, "old-session", "message-1", "message-1"));
+    assert!(!committed(
+        &value,
+        "session-1",
+        "other-message",
+        "message-1"
+    ));
+    assert!(!committed(&value, "session-1", "message-1", "old-prompt"));
+    value
+        .meta
+        .as_mut()
+        .unwrap()
+        .insert("promptId".into(), "old-prompt".into());
+    assert!(!committed(&value, "session-1", "message-1", "message-1"));
+}
+
+#[test]
+fn receipt_requires_successful_commit_and_exact_protocol() {
+    let mut value = response();
+    value
+        .meta
+        .as_mut()
+        .unwrap()
+        .get_mut("infinishellTerminalBridge")
+        .unwrap()["protocolVersion"] = 2.into();
+    assert!(!committed(&value, "session-1", "message-1", "message-1"));
+    let mut value = response();
+    value
+        .meta
+        .as_mut()
+        .unwrap()
+        .get_mut("infinishellTerminalBridge")
+        .unwrap()["admissionState"] = "dispatched".into();
+    assert!(!committed(&value, "session-1", "message-1", "message-1"));
+    let mut value = response();
+    value
+        .meta
+        .as_mut()
+        .unwrap()
+        .get_mut("infinishellTerminalBridge")
+        .unwrap()["admitted"] = Value::Null;
+    assert!(!committed(&value, "session-1", "message-1", "message-1"));
+}
+
+#[test]
+fn only_explicit_identity_bound_non_admission_can_release_a_rejected_message() {
+    let error = acp::Error::new(-32071, "terminal_bridge_not_admitted").data(json!({
+        "infinishellTerminalBridge": {
+            "protocolVersion":1,"sessionId":"session-1","promptId":"message-1",
+            "messageId":"message-1","admitted":false,
+        },
+    }));
+    assert!(rejected(&error, "session-1", "message-1", "message-1"));
+    assert!(!rejected(&error, "old-session", "message-1", "message-1"));
+    assert!(!rejected(&error, "session-1", "other-message", "message-1"));
+    let duplicate = acp::Error::new(-32072, "terminal_bridge_duplicate").data(error.data.clone());
+    assert!(!rejected(&duplicate, "session-1", "message-1", "message-1"));
+    assert!(!rejected(
+        &acp::Error::internal_error(),
+        "session-1",
+        "message-1",
+        "message-1"
+    ));
+}
+
+#[test]
+fn raw_query_proof_requires_commit_and_exact_identity_without_a_prompt_response() {
+    let proof = json!({
+        "infinishellTerminalBridge": {
+            "protocolVersion": 1, "sessionId": "session-1",
+            "messageId": "message-1", "promptId": "message-1",
+            "admissionState": "committed", "admitted": true,
+        },
+    });
+    assert!(committed_proof(
+        &proof,
+        "session-1",
+        "message-1",
+        "message-1"
+    ));
+    for (key, value) in [
+        ("protocolVersion", json!(2)),
+        ("sessionId", json!("other-session")),
+        ("messageId", json!("other-message")),
+        ("promptId", json!("other-prompt")),
+        ("admissionState", json!("unknown")),
+        ("admitted", Value::Null),
+        ("admitted", json!(false)),
+    ] {
+        let mut changed = proof.clone();
+        changed
+            .get_mut("infinishellTerminalBridge")
+            .unwrap()
+            .as_object_mut()
+            .unwrap()
+            .insert(key.into(), value);
+        assert!(!committed_proof(
+            &changed,
+            "session-1",
+            "message-1",
+            "message-1"
+        ));
+    }
+    assert!(!committed_proof(
+        &json!({"result": proof}),
+        "session-1",
+        "message-1",
+        "message-1",
+    ));
+}
