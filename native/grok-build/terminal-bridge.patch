+
+pub(super) fn invalid() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::PermissionDenied,
+        "terminal bridge Windows identity invalid",
+    )
+}
+
+struct LocalMemory(*mut c_void);
+
+impl Drop for LocalMemory {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe {
+                LocalFree(self.0);
+            }
+        }
+    }
+}
+
+/// SID 使用独立对齐存储，不保留指向 TokenUser 临时缓冲区的指针。
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct UserIdentity {
+    sid: Vec<u32>,
+    session: u32,
+    authentication: (u32, i32),
+}
+
+fn token_buffer(token: HANDLE, class: i32) -> io::Result<Vec<usize>> {
+    let mut length = 0;
+    unsafe {
+        GetTokenInformation(token, class, ptr::null_mut(), 0, &mut length);
+    }
+    if length == 0 || length > 65536 {
+        return Err(invalid());
+    }
+    let mut buffer = vec![0usize; (length as usize).div_ceil(size_of::<usize>())];
+    if unsafe {
+        GetTokenInformation(
+            token,
+            class,
+            buffer.as_mut_ptr().cast(),
+            length,
+            &mut length,
+        )
+    } == 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(buffer)
+}
+
+impl UserIdentity {
+    pub(super) fn current() -> io::Result<Self> {
+        let mut token = ptr::null_mut();
+        if unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let token = unsafe { OwnedHandle::from_raw_handle(token) };
+        Self::from_token(token.as_raw_handle())
+    }
+
+    fn from_token(token: HANDLE) -> io::Result<Self> {
+        let user = token_buffer(token, TokenUser)?;
+        if user.len() * size_of::<usize>() < size_of::<TOKEN_USER>() {
+            return Err(invalid());
+        }
+        let source = unsafe { (*(user.as_ptr().cast::<TOKEN_USER>())).User.Sid };
+        if unsafe { IsValidSid(source) } == 0 {
+            return Err(invalid());
+        }
+        let length = unsafe { GetLengthSid(source) };
+        let mut sid = vec![0u32; (length as usize).div_ceil(size_of::<u32>())];
+        if unsafe { CopySid(length, sid.as_mut_ptr().cast(), source) } == 0 {
+            return Err(invalid());
+        }
+        let session = token_buffer(token, TokenSessionId)?;
+        let statistics = token_buffer(token, TokenStatistics)?;
+        if session.len() * size_of::<usize>() < size_of::<u32>()
+            || statistics.len() * size_of::<usize>() < size_of::<TOKEN_STATISTICS>()
+        {
+            return Err(invalid());
+        }
+        let session = unsafe { *session.as_ptr().cast::<u32>() };
+        let authentication =
+            unsafe { (*statistics.as_ptr().cast::<TOKEN_STATISTICS>()).AuthenticationId };
+        Ok(Self {
+            sid,
+            session,
+            authentication: (authentication.LowPart, authentication.HighPart),
+        })
+    }
+
+    fn sid(&self) -> *mut c_void {
+        self.sid.as_ptr().cast_mut().cast()
+    }
+
+    /// 必须先读到该连接的消息；模拟令牌只在本同步函数的当前线程生效，不跨 await。
+    pub(super) fn verify_pipe_client(&self, pipe: HANDLE) -> io::Result<()> {
+        let mut pid = 0;
+        let mut session = 0;
+        if unsafe { GetNamedPipeClientProcessId(pipe, &mut pid) } == 0
+            || pid == 0
+            || unsafe { GetNamedPipeClientSessionId(pipe, &mut session) } == 0
+            || session != self.session
+        {
+            return Err(invalid());
+        }
+        if unsafe { ImpersonateNamedPipeClient(pipe) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        struct Revert;
+        impl Drop for Revert {
+            fn drop(&mut self) {
+                // 不允许运行时工作线程带着客户端模拟身份继续执行任何任务。
+                if unsafe { RevertToSelf() } == 0 {
+                    std::process::abort();
+                }
+            }
+        }
+        let revert = Revert;
+        let mut token = ptr::null_mut();
+        if unsafe { OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, 1, &mut token) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let token = unsafe { OwnedHandle::from_raw_handle(token) };
+        let peer = Self::from_token(token.as_raw_handle())?;
+        drop(revert);
+        if &peer != self {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+
+    pub(super) fn security(&self, directory: bool) -> io::Result<Security> {
+        let mut text = ptr::null_mut();
+        if unsafe { ConvertSidToStringSidW(self.sid(), &mut text) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let text_memory = LocalMemory(text.cast());
+        let mut length = 0;
+        while length < 256 && unsafe { *text.add(length) } != 0 {
+            length += 1;
+        }
+        if length == 256 {
+            return Err(invalid());
+        }
+        let sid = String::from_utf16(unsafe { std::slice::from_raw_parts(text, length) })
+            .map_err(|_| invalid())?;
+        drop(text_memory);
+        let flags = if directory { "OICI" } else { "" };
+        let sddl = format!("O:{sid}D:P(A;{flags};FA;;;{sid})(A;{flags};FA;;;SY)");
+        let wide: Vec<u16> = sddl.encode_utf16().chain(Some(0)).collect();
+        let mut descriptor = ptr::null_mut();
+        if unsafe {
+            ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                wide.as_ptr(),
+                1,
+                &mut descriptor,
+                ptr::null_mut(),
+            )
+        } == 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Security(LocalMemory(descriptor)))
+    }
+
+    pub(super) fn verify_acl(&self, file: &File, directory: bool) -> io::Result<()> {
+        let mut owner = ptr::null_mut();
+        let mut dacl: *mut ACL = ptr::null_mut();
+        let mut descriptor = ptr::null_mut();
+        let error = unsafe {
+            GetSecurityInfo(
+                file.as_raw_handle(),
+                SE_FILE_OBJECT,
+                OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+                &mut owner,
+                ptr::null_mut(),
+                &mut dacl,
+                ptr::null_mut(),
+                &mut descriptor,
+            )
+        };
+        let _memory = LocalMemory(descriptor);
+        if error != 0
+            || owner.is_null()
+            || dacl.is_null()
+            || unsafe { EqualSid(owner, self.sid()) } == 0
+        {
+            return Err(invalid());
+        }
+        let mut control = 0;
+        let mut revision = 0;
+        if unsafe { GetSecurityDescriptorControl(descriptor, &mut control, &mut revision) } == 0
+            || control & SE_DACL_PROTECTED == 0
+            || unsafe { (*dacl).AceCount } != 2
+        {
+            return Err(invalid());
+        }
+        let flags = if directory { 3 } else { 0 };
+        let mut user_seen = false;
+        let mut system_seen = false;
+        for index in 0..2 {
+            let mut raw = ptr::null_mut();
+            if unsafe { GetAce(dacl, index, &mut raw) } == 0 || raw.is_null() {
+                return Err(invalid());
+            }
+            let header = unsafe { &*raw.cast::<ACE_HEADER>() };
+            if header.AceType != 0 || header.AceFlags != flags || header.AceSize < 16 {
+                return Err(invalid());
+            }
+            let ace = unsafe { &*raw.cast::<ACCESS_ALLOWED_ACE>() };
+            if ace.Mask != FILE_ALL_ACCESS {
+                return Err(invalid());
+            }
+            let sid = ptr::addr_of!(ace.SidStart).cast_mut().cast();
+            if unsafe { IsValidSid(sid) } == 0
+                || unsafe { GetLengthSid(sid) } as usize + 8 > usize::from(header.AceSize)
+            {
+                return Err(invalid());
+            }
+            if unsafe { EqualSid(sid, self.sid()) } != 0 && !user_seen {
+                user_seen = true;
+            } else if unsafe { IsWellKnownSid(sid, WinLocalSystemSid) } != 0 && !system_seen {
+                system_seen = true;
+            } else {
+                return Err(invalid());
+            }
+        }
+        if !user_seen || !system_seen {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+}
+
+pub(super) struct Security(LocalMemory);
+
+impl Security {
+    pub(super) fn attributes(&self) -> SECURITY_ATTRIBUTES {
+        SECURITY_ATTRIBUTES {
+            nLength: size_of::<SECURITY_ATTRIBUTES>() as u32,
+            lpSecurityDescriptor: self.0.0,
+            bInheritHandle: 0,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct FileIdentity {
+    pub(super) volume: u32,
+    index: u64,
+}
+
+pub(super) fn identity(file: &File, directory: bool) -> io::Result<FileIdentity> {
+    let mut info: BY_HANDLE_FILE_INFORMATION = unsafe { mem::zeroed() };
+    if unsafe { GetFileInformationByHandle(file.as_raw_handle(), &mut info) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT != 0
+        || (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY != 0) != directory
+        || (!directory && info.nNumberOfLinks != 1)
+    {
+        return Err(invalid());
+    }
+    Ok(FileIdentity {
+        volume: info.dwVolumeSerialNumber,
+        index: (u64::from(info.nFileIndexHigh) << 32) | u64::from(info.nFileIndexLow),
+    })
+}
+
+fn wide(path: &Path) -> io::Result<Vec<u16>> {
+    let mut result: Vec<u16> = path.as_os_str().encode_wide().collect();
+    if result.contains(&0) {
+        return Err(invalid());
+    }
+    result.push(0);
+    Ok(result)
+}
+
+fn open(path: &Path, directory: bool, access: u32, share: u32) -> io::Result<File> {
+    let path = wide(path)?;
+    let handle = unsafe {
+        CreateFileW(
+            path.as_ptr(),
+            access,
+            share,
+            ptr::null(),
+            OPEN_EXISTING,
+            FILE_FLAG_OPEN_REPARSE_POINT
+                | if directory {
+                    FILE_FLAG_BACKUP_SEMANTICS
+                } else {
+                    0
+                },
+            ptr::null_mut(),
+        )
+    };
+    if handle == INVALID_HANDLE_VALUE {
+        return Err(io::Error::last_os_error());
+    }
+    let file = unsafe { File::from_raw_handle(handle) };
+    identity(&file, directory)?;
+    Ok(file)
+}
+
+/// 保持所有祖先句柄不共享 DELETE，防止在路径核验和后续打开之间替换目录。
+pub(super) struct Directory {
+    path: PathBuf,
+    ancestors: Vec<(PathBuf, File, FileIdentity)>,
+    owner: UserIdentity,
+}
+
+impl Directory {
+    pub(super) fn open(path: &Path, owner: &UserIdentity) -> io::Result<Self> {
+        let mut components = path.components();
+        let drive = match components.next() {
+            Some(Component::Prefix(prefix)) => match prefix.kind() {
+                Prefix::Disk(drive) | Prefix::VerbatimDisk(drive) => drive,
+                _ => return Err(invalid()),
+            },
+            _ => return Err(invalid()),
+        };
+        if !path.is_absolute()
+            || components.any(|part| !matches!(part, Component::RootDir | Component::Normal(_)))
+        {
+            return Err(invalid());
+        }
+        let drive_root = [u16::from(drive), b':' as u16, b'\\' as u16, 0];
+        // GetDriveTypeW 的 DRIVE_FIXED 值为 3；UNC、映射网络盘和可移动盘均不作私有桥根。
+        if unsafe { GetDriveTypeW(drive_root.as_ptr()) } != 3 {
+            return Err(invalid());
+        }
+        let mut ancestors = Vec::new();
+        for path in path.ancestors().collect::<Vec<_>>().into_iter().rev() {
+            let file = open(
+                path,
+                true,
+                // 仅查询属性不参与删除共享限制；保留目录读取权才能阻止改名和删除。
+                READ_CONTROL | FILE_READ_ATTRIBUTES | FILE_LIST_DIRECTORY,
+                FILE_SHARE_READ | FILE_SHARE_WRITE,
+            )?;
+            let id = identity(&file, true)?;
+            ancestors.push((path.to_owned(), file, id));
+        }
+        let result = Self {
+            path: path.to_owned(),
+            ancestors,
+            owner: owner.clone(),
+        };
+        result.validate()?;
+        Ok(result)
+    }
+
+    pub(super) fn identity(&self) -> FileIdentity {
+        self.ancestors.last().expect("目录含根句柄").2
+    }
+
+    pub(super) fn validate(&self) -> io::Result<()> {
+        for (path, file, expected) in &self.ancestors {
+            let reopened = open(
+                path,
+                true,
+                READ_CONTROL | FILE_READ_ATTRIBUTES | FILE_LIST_DIRECTORY,
+                FILE_SHARE_READ | FILE_SHARE_WRITE,
+            )?;
+            if identity(file, true)? != *expected || identity(&reopened, true)? != *expected {
+                return Err(invalid());
+            }
+        }
+        self.owner
+            .verify_acl(&self.ancestors.last().ok_or_else(invalid)?.1, true)
+    }
+
+    pub(super) fn create_child(&self, name: &str) -> io::Result<Self> {
+        if name.is_empty() || name.contains(['/', '\\', ':']) || name == "." || name == ".." {
+            return Err(invalid());
+        }
+        self.validate()?;
+        let path = self.path.join(name);
+        let security = self.owner.security(true)?;
+        let attributes = security.attributes();
+        let wide = wide(&path)?;
+        if unsafe { CreateDirectoryW(wide.as_ptr(), &attributes) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let child = Self::open(&path, &self.owner)?;
+        self.validate()?;
+        if child.identity().volume != self.identity().volume {
+            return Err(invalid());
+        }
+        Ok(child)
+    }
+
+    pub(super) fn path(&self) -> &Path {
+        &self.path
+    }
+
+    pub(super) fn create_file(&self, name: &str) -> io::Result<File> {
+        if !matches!(name, "manifest.json" | "receipts.jsonl") {
+            return Err(invalid());
+        }
+        self.validate()?;
+        let security = self.owner.security(false)?;
+        let attributes = security.attributes();
+        let path = wide(&self.path.join(name))?;
+        let handle = unsafe {
+            CreateFileW(
+                path.as_ptr(),
+                FILE_GENERIC_READ | FILE_GENERIC_WRITE | READ_CONTROL,
+                FILE_SHARE_READ,
+                &attributes,
+                CREATE_NEW,
+                FILE_FLAG_OPEN_REPARSE_POINT,
+                ptr::null_mut(),
+            )
+        };
+        if handle == INVALID_HANDLE_VALUE {
+            return Err(io::Error::last_os_error());
+        }
+        let file = unsafe { File::from_raw_handle(handle) };
+        self.validate_file(&file)?;
+        Ok(file)
+    }
+
+    pub(super) fn read_file(&self, name: &str) -> io::Result<File> {
+        self.validate()?;
+        let file = open(
+            &self.path.join(name),
+            false,
+            FILE_GENERIC_READ | READ_CONTROL,
+            FILE_SHARE_READ,
+        )?;
+        self.validate_file(&file)?;
+        Ok(file)
+    }
+
+    pub(super) fn validate_file(&self, file: &File) -> io::Result<FileIdentity> {
+        self.validate()?;
+        let id = identity(file, false)?;
+        if id.volume != self.identity().volume {
+            return Err(invalid());
+        }
+        self.owner.verify_acl(file, false)?;
+        Ok(id)
+    }
+
+    pub(super) fn remove_manifest(&self, expected: FileIdentity) -> io::Result<()> {
+        self.validate()?;
+        let file = open(
+            &self.path.join("manifest.json"),
+            false,
+            DELETE | READ_CONTROL | FILE_READ_ATTRIBUTES,
+            FILE_SHARE_READ,
+        )?;
+        if self.validate_file(&file)? != expected {
+            return Err(invalid());
+        }
+        let disposition = FILE_DISPOSITION_INFO { DeleteFile: 1 };
+        if unsafe {
+            SetFileInformationByHandle(
+                file.as_raw_handle(),
+                FileDispositionInfo,
+                ptr::addr_of!(disposition).cast(),
+                size_of::<FILE_DISPOSITION_INFO>() as u32,
+            )
+        } == 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(())
+    }
+}
+
+pub(super) struct Journal {
+    file: File,
+    directory: Directory,
+    root: Directory,
+    identity: FileIdentity,
+}
+
+impl Journal {
+    pub(super) fn new(path: &Path) -> io::Result<Self> {
+        let owner = UserIdentity::current()?;
+        let root = Directory::open(path.parent().ok_or_else(invalid)?, &owner)?;
+        let directory = Directory::open(path, &owner)?;
+        let file = directory.create_file("receipts.jsonl")?;
+        let identity = directory.validate_file(&file)?;
+        let journal = Self {
+            file,
+            directory,
+            root,
+            identity,
+        };
+        journal.sync_all()?;
+        Ok(journal)
+    }
+
+    pub(super) fn sync_all(&self) -> io::Result<()> {
+        self.root.validate()?;
+        if self.directory.validate_file(&self.file)? != self.identity {
+            return Err(invalid());
+        }
+        self.file.sync_all()
+    }
+}
+
+impl Write for Journal {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.root.validate()?;
+        if self.directory.validate_file(&self.file)? != self.identity {
+            return Err(invalid());
+        }
+        self.file.write(bytes)
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        self.file.flush()
+    }
+}
