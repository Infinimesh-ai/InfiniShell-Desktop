+use super::*;
+
+use crate::app::agent::AgentId;
+use crate::app::app_view::tests::test_app_with_agent;
+use crate::views::agent::ActivePane;
+use serde_json::json;
+use tokio::sync::mpsc;
+use xai_acp_lib::{AcpAgentMessage, AcpAgentRx, AcpArgs};
+
+fn dispatched() -> (tempfile::TempDir, TerminalBridge, AppView, Request, Receipt) {
+    let directory = tempfile::tempdir().unwrap();
+    let mut state =
+        TerminalBridge::new("fixture-instance".into(), directory.path().into()).unwrap();
+    state.set_native_capability(true);
+    let mut app = test_app_with_agent();
+    app.agents.get_mut(&AgentId(0)).unwrap().active_pane = ActivePane::Prompt;
+    let (response, _) = state.handle(
+        Request::State {
+            instance_id: "fixture-instance".into(),
+        },
+        &mut app,
+    );
+    let Response::State {
+        lease: Some(lease), ..
+    } = response
+    else {
+        panic!("应取得原生空闲租约");
+    };
+    let message_id = uuid::Uuid::new_v4().to_string();
+    let request = Request::SubmitIfIdle {
+        instance_id: "fixture-instance".into(),
+        lease_id: lease.lease_id,
+        session_id: lease.session_id,
+        binding_epoch: lease.binding_epoch,
+        input_epoch: lease.input_epoch,
+        message_id: message_id.clone(),
+        prompt_id: message_id,
+        text: "只查询收据，不重新投递此正文".into(),
+    };
+    let (response, effects) = state.handle(request.clone(), &mut app);
+    assert_eq!(effects.len(), 1);
+    let Response::Receipt { receipt } = response else {
+        panic!("应记录已派发事务");
+    };
+    assert_eq!(receipt.state, ReceiptState::Dispatched);
+    (directory, state, app, request, receipt)
+}
+
+fn local_receipt(state: &mut TerminalBridge, app: &mut AppView, receipt: &Receipt) -> Receipt {
+    let (response, effects) = state.handle(
+        Request::QueryReceipt {
+            instance_id: "fixture-instance".into(),
+            message_id: receipt.message_id.clone(),
+        },
+        app,
+    );
+    assert!(effects.is_empty());
+    let Response::Receipt { receipt } = response else {
+        panic!("本地领取记录应保留");
+    };
+    receipt
+}
+
+async fn receive_query(rx: &mut AcpAgentRx, receipt: &Receipt) -> AcpArgs<acp::ExtRequest> {
+    let Some(AcpAgentMessage::ExtMethod(args)) = rx.recv().await else {
+        panic!("恢复只能发送只读扩展");
+    };
+    assert_eq!(args.request.method.as_ref(), "infinishell/session/receipt");
+    let params: serde_json::Value = serde_json::from_str(args.request.params.get()).unwrap();
+    assert_eq!(
+        params,
+        json!({
+            "protocolVersion": 1,
+            "sessionId": receipt.session_id,
+            "promptId": receipt.prompt_id,
+            "messageId": receipt.message_id,
+        })
+    );
+    args
+}
+
+fn proof(receipt: &Receipt) -> serde_json::Value {
+    json!({"infinishellTerminalBridge": {
+        "protocolVersion": 1,
+        "sessionId": receipt.session_id,
+        "promptId": receipt.prompt_id,
+        "messageId": receipt.message_id,
+        "admissionState": "committed", "admitted": true,
+    }})
+}
+
+fn respond(args: AcpArgs<acp::ExtRequest>, proof: &serde_json::Value) {
+    args.response_tx
+        .send(Ok(acp::ExtResponse::new(
+            serde_json::value::to_raw_value(proof).unwrap().into(),
+        )))
+        .ok()
+        .unwrap();
+}
+
+async fn finish_query(queries: &mut ReceiptQueries, message_id: &str) {
+    (&mut queries.0.get_mut(message_id).unwrap().task)
+        .await
+        .unwrap();
+}
+
+#[tokio::test]
+async fn recovery_reads_receipt_once_and_acknowledges_only_in_event_loop() {
+    let (directory, mut state, mut app, original, receipt) = dispatched();
+    let (tx, mut rx) = mpsc::unbounded_channel();
+    let mut queries = ReceiptQueries::default();
+    queries.start(&tx, receipt.clone());
+    queries.start(&tx, receipt.clone());
+    assert_eq!(queries.0.len(), 1);
+    let args = receive_query(&mut rx, &receipt).await;
+    respond(args, &proof(&receipt));
+    finish_query(&mut queries, &receipt.message_id).await;
+    // 后台查询结束仍不能自行写账本。
+    assert_eq!(
+        local_receipt(&mut state, &mut app, &receipt).state,
+        ReceiptState::Dispatched
+    );
+    queries.drain(&mut state);
+    assert_eq!(
+        local_receipt(&mut state, &mut app, &receipt).state,
+        ReceiptState::NativeAcknowledged
+    );
+    assert!(queries.0.is_empty());
+    assert!(rx.try_recv().is_err());
+    let (_, effects) = state.handle(original, &mut app);
+    assert!(effects.is_empty());
+    let journal = std::fs::read_to_string(directory.path().join("receipts.jsonl")).unwrap();
+    let last: Receipt = serde_json::from_str(journal.lines().last().unwrap()).unwrap();
+    assert_eq!(last.state, ReceiptState::NativeAcknowledged);
+}
+
+#[tokio::test]
+async fn unknown_or_wrong_identity_never_acknowledges_or_releases_duplicate_lock() {
+    for key in ["admissionState", "sessionId", "messageId", "promptId"] {
+        let (_directory, mut state, mut app, original, receipt) = dispatched();
+        let (tx, mut rx) = mpsc::unbounded_channel();
+        let mut queries = ReceiptQueries::default();
+        queries.start(&tx, receipt.clone());
+        let args = receive_query(&mut rx, &receipt).await;
+        let mut changed = proof(&receipt);
+        changed
+            .get_mut("infinishellTerminalBridge")
+            .unwrap()
+            .as_object_mut()
+            .unwrap()
+            .insert(key.into(), "unknown".into());
+        respond(args, &changed);
+        finish_query(&mut queries, &receipt.message_id).await;
+        queries.drain(&mut state);
+        assert_eq!(
+            local_receipt(&mut state, &mut app, &receipt).state,
+            ReceiptState::Dispatched
+        );
+        let (_, effects) = state.handle(original, &mut app);
+        assert!(effects.is_empty());
+        assert!(rx.try_recv().is_err());
+    }
+}
+
+#[tokio::test]
+async fn receipt_queries_are_bounded_and_disconnect_cancels_each_inflight_request() {
+    let (_directory, mut state, mut app, _original, receipt) = dispatched();
+    let (tx, mut rx) = mpsc::unbounded_channel();
+    let mut queries = ReceiptQueries::default();
+    for index in 0..=MAX_RECEIPT_QUERIES {
+        let mut candidate = receipt.clone();
+        let id = uuid::Uuid::from_u128(index as u128 + 1).to_string();
+        candidate.message_id = id.clone();
+        candidate.prompt_id = id;
+        queries.start(&tx, candidate.clone());
+    }
+    assert_eq!(queries.0.len(), MAX_RECEIPT_QUERIES);
+    let mut requests = Vec::new();
+    // 各查询任务允许不同调度顺序，按发送中的身份核对即可。
+    for _ in 0..MAX_RECEIPT_QUERIES {
+        let Some(AcpAgentMessage::ExtMethod(args)) = rx.recv().await else {
+            panic!("只允许收据查询");
+        };
+        assert_eq!(args.request.method.as_ref(), "infinishell/session/receipt");
+        requests.push(args);
+    }
+    assert!(rx.try_recv().is_err());
+    queries.clear();
+    tokio::task::yield_now().await;
+    assert!(queries.0.is_empty());
+    assert!(requests.iter().all(|args| args.response_tx.is_closed()));
+    queries.drain(&mut state);
+    assert_eq!(
+        local_receipt(&mut state, &mut app, &receipt).state,
+        ReceiptState::Dispatched
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn query_timeout_keeps_pending_receipt_and_retries_only_the_read() {
+    let (_directory, mut state, mut app, _original, receipt) = dispatched();
+    let (tx, mut rx) = mpsc::unbounded_channel();
+    let mut queries = ReceiptQueries::default();
+    queries.start(&tx, receipt.clone());
+    let first = receive_query(&mut rx, &receipt).await;
+    tokio::time::advance(RECEIPT_QUERY_TIMEOUT + Duration::from_millis(1)).await;
+    finish_query(&mut queries, &receipt.message_id).await;
+    queries.drain(&mut state);
+    assert!(first.response_tx.is_closed());
+    assert_eq!(
+        local_receipt(&mut state, &mut app, &receipt).state,
+        ReceiptState::Dispatched
+    );
+    queries.start(&tx, receipt.clone());
+    let second = receive_query(&mut rx, &receipt).await;
+    respond(second, &proof(&receipt));
+    finish_query(&mut queries, &receipt.message_id).await;
+    // 断线清理也丢弃已经到达但尚未由原生循环消费的旧连接结果。
+    queries.clear();
+    queries.drain(&mut state);
+    assert_eq!(
+        local_receipt(&mut state, &mut app, &receipt).state,
+        ReceiptState::Dispatched
+    );
+    assert!(rx.try_recv().is_err());
+}
