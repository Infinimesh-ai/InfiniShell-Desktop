+#![cfg(unix)]
+
+#[allow(dead_code)]
+mod acp_harness;
+
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use acp_harness::{AutoApproveClient, RPC_TIMEOUT, connect_and_auth, ext_method, run_agent_test};
+use agent_client_protocol::{self as acp, Agent as _};
+use serde_json::json;
+use sha2::{Digest, Sha256};
+use xai_grok_shell::session::notification_plugin::NotificationPlugin;
+use xai_hooks_plugins_types::HooksListResponse;
+
+fn start_hook(marker: &Path) -> serde_json::Value {
+    json!({"hooks": {"SessionStart": [{"hooks": [{
+        "type": "command", "command": format!("printf 'start\\n' >> '{}'", marker.display()),
+        "timeout": 5
+    }]}]}})
+}
+
+fn write_json(path: &Path, value: serde_json::Value) {
+    std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+    std::fs::write(path, serde_json::to_vec(&value).unwrap()).unwrap();
+}
+
+fn notification_plugin(cwd: &Path, plugin_dir: PathBuf, session_id: String) -> NotificationPlugin {
+    write_json(
+        &plugin_dir.join(".grok-plugin/plugin.json"),
+        json!({"name": "infinishell-grok", "version": "test"}),
+    );
+    let hooks = [
+        "SessionStart", "UserPromptSubmit", "PostToolUse", "PostToolUseFailure",
+        "PermissionDenied", "Notification", "StopFailure", "Stop", "SessionEnd", "StopCancelled",
+    ].into_iter().map(|event| (event.to_owned(), json!([{"hooks": [{
+        "type": "command",
+        "command": "node -e \"require(process.env.GROK_PLUGIN_ROOT + '/hooks/notify.cjs').main()\"",
+        "timeout": 5,
+        "env": {
+            "WARP_CLI_AGENT_PROTOCOL_VERSION": "1",
+            "WARP_CLI_AGENT_NOTIFY_EXECUTABLE": cwd.join("synthetic-worker"),
+            "WARP_CLI_AGENT_SESSION_ROUTE": "1"
+        }
+    }]}]))).collect::<serde_json::Map<_, _>>();
+    write_json(
+        &plugin_dir.join("hooks/hooks.json"),
+        json!({"hooks": hooks}),
+    );
+    std::fs::write(
+        plugin_dir.join("hooks/notify.cjs"),
+        b"exports.main = () => {};\n",
+    )
+    .unwrap();
+    let files = [
+        ".grok-plugin/plugin.json",
+        "hooks/hooks.json",
+        "hooks/notify.cjs",
+    ]
+    .into_iter()
+    .map(|name| {
+        (
+            name.to_owned(),
+            format!(
+                "{:x}",
+                Sha256::digest(std::fs::read(plugin_dir.join(name)).unwrap())
+            ),
+        )
+    })
+    .collect();
+    let binding = NotificationPlugin {
+        version: 1,
+        session_id,
+        cwd: cwd.to_owned(),
+        plugin_dir,
+        files,
+    };
+    binding.validate_target(&binding.session_id, cwd).unwrap();
+    binding
+}
+
+async fn list_hooks(
+    conn: &acp::ClientSideConnection,
+    session_id: &acp::SessionId,
+) -> HooksListResponse {
+    let response = ext_method(conn, "x.ai/hooks/list", json!({"sessionId": session_id.0})).await;
+    serde_json::from_value(response.get("result").unwrap_or(&response).clone()).unwrap()
+}
+
+#[test]
+fn session_create_initializes_plugin_hooks_before_session_start() {
+    run_agent_test(|cwd, _server| async move {
+        let cwd = dunce::canonicalize(cwd).unwrap();
+        let grok_home = PathBuf::from(std::env::var("GROK_HOME").unwrap());
+        // 仅隔离 GROK_HOME；不改用户 HOME/CODEX_HOME，也不导入用户兼容配置。
+        std::fs::write(grok_home.join("config.toml"), concat!(
+            "[claude_compat]\nimported = true\n",
+            "[plugins]\ndisabled = [\"disabled-plugin\"]\n",
+            "[compat.claude]\nskills = false\nrules = false\nagents = false\nmcps = false\nhooks = false\nsessions = false\n",
+            "[compat.cursor]\nskills = false\nrules = false\nagents = false\nmcps = false\nhooks = false\nsessions = false\n",
+        )).unwrap();
+        git2::Repository::init(&cwd).unwrap();
+        let global_marker = cwd.join("global-start");
+        let project_marker = cwd.join("project-start");
+        let file_marker = cwd.join("file-start");
+        let inline_marker = cwd.join("inline-start");
+        let disabled_marker = cwd.join("disabled-start");
+        let user_disabled_marker = cwd.join("user-disabled-start");
+        write_json(
+            &grok_home.join("hooks/global.json"),
+            start_hook(&global_marker),
+        );
+        write_json(
+            &cwd.join(".grok/hooks/project.json"),
+            start_hook(&project_marker),
+        );
+        xai_grok_workspace::folder_trust::grant_folder_trust(&cwd);
+
+        let file_plugin = cwd.join("file-plugin");
+        write_json(
+            &file_plugin.join("plugin.json"),
+            json!({"name": "file-plugin"}),
+        );
+        write_json(
+            &file_plugin.join("hooks/hooks.json"),
+            start_hook(&file_marker),
+        );
+        let user_disabled_plugin = cwd.join("user-disabled-plugin");
+        write_json(
+            &user_disabled_plugin.join("plugin.json"),
+            json!({"name": "user-disabled-plugin"}),
+        );
+        write_json(
+            &user_disabled_plugin.join("hooks/hooks.json"),
+            start_hook(&user_disabled_marker),
+        );
+        let disabled_hook_name = "plugin/user-disabled-plugin/hooks:session_start[0].hooks[0]";
+        std::fs::write(
+            grok_home.join("disabled-hooks"),
+            format!("{disabled_hook_name}\n"),
+        )
+        .unwrap();
+        let inline_plugin = cwd.join("inline-plugin");
+        write_json(
+            &inline_plugin.join("plugin.json"),
+            json!({
+                "name": "inline-plugin", "hooks": start_hook(&inline_marker)
+            }),
+        );
+        let disabled_plugin = cwd.join("disabled-plugin");
+        write_json(
+            &disabled_plugin.join("plugin.json"),
+            json!({
+                "name": "disabled-plugin", "hooks": start_hook(&disabled_marker)
+            }),
+        );
+
+        let sid = uuid::Uuid::new_v4().to_string();
+        let binding = notification_plugin(&cwd, cwd.join("notification-plugin"), sid.clone());
+        let (conn, _init) = connect_and_auth(AutoApproveClient, "plugin-startup-test").await;
+        // 走真实 ACP→prefetch→actor 启动；这里不伪造 leader 的原生终端身份。
+        let session = tokio::time::timeout(RPC_TIMEOUT, conn.new_session(
+            acp::NewSessionRequest::new(cwd.clone()).meta(json!({
+                "modelId": "test-model", "sessionId": sid,
+                "pluginDirs": [file_plugin, inline_plugin, disabled_plugin, user_disabled_plugin, binding.plugin_dir]
+            }).as_object().cloned())
+        )).await.unwrap().unwrap().session_id;
+        let hooks = list_hooks(&conn, &session).await;
+        assert!(hooks.load_errors.is_empty(), "{:?}", hooks.load_errors);
+        assert_eq!(
+            hooks
+                .hooks
+                .iter()
+                .filter(|hook| hook.name.starts_with("plugin/infinishell-grok/"))
+                .count(),
+            10
+        );
+        assert!(
+            !hooks
+                .hooks
+                .iter()
+                .any(|hook| hook.name.starts_with("plugin/disabled-plugin/"))
+        );
+        assert!(
+            hooks
+                .hooks
+                .iter()
+                .any(|hook| hook.name == disabled_hook_name && hook.disabled)
+        );
+        assert_eq!(
+            hooks
+                .hooks
+                .iter()
+                .filter(|hook| hook.name.starts_with("global/"))
+                .count(),
+            1
+        );
+        assert_eq!(
+            hooks
+                .hooks
+                .iter()
+                .filter(|hook| hook.name.starts_with("project/"))
+                .count(),
+            1
+        );
+
+        tokio::time::timeout(Duration::from_secs(15), async {
+            while [
+                &global_marker,
+                &project_marker,
+                &file_marker,
+                &inline_marker,
+            ]
+            .iter()
+            .any(|marker| !marker.exists())
+            {
+                tokio::time::sleep(Duration::from_millis(20)).await;
+            }
+        })
+        .await
+        .expect("真实启动必须执行文件插件、内联插件及既有全局/项目 SessionStart");
+        assert_eq!(std::fs::read_to_string(global_marker).unwrap(), "start\n");
+        assert_eq!(std::fs::read_to_string(project_marker).unwrap(), "start\n");
+        assert_eq!(std::fs::read_to_string(file_marker).unwrap(), "start\n");
+        assert_eq!(std::fs::read_to_string(inline_marker).unwrap(), "start\n");
+        assert!(!disabled_marker.exists());
+        assert!(!user_disabled_marker.exists());
+
+        // 后续普通新会话不能继承前一会话的插件目录。
+        let next = acp_harness::new_session(&conn, &cwd).await;
+        assert!(
+            !list_hooks(&conn, &next)
+                .await
+                .hooks
+                .iter()
+                .any(|hook| hook.name.starts_with("plugin/"))
+        );
+    });
+}
