+    other = owner.clone();
+    other.session = other.session.wrapping_add(1);
+    assert!(other.verify_pipe_client(server.as_raw_handle()).is_err());
+    // 两次失败后当前线程必须已恢复自身令牌，不能把模拟身份留给后续任务。
+    owner.verify_pipe_client(server.as_raw_handle()).unwrap();
+}
