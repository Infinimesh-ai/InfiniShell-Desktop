+//! 显式启动的 InfiniShell 通知插件只属于一个会话，不写入 leader 的全局插件配置。
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs::{self, OpenOptions};
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+
+use agent_client_protocol as acp;
+use anyhow::{Context, Result, ensure};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+use super::persistence;
+use super::session_create_prefetch::SESSION_PLUGIN_DIRS_META_KEY;
+
+pub const META_KEY: &str = "infinishell/notificationPlugin";
+const BINDING_FILE: &str = "infinishell-notification-plugin.json";
+const RESOURCE_FILES: [&str; 3] = [
+    ".grok-plugin/plugin.json",
+    "hooks/hooks.json",
+    "hooks/notify.cjs",
+];
+const NOTIFY_COMMAND: &str =
+    "node -e \"require(process.env.GROK_PLUGIN_ROOT + '/hooks/notify.cjs').main()\"";
+const EVENTS: [&str; 10] = [
+    "SessionStart",
+    "UserPromptSubmit",
+    "PostToolUse",
+    "PostToolUseFailure",
+    "PermissionDenied",
+    "Notification",
+    "StopFailure",
+    "Stop",
+    "SessionEnd",
+    "StopCancelled",
+];
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NotificationPlugin {
+    pub version: u32,
+    pub session_id: String,
+    pub cwd: PathBuf,
+    pub plugin_dir: PathBuf,
+    pub files: BTreeMap<String, String>,
+}
+
+impl NotificationPlugin {
+    pub fn from_file(path: &Path) -> Result<Self> {
+        let binding: Self = serde_json::from_slice(&read_regular(path, 16 * 1024)?)?;
+        binding.validate()?;
+        Ok(binding)
+    }
+
+    pub fn validate_target(&self, session_id: &str, cwd: &Path) -> Result<()> {
+        ensure!(
+            self.session_id == session_id,
+            "notification plugin session mismatch"
+        );
+        ensure!(
+            self.cwd == dunce::canonicalize(cwd)?,
+            "notification plugin cwd mismatch"
+        );
+        self.validate()
+    }
+
+    /// 后续 /new、切换到其他 SID 和派生会话不会继承本次启动的授权。
+    pub fn add_meta_for(&self, session_id: Option<&str>, meta: &mut Option<acp::Meta>) {
+        if session_id == Some(self.session_id.as_str()) {
+            meta.get_or_insert_with(acp::Meta::new).insert(
+                META_KEY.into(),
+                serde_json::to_value(self).expect("通知插件绑定只包含可序列化字段"),
+            );
+        }
+    }
+
+    pub(crate) fn validate(&self) -> Result<()> {
+        ensure!(
+            self.version == 1,
+            "unsupported notification plugin binding version"
+        );
+        uuid::Uuid::try_parse(&self.session_id).context("invalid notification plugin session")?;
+        require_canonical_dir(&self.cwd)?;
+        require_canonical_dir(&self.plugin_dir)?;
+        ensure!(
+            self.files.len() == RESOURCE_FILES.len(),
+            "notification plugin resource set mismatch"
+        );
+        let mut bytes = BTreeMap::new();
+        for relative in RESOURCE_FILES {
+            let expected = self
+                .files
+                .get(relative)
+                .context("missing notification plugin resource")?;
+            ensure!(
+                expected.len() == 64
+                    && expected
+                        .bytes()
+                        .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+                "invalid notification plugin SHA-256"
+            );
+            let actual = read_regular(&self.plugin_dir.join(relative), 256 * 1024)?;
+            ensure!(
+                format!("{:x}", Sha256::digest(&actual)) == *expected,
+                "notification plugin resource digest mismatch"
+            );
+            bytes.insert(relative, actual);
+        }
+        require_entries(&self.plugin_dir, &[".grok-plugin", "hooks"])?;
+        require_entries(&self.plugin_dir.join(".grok-plugin"), &["plugin.json"])?;
+        require_entries(
+            &self.plugin_dir.join("hooks"),
+            &["hooks.json", "notify.cjs"],
+        )?;
+        let manifest: serde_json::Value = serde_json::from_slice(
+            bytes
+                .get(".grok-plugin/plugin.json")
+                .context("missing plugin manifest")?,
+        )?;
+        let manifest = manifest
+            .as_object()
+            .context("invalid notification plugin manifest")?;
+        ensure!(
+            manifest
+                .keys()
+                .all(|key| matches!(key.as_str(), "name" | "version" | "description")),
+            "notification plugin cannot declare other components"
+        );
+        ensure!(
+            manifest.get("name").and_then(|v| v.as_str()) == Some("infinishell-grok"),
+            "unexpected notification plugin name"
+        );
+        let hooks: serde_json::Value = serde_json::from_slice(
+            bytes
+                .get("hooks/hooks.json")
+                .context("missing plugin hooks")?,
+        )?;
+        validate_hooks(&hooks)?;
+        Ok(())
+    }
+}
+
+fn validate_hooks(value: &serde_json::Value) -> Result<()> {
+    let root = value.as_object().context("invalid notification hooks")?;
+    ensure!(root.len() == 1, "unexpected notification hooks fields");
+    let hooks = root
+        .get("hooks")
+        .and_then(|v| v.as_object())
+        .context("missing notification hooks")?;
+    ensure!(
+        hooks.len() == EVENTS.len(),
+        "notification event set mismatch"
+    );
+    for event in EVENTS {
+        let rules = hooks
+            .get(event)
+            .and_then(|v| v.as_array())
+            .context("missing notification event")?;
+        ensure!(rules.len() == 1, "unexpected notification rules");
+        let rule = rules
+            .first()
+            .and_then(|v| v.as_object())
+            .context("invalid notification rule")?;
+        ensure!(rule.len() == 1, "unexpected notification matcher");
+        let handlers = rule
+            .get("hooks")
+            .and_then(|v| v.as_array())
+            .context("missing notification handlers")?;
+        ensure!(handlers.len() == 1, "unexpected notification handlers");
+        let handler = handlers
+            .first()
+            .and_then(|v| v.as_object())
+            .context("invalid notification handler")?;
+        ensure!(
+            handler
+                .keys()
+                .all(|key| matches!(key.as_str(), "type" | "command" | "timeout" | "env")),
+            "unexpected notification handler fields"
+        );
+        ensure!(
+            handler.get("type").and_then(|v| v.as_str()) == Some("command")
+                && handler.get("command").and_then(|v| v.as_str()) == Some(NOTIFY_COMMAND)
+                && handler.get("timeout").and_then(|v| v.as_u64()) == Some(5),
+            "notification handler must use the fixed notification entrypoint"
+        );
+        // env 由宿主写入最终资源并绑定摘要；不能依赖已存在 leader 的进程环境。
+        let env = handler
+            .get("env")
+            .and_then(|v| v.as_object())
+            .context("missing notification environment")?;
+        ensure!(
+            env.len() == 3
+                && env
+                    .get("WARP_CLI_AGENT_PROTOCOL_VERSION")
+                    .and_then(|v| v.as_str())
+                    == Some("1")
+                && env
+                    .get(super::notification_route::ROUTE_REQUIRED_ENV)
+                    .and_then(|v| v.as_str())
+                    == Some("1"),
+            "unexpected notification environment"
+        );
+        let executable = env
+            .get("WARP_CLI_AGENT_NOTIFY_EXECUTABLE")
+            .and_then(|v| v.as_str())
+            .context("missing notification worker")?;
+        ensure!(
+            Path::new(executable).is_absolute() && !executable.contains('\0'),
+            "invalid notification worker path"
+        );
+    }
+    Ok(())
+}
+
+fn require_canonical_dir(path: &Path) -> Result<()> {
+    ensure!(
+        path.is_absolute() && dunce::canonicalize(path)? == path,
+        "notification plugin path must be canonical and absolute"
+    );
+    let metadata = fs::symlink_metadata(path)?;
+    ensure!(
+        metadata.is_dir() && !metadata.file_type().is_symlink(),
+        "notification plugin directory is not regular"
+    );
+    require_protected(&metadata)?;
+    #[cfg(windows)]
+    let _directory = super::notification_plugin_windows::open_read(path, true)?;
+    Ok(())
+}
+
+fn require_protected(metadata: &fs::Metadata) -> Result<()> {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        ensure!(
+            metadata.uid() == unsafe { libc::geteuid() } && metadata.mode() & 0o022 == 0,
+            "notification plugin path is not protected by its owner"
+        );
+    }
+    Ok(())
+}
+
+fn require_entries(path: &Path, expected: &[&str]) -> Result<()> {
+    require_canonical_dir(path)?;
+    let names = fs::read_dir(path)?
+        .map(|entry| entry.map(|entry| entry.file_name()))
+        .collect::<std::io::Result<BTreeSet<_>>>()?;
+    let expected = expected
+        .iter()
+        .map(std::ffi::OsString::from)
+        .collect::<BTreeSet<_>>();
+    ensure!(names == expected, "unexpected notification plugin resource");
+    Ok(())
+}
+
+fn read_regular(path: &Path, max_bytes: u64) -> Result<Vec<u8>> {
+    ensure!(
+        path.is_absolute() && dunce::canonicalize(path)? == path,
+        "notification plugin file must be canonical and absolute"
+    );
+    let before = fs::symlink_metadata(path)?;
+    ensure!(
+        before.is_file() && !before.file_type().is_symlink() && before.len() <= max_bytes,
+        "invalid notification plugin file"
+    );
+    require_protected(&before)?;
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW);
+    }
+    #[cfg(not(windows))]
+    let file = options.open(path)?;
+    #[cfg(windows)]
+    let file = super::notification_plugin_windows::open_read(path, false)?;
+    let opened = file.metadata()?;
+    require_protected(&opened)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        ensure!(
+            before.dev() == opened.dev() && before.ino() == opened.ino(),
+            "notification plugin file changed while opening"
+        );
+    }
+    ensure!(
+        opened.is_file() && opened.len() <= max_bytes,
+        "invalid notification plugin file"
+    );
+    let mut bytes = Vec::new();
+    file.take(max_bytes + 1).read_to_end(&mut bytes)?;
+    ensure!(
+        bytes.len() as u64 <= max_bytes,
+        "notification plugin file exceeds size limit"
+    );
+    Ok(bytes)
+}
+
+/// 创建和恢复都先核绑定，再把已核目录交给既有原生会话级插件发现与禁用策略。
+pub(crate) fn prepare_session(
+    info: &super::info::Info,
+    meta: &mut Option<acp::Meta>,
+    creating: bool,
+    resident: bool,
+) -> Result<bool> {
+    let requested = meta
+        .as_ref()
+        .and_then(|meta| meta.get(META_KEY))
+        .map(|value| serde_json::from_value::<NotificationPlugin>(value.clone()))
+        .transpose()?;
+    if let Some(binding) = &requested {
+        binding.validate_target(info.id.0.as_ref(), Path::new(&info.cwd))?;
+        super::notification_route::validate_pending(binding, meta.as_ref())?;
+        ensure!(
+            !meta
+                .as_ref()
+                .is_some_and(|meta| meta.contains_key(SESSION_PLUGIN_DIRS_META_KEY)),
+            "notification binding cannot be combined with pluginDirs"
+        );
+    }
+    let dir = persistence::session_dir(info);
+    if let Some(existing) = persistence::find_any_session_dir_by_id_result(info.id.0.as_ref())? {
+        if requested.is_some() || existing.join(BINDING_FILE).try_exists()? {
+            ensure!(
+                existing == dir,
+                "notification session cannot change its bound cwd"
+            );
+        }
+    }
+    if creating && requested.is_some() {
+        persistence::ensure_owner_only_session_dir(info)?;
+    }
+    if let Some(binding) = verify_binding(&dir, requested.as_ref(), creating, resident)? {
+        // 已驻留会话的 sidecar 只借用 actor；不能重新发现插件或取得通知终端所有权。
+        binding.validate_target(info.id.0.as_ref(), Path::new(&info.cwd))?;
+        ensure!(
+            !meta
+                .as_ref()
+                .is_some_and(|meta| meta.contains_key(SESSION_PLUGIN_DIRS_META_KEY)),
+            "resident notification attachment cannot replace plugins"
+        );
+        return Ok(true);
+    }
+    if let Some(binding) = requested {
+        meta.get_or_insert_with(acp::Meta::new).insert(
+            SESSION_PLUGIN_DIRS_META_KEY.into(),
+            serde_json::json!([binding.plugin_dir]),
+        );
+    }
+    Ok(false)
+}
+
+fn verify_binding(
+    dir: &Path,
+    requested: Option<&NotificationPlugin>,
+    creating: bool,
+    resident: bool,
+) -> Result<Option<NotificationPlugin>> {
+    let path = dir.join(BINDING_FILE);
+    match fs::symlink_metadata(&path) {
+        Ok(_) => {
+            let stored: NotificationPlugin =
+                serde_json::from_slice(&read_regular(&path, 16 * 1024)?)?;
+            if requested.is_none() && !creating && resident {
+                return Ok(Some(stored));
+            }
+            ensure!(
+                requested == Some(&stored),
+                "notification plugin binding is immutable; repeat the original explicit opt-in"
+            );
+        }
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            let Some(requested) = requested else {
+                return Ok(None);
+            };
+            ensure!(
+                creating && !dir.join("summary.json").exists(),
+                "cannot add a notification plugin to an existing session"
+            );
+            require_canonical_dir(dir)?;
+            let mut options = OpenOptions::new();
+            options.write(true).create_new(true);
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::OpenOptionsExt;
+                options.mode(0o600).custom_flags(libc::O_NOFOLLOW);
+            }
+            match options.open(&path) {
+                Ok(mut file) => {
+                    #[cfg(windows)]
+                    super::notification_plugin_windows::verify_file(&file, false)?;
+                    file.write_all(&serde_json::to_vec(requested)?)?;
+                    file.sync_all()?;
+                    super::storage::sync_dir_durable(dir)?;
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {
+                    // 同 SID 的竞争创建只允许完全相同的冻结资源，半写记录保持拒绝。
+                    return verify_binding(dir, Some(requested), false, resident);
+                }
+                Err(error) => return Err(error.into()),
+            }
+        }
+        Err(error) => return Err(error.into()),
+    }
+    Ok(None)
+}
