+/// 外部事务已在同一事件循环完成守卫与持久领取；不经过按键、斜杠命令或审批处理。
+#[cfg(any(unix, windows))]
+pub(crate) fn dispatch_terminal_bridge_prompt(
+    app: &mut AppView,
+    text: String,
+    images: Vec<PngImage>,
+    message_id: String,
+    prompt_id: String,
+) -> Vec<Effect> {
+    let ActiveView::Agent(agent_id) = app.active_view else {
+        return vec![];
+    };
+    let Some(agent) = app.agents.get_mut(&agent_id) else {
+        return vec![];
+    };
+    let Some(session_id) = agent.session.session_id.clone() else {
+        return vec![];
+    };
+    agent.note_self_originated_prompt(&prompt_id);
+    agent.clear_follow_ups();
+    let sid_str = session_id.0.to_string();
+    push_server_queue_echo(app, agent_id, &sid_str, &prompt_id, &text, "terminal_bridge");
+    vec![Effect::SendTerminalBridgePrompt {
+        agent_id,
+        session_id,
+        text,
+        images,
+        prompt_id,
+        message_id,
+    }]
+}
