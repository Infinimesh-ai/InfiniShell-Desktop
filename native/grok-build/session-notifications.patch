+//! 通知专用短命 broker 接入真实 peer 控制台；leader 与普通 hook 保持分离。
+
+use std::ffi::{OsStr, OsString};
+use std::fs::File;
+use std::io::{self, Read};
+use std::mem::size_of;
+use std::os::windows::ffi::{OsStrExt, OsStringExt};
+use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+use std::process::Stdio;
+use std::sync::Arc;
+use std::time::Duration;
+
+use serde::{Deserialize, Serialize};
+use windows::Win32::Foundation::{
+    DUPLICATE_HANDLE_OPTIONS, DUPLICATE_SAME_ACCESS, DuplicateHandle, FILETIME,
+    GetHandleInformation, HANDLE, WAIT_TIMEOUT,
+};
+use windows::Win32::Security::{
+    GetLengthSid, GetTokenInformation, IsValidSid, RevertToSelf, TOKEN_QUERY, TOKEN_STATISTICS,
+    TOKEN_USER, TokenSessionId, TokenStatistics, TokenUser,
+};
+use windows::Win32::System::Console::{
+    AttachConsole, FreeConsole, GetConsoleProcessList, GetStdHandle, STD_ERROR_HANDLE, STD_HANDLE,
+    STD_INPUT_HANDLE, STD_OUTPUT_HANDLE,
+};
+use windows::Win32::System::Pipes::{
+    GetNamedPipeClientProcessId, GetNamedPipeClientSessionId, ImpersonateNamedPipeClient,
+};
+use windows::Win32::System::Threading::{
+    DETACHED_PROCESS, GetCurrentProcess, GetCurrentThread, GetProcessId, GetProcessTimes,
+    OpenProcess, OpenProcessToken, OpenThreadToken, PROCESS_QUERY_LIMITED_INFORMATION,
+    PROCESS_SYNCHRONIZE, WaitForSingleObject,
+};
+
+pub const BROKER_ARGUMENT: &str = "--infinishell-notification-console-broker-v1";
+const MAX_STARTUP_FRAME: usize = 64 * 1024;
+const MAX_CONSOLE_MEMBERS: usize = 4096;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct UserIdentity {
+    sid: Vec<u8>,
+    logon_low: u32,
+    logon_high: i32,
+    session: u32,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ProcessIdentity {
+    pid: u32,
+    created_at: u64,
+    user: UserIdentity,
+}
+
+/// 句柄只有查询和等待权限；析构、路由撤销与 Job 回收均不能终止用户 CLI。
+#[derive(Debug, Clone)]
+pub struct ConsolePeer {
+    handle: Arc<OwnedHandle>,
+    identity: ProcessIdentity,
+}
+
+impl PartialEq for ConsolePeer {
+    fn eq(&self, other: &Self) -> bool {
+        self.identity == other.identity
+    }
+}
+
+impl Eq for ConsolePeer {}
+
+impl ConsolePeer {
+    /// 必须在读完同一连接的注册消息后调用，模拟令牌对应内核收到的真实发送者。
+    pub fn from_named_pipe(pipe: &impl AsRawHandle) -> io::Result<Self> {
+        let pipe = HANDLE(pipe.as_raw_handle());
+        let (pid, session) = pipe_identity(pipe)?;
+        let handle = unsafe {
+            OpenProcess(
+                PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_SYNCHRONIZE,
+                false,
+                pid,
+            )
+        }?;
+        let handle = unsafe { OwnedHandle::from_raw_handle(handle.0) };
+        let identity = process_identity(HANDLE(handle.as_raw_handle()))?;
+        let current_user = process_identity(unsafe { GetCurrentProcess() })?.user;
+        if identity.pid != pid || identity.user.session != session || identity.user != current_user
+        {
+            return Err(denied("notification peer account mismatch"));
+        }
+        let impersonated = pipe_user(pipe)?;
+        if impersonated != identity.user || pipe_identity(pipe)? != (pid, session) {
+            return Err(denied("notification pipe sender changed"));
+        }
+        let peer = Self {
+            handle: Arc::new(handle),
+            identity,
+        };
+        peer.verify()?;
+        Ok(peer)
+    }
+
+    pub fn verify(&self) -> io::Result<()> {
+        let handle = HANDLE(self.handle.as_raw_handle());
+        if unsafe { WaitForSingleObject(handle, 0) } != WAIT_TIMEOUT
+            || process_identity(handle)? != self.identity
+            || self.identity.user != process_identity(unsafe { GetCurrentProcess() })?.user
+            || unsafe { WaitForSingleObject(handle, 0) } != WAIT_TIMEOUT
+        {
+            return Err(denied("notification peer lifetime changed"));
+        }
+        Ok(())
+    }
+
+    fn from_transferred_handle(raw: u64, identity: ProcessIdentity) -> io::Result<Self> {
+        let raw = usize::try_from(raw).map_err(|_| denied("invalid peer handle"))?;
+        if raw == 0 || raw == usize::MAX {
+            return Err(denied("invalid peer handle"));
+        }
+        let handle = HANDLE(raw as *mut std::ffi::c_void);
+        let mut flags = 0;
+        // 先证明它是本进程有效的真实句柄，再取得所有权；不接受伪句柄或裸 PID。
+        unsafe { GetHandleInformation(handle, &mut flags) }?;
+        if flags != 0 || process_identity(handle)? != identity {
+            return Err(denied("transferred peer handle mismatch"));
+        }
+        let handle = unsafe { OwnedHandle::from_raw_handle(handle.0) };
+        let peer = Self {
+            handle: Arc::new(handle),
+            identity,
+        };
+        peer.verify()?;
+        Ok(peer)
+    }
+
+    fn verify_console(&self) -> io::Result<()> {
+        self.verify()?;
+        let members = console_members()?;
+        if !members.contains(&self.identity.pid) || !members.contains(&std::process::id()) {
+            return Err(denied("notification peer console changed"));
+        }
+        self.verify()
+    }
+}
+
+fn denied(message: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::PermissionDenied, message)
+}
+
+fn pipe_identity(pipe: HANDLE) -> io::Result<(u32, u32)> {
+    let mut pid = 0;
+    let mut session = 0;
+    unsafe {
+        GetNamedPipeClientProcessId(pipe, &mut pid)?;
+        GetNamedPipeClientSessionId(pipe, &mut session)?;
+    }
+    if pid == 0 {
+        return Err(denied("invalid notification pipe pid"));
+    }
+    Ok((pid, session))
+}
+
+fn pipe_user(pipe: HANDLE) -> io::Result<UserIdentity> {
+    struct Revert;
+    impl Drop for Revert {
+        fn drop(&mut self) {
+            // 无法恢复时不能让 Tokio 工作线程带着模拟身份继续处理别的会话。
+            if unsafe { RevertToSelf() }.is_err() {
+                std::process::abort();
+            }
+        }
+    }
+    unsafe { ImpersonateNamedPipeClient(pipe) }?;
+    let revert = Revert;
+    let mut token = HANDLE::default();
+    unsafe { OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, true, &mut token) }?;
+    let token = unsafe { OwnedHandle::from_raw_handle(token.0) };
+    let result = token_identity(HANDLE(token.as_raw_handle()));
+    drop(revert);
+    result
+}
+
+fn process_identity(process: HANDLE) -> io::Result<ProcessIdentity> {
+    let pid = unsafe { GetProcessId(process) };
+    if pid == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut creation = FILETIME::default();
+    let mut exit = FILETIME::default();
+    let mut kernel = FILETIME::default();
+    let mut user = FILETIME::default();
+    unsafe { GetProcessTimes(process, &mut creation, &mut exit, &mut kernel, &mut user) }?;
+    let mut token = HANDLE::default();
+    unsafe { OpenProcessToken(process, TOKEN_QUERY, &mut token) }?;
+    let token = unsafe { OwnedHandle::from_raw_handle(token.0) };
+    Ok(ProcessIdentity {
+        pid,
+        created_at: (u64::from(creation.dwHighDateTime) << 32) | u64::from(creation.dwLowDateTime),
+        user: token_identity(HANDLE(token.as_raw_handle()))?,
+    })
+}
+
+fn token_identity(token: HANDLE) -> io::Result<UserIdentity> {
+    let mut statistics = TOKEN_STATISTICS::default();
+    let mut session = 0u32;
+    let mut written = 0;
+    unsafe {
+        GetTokenInformation(
+            token,
+            TokenStatistics,
+            Some((&raw mut statistics).cast()),
+            size_of::<TOKEN_STATISTICS>() as u32,
+            &mut written,
+        )?;
+    }
+    if written as usize != size_of::<TOKEN_STATISTICS>() {
+        return Err(denied("invalid token statistics length"));
+    }
+    unsafe {
+        GetTokenInformation(
+            token,
+            TokenSessionId,
+            Some((&raw mut session).cast()),
+            size_of::<u32>() as u32,
+            &mut written,
+        )?;
+    }
+    if written as usize != size_of::<u32>() {
+        return Err(denied("invalid token session length"));
+    }
+    let _ = unsafe { GetTokenInformation(token, TokenUser, None, 0, &mut written) };
+    if !(size_of::<TOKEN_USER>()..=4096).contains(&(written as usize)) {
+        return Err(denied("invalid token user length"));
+    }
+    let mut storage = vec![0usize; (written as usize).div_ceil(size_of::<usize>())];
+    let capacity = storage.len() * size_of::<usize>();
+    unsafe {
+        GetTokenInformation(
+            token,
+            TokenUser,
+            Some(storage.as_mut_ptr().cast()),
+            capacity as u32,
+            &mut written,
+        )?;
+    }
+    let user = unsafe { &*storage.as_ptr().cast::<TOKEN_USER>() };
+    let start = storage.as_ptr() as usize;
+    let sid_start = user.User.Sid.0 as usize;
+    let end = start + written as usize;
+    if written as usize > capacity
+        || (written as usize) < size_of::<TOKEN_USER>()
+        || sid_start < start
+        || sid_start.checked_add(8).is_none_or(|value| value > end)
+    {
+        return Err(denied("invalid token SID bounds"));
+    }
+    let length = unsafe { GetLengthSid(user.User.Sid) } as usize;
+    if length == 0
+        || sid_start
+            .checked_add(length)
+            .is_none_or(|value| value > end)
+        || !unsafe { IsValidSid(user.User.Sid) }.as_bool()
+    {
+        return Err(denied("invalid token SID"));
+    }
+    let sid = unsafe { std::slice::from_raw_parts(user.User.Sid.0.cast::<u8>(), length) }.to_vec();
+    Ok(UserIdentity {
+        sid,
+        logon_low: statistics.AuthenticationId.LowPart,
+        logon_high: statistics.AuthenticationId.HighPart,
+        session,
+    })
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CommandPlan {
+    program: Vec<u16>,
+    arguments: Vec<Vec<u16>>,
+    directory: Vec<u16>,
+    environment: Vec<(Vec<u16>, Option<Vec<u16>>)>,
+}
+
+impl CommandPlan {
+    fn capture(command: &tokio::process::Command) -> io::Result<Self> {
+        let command = command.as_std();
+        let directory = command
+            .get_current_dir()
+            .ok_or_else(|| denied("missing hook directory"))?;
+        Ok(Self {
+            program: encode_os(command.get_program())?,
+            arguments: command
+                .get_args()
+                .map(encode_os)
+                .collect::<io::Result<_>>()?,
+            directory: encode_os(directory.as_os_str())?,
+            environment: command
+                .get_envs()
+                .map(|(key, value)| Ok((encode_os(key)?, value.map(encode_os).transpose()?)))
+                .collect::<io::Result<_>>()?,
+        })
+    }
+
+    fn command(self) -> io::Result<std::process::Command> {
+        let mut command = std::process::Command::new(decode_os(&self.program)?);
+        for argument in self.arguments {
+            command.arg(decode_os(&argument)?);
+        }
+        let directory = std::path::PathBuf::from(decode_os(&self.directory)?);
+        if !directory.is_absolute() {
+            return Err(denied("hook directory is not absolute"));
+        }
+        command.current_dir(directory);
+        for (key, value) in self.environment {
+            let key = decode_os(&key)?;
+            if let Some(value) = value {
+                command.env(key, decode_os(&value)?);
+            } else {
+                command.env_remove(key);
+            }
+        }
+        Ok(command)
+    }
+}
+
+fn encode_os(value: &OsStr) -> io::Result<Vec<u16>> {
+    let encoded: Vec<u16> = value.encode_wide().collect();
+    if encoded.contains(&0) {
+        return Err(denied("hook command contains NUL"));
+    }
+    Ok(encoded)
+}
+
+fn decode_os(value: &[u16]) -> io::Result<OsString> {
+    if value.contains(&0) {
+        return Err(denied("hook command contains NUL"));
+    }
+    Ok(OsString::from_wide(value))
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct StartupFrame {
+    version: u32,
+    peer_handle: u64,
+    peer: ProcessIdentity,
+    command: CommandPlan,
+}
+
+/// 首帧必须由 runner 在 Job 和两个撤销 scope 登记成功后，放进原 hook 超时范围写入。
+pub struct PreparedConsoleHook {
+    pub child: tokio::process::Child,
+    pub startup_frame: Vec<u8>,
+}
+
+pub async fn spawn_notification_command(
+    command: &tokio::process::Command,
+    peer: &ConsolePeer,
+) -> io::Result<PreparedConsoleHook> {
+    peer.verify()?;
+    let plan = CommandPlan::capture(command)?;
+    // 子进程在首帧前只阻塞读 stdin，不载入认证/配置，也不能派生 hook。
+    let mut broker = tokio::process::Command::new(std::env::current_exe()?);
+    broker
+        .arg(BROKER_ARGUMENT)
+        .creation_flags(DETACHED_PROCESS.0)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .kill_on_drop(true);
+    let child = broker.spawn()?;
+    prepare_child(child, plan, peer).await
+}
+
+async fn prepare_child(
+    mut child: tokio::process::Child,
+    plan: CommandPlan,
+    peer: &ConsolePeer,
+) -> io::Result<PreparedConsoleHook> {
+    let prepared = (|| {
+        let target = child
+            .raw_handle()
+            .ok_or_else(|| denied("broker process handle missing"))?;
+        let mut transferred = HANDLE::default();
+        unsafe {
+            DuplicateHandle(
+                GetCurrentProcess(),
+                HANDLE(peer.handle.as_raw_handle()),
+                HANDLE(target),
+                &mut transferred,
+                (PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_SYNCHRONIZE).0,
+                false,
+                DUPLICATE_HANDLE_OPTIONS(0),
+            )?;
+        }
+        // transferred 仅在 broker 的句柄表中有效，父进程不能用 CloseHandle 关闭它。
+        peer.verify()?;
+        let frame = StartupFrame {
+            version: 1,
+            peer_handle: transferred.0 as usize as u64,
+            peer: peer.identity.clone(),
+            command: plan,
+        };
+        encode_frame(&frame)
+    })();
+    match prepared {
+        Ok(startup_frame) => Ok(PreparedConsoleHook {
+            child,
+            startup_frame,
+        }),
+        Err(error) => {
+            let _ = child.start_kill();
+            let _ = tokio::time::timeout(Duration::from_secs(2), child.wait()).await;
+            Err(error)
+        }
+    }
+}
+
+fn encode_frame(frame: &StartupFrame) -> io::Result<Vec<u8>> {
+    let body = serde_json::to_vec(frame)?;
+    if body.is_empty() || body.len() > MAX_STARTUP_FRAME {
+        return Err(denied("notification startup frame too large"));
+    }
+    let mut bytes = Vec::with_capacity(body.len() + 4);
+    bytes.extend_from_slice(&(body.len() as u32).to_be_bytes());
+    bytes.extend_from_slice(&body);
+    Ok(bytes)
+}
+
+fn read_frame(input: &mut impl Read) -> io::Result<StartupFrame> {
+    let mut length = [0u8; 4];
+    input.read_exact(&mut length)?;
+    let length = u32::from_be_bytes(length) as usize;
+    if length == 0 || length > MAX_STARTUP_FRAME {
+        return Err(denied("invalid notification startup frame length"));
+    }
+    let mut bytes = vec![0u8; length];
+    input.read_exact(&mut bytes)?;
+    let frame: StartupFrame = serde_json::from_slice(&bytes)?;
+    if frame.version != 1 {
+        return Err(denied("unsupported notification startup protocol"));
+    }
+    Ok(frame)
+}
+
+fn duplicate_standard_handle(which: STD_HANDLE) -> io::Result<File> {
+    let source = unsafe { GetStdHandle(which) }?;
+    let mut duplicated = HANDLE::default();
+    unsafe {
+        DuplicateHandle(
+            GetCurrentProcess(),
+            source,
+            GetCurrentProcess(),
+            &mut duplicated,
+            0,
+            false,
+            DUPLICATE_SAME_ACCESS,
+        )?;
+    }
+    Ok(File::from(unsafe {
+        OwnedHandle::from_raw_handle(duplicated.0)
+    }))
+}
+
+fn console_members() -> io::Result<Vec<u32>> {
+    let mut members = vec![0u32; 32];
+    for _ in 0..3 {
+        let count = unsafe { GetConsoleProcessList(&mut members) } as usize;
+        if count == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        if count <= members.len() {
+            members.truncate(count);
+            return Ok(members);
+        }
+        if count > MAX_CONSOLE_MEMBERS {
+            return Err(denied("notification console membership too large"));
+        }
+        members.resize(count, 0);
+    }
+    Err(denied("notification console membership did not stabilize"))
+}
+
+#[derive(Debug, thiserror::Error)]
+#[error("notification broker stage={stage} code={code:?}: {source}")]
+struct BrokerStageError {
+    stage: &'static str,
+    code: Option<i32>,
+    #[source]
+    source: io::Error,
+}
+
+// 只补充固定阶段和系统错误码，保留原始错误链，不记录命令、环境或启动帧。
+fn broker_error(stage: &'static str, source: io::Error) -> io::Error {
+    io::Error::new(
+        source.kind(),
+        BrokerStageError {
+            stage,
+            code: source.raw_os_error(),
+            source,
+        },
+    )
+}
+
+/// 只能由固定隐藏参数在主程序最早入口调用，早于运行时、配置、认证和 leader 初始化。
+pub fn run_broker() -> io::Result<i32> {
+    // 保存原管道，AttachConsole 不得让 hook 的普通输出或 envelope 混进终端输入。
+    let mut input = duplicate_standard_handle(STD_INPUT_HANDLE)
+        .map_err(|error| broker_error("duplicate_stdin", error))?;
+    let output = duplicate_standard_handle(STD_OUTPUT_HANDLE)
+        .map_err(|error| broker_error("duplicate_stdout", error))?;
+    let error = duplicate_standard_handle(STD_ERROR_HANDLE)
+        .map_err(|error| broker_error("duplicate_stderr", error))?;
+    let frame = read_frame(&mut input)?;
+    let peer = ConsolePeer::from_transferred_handle(frame.peer_handle, frame.peer)
+        .map_err(|error| broker_error("verify_transferred_peer", error))?;
+    unsafe { AttachConsole(peer.identity.pid) }
+        .map_err(|error| broker_error("AttachConsole", error.into()))?;
+    struct Console;
+    impl Drop for Console {
+        fn drop(&mut self) {
+            let _ = unsafe { FreeConsole() };
+        }
+    }
+    let console = Console;
+    peer.verify_console()
+        .map_err(|error| broker_error("verify_attached_console", error))?;
+    let mut command = frame.command.command()?;
+    command
+        .stdin(Stdio::from(input))
+        .stdout(Stdio::from(output))
+        .stderr(Stdio::from(error));
+    // 此子进程继承 broker 已核控制台与外层 Job，绝不 detach 或突破 Job。
+    peer.verify_console()
+        .map_err(|error| broker_error("verify_console_before_spawn", error))?;
+    let mut child = command
+        .spawn()
+        .map_err(|error| broker_error("spawn_hook", error))?;
+    let result = loop {
+        if let Some(status) = child
+            .try_wait()
+            .map_err(|error| broker_error("wait_hook", error))?
+        {
+            break Ok(status.code().unwrap_or(1));
+        }
+        if let Err(error) = peer.verify_console() {
+            // 只回收刚派生的 hook；用户 peer 句柄没有终止权限。
+            let _ = child.kill();
+            let _ = child.wait();
+            break Err(broker_error("verify_running_console", error));
+        }
+        std::thread::sleep(Duration::from_millis(25));
+    };
+    drop(console);
+    result
+}
