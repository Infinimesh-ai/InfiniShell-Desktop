+#[test]
+fn typed_png_contract_keeps_order_and_rejects_extra_content_fields() {
+    let mut value = request_value();
+    value["prompt"] = serde_json::json!([
+        {"type":"text","text":"中文\n"}, {"type":"image","mimeType":"image/png","data":RED}, {"type":"image","mimeType":"image/png","data":BLUE}
+    ]);
+    let parsed = parse(&value).unwrap();
+    assert_eq!(
+        serde_json::to_value(parsed.prompt).unwrap(),
+        value["prompt"]
+    );
+    for key in ["uri", "_meta", "annotations", "unknown"] {
+        let mut bad = value.clone();
+        bad["prompt"][1][key] = serde_json::json!(null);
+        let error = parse(&bad).unwrap_err();
+        assert_eq!(serde_json::to_value(error.code).unwrap(), -32071);
+        assert_eq!(error.data.unwrap()[BRIDGE_META_KEY]["admitted"], false);
+    }
+    value["prompt"][2]["data"] = serde_json::json!("bad");
+    assert!(parse(&value).is_err());
+}
