+//! Owned 输入约束只缩紧一次接收条件，不改变普通输入和权限选择。
+
+use crate::session::OwnedInputPrecondition;
+use agent_client_protocol as acp;
+
+pub(crate) const INPUT_KEY: &str = "infinishellOwnedInput";
+
+pub(crate) fn input_precondition(
+    request: &acp::PromptRequest,
+) -> acp::Result<Option<OwnedInputPrecondition>> {
+    let Some(meta) = &request.meta else {
+        return Ok(None);
+    };
+    let Some(value) = meta.get(INPUT_KEY) else {
+        return Ok(None);
+    };
+    let condition: OwnedInputPrecondition =
+        serde_json::from_value(value.clone()).map_err(|_| acp::Error::invalid_params())?;
+    let id =
+        uuid::Uuid::parse_str(&condition.request_id).map_err(|_| acp::Error::invalid_params())?;
+    if id.is_nil() || id.to_string() != condition.request_id {
+        return Err(acp::Error::invalid_params());
+    }
+    if condition.protocol_version != 1
+        || !condition.require_default_permissions
+        || condition.notification_binding.session_id != request.session_id.0.as_ref()
+        || meta.get("verbatim").and_then(|value| value.as_bool()) != Some(true)
+        || meta.keys().any(|key| {
+            !matches!(
+                key.as_str(),
+                INPUT_KEY
+                    | "verbatim"
+                    | "clientIdentifier"
+                    | "screenMode"
+                    | "traceparent"
+                    | "tracestate"
+            )
+        })
+        || request.prompt.is_empty()
+        || request.prompt.iter().any(|block| match block {
+            acp::ContentBlock::Text(text) => text.meta.is_some(),
+            acp::ContentBlock::Image(image) => {
+                image.meta.is_some() || image.mime_type != "image/png"
+            }
+            _ => true,
+        })
+    {
+        return Err(rejected(
+            request.session_id.0.as_ref(),
+            &condition.request_id,
+            "invalid_precondition",
+        ));
+    }
+    Ok(Some(condition))
+}
+
+pub(crate) fn rejected(session_id: &str, request_id: &str, reason: &str) -> acp::Error {
+    acp::Error::new(-32073, "owned input precondition rejected").data(serde_json::json!({
+        "code":"infinishell_owned_input_rejected", "protocolVersion":1,
+        "sessionId":session_id, "requestId":request_id, "queued":false, "reason":reason,
+    }))
+}
+
