+#[test]
+fn transferred_handle_rejects_pid_pseudo_handle_and_regular_file() {
+    let identity = self_peer().identity;
+    assert!(ConsolePeer::from_transferred_handle(0, identity.clone()).is_err());
+    assert!(ConsolePeer::from_transferred_handle(u64::MAX, identity.clone()).is_err());
+    let file = tempfile::tempfile().unwrap();
+    assert!(
+        ConsolePeer::from_transferred_handle(file.as_raw_handle() as usize as u64, identity)
+            .is_err()
+    );
+    // 错类型验证不能获取或关闭调用方普通文件的所有权。
+    file.metadata().unwrap();
