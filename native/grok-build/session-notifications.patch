+#[test]
+fn metadata_is_scoped_to_exact_sid_without_changing_permission_flags() {
+    let fixture = Fixture::new();
+    for session in [None, Some("other-session")] {
+        let mut meta = Some(
+            serde_json::json!({"yoloMode":false,"autoMode":false})
+                .as_object()
+                .unwrap()
+                .clone(),
+        );
+        let before = meta.clone();
+        fixture.binding.add_meta_for(session, &mut meta);
+        assert_eq!(meta, before);
+    }
+    let mut meta = Some(
+        serde_json::json!({"yoloMode":false,"autoMode":false})
+            .as_object()
+            .unwrap()
+            .clone(),
+    );
+    fixture
+        .binding
+        .add_meta_for(Some(&fixture.binding.session_id), &mut meta);
+    let meta = meta.unwrap();
+    assert_eq!(meta.get("yoloMode"), Some(&serde_json::json!(false)));
+    assert_eq!(meta.get("autoMode"), Some(&serde_json::json!(false)));
+    assert!(meta.contains_key(META_KEY));
+    assert!(!meta.contains_key(SESSION_PLUGIN_DIRS_META_KEY));
+}
