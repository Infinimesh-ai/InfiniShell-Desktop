+    let child = root.create_child("empty").unwrap();
+    let original = child.path().to_owned();
+    let renamed = temporary.path().join("renamed");
+    let renamed_root = temporary.path().with_file_name("renamed-root");
+    let expected = child.identity();
+    drop(root);
+
+    // 不放置文件，确保拒绝来自目录句柄，而不是非空目录或文件句柄的副作用。
+    assert!(fs::read_dir(&original).unwrap().next().is_none());
