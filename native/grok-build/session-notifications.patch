+    /// 正常 owned 退出先排空 actor，再关闭原 scope；通用 close 和异常断连不走此分支。
+    pub(crate) async fn finish_owned_exit(
+        &self,
+        request: &crate::session::notification_route::OwnedExitRequest,
+    ) -> Result<&'static str, acp::Error> {
+        use crate::session::notification_route::{OWNED_EXIT_BUDGET, OwnedExitGuard};
+        let mut exit = OwnedExitGuard::claim(request).map_err(|_| acp::Error::invalid_params())?;
+        let id = acp::SessionId::new(request.session_id.clone());
+        let deadline = tokio::time::Instant::now() + OWNED_EXIT_BUDGET;
+        self.wait_for_load_to_settle(&id, stage_budget(deadline, CLOSE_ATTACH_SETTLE_WAIT))
+            .await;
+        if self.session_registry.is_attaching(&id) {
+            return Err(acp::Error::invalid_params());
+        }
+        let intake = self.dispatch_lock(&id);
+        let _intake = tokio::time::timeout_at(deadline, intake.lock())
+            .await
+            .map_err(|_| acp::Error::internal_error())?;
+        let handle = self
+            .resident_handle(&id)
+            .ok_or_else(acp::Error::invalid_params)?;
+        let target = handle.cmd_tx.clone();
+        let scope = handle.tool_context.process_scope.clone();
+        let (tx, rx) = tokio::sync::oneshot::channel();
+        target
+            .send(SessionCommand::PrepareOwnedExit {
+                token: exit.token(),
+                respond_to: tx,
+            })
+            .map_err(|_| acp::Error::invalid_params())?;
+        let result = tokio::time::timeout_at(deadline, async {
+            let accepted = rx.await.map_err(|_| acp::Error::invalid_params())??;
+            if !accepted {
+                return Ok(false);
+            }
+            loop {
+                if !self
+                    .resident_handle(&id)
+                    .is_some_and(|current| current.cmd_tx.same_channel(&target))
+                {
+                    return Err(acp::Error::invalid_params());
+                }
+                match self.session_registry.thread_is_finished(&id) {
+                    Some(true) => return Ok(true),
+                    Some(false) => tokio::time::sleep(std::time::Duration::from_millis(10)).await,
+                    None => return Err(acp::Error::internal_error()),
+                }
+            }
+        })
+        .await
+        .unwrap_or_else(|_| Err(acp::Error::internal_error()));
+        if matches!(result, Ok(false)) {
+            exit.detach_busy();
+            return Ok("busy");
+        }
+        // 接收后邮箱已封闭；超时也只回收原 actor 的 scope，不取消 busy 分支的回合。
+        if target.is_closed() {
+            if let Some(scope) = scope {
+                scope.kill_all();
+            }
+            if self
+                .resident_handle(&id)
+                .is_some_and(|current| current.cmd_tx.same_channel(&target))
+                && !self.session_registry.is_attaching(&id)
+            {
+                self.retire_root_session(&id);
+                self.take_session(&id);
+                self.session_registry.remove_retired_root(&id);
+                self.session_registry.clear_resident(&id);
+                self.set_session_live_state(&id, SessionLiveState::Dormant);
+            }
+        }
+        result.map(|_| "closed")
+    }
