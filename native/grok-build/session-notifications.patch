+use super::*;
+use std::io::Cursor;
+
+const RED: &str = "iVBORw0KGgoAAAANSUhEUgAAACAAAAAQCAIAAAD4YuoOAAAAHklEQVR4nGP4z8BAU0Rb00ctGLVg1IJRC0YtoBICAE7E/hC4KNCvAAAAAElFTkSuQmCC";
+const BLUE: &str = "iVBORw0KGgoAAAANSUhEUgAAACAAAAAQCAIAAAD4YuoOAAAAHElEQVR4nGNgYPhPYzRqwagFoxaMWjBqwRCwAABSiP4QftsDtAAAAABJRU5ErkJggg==";
+
+fn png(data: &str) -> PngImage {
+    PngImage {
+        mime_type: "image/png".into(),
+        data: data.into(),
+    }
+}
+
+#[test]
+fn typed_png_digest_matches_independent_ordered_golden() {
+    assert_eq!(
+        payload_digest("中文\n", &[png(RED), png(BLUE)]).unwrap(),
+        "blake3:97e469a43a4f801f94c4a09285886353720487402268d93c3bac94dc9d2c09d5"
+    );
+    assert_eq!(
+        payload_digest("中文\n", &[png(BLUE), png(RED)]).unwrap(),
+        "blake3:4179efe33f074957eae316395d881d07756a8c8edc73c7234227f9fd0950fc3e"
+    );
+    assert_eq!(
+        payload_digest("", &[png(RED)]).unwrap(),
+        "blake3:06867bbf1b6ab21af733242d8be039ebbacb2fee3e9976d42831caaaf48a5483"
+    );
+    assert_eq!(
+        payload_digest("abc", &[]).unwrap(),
+        "blake3:6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85"
+    );
+}
+
+#[test]
+fn typed_png_batch_rejects_one_bad_crc_and_noncanonical_encoding() {
+    let mut corrupt = STANDARD.decode(BLUE).unwrap();
+    corrupt[50] ^= 1;
+    assert_eq!(
+        payload_digest("", &[png(RED), png(&STANDARD.encode(corrupt))]),
+        Err("invalid_image")
+    );
+    assert_eq!(
+        payload_digest("", &[png(&format!("{RED}\n"))]),
+        Err("invalid_image")
+    );
+    assert_eq!(
+        payload_digest(
+            "",
+            &[PngImage {
+                mime_type: "image/jpeg".into(),
+                data: RED.into()
+            }]
+        ),
+        Err("invalid_image")
+    );
+    assert!(serde_json::from_value::<PngImage>(serde_json::json!({"mime_type":"image/png","data":RED,"uri":"file:///private/image.png"})).is_err());
+}
+
+#[test]
+fn typed_png_count_and_encoded_capacity_are_explicit() {
+    assert_eq!(
+        payload_digest("", &vec![png(RED); 21]),
+        Err("image_count_capacity")
+    );
+    assert_eq!(
+        payload_digest("", &[png(&"A".repeat(MAX_FRAME_BYTES + 1))]),
+        Err("image_frame_capacity")
+    );
+    assert_eq!(payload_digest("", &[]), Err("invalid_submission"));
+}
+
+#[test]
+fn typed_png_requires_native_pixel_floor_without_reencoding_long_image() {
+    let mut tiny = Cursor::new(Vec::new());
+    image::DynamicImage::ImageRgb8(image::RgbImage::from_pixel(8, 8, image::Rgb([255, 0, 0])))
+        .write_to(&mut tiny, image::ImageFormat::Png)
+        .unwrap();
+    assert_eq!(
+        payload_digest("", &[png(&STANDARD.encode(tiny.into_inner()))]),
+        Err("invalid_image")
+    );
+    let mut long = Cursor::new(Vec::new());
+    image::DynamicImage::ImageRgb8(image::RgbImage::from_pixel(
+        2048,
+        8,
+        image::Rgb([255, 0, 0]),
+    ))
+    .write_to(&mut long, image::ImageFormat::Png)
+    .unwrap();
+    let data = STANDARD.encode(long.into_inner());
+    let blocks = prompt_blocks("".into(), vec![png(&data)]);
+    assert!(validate_prompt_blocks(&blocks).unwrap());
+    assert!(
+        matches!(&blocks[0], acp::ContentBlock::Image(image) if image.data == data && image.mime_type == "image/png")
+    );
+}
+
+#[test]
+fn typed_png_prompt_preserves_bytes_and_rejects_uri_or_reordered_text() {
+    let blocks = prompt_blocks("中文\n".into(), vec![png(RED), png(BLUE)]);
+    assert_eq!(
+        serde_json::to_value(&blocks).unwrap(),
+        serde_json::json!([
+            {"type":"text","text":"中文\n"}, {"type":"image","mimeType":"image/png","data":RED}, {"type":"image","mimeType":"image/png","data":BLUE}
+        ])
+    );
+    let mut uri = blocks.clone();
+    if let acp::ContentBlock::Image(image) = &mut uri[1] {
+        image.uri = Some("file:///private/image.png".into());
+    }
+    assert_eq!(validate_prompt_blocks(&uri), Err("invalid_image_batch"));
+    let mut mixed = blocks;
+    mixed.swap(0, 1);
+    assert_eq!(validate_prompt_blocks(&mixed), Err("invalid_image_batch"));
+}
+
+#[test]
+fn typed_png_iend_must_end_the_entire_payload() {
+    let mut bytes = STANDARD.decode(RED).unwrap();
+    bytes.extend_from_slice(b"trailing data");
+    assert_eq!(
+        payload_digest("", &[png(&STANDARD.encode(&bytes))]),
+        Err("invalid_image")
+    );
+    bytes.extend_from_slice(b"\0\0\0\0IEND\xaeB`\x82");
+    assert_eq!(
+        payload_digest("", &[png(&STANDARD.encode(&bytes))]),
+        Err("invalid_image")
+    );
+}
