+                    .as_deref(),
+                Some("blake3:97e469a43a4f801f94c4a09285886353720487402268d93c3bac94dc9d2c09d5")
+            );
+            drop(state);
+            let images = actor
+                .terminal_bridge_exact_images("images", &expected)
+                .await
+                .unwrap()
+                .unwrap();
+            assert_eq!(images[0].data, RED);
+            assert_eq!(images[1].data, BLUE);
+            let mut changed = expected.clone();
