+//! Windows 通知资源保持句柄读取，拒绝重解析点、硬链接和其他普通账户的写入权限。
+
+use std::fs::{File, OpenOptions};
+use std::io;
+use std::mem::size_of;
+use std::os::windows::fs::OpenOptionsExt;
+use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+use std::path::Path;
+
+use windows::Win32::Foundation::{HANDLE, HLOCAL, LocalFree};
+use windows::Win32::Security::Authorization::{GetSecurityInfo, SE_FILE_OBJECT};
+use windows::Win32::Security::{
+    ACCESS_ALLOWED_ACE, ACE_HEADER, ACL, DACL_SECURITY_INFORMATION, EqualSid, GetAce, GetLengthSid,
+    GetTokenInformation, INHERIT_ONLY_ACE, IsValidSid, IsWellKnownSid, OWNER_SECURITY_INFORMATION,
+    PSECURITY_DESCRIPTOR, PSID, TOKEN_QUERY, TOKEN_USER, TokenUser, WinBuiltinAdministratorsSid,
+    WinLocalSystemSid,
+};
+use windows::Win32::Storage::FileSystem::{
+    BY_HANDLE_FILE_INFORMATION, FILE_ATTRIBUTE_DIRECTORY, FILE_ATTRIBUTE_REPARSE_POINT,
+    FILE_FLAG_BACKUP_SEMANTICS, FILE_FLAG_OPEN_REPARSE_POINT, FILE_SHARE_READ,
+    GetFileInformationByHandle,
+};
+use windows::Win32::System::Threading::{GetCurrentProcess, OpenProcessToken};
+
+fn denied() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::PermissionDenied,
+        "notification plugin file is not protected",
+    )
+}
+
+struct Descriptor(PSECURITY_DESCRIPTOR);
+impl Drop for Descriptor {
+    fn drop(&mut self) {
+        if !self.0.0.is_null() {
+            let _ = unsafe { LocalFree(Some(HLOCAL(self.0.0))) };
+        }
+    }
+}
+
+pub(super) fn open_read(path: &Path, directory: bool) -> io::Result<File> {
+    let file = OpenOptions::new()
+        .read(true)
+        .share_mode(FILE_SHARE_READ.0)
+        .custom_flags(
+            FILE_FLAG_OPEN_REPARSE_POINT.0
+                | if directory {
+                    FILE_FLAG_BACKUP_SEMANTICS.0
+                } else {
+                    0
+                },
+        )
+        .open(path)?;
+    verify_file(&file, directory)?;
+    Ok(file)
+}
+
+pub(super) fn verify_file(file: &File, directory: bool) -> io::Result<()> {
+    let handle = HANDLE(file.as_raw_handle());
+    let mut info = BY_HANDLE_FILE_INFORMATION::default();
+    unsafe { GetFileInformationByHandle(handle, &mut info) }?;
+    if info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT.0 != 0
+        || (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY.0 != 0) != directory
+        || (!directory && info.nNumberOfLinks != 1)
+    {
+        return Err(denied());
+    }
+    let mut token = HANDLE::default();
+    unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) }?;
+    let token = unsafe { OwnedHandle::from_raw_handle(token.0) };
+    let mut length = 0;
+    let _ = unsafe {
+        GetTokenInformation(
+            HANDLE(token.as_raw_handle()),
+            TokenUser,
+            None,
+            0,
+            &mut length,
+        )
+    };
+    if length < size_of::<TOKEN_USER>() as u32 || length > 64 * 1024 {
+        return Err(denied());
+    }
+    let mut user = vec![0usize; (length as usize).div_ceil(size_of::<usize>())];
+    let capacity = user.len() * size_of::<usize>();
+    unsafe {
+        GetTokenInformation(
+            HANDLE(token.as_raw_handle()),
+            TokenUser,
+            Some(user.as_mut_ptr().cast()),
+            capacity as u32,
+            &mut length,
+        )
+    }?;
+    if length < size_of::<TOKEN_USER>() as u32 || length as usize > capacity {
+        return Err(denied());
+    }
+    let sid = unsafe { (*user.as_ptr().cast::<TOKEN_USER>()).User.Sid };
+    let start = user.as_ptr() as usize;
+    let end = start + length as usize;
+    let sid_start = sid.0 as usize;
+    if sid_start < start || sid_start.checked_add(8).is_none_or(|value| value > end) {
+        return Err(denied());
+    }
+    let sid_length = unsafe { GetLengthSid(sid) } as usize;
+    if !unsafe { IsValidSid(sid) }.as_bool()
+        || sid_start
+            .checked_add(sid_length)
+            .is_none_or(|value| value > end)
+    {
+        return Err(denied());
+    }
+    let mut owner = PSID::default();
+    let mut acl: *mut ACL = std::ptr::null_mut();
+    let mut descriptor = PSECURITY_DESCRIPTOR::default();
+    let result = unsafe {
+        GetSecurityInfo(
+            handle,
+            SE_FILE_OBJECT,
+            OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+            Some(&mut owner),
+            None,
+            Some(&mut acl),
+            None,
+            Some(&mut descriptor),
+        )
+    };
+    let _descriptor = Descriptor(descriptor);
+    result.ok()?;
+    if owner.0.is_null() || acl.is_null() || unsafe { EqualSid(owner, sid) }.is_err() {
+        return Err(denied());
+    }
+    for index in 0..u32::from(unsafe { (*acl).AceCount }) {
+        let mut raw = std::ptr::null_mut();
+        unsafe { GetAce(acl, index, &mut raw) }?;
+        if raw.is_null() {
+            return Err(denied());
+        }
+        let header = unsafe { &*raw.cast::<ACE_HEADER>() };
+        // 仅继承 ACE 不授权当前对象；子目录和资源会按各自实际 DACL 独立校验。
+        if u32::from(header.AceFlags) & INHERIT_ONLY_ACE.0 != 0 {
+            continue;
+        }
+        // 只解释简单 allow/deny ACE；无法证明的对象或条件 ACE 保持拒绝。
+        if header.AceType == 1 {
+            continue;
+        }
+        if header.AceType != 0 || usize::from(header.AceSize) < size_of::<ACCESS_ALLOWED_ACE>() {
+            return Err(denied());
+        }
+        let ace = unsafe { &*raw.cast::<ACCESS_ALLOWED_ACE>() };
+        let trustee = PSID(std::ptr::addr_of!(ace.SidStart).cast_mut().cast());
+        if !unsafe { IsValidSid(trustee) }.as_bool()
+            || unsafe { GetLengthSid(trustee) } as usize + 8 > usize::from(header.AceSize)
+        {
+            return Err(denied());
+        }
+        let trusted = unsafe { EqualSid(trustee, sid) }.is_ok()
+            || unsafe { IsWellKnownSid(trustee, WinLocalSystemSid) }.as_bool()
+            || unsafe { IsWellKnownSid(trustee, WinBuiltinAdministratorsSid) }.as_bool();
+        // SYSTEM/管理员对应 Unix 超级用户；普通账户不得写数据、删文件或改 ACL/owner。
+        if grants_mutation(ace.Mask) && !trusted {
+            return Err(denied());
+        }
+    }
+    Ok(())
+}
+
+fn grants_mutation(mask: u32) -> bool {
+    // 文件/目录写入位，以及 DELETE、WRITE_DAC、WRITE_OWNER、GENERIC_WRITE/ALL。
+    mask & (0x0000_0156 | 0x000D_0000 | 0x5000_0000) != 0
+}
