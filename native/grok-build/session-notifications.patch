+//! 普通终端桥的整批 PNG 合同；只接受原字节，不补读路径或逐图降级。
+
+use crate::session::image_normalize::{MIN_VISION_SIDE_PX, MIN_VISION_TOTAL_PX};
+use agent_client_protocol as acp;
+use base64::{Engine as _, engine::general_purpose::STANDARD};
+use serde::{Deserialize, Serialize};
+use xai_grok_tools::util::image_validate;
+
+pub const MAX_FRAME_BYTES: usize = 256 * 1024;
+const MAX_TEXT_BYTES: usize = 128 * 1024;
+const MAX_IMAGES: usize = 20;
+const MAX_PIXELS: u64 = 1_150_000;
+const DIGEST_DOMAIN: &[u8] = b"infinishell-terminal-bridge-png-v1\0";
+
+#[derive(Clone, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct PngImage {
+    pub mime_type: String,
+    pub data: String,
+}
+
+impl std::fmt::Debug for PngImage {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("PngImage")
+            .field("encoded_bytes", &self.data.len())
+            .finish()
+    }
+}
+
+fn png_ends_at_iend(bytes: &[u8]) -> bool {
+    if !bytes.starts_with(b"\x89PNG\r\n\x1a\n") {
+        return false;
+    }
+    let mut offset = 8usize;
+    while let Some(header) = bytes.get(offset..offset.saturating_add(8)) {
+        let [l0, l1, l2, l3, t0, t1, t2, t3] = header else {
+            return false;
+        };
+        let length = u32::from_be_bytes([*l0, *l1, *l2, *l3]) as usize;
+        let Some(end) = offset.checked_add(12).and_then(|n| n.checked_add(length)) else {
+            return false;
+        };
+        if end > bytes.len() {
+            return false;
+        }
+        if [*t0, *t1, *t2, *t3] == *b"IEND" {
+            return length == 0 && end == bytes.len();
+        }
+        offset = end;
+    }
+    false
+}
+
+fn decode(image: &PngImage) -> Result<Vec<u8>, &'static str> {
+    if image.mime_type != "image/png" {
+        return Err("invalid_image");
+    }
+    if image.data.len() > MAX_FRAME_BYTES {
+        return Err("image_frame_capacity");
+    }
+    let bytes = STANDARD.decode(&image.data).map_err(|_| "invalid_image")?;
+    if STANDARD.encode(&bytes) != image.data {
+        return Err("invalid_image");
+    }
+    // 先检查头部尺寸，再完整解码，避免压缩炸弹先占用像素内存。
+    let (width, height, mime) =
+        image_validate::validate_image_bytes_with(&bytes, false).map_err(|_| "invalid_image")?;
+    let pixels = u64::from(width) * u64::from(height);
+    if mime != "image/png"
+        || width < MIN_VISION_SIDE_PX
+        || height < MIN_VISION_SIDE_PX
+        || !(MIN_VISION_TOTAL_PX..=MAX_PIXELS).contains(&pixels)
+        || !png_ends_at_iend(&bytes)
+        || !image_validate::image_structurally_complete(&bytes)
+    {
+        return Err("invalid_image");
+    }
+    image_validate::validate_image_bytes(&bytes).map_err(|_| "invalid_image")?;
+    Ok(bytes)
+}
+
+/// 无图时沿用 v1 文本摘要；图批次以长度和域分隔绑定原字节及顺序。
+pub fn payload_digest(text: &str, images: &[PngImage]) -> Result<String, &'static str> {
+    if text.len() > MAX_TEXT_BYTES || (images.is_empty() && text.trim().is_empty()) {
+        return Err("invalid_submission");
+    }
+    if images.is_empty() {
+        return Ok(format!("blake3:{}", blake3::hash(text.as_bytes()).to_hex()));
+    }
+    if images.len() > MAX_IMAGES {
+        return Err("image_count_capacity");
+    }
+    let mut hasher = blake3::Hasher::new();
+    hasher.update(DIGEST_DOMAIN);
+    hasher.update(&(text.len() as u64).to_be_bytes());
+    hasher.update(text.as_bytes());
+    hasher.update(&(images.len() as u32).to_be_bytes());
+    let mut encoded_bytes = 0usize;
+    for image in images {
+        encoded_bytes = encoded_bytes
+            .checked_add(image.data.len())
+            .ok_or("image_frame_capacity")?;
+        if encoded_bytes > MAX_FRAME_BYTES {
+            return Err("image_frame_capacity");
+        }
+        let bytes = decode(image)?;
+        hasher.update(&9u32.to_be_bytes());
+        hasher.update(b"image/png");
+        hasher.update(&(bytes.len() as u64).to_be_bytes());
+        hasher.update(&bytes);
+    }
+    Ok(format!("blake3:{}", hasher.finalize().to_hex()))
+}
+
+pub fn prompt_blocks(text: String, images: Vec<PngImage>) -> Vec<acp::ContentBlock> {
+    let mut blocks = Vec::with_capacity(images.len() + 1);
+    if !text.is_empty() || images.is_empty() {
+        blocks.push(acp::ContentBlock::from(text));
+    }
+    blocks.extend(images.into_iter().map(|image| {
+        acp::ContentBlock::Image(acp::ImageContent::new(image.data, image.mime_type))
+    }));
+    blocks
+}
+
+/// 图批次只允许可选的首个文本块，随后为无元数据的 PNG；返回值不授予准入。
+pub fn prompt_image_digest(blocks: &[acp::ContentBlock]) -> Result<Option<String>, &'static str> {
+    let has_images = blocks
+        .iter()
+        .any(|block| matches!(block, acp::ContentBlock::Image(_)));
+    if !has_images {
+        return Ok(None);
+    }
+    let mut text = "";
+    let mut images = Vec::new();
+    for (index, block) in blocks.iter().enumerate() {
+        match block {
+            acp::ContentBlock::Text(value)
+                if index == 0 && value.meta.is_none() && value.annotations.is_none() =>
+            {
+                text = &value.text
+            }
+            acp::ContentBlock::Image(value)
+                if value.meta.is_none() && value.annotations.is_none() && value.uri.is_none() =>
+            {
+                images.push(PngImage {
+                    mime_type: value.mime_type.clone(),
+                    data: value.data.clone(),
+                })
+            }
+            _ => return Err("invalid_image_batch"),
+        }
+    }
+    let digest = payload_digest(text, &images)?;
+    if serde_json::to_vec(blocks)
+        .map_err(|_| "invalid_image_batch")?
+        .len()
+        > MAX_FRAME_BYTES
+    {
+        return Err("image_frame_capacity");
+    }
+    Ok(Some(digest))
+}
+
+pub fn validate_prompt_blocks(blocks: &[acp::ContentBlock]) -> Result<bool, &'static str> {
+    prompt_image_digest(blocks).map(|digest| digest.is_some())
+}
+
+pub fn prompt_request(
+    session_id: acp::SessionId,
+    text: String,
+    images: Vec<PngImage>,
+    prompt_id: &str,
+    message_id: &str,
+    screen_mode: Option<&str>,
+) -> acp::PromptRequest {
+    let mut meta = acp::Meta::new();
+    meta.insert("promptId".into(), prompt_id.into());
+    if let Some(mode) = screen_mode {
+        meta.insert("screenMode".into(), mode.into());
+    }
+    meta.insert("verbatim".into(), true.into());
+    meta.insert(
+        "infinishellTerminalBridge".into(),
+        serde_json::json!({"protocolVersion":1,"requireIdle":true,"messageId":message_id}),
+    );
+    acp::PromptRequest::new(session_id, prompt_blocks(text, images)).meta(Some(meta))
+}
