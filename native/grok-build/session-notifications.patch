+use super::*;
+use serde_json::json;
+use std::sync::Arc;
+
+const MESSAGE_ID: &str = "441a1b92-6fa1-4bab-b80c-95ce5627c18c";
+
+fn request_value() -> serde_json::Value {
+    json!({
+        "sessionId": "session",
+        "prompt": [{"type": "text", "text": "中文第一行\n第二行"}],
+        "_meta": {
+            "promptId": MESSAGE_ID,
+            "verbatim": true,
+            "infinishellTerminalBridge": {
+                "protocolVersion": 1,
+                "requireIdle": true,
+                "messageId": MESSAGE_ID,
+            }
+        }
+    })
+}
+
+fn parse(value: &serde_json::Value) -> Result<acp::PromptRequest, acp::Error> {
+    parse_request(&acp::ExtRequest::new(
+        SUBMIT_IF_IDLE_METHOD,
+        Arc::from(serde_json::value::to_raw_value(value).unwrap()),
+    ))
+}
+
+#[test]
+fn exact_contract_preserves_multiline_text() {
+    let request = parse(&request_value()).unwrap();
+    assert!(requires_idle(&request).unwrap());
+    assert!(
+        matches!(&request.prompt[0], acp::ContentBlock::Text(text) if text.text == "中文第一行\n第二行")
+    );
+}
+
+#[test]
+fn malformed_contract_cannot_fall_back_to_ordinary_prompt() {
+    for (pointer, value) in [
+        ("/_meta/infinishellTerminalBridge/protocolVersion", json!(2)),
+        ("/_meta/infinishellTerminalBridge/requireIdle", json!(false)),
+        ("/_meta/infinishellTerminalBridge/messageId", json!("other")),
+        ("/_meta/promptId", json!("other")),
+        ("/_meta/verbatim", json!(false)),
+    ] {
+        let mut request = request_value();
+        *request.pointer_mut(pointer).unwrap() = value;
+        assert!(parse(&request).is_err(), "{pointer}");
+    }
+    let mut missing = request_value();
+    missing["_meta"]
+        .as_object_mut()
+        .unwrap()
+        .remove(BRIDGE_META_KEY);
+    assert!(parse(&missing).is_err());
+}
+
+#[test]
+fn override_fields_and_bash_metadata_are_rejected() {
+    for key in ["sendNow", "toolOverrides", "mode", "permissions", "unknown"] {
+        let mut request = request_value();
+        request["_meta"][key] = json!(true);
+        assert!(parse(&request).is_err(), "{key}");
+    }
+    let mut request = request_value();
+    request["prompt"][0]["_meta"] = json!({"bash_command": "echo injected"});
+    assert!(parse(&request).is_err());
+    request = request_value();
+    request["extra"] = json!(true);
+    assert!(parse(&request).is_err());
+}
+
+#[test]
+fn ordinary_prompt_without_bridge_is_unchanged() {
+    let request = acp::PromptRequest::new("session", vec![acp::ContentBlock::from("hello")]);
+    assert!(!requires_idle(&request).unwrap());
+}
+
+#[test]
+fn pre_admission_rejection_is_bound_to_all_identities() {
+    let error = busy_error("session", MESSAGE_ID);
+    assert_eq!(serde_json::to_value(error.code).unwrap(), json!(-32071));
+    let data = error.data.unwrap();
+    assert_eq!(data[BRIDGE_META_KEY]["protocolVersion"], 1);
+    assert_eq!(data[BRIDGE_META_KEY]["sessionId"], "session");
+    assert_eq!(data[BRIDGE_META_KEY]["promptId"], MESSAGE_ID);
+    assert_eq!(data[BRIDGE_META_KEY]["messageId"], MESSAGE_ID);
+    assert_eq!(data[BRIDGE_META_KEY]["admitted"], false);
+}
+
+#[test]
+fn duplicate_or_unproven_receipt_never_claims_not_admitted() {
+    let duplicate = duplicate_error("session", MESSAGE_ID);
+    assert_eq!(serde_json::to_value(duplicate.code).unwrap(), json!(-32072));
+    let unknown = receipt("session", MESSAGE_ID, false);
+    assert_eq!(unknown[BRIDGE_META_KEY]["admissionState"], "unknown");
+    assert!(unknown[BRIDGE_META_KEY]["admitted"].is_null());
+    let committed = receipt("session", MESSAGE_ID, true);
+    assert_eq!(committed[BRIDGE_META_KEY]["admissionState"], "committed");
+    assert_eq!(committed[BRIDGE_META_KEY]["admitted"], true);
+}
+
+fn receipt_request_value() -> serde_json::Value {
+    json!({
+        "protocolVersion": 1,
+        "sessionId": "session",
+        "promptId": MESSAGE_ID,
+        "messageId": MESSAGE_ID,
+    })
+}
+
+fn parse_receipt(value: &serde_json::Value) -> Result<ReceiptRequest, acp::Error> {
+    parse_receipt_request(&acp::ExtRequest::new(
+        RECEIPT_METHOD,
+        Arc::from(serde_json::value::to_raw_value(value).unwrap()),
+    ))
+}
+
+#[test]
+fn receipt_query_requires_exact_version_and_message_identity() {
+    let request = parse_receipt(&receipt_request_value()).unwrap();
+    assert_eq!(request.session_id.0.as_ref(), "session");
+    assert_eq!(request.prompt_id, MESSAGE_ID);
+    for (key, value) in [
+        ("protocolVersion", json!(2)),
+        ("protocolVersion", json!(1.0)),
+        ("sessionId", json!("")),
+        ("messageId", json!("00000000-0000-0000-0000-000000000000")),
+        ("messageId", json!(MESSAGE_ID.to_uppercase())),
+        ("promptId", json!("other")),
+        ("messageId", json!("other")),
+    ] {
+        let mut value_object = receipt_request_value();
+        value_object[key] = value;
+        let error = parse_receipt(&value_object).err().unwrap();
+        assert_eq!(error.code, acp::ErrorCode::InvalidParams, "{key}");
+        assert!(
+            error
+                .data
+                .as_ref()
+                .and_then(|data| data.get(BRIDGE_META_KEY))
+                .is_none()
+        );
+    }
+    for key in ["protocolVersion", "sessionId", "promptId", "messageId"] {
+        let mut value = receipt_request_value();
+        value.as_object_mut().unwrap().remove(key);
+        assert!(parse_receipt(&value).is_err(), "{key}");
+    }
+    let mut value = receipt_request_value();
+    value["prompt"] = json!([{"type":"text", "text":"不能通过查询提交"}]);
+    assert!(parse_receipt(&value).is_err());
+}
+
+#[tokio::test]
+async fn receipt_query_for_missing_or_closed_session_remains_unknown() {
+    let expected = receipt("session", MESSAGE_ID, false);
+    assert_eq!(query_receipt(None, "session", MESSAGE_ID).await, expected);
+    let (sender, receiver) = mpsc::unbounded_channel();
+    drop(receiver);
+    assert_eq!(
+        query_receipt(Some(&sender), "session", MESSAGE_ID).await,
+        expected
+    );
+}
+
+#[tokio::test]
+async fn receipt_query_sends_only_read_command_and_keeps_exact_proof() {
+    let (sender, mut commands) = mpsc::unbounded_channel();
+    for committed in [false, true, true] {
+        let actor = async {
+            let Some(SessionCommand::TerminalBridgeReceipt {
+                prompt_id,
+                respond_to,
+            }) = commands.recv().await
+            else {
+                panic!("回执查询不能入队提示或更改会话");
+            };
+            assert_eq!(prompt_id, MESSAGE_ID);
+            respond_to.send(committed).unwrap();
+        };
+        let (proof, ()) =
+            futures::join!(query_receipt(Some(&sender), "session", MESSAGE_ID), actor);
+        assert_eq!(proof, receipt("session", MESSAGE_ID, committed));
+        assert!(commands.try_recv().is_err());
+    }
+}
+
+#[tokio::test]
+async fn dropped_receipt_response_never_becomes_a_rejection() {
+    let (sender, mut commands) = mpsc::unbounded_channel();
+    let actor = async {
+        let Some(SessionCommand::TerminalBridgeReceipt { respond_to, .. }) = commands.recv().await
+        else {
+            panic!("回执查询不能入队提示或更改会话");
+        };
+        drop(respond_to);
+    };
+    let (proof, ()) = futures::join!(query_receipt(Some(&sender), "session", MESSAGE_ID), actor);
+    assert_eq!(proof, receipt("session", MESSAGE_ID, false));
+    assert!(proof[BRIDGE_META_KEY]["admitted"].is_null());
+}
+
+#[tokio::test(start_paused = true)]
+async fn receipt_query_timeout_is_bounded_and_unknown() {
+    let (sender, mut commands) = mpsc::unbounded_channel();
+    let actor = async {
+        let Some(SessionCommand::TerminalBridgeReceipt { respond_to, .. }) = commands.recv().await
+        else {
+            panic!("回执查询不能入队提示或更改会话");
+        };
+        tokio::time::sleep(Duration::from_secs(3)).await;
+        assert!(respond_to.send(true).is_err());
+    };
+    let (proof, ()) = futures::join!(query_receipt(Some(&sender), "session", MESSAGE_ID), actor);
+    assert_eq!(proof, receipt("session", MESSAGE_ID, false));
+}
