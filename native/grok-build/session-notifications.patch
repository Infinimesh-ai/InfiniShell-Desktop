+use super::*;
+
+#[cfg(unix)]
+use super::super::owned_identity_fixture::Fixture;
+
+#[cfg(unix)]
+#[tokio::test]
+async fn owned_exit_fences_input_and_attach_but_keeps_verified_hook_route() {
+    let fixture = Fixture::new().await;
+    let request = fixture.reserve_exit();
+    let guard = OwnedExitGuard::claim(&request).unwrap();
+    let binding = fixture.binding();
+    assert!(owned_binding(&binding.session_id, &binding.cwd).is_err());
+    assert!(session_open_guard(&binding.session_id).is_err());
+    assert!(verify_exit(&guard.token(), &binding.session_id, &binding.cwd).is_ok());
+    assert!(
+        provider(&binding.session_id)
+            .environment(binding.plugin_dir.to_str().unwrap())
+            .is_some()
+    );
+    drop(guard);
+    assert!(
+        provider(&binding.session_id)
+            .environment(binding.plugin_dir.to_str().unwrap())
+            .is_none()
+    );
+    fixture.close().await;
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn owned_exit_busy_releases_only_exit_fence_and_preserves_route() {
+    let fixture = Fixture::new().await;
+    let request = fixture.reserve_exit();
+    let mut guard = OwnedExitGuard::claim(&request).unwrap();
+    guard.detach_busy();
+    drop(guard);
+    let binding = fixture.binding();
+    assert_eq!(
+        owned_binding(&binding.session_id, &binding.cwd).unwrap(),
+        *binding
+    );
+    assert!(session_open_guard(&binding.session_id).is_ok());
+    fixture.close().await;
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn owned_exit_disconnect_revokes_immediately_and_stale_cleanup_cannot_close_replacement() {
+    let fixture = Fixture::new().await;
+    let request = fixture.reserve_exit();
+    let guard = OwnedExitGuard::claim(&request).unwrap();
+    let binding = fixture.binding();
+    let mut replacement = {
+        let routes = routes().lock().unwrap();
+        routes
+            .get(&binding.session_id)
+            .unwrap()
+            .active
+            .as_ref()
+            .unwrap()
+            .clone()
+    };
+    let old_provider = provider_for_exit(&guard.token());
+    disconnect(replacement.client);
+    assert!(verify_exit(&guard.token(), &binding.session_id, &binding.cwd).is_err());
+    assert!(
+        provider(&binding.session_id)
+            .environment(binding.plugin_dir.to_str().unwrap())
+            .is_none()
+    );
+    replacement.generation = uuid::Uuid::new_v4().to_string();
+    replacement.exit = None;
+    replacement.process_scope = xai_grok_tools::util::ProcessScope::new();
+    let replacement_scope = replacement.process_scope.clone();
+    routes().lock().unwrap().insert(
+        binding.session_id.clone(),
+        SessionRoute {
+            active: Some(replacement),
+            pending: None,
+        },
+    );
+    drop(guard);
+    assert!(!replacement_scope.is_closed());
+    assert!(
+        old_provider
+            .environment(binding.plugin_dir.to_str().unwrap())
+            .is_none()
+    );
+    assert_eq!(
+        owned_binding(&binding.session_id, &binding.cwd).unwrap(),
+        *binding
+    );
+    fixture.close().await;
+}
+
+#[test]
+fn owned_exit_client_cannot_supply_internal_authorization() {
+    let binding = NotificationPlugin {
+        version: 1,
+        session_id: uuid::Uuid::new_v4().to_string(),
+        cwd: PathBuf::from("/unused"),
+        plugin_dir: PathBuf::from("/unused/plugin"),
+        files: Default::default(),
+    };
+    let mut frame = serde_json::json!({"params":{
+        "protocolVersion":1,"sessionId":binding.session_id,"notificationBinding":binding,
+        "_meta":{EXIT_KEY:{"session_id":"foreign","generation":"foreign","nonce":"foreign"}}
+    }});
+    assert!(reserve_exit(&mut frame, 1, None).is_err());
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn owned_exit_rejects_duplicate_and_changed_descriptor_before_shutdown() {
+    let fixture = Fixture::new().await;
+    let request = fixture.reserve_exit();
+    let guard = OwnedExitGuard::claim(&request).unwrap();
+    let mut changed = request.clone();
+    changed.notification_binding.cwd.push("different");
+    assert!(OwnedExitGuard::claim(&changed).is_err());
+    let (client, peer) = {
+        let routes = routes().lock().unwrap();
+        let route = routes
+            .get(&request.session_id)
+            .unwrap()
+            .active
+            .as_ref()
+            .unwrap();
+        (route.client, route.peer.clone())
+    };
+    let mut clean_request = request;
+    clean_request.meta = None;
+    let mut frame = serde_json::json!({"params": clean_request});
+    assert!(reserve_exit(&mut frame, client, Some(&peer)).is_err());
+    drop(guard);
+    fixture.close().await;
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn owned_exit_expired_undispatched_request_revokes_original_without_permanent_fence() {
+    let fixture = Fixture::new().await;
+    let request = fixture.reserve_exit();
+    let original_scope = {
+        let mut routes = routes().lock().unwrap();
+        let route = routes
+            .get_mut(&request.session_id)
+            .unwrap()
+            .active
+            .as_mut()
+            .unwrap();
+        route.exit.as_mut().unwrap().deadline = std::time::Instant::now();
+        route.process_scope.clone()
+    };
+    assert!(session_open_guard(&request.session_id).is_ok());
+    assert!(original_scope.is_closed());
+    assert!(!exit_pending(&request.session_id));
+    assert!(OwnedExitGuard::claim(&request).is_err());
+    fixture.close().await;
+}
