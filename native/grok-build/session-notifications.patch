+}
+
+#[tokio::test]
+async fn terminal_bridge_windows_oversize_or_truncated_frame_never_enters_event_loop() {
+    let root = private_test_directory();
+    let mut bridge = BridgeIo::start(root.path()).unwrap();
+    let manifest = manifest(&bridge);
+    let mut client = ClientOptions::new().open(&manifest.socket).unwrap();
+    client.write_u32(MAX_FRAME_BYTES as u32 + 1).await.unwrap();
+    drop(client);
+    assert_no_delivery(&mut bridge).await;
+    let mut client = ClientOptions::new().open(&manifest.socket).unwrap();
+    client.write_u32(42).await.unwrap();
+    client.write_all(b"{}").await.unwrap();
+    drop(client);
+    assert_no_delivery(&mut bridge).await;
+}
