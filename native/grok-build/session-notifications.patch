+#[tokio::test]
+async fn typed_png_effect_emits_one_exact_atomic_acp_request() {
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let mut tasks = JoinSet::new();
+    let (progress, _progress_rx) = tokio::sync::mpsc::unbounded_channel();
+    execute(
+        Effect::SendTerminalBridgePrompt {
+            agent_id: AgentId(0),
+            session_id: "session".into(),
+            text: "中文\n".into(),
+            images: vec![
+                PngImage {
+                    mime_type: "image/png".into(),
+                    data: RED.into(),
+                },
+                PngImage {
+                    mime_type: "image/png".into(),
+                    data: BLUE.into(),
+                },
+            ],
+            prompt_id: "441a1b92-6fa1-4bab-b80c-95ce5627c18c".into(),
+            message_id: "441a1b92-6fa1-4bab-b80c-95ce5627c18c".into(),
+        },
+        &mut tasks,
+        &tx,
+        Path::new("."),
+        &SessionFlags::default(),
+        &progress,
+    );
+    let Some(AcpAgentMessage::ExtMethod(args)) = rx.recv().await else {
+        panic!("必须使用专用原子方法");
+    };
+    assert_eq!(
+        args.request.method.as_ref(),
+        "infinishell/session/submit_if_idle"
+    );
+    let value: serde_json::Value = serde_json::from_str(args.request.params.get()).unwrap();
+    assert_eq!(
+        value["prompt"],
+        serde_json::json!([
+            {"type":"text","text":"中文\n"}, {"type":"image","mimeType":"image/png","data":RED}, {"type":"image","mimeType":"image/png","data":BLUE}
+        ])
+    );
+    assert_eq!(value["_meta"]["verbatim"], true);
+    assert_eq!(
+        value["_meta"]["infinishellTerminalBridge"]["requireIdle"],
+        true
+    );
+    args.response_tx
+        .send(Ok(acp::ExtResponse::new(Arc::from(
+            serde_json::value::RawValue::from_string("{\"stopReason\":\"end_turn\"}".into())
+                .unwrap(),
+        ))))
+        .unwrap();
+    let result = tasks.join_next().await.unwrap().unwrap();
+    assert!(matches!(
+        result,
+        TaskResult::TerminalBridgeResponse { result: Ok(_), .. }
+    ));
+    assert!(tasks.is_empty());
+    assert!(rx.try_recv().is_err());
+}
