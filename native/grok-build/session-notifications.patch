+#[test]
+fn failed_peer_recheck_preserves_the_previously_attached_route() {
+    let mut state = SessionRoute {
+        active: Some(route(1, "first")),
+        pending: None,
+    };
+    reserve_verified(&mut state, route(1, "second")).unwrap();
+    assert!(
+        activate_verified(
+            &mut state,
+            "second",
+            |_| bail!("peer exited"),
+            || panic!("失效 peer 不得入队")
+        )
