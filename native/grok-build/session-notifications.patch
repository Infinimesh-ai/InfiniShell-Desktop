+#[tokio::test(flavor = "current_thread")]
+async fn child_work_and_unavailable_coordinator_cannot_look_idle() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            for answer_busy in [true, false] {
+                let mut actor = actor().await;
+                let (sender, mut commands) = tokio::sync::mpsc::unbounded_channel();
+                actor.tool_context.subagent_event_tx = Some(sender);
+                let (content, response) = content();
+                let query = async {
+                    let command = commands.recv().await.unwrap();
+                    let SubagentEvent::IdleAdmissionCheck {
+                        parent_session_id,
+                        respond_to,
+                    } = command
+                    else {
+                        panic!("错误的查询类型")
+                    };
+                    assert_eq!(parent_session_id, actor.session_info.id.to_string());
+                    if answer_busy {
+                        let _ = respond_to.send(None);
+                    }
+                };
+                let (admitted, ()) = futures::join!(
+                    actor.admit_terminal_bridge("bridge".to_owned(), content),
+                    query
+                );
+                assert!(!admitted);
+                assert!(response.await.unwrap().is_err());
+                assert!(actor.state.lock().await.pending_inputs.is_empty());
+            }
+        })
+        .await;
+}
