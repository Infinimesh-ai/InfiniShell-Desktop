+use std::os::unix::fs::PermissionsExt;
+#[cfg(unix)]
+use tempfile::TempDir as TestDirectory;
+
+fn setup() -> (TestDirectory, TerminalBridge, AppView) {
+    #[cfg(unix)]
+    let directory = tempfile::tempdir().unwrap();
+    #[cfg(windows)]
+    let directory = crate::app::terminal_bridge_windows::private_test_directory();
+    let mut bridge = TerminalBridge::new("test-instance".into(), directory.path().into()).unwrap();
+    bridge.set_native_capability(true);
+    let mut app = test_app_with_agent();
+    app.agents.get_mut(&AgentId(0)).unwrap().active_pane = ActivePane::Prompt;
+    (directory, bridge, app)
+}
+
+fn lease(bridge: &mut TerminalBridge, app: &mut AppView) -> Lease {
+    let (response, effects) = bridge.handle(
+        Request::State {
+            instance_id: "test-instance".into(),
+        },
+        app,
+    );
+    assert!(effects.is_empty());
+    match response {
+        Response::State {
+            ready: true,
+            lease: Some(lease),
+            ..
+        } => lease,
+        other => panic!("应取得空闲租约：{other:?}"),
+    }
+}
+
+fn submission(lease: &Lease, text: &str) -> Request {
+    Request::SubmitIfIdle {
+        instance_id: "test-instance".into(),
+        lease_id: lease.lease_id.clone(),
+        session_id: lease.session_id.clone(),
+        binding_epoch: lease.binding_epoch,
+        input_epoch: lease.input_epoch,
+        message_id: "988b3ed9-86d7-4c57-9609-e106f0a01501".into(),
+        prompt_id: "988b3ed9-86d7-4c57-9609-e106f0a01501".into(),
+        text: text.into(),
+        images: vec![],
+    }
+}
+
+fn receipt(response: Response) -> Receipt {
+    match response {
+        Response::Receipt { receipt } => receipt,
+        other => panic!("应返回回执：{other:?}"),
+    }
+}
+
+fn home_setup(precreated: bool) -> (TestDirectory, TerminalBridge, AppView) {
+    let (directory, bridge, mut app) = setup();
+    if precreated {
+        app.active_view = ActiveView::Welcome;
+        app.home_session_agent = Some(AgentId(0));
+        app.optimistic_home_husk = Some(AgentId(0));
+        app.next_agent_id = 1;
+    } else {
+        app = test_app();
+    }
+    app.welcome_prompt_focused = true;
+    (directory, bridge, app)
+}
+
+fn prepare(bridge: &TerminalBridge) -> Request {
+    Request::PrepareSessionIfIdle {
+        instance_id: "test-instance".into(),
+        input_epoch: bridge.input_epoch,
+    }
+}
+
+fn run_animation_tick(bridge: &mut TerminalBridge, app: &mut AppView) -> bool {
+    // 测试不读取系统剪贴板；仍执行生产恢复函数与完整 AppView::tick。
+    app.contextual_hints.image_input = false;
+    let before = bridge.display_only_animation_identity(app);
+    assert!(crate::app::dispatch::reconcile_overdue_cancels(app).is_none());
+    assert!(
+        crate::app::dispatch::reconcile_overdue_prompt_acks(
+            app,
+            &crate::app::prompt_ack::PromptAckDeadlines::from_env(None),
+        )
+        .is_none()
+    );
+    assert!(crate::app::dispatch::reconcile_overdue_turn_ends(app).is_none());
+    app.flush_image_notices_if_root();
+    app.tick();
+    let unchanged = before.is_some() && before == bridge.display_only_animation_identity(app);
+    if !unchanged {
+        bridge.invalidate();
+    }
+    unchanged
+}
+
+#[test]
