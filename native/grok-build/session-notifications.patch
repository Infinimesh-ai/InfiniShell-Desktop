+fn self_peer() -> ConsolePeer {
+    let raw = unsafe {
+        OpenProcess(
+            PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_SYNCHRONIZE,
+            false,
+            std::process::id(),
+        )
+    }
+    .unwrap();
+    let handle = unsafe { OwnedHandle::from_raw_handle(raw.0) };
+    ConsolePeer {
+        identity: process_identity(raw).unwrap(),
+        handle: Arc::new(handle),
+    }
+}
+
+fn frame() -> StartupFrame {
+    let mut command = tokio::process::Command::new("cmd.exe");
+    command
+        .args(["/d", "/c", "echo fixture"])
+        .current_dir(std::env::temp_dir());
+    StartupFrame {
+        version: 1,
+        peer_handle: 8,
+        peer: self_peer().identity,
+        command: CommandPlan::capture(&command).unwrap(),
+    }
+}
+
+#[test]
+fn startup_frame_leaves_entire_hook_envelope_unconsumed() {
+    let frame = frame();
+    let mut bytes = encode_frame(&frame).unwrap();
+    let envelope = br#"{"session_id":"fixture","tool_input":{"text":"non-secret fixture"}}"#;
+    bytes.extend_from_slice(envelope);
+    let mut input = io::Cursor::new(bytes);
+    let decoded = read_frame(&mut input).unwrap();
+    assert_eq!(decoded.peer, frame.peer);
+    assert_eq!(decoded.command.program, frame.command.program);
+    let mut rest = Vec::new();
+    io::Read::read_to_end(&mut input, &mut rest).unwrap();
+    assert_eq!(rest, envelope);
+}
+
+#[test]
+fn startup_frame_rejects_bad_length_version_and_unknown_fields() {
+    for length in [0u32, MAX_STARTUP_FRAME as u32 + 1, u32::MAX] {
+        assert!(read_frame(&mut &length.to_be_bytes()[..]).is_err());
+    }
+    assert!(read_frame(&mut &[0, 0, 0, 8, b'{'][..]).is_err());
+    let mut frame = frame();
+    frame.version = 2;
+    assert!(read_frame(&mut encode_frame(&frame).unwrap().as_slice()).is_err());
+    let mut value = serde_json::to_value(frame).unwrap();
+    value["unexpected"] = serde_json::json!(true);
+    let bytes = serde_json::to_vec(&value).unwrap();
+    let mut framed = (bytes.len() as u32).to_be_bytes().to_vec();
+    framed.extend_from_slice(&bytes);
+    assert!(read_frame(&mut framed.as_slice()).is_err());
+}
