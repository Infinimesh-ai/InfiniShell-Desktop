+#[tokio::test]
+async fn notification_pipe_clones_preserve_kernel_identity() {
+    let name = format!(
+        r"\\.\pipe\grok-notification-self-test-{}",
+        uuid::Uuid::new_v4()
+    );
+    let mut server = ServerOptions::new()
+        .first_pipe_instance(true)
+        .create(&name)
+        .unwrap();
+    let mut client = ClientOptions::new().open(&name).unwrap();
+    server.connect().await.unwrap();
+    client.write_all(&[1]).await.unwrap();
+    assert_eq!(server.read_u8().await.unwrap(), 1);
+    let peer = VerifiedPeer::capture(&server).unwrap();
+    let cloned = peer.clone();
+    assert_eq!(peer, cloned);
+    drop(client);
+    drop(server);
+    peer.verify().unwrap();
+    cloned.console_peer().verify().unwrap();
+}
