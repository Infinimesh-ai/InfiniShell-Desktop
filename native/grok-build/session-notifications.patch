+fn notification_session_flags_do_not_leak_into_new_or_other_sessions() {
+    use xai_grok_shell::session::notification_plugin::{META_KEY, NotificationPlugin};
+    use xai_grok_shell::session::notification_route::{ROUTE_KEY, RouteCandidate};
+    let flags = SessionFlags {
+        notification_plugin: Some(NotificationPlugin {
+            version: 1,
+            session_id: "018f97ad-9100-7000-8000-000000000001".into(),
+            cwd: "/synthetic/project".into(), plugin_dir: "/synthetic/plugin".into(),
+            files: Default::default(),
+        }),
+        notification_route: Some(serde_json::from_value::<RouteCandidate>(serde_json::json!({
+            "tty":"/dev/synthetic", "tmux":null, "tmux_pane":null
+        })).unwrap()),
+        ..SessionFlags::default()
+    };
+    for sid in [None, Some("other-sid")] {
+        let mut meta = flags.to_meta();
+        let before = meta.clone();
+        flags.add_notification_meta(sid, &mut meta);
+        assert_eq!(meta, before);
+    }
+    let mut meta = flags.to_meta();
+    flags.add_notification_meta(Some("018f97ad-9100-7000-8000-000000000001"), &mut meta);
+    let meta = meta.unwrap();
+    assert!(meta.contains_key(META_KEY));
+    assert!(meta.contains_key(ROUTE_KEY));
+    assert_eq!(meta.get("yoloMode"), Some(&serde_json::json!(false)));
+}
