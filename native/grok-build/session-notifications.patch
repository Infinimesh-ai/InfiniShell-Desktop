+#[test]
+fn old_session_without_binding_is_unchanged_and_cannot_acquire_one_on_load() {
+    let fixture = Fixture::new();
+    let dir = fixture.session_dir();
+    fs::write(dir.join("summary.json"), b"{}").unwrap();
+    verify_binding(&dir, None, false, false).unwrap();
+    verify_binding(&dir, None, true, false).unwrap();
+    assert!(verify_binding(&dir, Some(&fixture.binding), false, false).is_err());
+    assert!(verify_binding(&dir, Some(&fixture.binding), true, false).is_err());
+    assert!(!dir.join(BINDING_FILE).exists());
+}
