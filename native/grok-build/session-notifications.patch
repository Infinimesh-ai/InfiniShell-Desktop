+//! 普通 TUI 的专用原子提交合同；元数据只增加约束，不授予权限。
+
+use crate::session::SessionCommand;
+use agent_client_protocol as acp;
+use serde::Deserialize;
+use std::time::Duration;
+use tokio::sync::{mpsc, oneshot};
+
+pub(crate) const SUBMIT_IF_IDLE_METHOD: &str = "infinishell/session/submit_if_idle";
+pub(crate) const CAPABILITIES_METHOD: &str = "infinishell/terminal_bridge/capabilities";
+pub(crate) const RECEIPT_METHOD: &str = "infinishell/session/receipt";
+const BRIDGE_META_KEY: &str = "infinishellTerminalBridge";
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct BridgeMeta {
+    protocol_version: u32,
+    require_idle: bool,
+    message_id: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct BridgeRequest {
+    session_id: acp::SessionId,
+    prompt: Vec<acp::ContentBlock>,
+    #[serde(rename = "_meta")]
+    meta: acp::Meta,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct ReceiptRequest {
+    protocol_version: u32,
+    pub(crate) session_id: acp::SessionId,
+    pub(crate) prompt_id: String,
+    message_id: String,
+}
+
+pub(crate) fn parse_receipt_request(args: &acp::ExtRequest) -> Result<ReceiptRequest, acp::Error> {
+    let request: ReceiptRequest = super::parse_params(args)?;
+    let id =
+        uuid::Uuid::parse_str(&request.message_id).map_err(|_| acp::Error::invalid_params())?;
+    if request.protocol_version != 1
+        || request.session_id.0.is_empty()
+        || request.prompt_id != request.message_id
+        || id.is_nil()
+        || id.hyphenated().to_string() != request.message_id
+    {
+        return Err(acp::Error::invalid_params());
+    }
+    Ok(request)
+}
+
+pub(crate) async fn query_receipt(
+    cmd_tx: Option<&mpsc::UnboundedSender<SessionCommand>>,
+    session_id: &str,
+    prompt_id: &str,
+) -> serde_json::Value {
+    // 此路径只查询现存 actor；缺失、断线和超时均不能证明输入从未接收。
+    let committed = if let Some(cmd_tx) = cmd_tx {
+        let (respond_to, response) = oneshot::channel();
+        if cmd_tx
+            .send(SessionCommand::TerminalBridgeReceipt {
+                prompt_id: prompt_id.to_owned(),
+                respond_to,
+            })
+            .is_ok()
+        {
+            matches!(
+                tokio::time::timeout(Duration::from_secs(2), response).await,
+                Ok(Ok(true))
+            )
+        } else {
+            false
+        }
+    } else {
+        false
+    };
+    receipt(session_id, prompt_id, committed)
+}
+
+pub(crate) fn parse_request(args: &acp::ExtRequest) -> Result<acp::PromptRequest, acp::Error> {
+    let raw: serde_json::Value = serde_json::from_str(args.params.get()).unwrap_or_default();
+    if let Some(blocks) = raw.get("prompt").and_then(|v| v.as_array())
+        && blocks
+            .iter()
+            .any(|block| block.get("type").and_then(|v| v.as_str()) == Some("image"))
+        && blocks.iter().any(|block| {
+            block.as_object().is_none_or(|object| {
+                match object.get("type").and_then(|value| value.as_str()) {
+                    Some("text") => object
+                        .keys()
+                        .any(|key| !matches!(key.as_str(), "type" | "text")),
+                    Some("image") => object
+                        .keys()
+                        .any(|key| !matches!(key.as_str(), "type" | "data" | "mimeType")),
+                    Some(_) | None => true,
+                }
+            })
+        })
+    {
+        return Err(rejection_error(
+            raw.get("sessionId").and_then(|v| v.as_str()),
+            raw.pointer("/_meta/promptId").and_then(|v| v.as_str()),
+            raw.pointer("/_meta/infinishellTerminalBridge/messageId")
+                .and_then(|v| v.as_str()),
+            "infinishell_terminal_bridge_invalid_request",
+        ));
+    }
+    let request: BridgeRequest = super::parse_params(args).map_err(|_| {
+        let raw: serde_json::Value = serde_json::from_str(args.params.get()).unwrap_or_default();
+        rejection_error(
+            raw.get("sessionId").and_then(|v| v.as_str()),
+            raw.pointer("/_meta/promptId").and_then(|v| v.as_str()),
+            raw.pointer("/_meta/infinishellTerminalBridge/messageId")
+                .and_then(|v| v.as_str()),
+            "infinishell_terminal_bridge_invalid_request",
+        )
+    })?;
+    let request =
+        acp::PromptRequest::new(request.session_id, request.prompt).meta(Some(request.meta));
+    if !requires_idle(&request)? {
+        return Err(invalid_request(&request));
+    }
+    Ok(request)
+}
+
+pub(crate) fn requires_idle(request: &acp::PromptRequest) -> Result<bool, acp::Error> {
+    let Some(meta) = request.meta.as_ref() else {
+        return Ok(false);
+    };
+    let Some(value) = meta.get(BRIDGE_META_KEY) else {
+        return Ok(false);
+    };
+    let bridge: BridgeMeta =
+        serde_json::from_value(value.clone()).map_err(|_| invalid_request(request))?;
+    let id = uuid::Uuid::parse_str(&bridge.message_id).map_err(|_| invalid_request(request))?;
+    if bridge.protocol_version != 1
+        || !bridge.require_idle
+        || id.is_nil()
+        || id.hyphenated().to_string() != bridge.message_id
+        || meta.get("promptId").and_then(|v| v.as_str()) != Some(bridge.message_id.as_str())
+        || meta.get("verbatim").and_then(|v| v.as_bool()) != Some(true)
+        || meta.keys().any(|key| {
+            !matches!(
+                key.as_str(),
+                BRIDGE_META_KEY
+                    | "promptId"
+                    | "verbatim"
+                    | "clientIdentifier"
+                    | "screenMode"
+                    | "traceparent"
+                    | "tracestate"
+            )
+        })
+        || request.prompt.is_empty()
+        || !valid_blocks(&request.prompt)
+        || (request
+            .prompt
+            .iter()
+            .any(|block| matches!(block, acp::ContentBlock::Image(_)))
+            && serde_json::to_vec(request).map_or(true, |bytes| {
+                bytes.len() > super::terminal_bridge_images::MAX_FRAME_BYTES
+            }))
+    {
+        return Err(invalid_request(request));
+    }
+    Ok(true)
+}
+
+fn valid_blocks(blocks: &[acp::ContentBlock]) -> bool {
+    match super::terminal_bridge_images::validate_prompt_blocks(blocks) {
+        Ok(true) => true,
+        Ok(false) => blocks
+            .iter()
+            .all(|block| matches!(block, acp::ContentBlock::Text(text) if text.meta.is_none())),
+        Err(_) => false,
+    }
+}
+
+pub(crate) fn invalid_image_batch(session_id: &str, prompt_id: &str) -> acp::Error {
+    rejection_error(
+        Some(session_id),
+        Some(prompt_id),
+        Some(prompt_id),
+        "infinishell_terminal_bridge_invalid_request",
+    )
+}
+
+fn invalid_request(request: &acp::PromptRequest) -> acp::Error {
+    let meta = request.meta.as_ref();
+    rejection_error(
+        Some(request.session_id.0.as_ref()),
+        meta.and_then(|m| m.get("promptId"))
+            .and_then(|v| v.as_str()),
+        meta.and_then(|m| m.get(BRIDGE_META_KEY))
+            .and_then(|v| v.get("messageId"))
+            .and_then(|v| v.as_str()),
+        "infinishell_terminal_bridge_invalid_request",
+    )
+}
+
+fn rejection_error(
+    session_id: Option<&str>,
+    prompt_id: Option<&str>,
+    message_id: Option<&str>,
+    reason: &str,
+) -> acp::Error {
+    acp::Error::new(-32071, reason).data(serde_json::json!({
+        "infinishellTerminalBridge": {
+            "protocolVersion": 1,
+            "sessionId": session_id,
+            "promptId": prompt_id,
+            "messageId": message_id,
+            "admitted": false,
+        }
+    }))
+}
+
+pub(crate) fn busy_error(session_id: &str, prompt_id: &str) -> acp::Error {
+    rejection_error(
+        Some(session_id),
+        Some(prompt_id),
+        Some(prompt_id),
+        "infinishell_terminal_bridge_busy",
+    )
+}
+
+pub(crate) fn duplicate_error(session_id: &str, prompt_id: &str) -> acp::Error {
+    acp::Error::new(-32072, "infinishell_terminal_bridge_duplicate")
+        .data(receipt(session_id, prompt_id, false))
+}
+
+pub(crate) fn receipt(session_id: &str, prompt_id: &str, committed: bool) -> serde_json::Value {
+    serde_json::json!({
+        "infinishellTerminalBridge": {
+            "protocolVersion": 1,
+            "sessionId": session_id,
+            "promptId": prompt_id,
+            "messageId": prompt_id,
+            "admissionState": if committed { "committed" } else { "unknown" },
+            "admitted": if committed { Some(true) } else { None },
+        }
+    })
+}
