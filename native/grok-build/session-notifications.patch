+use crate::app::terminal_bridge_windows::private_test_directory;
+
+fn manifest(bridge: &BridgeIo) -> Manifest {
+    serde_json::from_slice(&std::fs::read(bridge.instance_dir.join("manifest.json")).unwrap())
+        .unwrap()
+}
+
+async fn send(client: &mut NamedPipeClient, value: serde_json::Value) {
+    let bytes = serde_json::to_vec(&value).unwrap();
+    client.write_u32(bytes.len() as u32).await.unwrap();
+    client.write_all(&bytes).await.unwrap();
+}
+
+fn state(manifest: &Manifest, token: &str) -> serde_json::Value {
+    json!({"token":token,"request":{"operation":"state","instance_id":manifest.instance_id}})
+}
+
+async fn assert_no_delivery(bridge: &mut BridgeIo) {
+    assert!(
+        tokio::time::timeout(Duration::from_millis(150), bridge.requests.recv())
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn terminal_bridge_windows_authenticated_pipe_waits_for_complete_response_confirmation() {
+    let root = private_test_directory();
+    let mut bridge = BridgeIo::start(root.path()).unwrap();
+    let manifest = manifest(&bridge);
+    assert_eq!(manifest.protocol_version, 1);
+    assert_eq!(manifest.native_pid, std::process::id());
+    assert_eq!(manifest.instance_id, bridge.instance_id);
+    assert_eq!(
+        manifest.socket,
+        PathBuf::from(format!(
+            r"\\.\pipe\infinishell-grok-terminal-bridge-v1-{}",
+            Uuid::parse_str(&manifest.instance_id).unwrap().simple()
+        ))
+    );
+    let mut client = ClientOptions::new().open(&manifest.socket).unwrap();
+    send(&mut client, state(&manifest, &manifest.token)).await;
+    let call = tokio::time::timeout(Duration::from_secs(2), bridge.requests.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        matches!(call.request, Request::State { instance_id } if instance_id == bridge.instance_id)
+    );
+    call.reply
+        .send(Response::Rejected {
+            reason: "fixture".into(),
+        })
+        .unwrap();
+    // 客户端延迟读取时，服务端必须保留响应，收到完整帧确认后才关闭。
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    let length = client.read_u32().await.unwrap();
+    let mut bytes = vec![0; length as usize];
+    client.read_exact(&mut bytes).await.unwrap();
+    assert!(
+        matches!(serde_json::from_slice::<Response>(&bytes).unwrap(), Response::Rejected { reason } if reason == "fixture")
+    );
+    assert!(
+        tokio::time::timeout(Duration::from_millis(20), client.read_u8())
+            .await
+            .is_err()
+    );
+    client.write_all(&[1]).await.unwrap();
+    assert!(
+        tokio::time::timeout(Duration::from_secs(2), client.read_u8())
+            .await
+            .unwrap()
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn terminal_bridge_windows_missing_response_confirmation_has_bounded_shutdown() {
+    let pipe = format!(
+        r"\\.\pipe\infinishell-grok-terminal-bridge-test-{}",
+        Uuid::new_v4().simple()
+    );
+    let mut server = ServerOptions::new()
+        .first_pipe_instance(true)
+        .reject_remote_clients(true)
+        .create(&pipe)
+        .unwrap();
+    let mut client = ClientOptions::new().open(&pipe).unwrap();
+    server.connect().await.unwrap();
+    let response = tokio::spawn(async move {
+        write_response(&mut server, b"response", Duration::from_millis(100)).await
+    });
+    assert_eq!(client.read_u32().await.unwrap(), 8);
+    let mut bytes = [0; 8];
+    client.read_exact(&mut bytes).await.unwrap();
+    assert_eq!(&bytes, b"response");
+    // 不发送确认；服务端必须自行按同一期限返回，不能无界 FlushFileBuffers。
+    let error = tokio::time::timeout(Duration::from_secs(2), response)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::TimedOut);
+}
+
+#[tokio::test]
+async fn terminal_bridge_windows_token_and_strict_envelope_fail_before_event_loop() {
+    let root = private_test_directory();
