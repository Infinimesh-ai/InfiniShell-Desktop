+#[test]
+fn exact_peer_duplicate_survives_original_handle_drop() {
+    let peer = self_peer();
+    let mut transferred = HANDLE::default();
+    unsafe {
+        DuplicateHandle(
+            GetCurrentProcess(),
+            HANDLE(peer.handle.as_raw_handle()),
+            GetCurrentProcess(),
+            &mut transferred,
+            (PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_SYNCHRONIZE).0,
+            false,
+            DUPLICATE_HANDLE_OPTIONS(0),
+        )
+        .unwrap();
+    }
+    let retained =
+        ConsolePeer::from_transferred_handle(transferred.0 as usize as u64, peer.identity.clone())
+            .unwrap();
+    drop(peer);
+    retained.verify().unwrap();
+}
