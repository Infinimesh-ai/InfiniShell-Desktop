+#[test]
+fn malformed_digest_and_unknown_binding_fields_are_rejected() {
+    let mut fixture = Fixture::new();
+    fixture
+        .binding
+        .files
+        .insert("hooks/notify.cjs".into(), "F".repeat(64));
