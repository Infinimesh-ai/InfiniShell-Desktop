@@ -0,0 +1,84 @@
+//! 正常 owned 退出在 IPC 和终端仍附着时等待原生结束通知，不向宿主伪造事件。
+use super::app_view::AppView;
+use agent_client_protocol as acp;
+use anyhow::{Context, Result, ensure};
+use std::time::Duration;
+use xai_acp_lib::{AcpAgentTx, acp_send};
+use xai_grok_shell::session::notification_route::{
+    OWNED_EXIT_BUDGET, OWNED_EXIT_METHOD, OwnedExitRequest,
+};
+
+pub(super) async fn drain(app: &AppView) {
+    let Some(binding) = app.notification_plugin.as_ref() else {
+        return;
+    };
+    if !app.owned_exit_requested
+        || app.quit_for_update
+        || app.relaunch.is_some()
+        || app.reconnect_pending
+    {
+        return;
+    }
+    if app
+        .active_agent()
+        .and_then(|agent| agent.session.session_id.as_ref())
+        .is_none_or(|session| session.0.as_ref() != binding.session_id)
+    {
+        return;
+    }
+    let request = OwnedExitRequest {
+        protocol_version: 1,
+        session_id: binding.session_id.clone(),
+        notification_binding: binding.clone(),
+        meta: None,
+    };
+    if let Err(error) = request_exit(
+        &app.acp_tx,
+        request,
+        OWNED_EXIT_BUDGET + Duration::from_secs(2),
+    )
+    .await
+    {
+        // 失败或超时只结束本地退出等待；连接随后正常关闭并立即撤销旧路由，不重试。
+        tracing::warn!(%error, "owned session exit was not acknowledged");
+    }
+}
+
+async fn request_exit(tx: &AcpAgentTx, request: OwnedExitRequest, budget: Duration) -> Result<()> {
+    let session_id = request.session_id.clone();
+    let params = serde_json::value::to_raw_value(&request)?;
+    // SDK 为扩展方法添加 wire 下划线；不能把内部方法名直接写入原始 JSON-RPC。
+    let request = acp::ExtRequest::new(OWNED_EXIT_METHOD, params.into());
+    let response = tokio::time::timeout(budget, acp_send(request, tx))
+        .await
+        .context("owned exit acknowledgement timed out")??;
+    let response: serde_json::Value = serde_json::from_str(response.0.get())?;
+    ensure!(
+        response.get("error").is_none_or(serde_json::Value::is_null),
+        "owned exit failed"
+    );
+    let result = response
+        .get("result")
+        .context("owned exit result missing")?;
+    ensure!(
+        result
+            .get("protocolVersion")
+            .and_then(serde_json::Value::as_u64)
+            == Some(1)
+            && result.get("sessionId").and_then(serde_json::Value::as_str)
+                == Some(session_id.as_str()),
+        "owned exit identity mismatch"
+    );
+    ensure!(
+        matches!(
+            result.get("outcome").and_then(serde_json::Value::as_str),
+            Some("closed" | "busy")
+        ),
+        "owned exit outcome unavailable"
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+#[path = "owned_exit_tests.rs"]
+mod tests;
