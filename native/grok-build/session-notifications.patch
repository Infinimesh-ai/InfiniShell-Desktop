+//! 通知路由由 leader 的连接身份建立；不持久化，也不信任客户端指定的任意终端。
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex, OnceLock};
+use std::time::Duration;
+
+use agent_client_protocol as acp;
+use anyhow::{Context, Result, bail, ensure};
+use serde::{Deserialize, Serialize};
+use xai_grok_hooks::runner::{NotificationEnvironment, SessionNotificationRoute};
+
+use super::notification_plugin::{META_KEY, NotificationPlugin};
+
+pub const ROUTE_KEY: &str = "infinishell/notificationRoute";
+pub const ROUTE_REQUIRED_ENV: &str = "WARP_CLI_AGENT_SESSION_ROUTE";
+
+#[path = "notification_exit.rs"]
+mod owned_exit;
+pub use owned_exit::{OWNED_EXIT_BUDGET, OWNED_EXIT_METHOD, OwnedExitRequest, OwnedExitToken};
+pub(crate) use owned_exit::{
+    OwnedExitGuard, exit_pending, provider_for_exit, session_open_guard, verify_exit,
+};
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RouteCandidate {
+    tty: PathBuf,
+    tmux: Option<String>,
+    tmux_pane: Option<String>,
+}
+
+impl RouteCandidate {
+    pub fn current() -> Result<Self> {
+        #[cfg(unix)]
+        {
+            let mut buffer = vec![0u8; 1024];
+            let result = unsafe {
+                libc::ttyname_r(libc::STDIN_FILENO, buffer.as_mut_ptr().cast(), buffer.len())
+            };
+            ensure!(
+                result == 0,
+                "notification route requires the pager stdin terminal"
+            );
+            let end = buffer
+                .iter()
+                .position(|byte| *byte == 0)
+                .context("invalid terminal path")?;
+            let tty = PathBuf::from(std::str::from_utf8(
+                buffer.get(..end).context("invalid terminal path")?,
+            )?);
+            let tmux = std::env::var("TMUX").ok().filter(|value| !value.is_empty());
+            let tmux_pane = tmux.as_ref().and_then(|_| std::env::var("TMUX_PANE").ok());
+            Ok(Self {
+                tty,
+                tmux,
+                tmux_pane,
+            })
+        }
+        #[cfg(windows)]
+        {
+            use std::io::IsTerminal;
+            ensure!(
+                std::io::stdin().is_terminal(),
+                "notification route requires the pager console"
+            );
+            Ok(Self {
+                tty: PathBuf::from("CONOUT$"),
+                tmux: None,
+                tmux_pane: None,
+            })
+        }
+        #[cfg(not(any(unix, windows)))]
+        bail!("notification route requires native peer terminal verification on this platform")
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct PeerIdentity {
+    #[cfg(windows)]
+    peer: Option<super::notification_route_windows::VerifiedPeer>,
+    #[cfg(not(windows))]
+    pid: i32,
+    #[cfg(not(windows))]
+    start: (u64, u64),
+    #[cfg(not(windows))]
+    tty_device: u64,
+    #[cfg(not(windows))]
+    process_group: i32,
+    #[cfg(not(windows))]
+    foreground_group: i32,
+}
+
+impl PeerIdentity {
+    #[cfg(windows)]
+    pub(crate) fn capture_pipe(
+        pipe: &tokio::net::windows::named_pipe::NamedPipeServer,
+    ) -> Result<Self> {
+        Ok(Self {
+            peer: Some(super::notification_route_windows::VerifiedPeer::capture(
+                pipe,
+            )?),
+        })
+    }
+
+    #[cfg(not(windows))]
+    pub(crate) fn capture(pid: i32, uid: u32) -> Result<Self> {
+        #[cfg(unix)]
+        ensure!(
+            uid == unsafe { libc::geteuid() },
+            "notification peer uid mismatch"
+        );
+        ensure!(pid > 0, "invalid notification peer pid");
+        #[cfg(target_os = "macos")]
+        {
+            let mut info: libc::proc_bsdinfo = unsafe { std::mem::zeroed() };
+            let size = std::mem::size_of_val(&info) as i32;
+            let filled = unsafe {
+                libc::proc_pidinfo(pid, libc::PROC_PIDTBSDINFO, 0, (&raw mut info).cast(), size)
+            };
+            ensure!(
+                filled == size && info.pbi_pid == pid as u32 && info.pbi_uid == uid,
+                "notification peer identity unavailable"
+            );
+            return Ok(Self {
+                pid,
+                start: (info.pbi_start_tvsec, info.pbi_start_tvusec),
+                tty_device: u64::from(info.e_tdev),
+                process_group: info.pbi_pgid as i32,
+                foreground_group: info.e_tpgid as i32,
+            });
+        }
+        #[cfg(target_os = "linux")]
+        {
+            use std::os::unix::fs::MetadataExt;
+            ensure!(
+                std::fs::metadata(format!("/proc/{pid}"))?.uid() == uid,
+                "notification peer account changed"
+            );
+            let text = std::fs::read_to_string(format!("/proc/{pid}/stat"))?;
+            let fields = text
+                .rsplit_once(") ")
+                .context("invalid process stat")?
+                .1
+                .split_whitespace()
+                .collect::<Vec<_>>();
+            let start = fields
+                .get(19)
+                .context("missing process start identity")?
+                .parse()?;
+            let tty: i32 = fields.get(4).context("missing process terminal")?.parse()?;
+            let process_group = fields.get(2).context("missing process group")?.parse()?;
+            let foreground_group = fields.get(5).context("missing foreground group")?.parse()?;
+            return Ok(Self {
+                pid,
+                start: (start, 0),
+                tty_device: u64::from(tty as u32),
+                process_group,
+                foreground_group,
+            });
+        }
+        #[cfg(not(any(target_os = "macos", target_os = "linux")))]
+        bail!("native notification peer verification is unavailable on this platform")
+    }
+
+    fn verify(&self, candidate: &RouteCandidate) -> Result<()> {
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::{FileTypeExt, MetadataExt, OpenOptionsExt};
+            ensure!(
+                *self == Self::capture(self.pid, unsafe { libc::geteuid() })?,
+                "notification peer identity changed"
+            );
+            ensure!(
+                candidate.tty.is_absolute()
+                    && dunce::canonicalize(&candidate.tty)? == candidate.tty,
+                "notification terminal must be canonical"
+            );
+            let terminal = std::fs::OpenOptions::new()
+                .read(true)
+                .custom_flags(libc::O_NOFOLLOW | libc::O_NOCTTY | libc::O_NONBLOCK)
+                .open(&candidate.tty)?;
+            let metadata = terminal.metadata()?;
+            ensure!(
+                metadata.file_type().is_char_device()
+                    && metadata.rdev() == self.tty_device
+                    && metadata.uid() == unsafe { libc::geteuid() },
+                "notification terminal does not belong to the peer"
+            );
+            ensure!(
+                self.foreground_group > 0 && self.foreground_group == self.process_group,
+                "notification peer is not the foreground terminal owner"
+            );
+            #[cfg(target_os = "linux")]
+            ensure!(
+                std::fs::metadata(format!("/proc/{}/fd/0", self.pid))?.rdev() == metadata.rdev(),
+                "notification peer stdin terminal mismatch"
+            );
+            ensure!(
+                *self == Self::capture(self.pid, unsafe { libc::geteuid() })?,
+                "notification peer changed during terminal verification"
+            );
+            Ok(())
+        }
+        #[cfg(windows)]
+        {
+            ensure!(
+                candidate.tty == Path::new("CONOUT$")
+                    && candidate.tmux.is_none()
+                    && candidate.tmux_pane.is_none(),
+                "invalid notification console candidate"
+            );
+            self.peer
+                .as_ref()
+                .context("notification console peer is unavailable")?
+                .verify()?;
+            Ok(())
+        }
+        #[cfg(not(any(unix, windows)))]
+        bail!("native notification terminal verification is unavailable on this platform")
+    }
+}
+
+#[derive(Clone)]
+struct Route {
+    exit: Option<owned_exit::ExitReservation>,
+    process_scope: xai_grok_tools::util::ProcessScope,
+    client: u64,
+    generation: String,
+    peer: PeerIdentity,
+    candidate: RouteCandidate,
+    binding: NotificationPlugin,
+    request: serde_json::Value,
+}
+
+#[derive(Default)]
+struct SessionRoute {
+    active: Option<Route>,
+    pending: Option<Route>,
+}
+
+fn routes() -> &'static Mutex<HashMap<String, SessionRoute>> {
+    static ROUTES: OnceLock<Mutex<HashMap<String, SessionRoute>>> = OnceLock::new();
+    ROUTES.get_or_init(Mutex::default)
+}
+
+/// 只从已注册的真实 leader 连接调用，调用方不能提供内核 peer 身份。
+pub(crate) async fn reserve_request(
+    json: &mut serde_json::Value,
+    client: u64,
+    peer: Option<&PeerIdentity>,
+) -> Result<bool> {
+    if json.get("method").and_then(|value| value.as_str())
+        == Some(owned_exit::OWNED_EXIT_WIRE_METHOD)
+    {
+        return owned_exit::reserve_exit(json, client, peer);
+    }
+    let Some(meta) = json
+        .get("params")
+        .and_then(|params| params.get("_meta"))
+        .and_then(|meta| meta.as_object())
+    else {
+        return Ok(false);
+    };
+    if !meta.contains_key(META_KEY) {
+        ensure!(
+            !meta.contains_key(ROUTE_KEY),
+            "notification route requires an explicit plugin binding"
+        );
+        return Ok(false);
+    }
+    let method = json
+        .get("method")
+        .and_then(|value| value.as_str())
+        .unwrap_or("");
+    ensure!(
+        matches!(method, "session/new" | "session/load"),
+        "notification route requires create or load"
+    );
+    let binding: NotificationPlugin = serde_json::from_value(
+        meta.get(META_KEY)
+            .context("missing plugin binding")?
+            .clone(),
+    )?;
+    let requested_sid = if method == "session/new" {
+        meta.get("sessionId")
+    } else {
+        json.get("params")
+            .and_then(|params| params.get("sessionId"))
+    };
+    ensure!(
+        requested_sid.and_then(|value| value.as_str()) == Some(binding.session_id.as_str()),
+        "notification route session mismatch"
+    );
+    let peer = peer.context("notification route requires a verified native peer")?;
+    let candidate: RouteCandidate = serde_json::from_value(
+        meta.get(ROUTE_KEY)
+            .context("missing notification route candidate")?
+            .clone(),
+    )?;
+    peer.verify(&candidate)?;
+    verify_tmux(&candidate).await?;
+    peer.verify(&candidate)?;
+    let generation = uuid::Uuid::new_v4().to_string();
+    let request = json
+        .get("id")
+        .context("notification route requires request id")?
+        .clone();
+    let route = Route {
+        exit: None,
+        process_scope: xai_grok_tools::util::ProcessScope::new(),
+        client,
+        generation: generation.clone(),
+        peer: peer.clone(),
+        candidate,
+        binding: binding.clone(),
+        request,
+    };
+    {
+        let mut routes = routes().lock().expect("通知路由锁被污染");
+        owned_exit::expire_exit(&mut routes, &binding.session_id);
+        let state = routes.entry(binding.session_id).or_default();
+        reserve_verified(state, route)?;
+    }
+    json.get_mut("params")
+        .and_then(|params| params.get_mut("_meta"))
+        .and_then(|meta| meta.as_object_mut())
+        .context("missing route metadata")?
+        .insert(ROUTE_KEY.into(), serde_json::json!(generation));
+    Ok(true)
+}
+
+pub(crate) fn validate_pending(
+    binding: &NotificationPlugin,
+    meta: Option<&acp::Meta>,
+) -> Result<()> {
+    let generation = meta
+        .and_then(|meta| meta.get(ROUTE_KEY))
+        .and_then(|value| value.as_str())
+        .context("notification route was not verified by the leader")?;
+    let routes = routes().lock().expect("通知路由锁被污染");
+    let pending = routes
+        .get(&binding.session_id)
+        .and_then(|state| state.pending.as_ref())
+        .context("notification route is no longer pending")?;
+    ensure!(
+        pending.generation == generation && pending.binding == *binding,
+        "notification route generation mismatch"
+    );
+    pending.peer.verify(&pending.candidate)
+}
+
+pub(crate) fn activate(
+    session_id: &str,
+    meta: Option<&acp::Meta>,
+    enqueue: impl FnOnce() -> Result<()>,
+) -> Result<bool> {
+    if !meta.is_some_and(|meta| meta.contains_key(META_KEY)) {
+        return Ok(false);
+    }
+    let generation = meta
+        .and_then(|meta| meta.get(ROUTE_KEY))
+        .and_then(|value| value.as_str())
+        .context("missing verified route generation")?;
+    let mut routes = routes().lock().expect("通知路由锁被污染");
+    let state = routes
+        .get_mut(session_id)
+        .context("notification owner disconnected")?;
+    // 闭包只能同步入队，不能等待 actor 或重入路由。接收方读取路由时会等待此锁释放。
+    activate_verified(
+        state,
+        generation,
+        |route| route.peer.verify(&route.candidate),
+        enqueue,
+    )?;
+    Ok(true)
+}
+
+fn reserve_verified(state: &mut SessionRoute, route: Route) -> Result<()> {
+    ensure!(
+        state
+            .active
+            .as_ref()
+            .is_none_or(|active| active.exit.is_none()),
+        "notification owner is exiting"
+    );
+    ensure!(
+        state
+            .active
+            .as_ref()
+            .is_none_or(|active| active.client == route.client),
+        "notification session already has a live terminal owner"
+    );
+    ensure!(
+        state.pending.is_none(),
+        "notification session attach is already pending"
+    );
+    state.pending = Some(route);
+    Ok(())
+}
+
+fn activate_verified(
+    state: &mut SessionRoute,
+    generation: &str,
+    verify: impl FnOnce(&Route) -> Result<()>,
+    enqueue: impl FnOnce() -> Result<()>,
+) -> Result<()> {
+    let pending = state
+        .pending
+        .as_ref()
+        .context("notification attach is no longer pending")?;
+    ensure!(
+        pending.generation == generation,
+        "stale notification attach generation"
+    );
+    if let Err(error) = verify(pending).and_then(|()| enqueue()) {
+        // 代际已在同一临界区核对；失败只能收回本次 pending，原 active 继续服务。
+        if let Some(pending) = state.pending.take() {
+            pending.process_scope.kill_all();
+        }
+        return Err(error);
+    }
+    if let Some(active) = state.active.take() {
+        active.process_scope.kill_all();
+    }
+    state.active = state.pending.take();
+    Ok(())
+}
+
+pub(crate) fn discard_response(json: &serde_json::Value) {
+    let Some(id) = json.get("id") else {
+        return;
+    };
+    let mut routes = routes().lock().expect("通知路由锁被污染");
+    for state in routes.values_mut() {
+        if state
+            .pending
+            .as_ref()
+            .is_some_and(|route| route.request == *id)
+        {
+            if let Some(pending) = state.pending.take() {
+                pending.process_scope.kill_all();
+            }
+        }
+    }
+    routes.retain(|_, state| state.active.is_some() || state.pending.is_some());
+}
+
+pub(crate) fn disconnect(client: u64) {
+    let mut routes = routes().lock().expect("通知路由锁被污染");
+    disconnect_routes(&mut routes, client);
+}
+
+fn disconnect_routes(routes: &mut HashMap<String, SessionRoute>, client: u64) {
+    for state in routes.values_mut() {
+        if state
+            .active
+            .as_ref()
+            .is_some_and(|route| route.client == client)
+        {
+            if let Some(active) = state.active.take() {
+                active.process_scope.kill_all();
+            }
+        }
+        if state
+            .pending
+            .as_ref()
+            .is_some_and(|route| route.client == client)
+        {
+            if let Some(pending) = state.pending.take() {
+                pending.process_scope.kill_all();
+            }
+        }
+    }
+    routes.retain(|_, state| state.active.is_some() || state.pending.is_some());
+}
+
+/// 返回真实活动路由冻结的描述符；请求者不能用查询参数替换绑定或领取通知路由。
+pub(crate) fn owned_binding(session_id: &str, cwd: &Path) -> Result<NotificationPlugin> {
+    let mut routes = routes()
+        .lock()
+        .map_err(|_| anyhow::anyhow!("notification route unavailable"))?;
+    owned_exit::expire_exit(&mut routes, session_id);
+    let state = routes
+        .get(session_id)
+        .context("notification route unavailable")?;
+    owned_binding_from_state(state, session_id, cwd, |route| {
+        route.binding.validate_target(session_id, cwd)?;
+        route.peer.verify(&route.candidate)
+    })
+}
+
+pub(crate) struct OwnedBindingGuard {
+    _routes: std::sync::MutexGuard<'static, HashMap<String, SessionRoute>>,
+}
+
+/// 接收 owned 输入时持续持有活动路由代际，检查与队列写入之间不可替换或撤销。
+pub(crate) fn owned_binding_guard(
+    session_id: &str,
+    cwd: &Path,
+    expected: &NotificationPlugin,
+) -> Result<OwnedBindingGuard> {
+    let mut routes = routes()
+        .lock()
+        .map_err(|_| anyhow::anyhow!("notification route unavailable"))?;
+    owned_exit::expire_exit(&mut routes, session_id);
+    let state = routes
+        .get(session_id)
+        .context("notification route unavailable")?;
+    let binding = owned_binding_from_state(state, session_id, cwd, |route| {
+        route.binding.validate_target(session_id, cwd)?;
+        route.peer.verify(&route.candidate)
+    })?;
+    ensure!(binding == *expected, "notification descriptor changed");
+    Ok(OwnedBindingGuard { _routes: routes })
+}
+
+fn owned_binding_from_state(
+    state: &SessionRoute,
+    session_id: &str,
+    cwd: &Path,
+    verify: impl FnOnce(&Route) -> Result<()>,
+) -> Result<NotificationPlugin> {
+    let route = state
+        .active
+        .as_ref()
+        .context("notification route is not active")?;
+    ensure!(route.exit.is_none(), "notification owner is exiting");
+    ensure!(
+        route.binding.session_id == session_id && route.binding.cwd == cwd,
+        "notification identity target mismatch"
+    );
+    ensure!(!route.process_scope.is_closed(), "notification route is closed");
+    verify(route)?;
+    Ok(route.binding.clone())
+}
+
+pub(crate) fn provider(session_id: &str) -> Arc<dyn SessionNotificationRoute> {
+    Arc::new(SessionProvider(session_id.to_string()))
+}
+
+struct SessionProvider(String);
+impl SessionNotificationRoute for SessionProvider {
+    fn environment(&self, plugin_root: &str) -> Option<NotificationEnvironment> {
+        let mut routes = routes().lock().ok()?;
+        owned_exit::expire_exit(&mut routes, &self.0);
+        let route = routes.get(&self.0)?.active.as_ref()?;
+        environment_for_route(route, plugin_root)
+    }
+}
+
+fn environment_for_route(route: &Route, plugin_root: &str) -> Option<NotificationEnvironment> {
+    if route.binding.plugin_dir != Path::new(plugin_root)
+        || route.binding.validate().is_err()
+        || route.peer.verify(&route.candidate).is_err()
+    {
+        return None;
+    }
+    Some(NotificationEnvironment {
+        #[cfg(windows)]
+        console_peer: route.peer.peer.as_ref()?.console_peer(),
+        process_scope: route.process_scope.clone(),
+        tty: route.candidate.tty.to_string_lossy().into_owned(),
+        tmux: route.candidate.tmux.clone().unwrap_or_default(),
+        tmux_pane: route.candidate.tmux_pane.clone().unwrap_or_default(),
+    })
+}
+
+async fn verify_tmux(candidate: &RouteCandidate) -> Result<()> {
+    use tokio::io::AsyncReadExt;
+    let Some(tmux) = &candidate.tmux else {
+        ensure!(
+            candidate.tmux_pane.is_none(),
+            "tmux pane without tmux session"
+        );
+        return Ok(());
+    };
+    let pane = candidate
+        .tmux_pane
+        .as_deref()
+        .context("missing tmux pane")?;
+    ensure!(
+        pane.strip_prefix('%')
+            .is_some_and(|id| !id.is_empty() && id.bytes().all(|byte| byte.is_ascii_digit())),
+        "invalid tmux pane"
+    );
+    let (socket, suffix) = tmux.rsplit_once(',').context("invalid tmux session")?;
+    let (socket, pid) = socket.rsplit_once(',').context("invalid tmux session")?;
+    ensure!(
+        !suffix.is_empty()
+            && suffix.bytes().all(|byte| byte.is_ascii_digit())
+            && !pid.is_empty()
+            && pid.bytes().all(|byte| byte.is_ascii_digit()),
+        "invalid tmux session identity"
+    );
+    ensure!(
+        Path::new(socket).is_absolute(),
+        "tmux socket must be absolute"
+    );
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::{FileTypeExt, MetadataExt};
+        let metadata = std::fs::symlink_metadata(socket)?;
+        ensure!(
+            metadata.file_type().is_socket() && metadata.uid() == unsafe { libc::geteuid() },
+            "tmux socket is not owned by the peer"
+        );
+        let parent = Path::new(socket)
+            .parent()
+            .context("missing tmux socket directory")?;
+        let directory = std::fs::symlink_metadata(dunce::canonicalize(parent)?)?;
+        ensure!(
+            directory.is_dir()
+                && directory.uid() == unsafe { libc::geteuid() }
+                && directory.mode() & 0o077 == 0,
+            "tmux socket directory is not private"
+        );
+    }
+    let mut command = tokio::process::Command::new("tmux");
+    command
+        .args([
+            "-S",
+            socket,
+            "display-message",
+            "-p",
+            "-t",
+            pane,
+            "#{pane_tty}",
+        ])
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::null())
+        .kill_on_drop(true);
+    xai_grok_tools::util::detach_command(&mut command);
+    let mut group = xai_grok_tools::util::ProcessGroup::new()?;
+    let mut child = command.spawn()?;
+    if let Err(error) = group.attach(&child) {
+        let _ = child.start_kill();
+        let _ = xai_grok_tools::util::reap_killed_search_child(&mut child).await;
+        return Err(error.into());
+    }
+    let output = child.stdout.take().context("missing tmux output")?;
+    let result = tokio::time::timeout(Duration::from_millis(750), async {
+        let mut bytes = Vec::new();
+        output.take(4097).read_to_end(&mut bytes).await?;
+        ensure!(bytes.len() <= 4096, "tmux route output exceeds limit");
+        ensure!(child.wait().await?.success(), "tmux route query failed");
+        Ok::<_, anyhow::Error>(bytes)
+    })
+    .await;
+    // 只结束本次派生的进程组；超时和超量输出都不能留下后台查询。
+    if !matches!(&result, Ok(Ok(_))) {
+        let _ = group.kill();
+        let _ = xai_grok_tools::util::reap_killed_search_child(&mut child).await;
+    }
+    let bytes = result.context("tmux route query timed out")??;
+    let text = std::str::from_utf8(&bytes)?;
+    let tty = text.strip_suffix('\n').unwrap_or(text);
+    ensure!(
+        !tty.bytes().any(|byte| byte.is_ascii_control()) && Path::new(tty) == candidate.tty,
+        "tmux pane terminal does not match the verified peer"
+    );
+    Ok(())
+}
