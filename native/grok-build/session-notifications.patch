+#[test]
+fn create_and_cold_attach_require_same_frozen_binding() {
+    let fixture = Fixture::new();
+    let dir = fixture.session_dir();
+    verify_binding(&dir, Some(&fixture.binding), true, false).unwrap();
+    let before = fs::read(dir.join(BINDING_FILE)).unwrap();
+    verify_binding(&dir, Some(&fixture.binding), false, false).unwrap();
+    assert_eq!(before, fs::read(dir.join(BINDING_FILE)).unwrap());
+    assert!(verify_binding(&dir, None, false, false).is_err());
+    let mut replacement = fixture.binding.clone();
+    replacement
+        .files
+        .insert("hooks/notify.cjs".into(), "0".repeat(64));
+    assert!(verify_binding(&dir, Some(&replacement), false, false).is_err());
+    assert_eq!(before, fs::read(dir.join(BINDING_FILE)).unwrap());
+}
