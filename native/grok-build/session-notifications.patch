+use super::*;
+use futures::FutureExt;
+use std::future::Future;
+use std::panic::AssertUnwindSafe;
+use std::path::Path;
+use std::task::Poll;
+use tokio::sync::mpsc;
+use xai_grok_paths::AbsPathBuf;
+
+#[cfg(windows)]
+const SPAWN_READY_TIMEOUT: Duration = Duration::from_secs(10);
+#[cfg(unix)]
+const SPAWN_READY_TIMEOUT: Duration = Duration::from_secs(2);
+
+struct ReadyNotifier(mpsc::UnboundedSender<()>);
+
+#[async_trait::async_trait]
+impl SessionNotificationSender for ReadyNotifier {
+    async fn session_notification(
+        &self,
+        notification: acp::SessionNotification,
+    ) -> Result<(), acp::Error> {
+        if matches!(notification.update, acp::SessionUpdate::ToolCallUpdate(_)) {
+            let _ = self.0.send(());
+        }
+        Ok(())
+    }
+}
+
+fn session_id() -> String {
+    format!("bridge-{}", uuid::Uuid::now_v7())
+}
+
+fn marker_env(marker: Option<&Path>) -> HashMap<String, String> {
+    marker
+        .map(|path| {
+            let path = path.to_str().unwrap().to_owned();
+            #[cfg(windows)]
+            let path = path.replace('\\', "/");
+            ("GROK_BRIDGE_TEST_MARKER".to_owned(), path)
+        })
+        .into_iter()
+        .collect()
+}
+
+fn direct_command(marker: Option<&Path>) -> (&'static str, Vec<String>, HashMap<String, String>) {
+    #[cfg(unix)]
+    let (program, args) = match marker {
+        Some(_) => (
+            "sh",
+            vec![
+                "-c".to_owned(),
+                "printf started > \"$GROK_BRIDGE_TEST_MARKER\"; sleep 30".to_owned(),
+            ],
+        ),
+        None => ("sleep", vec!["30".to_owned()]),
+    };
+    #[cfg(windows)]
+    let (program, args) = {
+        let script = match marker {
+            Some(_) => {
+                "[System.IO.File]::WriteAllText($env:GROK_BRIDGE_TEST_MARKER, 'started'); Start-Sleep -Seconds 30"
+            }
+            None => "Start-Sleep -Seconds 30",
+        };
+        (
+            "powershell.exe",
+            [
+                "-NoLogo",
+                "-NoProfile",
+                "-NonInteractive",
+                "-Command",
+                script,
+            ]
+            .map(str::to_owned)
+            .to_vec(),
+        )
+    };
+    (program, args, marker_env(marker))
+}
+
+fn request(tool_call_id: &str, marker: Option<&Path>) -> TerminalRunRequest {
+    #[cfg(unix)]
+    let command = match marker {
+        Some(_) => "printf started > \"$GROK_BRIDGE_TEST_MARKER\"",
+        None => "sleep 30",
+    };
+    #[cfg(windows)]
+    let command = {
+        use xai_grok_config::shell::{WindowsShell, detect_windows_shell};
+        // 不覆盖真实 shell 检测；路径通过环境传入，不把空格或单引号拼成命令。
+        match (detect_windows_shell(), marker.is_some()) {
+            (WindowsShell::Pwsh | WindowsShell::PowerShell, true) => {
+                "[System.IO.File]::WriteAllText($env:GROK_BRIDGE_TEST_MARKER, 'started')"
+            }
+            (WindowsShell::Pwsh | WindowsShell::PowerShell, false) => "Start-Sleep -Seconds 30",
+            (WindowsShell::GitBash(_), true) => "printf started > \"$GROK_BRIDGE_TEST_MARKER\"",
+            (WindowsShell::GitBash(_), false) => "sleep 30",
+            (WindowsShell::Cmd, true) => {
+                "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"[System.IO.File]::WriteAllText($env:GROK_BRIDGE_TEST_MARKER, 'started')\""
+            }
+            (WindowsShell::Cmd, false) => {
+                "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"Start-Sleep -Seconds 30\""
+            }
+        }
+    };
+    TerminalRunRequest {
+        tool_call_id: acp::ToolCallId::new(tool_call_id),
+        command: command.to_owned(),
+        cwd: AbsPathBuf::new(std::env::current_dir().unwrap()).unwrap(),
+        env: marker_env(marker),
+        timeout: Duration::from_secs(30),
+        output_byte_limit: 1024,
+        stream: true,
+        output_file: None,
+    }
+}
+
+async fn run_with_session<F: Future<Output = ()>>(run: impl FnOnce(String) -> F) {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            let session = session_id();
+            let result = AssertUnwindSafe(run(session.clone())).catch_unwind().await;
+            // 注册表持有子进程，断言展开不会触发 KillOnDrop；只回收本用例精确登记的句柄。
+            let cleanup = tokio::time::timeout(Duration::from_secs(10), async {
+                let mut entries: Vec<_> = registry()
+                    .lock()
+                    .await
+                    .iter()
+                    .filter(|((sid, _), _)| sid == &session)
+                    .map(|(key, entry)| (key.clone(), entry.clone()))
+                    .collect();
+                entries.extend(
+                    retiring_terminals()
+                        .lock()
+                        .await
+                        .iter()
+                        .filter(|((sid, _), _)| sid == &session)
+                        .map(|(key, entry)| (key.clone(), entry.clone())),
+                );
+                for (key, entry) in entries {
+                    let mut child = entry.child.lock().await;
+                    if child.try_wait().unwrap().is_none() {
+                        child.start_kill().unwrap();
+                        child.wait().await.unwrap();
+                    }
+                    assert!(child.try_wait().unwrap().is_some());
+                    registry().lock().await.remove(&key);
+                    retiring_terminals().lock().await.remove(&key);
+                }
+            })
+            .await;
+            assert!(cleanup.is_ok(), "本用例子进程必须在期限内确认退出");
+            if let Err(panic) = result {
+                std::panic::resume_unwind(panic);
+            }
+        })
+        .await;
+}
+
+#[tokio::test]
+async fn terminal_bridge_backgrounded_bash_command_stays_busy_after_turn_returns() {
+    run_with_session(|session| async move {
+        let tool_id = "bash-mode-background";
+        let (notify, mut ready) = mpsc::unbounded_channel();
+        let runner = StreamingLocalTerminalRunner {
+            notifier: Arc::new(ReadyNotifier(notify)),
+            session_id: acp::SessionId::new(session.clone()),
+        };
+        let running =
+            tokio::task::spawn_local(async move { runner.run(request(tool_id, None)).await });
+        tokio::time::timeout(SPAWN_READY_TIMEOUT, ready.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        background_terminal(&session, tool_id).await;
+        let result = tokio::time::timeout(Duration::from_secs(2), running)
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        assert_eq!(result.signal.as_deref(), Some("backgrounded"));
+        assert!(acquire_piped_command_idle(&session).await.is_none());
+        release_terminal(&session, tool_id).await;
+        assert!(acquire_piped_command_idle(&session).await.is_some());
+    })
+    .await;
+}
