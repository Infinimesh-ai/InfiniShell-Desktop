+use super::*;
+
+pub(crate) struct Fixture {
+    _temp: tempfile::TempDir,
+    pub(crate) root: PathBuf,
+    pub(crate) binding: NotificationPlugin,
+}
+
+impl Fixture {
+    pub(crate) fn new() -> Self {
+        let temp = tempfile::tempdir().unwrap();
+        let root = dunce::canonicalize(temp.path()).unwrap();
+        let plugin_dir = root.join("notification-plugin");
+        fs::create_dir_all(plugin_dir.join(".grok-plugin")).unwrap();
+        fs::create_dir_all(plugin_dir.join("hooks")).unwrap();
+        fs::write(plugin_dir.join(".grok-plugin/plugin.json"), br#"{"name":"infinishell-grok","version":"test","description":"synthetic notification fixture"}"#).unwrap();
+        let hooks = EVENTS.into_iter().map(|event| (event.to_string(), serde_json::json!([{"hooks":[{
+            "type":"command", "command":NOTIFY_COMMAND, "timeout":5,
+            "env":{"WARP_CLI_AGENT_PROTOCOL_VERSION":"1", "WARP_CLI_AGENT_NOTIFY_EXECUTABLE":root.join("synthetic-worker"), "WARP_CLI_AGENT_SESSION_ROUTE":"1"}
+        }]}]))).collect::<serde_json::Map<_,_>>();
+        fs::write(
+            plugin_dir.join("hooks/hooks.json"),
+            serde_json::to_vec(&serde_json::json!({"hooks":hooks})).unwrap(),
+        )
+        .unwrap();
+        fs::write(
+            plugin_dir.join("hooks/notify.cjs"),
+            b"exports.main = () => {};\n",
+        )
+        .unwrap();
+        let binding = NotificationPlugin {
+            version: 1,
+            session_id: uuid::Uuid::new_v4().to_string(),
+            cwd: root.clone(),
+            plugin_dir,
+            files: BTreeMap::new(),
+        };
+        let mut fixture = Self {
+            _temp: temp,
+            root,
+            binding,
+        };
+        fixture.rehash();
+        fixture
+    }
+
+    fn rehash(&mut self) {
+        self.binding.files = RESOURCE_FILES
+            .into_iter()
+            .map(|name| {
+                (
+                    name.into(),
+                    format!(
+                        "{:x}",
+                        Sha256::digest(fs::read(self.binding.plugin_dir.join(name)).unwrap())
+                    ),
+                )
+            })
+            .collect();
+    }
+
+    fn session_dir(&self) -> PathBuf {
+        let path = self.root.join("session");
+        fs::create_dir(&path).unwrap();
+        path
+    }
+}
