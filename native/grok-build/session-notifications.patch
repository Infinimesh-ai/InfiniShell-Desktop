+#[tokio::test(flavor = "current_thread")]
+async fn owned_identity_requires_an_explicit_resident_session() {
+    let agent = build_minimal_agent_for_tests();
+    let sid = uuid::Uuid::new_v4().to_string();
+    assert!(
+        query(&agent, serde_json::json!({"infinishellOwnedIdentity":true}))
+            .await
+            .is_err()
+    );
+    assert!(
+        query(
+            &agent,
+            serde_json::json!({"sessionId":sid,"infinishellOwnedIdentity":true})
+        )
+        .await
+        .is_err()
+    );
+    assert!(agent.resident_ids().is_empty());
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn owned_identity_closed_actor_cannot_return_display_defaults() {
+    let agent = build_minimal_agent_for_tests();
+    let sid = acp::SessionId::new(uuid::Uuid::new_v4().to_string());
+    let (handle, _tx, rx) = make_live_session_handle(&sid, None);
+    agent.insert_resident(&sid, handle);
+    drop(rx);
+    assert!(
+        query(
+            &agent,
+            serde_json::json!({"sessionId":sid,"infinishellOwnedIdentity":true})
+        )
+        .await
+        .is_err()
+    );
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn owned_identity_uses_actor_reply_without_load_or_session_start() {
+    let agent = build_minimal_agent_for_tests();
+    let sid = acp::SessionId::new(uuid::Uuid::new_v4().to_string());
+    let (mut handle, _tx, mut rx) = make_live_session_handle(&sid, None);
+    let cwd = std::env::temp_dir();
+    handle.info.cwd = cwd.to_string_lossy().into_owned();
+    agent.insert_resident(&sid, handle);
+    let binding = crate::session::notification_plugin::NotificationPlugin {
+        version: 1,
+        session_id: sid.to_string(),
+        cwd: cwd.clone(),
+        plugin_dir: cwd.join("synthetic-plugin"),
+        files: Default::default(),
+    };
+    let identity = OwnedSessionInfo {
+        session_id: sid.to_string(),
+        cwd: cwd.to_string_lossy().into_owned(),
+        infinishell_owned_identity: OwnedSessionIdentity {
+            protocol_version: 1,
+            permission_mode: "auto".into(),
+            notification_binding: binding,
+        },
+    };
+    let expected = serde_json::to_value(&identity).unwrap();
+    let answer = async {
+        let Some(TestSessionCommand::GetOwnedIdentity { responds_to }) = rx.recv().await else {
+            panic!("只读查询不能入队 load、prompt 或通知命令");
+        };
+        responds_to.send(Ok(identity)).unwrap();
+    };
+    let (response, ()) = futures::join!(
+        query(
+            &agent,
+            serde_json::json!({"sessionId":sid,"infinishellOwnedIdentity":true})
+        ),
+        answer
+    );
+    assert_eq!(
+        serde_json::to_value(response.unwrap()).unwrap()["result"],
+        expected
+    );
+    assert!(rx.try_recv().is_err());
