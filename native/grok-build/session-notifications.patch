+const BLUE: &str = "iVBORw0KGgoAAAANSUhEUgAAACAAAAAQCAIAAAD4YuoOAAAAHElEQVR4nGNgYPhPYzRqwagFoxaMWjBqwRCwAABSiP4QftsDtAAAAABJRU5ErkJggg==";
