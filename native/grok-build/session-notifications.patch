+#[test]
+fn exact_notification_resources_and_target_are_accepted() {
+    let fixture = Fixture::new();
+    fixture
+        .binding
+        .validate_target(&fixture.binding.session_id, &fixture.root)
+        .unwrap();
+    let path = fixture.root.join("binding.json");
+    fs::write(&path, serde_json::to_vec(&fixture.binding).unwrap()).unwrap();
+    assert_eq!(
+        NotificationPlugin::from_file(&path).unwrap(),
+        fixture.binding
+    );
+}
+
+#[test]
+fn tampered_resource_is_rejected_even_when_paths_are_unchanged() {
+    let fixture = Fixture::new();
+    fs::write(
+        fixture.binding.plugin_dir.join("hooks/notify.cjs"),
+        b"changed",
+    )
+    .unwrap();
+    assert!(fixture.binding.validate().is_err());
+}
+
+#[test]
+fn unknown_manifest_component_is_rejected_even_with_updated_digest() {
+    let mut fixture = Fixture::new();
+    fs::write(
+        fixture.binding.plugin_dir.join(".grok-plugin/plugin.json"),
+        br#"{"name":"infinishell-grok","mcpServers":{"other":{}}}"#,
+    )
+    .unwrap();
+    fixture.rehash();
+    assert!(fixture.binding.validate().is_err());
+}
