+use super::*;
+use std::time::Duration;
+
+fn handle() -> PermissionHandle {
+    let (cmd_tx, _rx) = mpsc::unbounded_channel();
+    PermissionHandle::Actor {
+        cmd_tx,
+        yolo_state: Arc::new(AtomicBool::new(false)),
+        auto_state: Arc::new(AtomicBool::new(false)),
+        mode_guard: Arc::new(Mutex::new(())),
+        side_query_wired: Arc::new(AtomicBool::new(false)),
+        yolo_pin: None,
+        deny_read_globs: Arc::new(vec![]),
+        in_flight: Arc::new(AtomicUsize::new(0)),
+        user_prompt_notify: Arc::new(Mutex::new(None)),
+    }
+}
+
+#[test]
+fn owned_input_default_guard_rejects_auto_yolo_and_allow_all() {
+    let handle = handle();
+    assert!(handle.default_mode_guard().is_some());
+    handle.set_auto_mode(true);
+    assert!(handle.default_mode_guard().is_none());
+    handle.set_yolo_mode(true);
+    assert!(handle.default_mode_guard().is_none());
+    handle.set_yolo_mode(false);
+    assert!(handle.default_mode_guard().is_some());
+    assert!(PermissionHandle::AllowAll.default_mode_guard().is_none());
+}
+
+fn concurrent_setter_waits(enable_auto: bool) {
+    let handle = handle();
+    let guard = handle.default_mode_guard().unwrap();
+    let other = handle.clone();
+    let (started_tx, started_rx) = std::sync::mpsc::channel();
+    let (done_tx, done_rx) = std::sync::mpsc::channel();
+    let thread = std::thread::spawn(move || {
+        started_tx.send(()).unwrap();
+        if enable_auto {
+            other.set_auto_mode(true);
+        } else {
+            other.set_yolo_mode(true);
+        }
+        done_tx.send(()).unwrap();
+    });
+    started_rx.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert!(matches!(
+        done_rx.recv_timeout(Duration::from_millis(25)),
+        Err(std::sync::mpsc::RecvTimeoutError::Timeout)
+    ));
+    assert!(!handle.is_yolo_mode());
+    assert!(!handle.is_auto_mode());
+    drop(guard);
+    done_rx.recv_timeout(Duration::from_secs(2)).unwrap();
+    thread.join().unwrap();
+    assert!(handle.default_mode_guard().is_none());
+}
+
+#[test]
+fn owned_input_default_guard_excludes_concurrent_yolo_setter() {
+    concurrent_setter_waits(false);
+}
+
+#[test]
+fn owned_input_default_guard_excludes_concurrent_auto_setter() {
+    concurrent_setter_waits(true);
+}
