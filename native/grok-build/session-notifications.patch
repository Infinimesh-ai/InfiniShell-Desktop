+//! 只从已经读完注册消息的服务端管道捕获 Windows 原生通知 peer。
+
+use std::io;
+
+use tokio::net::windows::named_pipe::NamedPipeServer;
+use xai_grok_hooks::runner::notification_console_windows::ConsolePeer;
+
+pub fn run_console_broker() -> io::Result<i32> {
+    xai_grok_hooks::runner::notification_console_windows::run_broker()
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct VerifiedPeer {
+    peer: ConsolePeer,
+}
+
+impl VerifiedPeer {
+    pub(crate) fn capture(pipe: &NamedPipeServer) -> io::Result<Self> {
+        Ok(Self {
+            peer: ConsolePeer::from_named_pipe(pipe)?,
+        })
+    }
+
+    pub(crate) fn verify(&self) -> io::Result<()> {
+        self.peer.verify()
+    }
+
+    pub(crate) fn console_peer(&self) -> ConsolePeer {
+        self.peer.clone()
+    }
+}
+
+#[cfg(test)]
+#[path = "notification_route_windows_tests.rs"]
+mod tests;
