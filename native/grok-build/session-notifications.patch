+use super::*;
+use serde_json::json;
+
+fn request() -> acp::PromptRequest {
+    acp::PromptRequest::new(
+        acp::SessionId::new("00000000-0000-4000-8000-000000000001"),
+        vec![
+            acp::ContentBlock::Text(acp::TextContent::new("第一行\nsecond line")),
+            acp::ContentBlock::Image(acp::ImageContent::new("AA==", "image/png")),
+        ],
+    )
+    .meta(Some(
+        json!({
+            "verbatim":true,
+            "infinishellOwnedInput": {
+                "protocolVersion":1,"requireDefaultPermissions":true,
+                "requestId":"00000000-0000-4000-8000-000000000002",
+                "notificationBinding": {
+                    "version":1,"session_id":"00000000-0000-4000-8000-000000000001",
+                    "cwd":"/synthetic/project","plugin_dir":"/synthetic/plugin","files":{}
+                }
+            }
+        })
+        .as_object()
+        .unwrap()
+        .clone(),
+    ))
+}
+
+#[test]
+fn owned_identity_input_preserves_typed_png_and_text() {
+    let request = request();
+    let before = serde_json::to_value(&request.prompt).unwrap();
+    let condition = input_precondition(&request).unwrap().unwrap();
+    assert_eq!(condition.request_id, "00000000-0000-4000-8000-000000000002");
+    assert_eq!(serde_json::to_value(&request.prompt).unwrap(), before);
+}
+
+#[test]
+fn owned_identity_input_cannot_override_permissions_or_queue_semantics() {
+    let mut request = request();
+    request
+        .meta
+        .as_mut()
+        .unwrap()
+        .insert("mode".into(), json!("plan"));
+    let error = input_precondition(&request).unwrap_err();
+    assert_eq!(serde_json::to_value(error.code).unwrap(), -32073);
+    assert_eq!(
+        error.data.unwrap(),
+        json!({
+            "code":"infinishell_owned_input_rejected", "protocolVersion":1,
+            "sessionId":"00000000-0000-4000-8000-000000000001",
+            "requestId":"00000000-0000-4000-8000-000000000002", "queued":false,
+            "reason":"invalid_precondition"
+        })
+    );
+}
+
+#[test]
+fn owned_identity_input_rejects_foreign_descriptor_and_nondefault_requirement() {
+    let mut request = request();
+    request.meta.as_mut().unwrap().get_mut(INPUT_KEY).unwrap()["notificationBinding"]["session_id"] =
+        json!("foreign");
+    assert!(input_precondition(&request).is_err());
+    let mut request = self::request();
+    request.meta.as_mut().unwrap().get_mut(INPUT_KEY).unwrap()["requireDefaultPermissions"] =
+        json!(false);
+    assert!(input_precondition(&request).is_err());
+}
+
+#[test]
+fn ordinary_prompt_has_no_owned_precondition() {
+    let request = acp::PromptRequest::new(acp::SessionId::new("ordinary"), vec![]);
+    assert!(input_precondition(&request).unwrap().is_none());
+}
