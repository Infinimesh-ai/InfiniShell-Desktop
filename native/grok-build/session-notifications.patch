+            let (content, _response) = image_content();
+            let expected = content.prompt_blocks.clone();
+            assert!(actor.admit_terminal_bridge("images".into(), content).await);
+            let state = actor.state.lock().await;
+            assert_eq!(state.pending_inputs.len(), 1);
