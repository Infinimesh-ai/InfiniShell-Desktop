index 0000000000000000000000000000000000000000..64da658bad6a07bd5115b2c325e8d30fc8e832eb
--- /dev/null
+++ b/crates/build/xai-proto-build/src/lib_tests.rs
@@ -0,0 +1,75 @@
+use super::*;
+
+#[test]
+fn dependency_paths_preserve_windows_drive_spaces_and_crlf() {
+    let target = Path::new(r"C:\build temp\dependencies.pbbin");
+    let manifest = concat!(
+        "C:\\build temp\\dependencies.pbbin: C:\\source dir\\child.proto\\\r\n",
+        " C:\\source dir\\root.proto\r\n",
+    );
+    assert_eq!(
+        parse_dependency_paths(manifest, target).unwrap(),
+        [r"C:\source dir\child.proto", r"C:\source dir\root.proto"]
+    );
+}
+
+#[test]
+fn dependency_paths_preserve_unix_spaces_and_continuations() {
+    let target = Path::new("/build temp/dependencies.pbbin");
+    let manifest = concat!(
+        "/build temp/dependencies.pbbin: /source dir/child.proto\\\n",
+        " /source dir/root.proto",
+    );
+    assert_eq!(
+        parse_dependency_paths(manifest, target).unwrap(),
+        ["/source dir/child.proto", "/source dir/root.proto"]
+    );
+}
+
+#[test]
+fn dependency_paths_reject_different_target_or_empty_path() {
+    let target = Path::new("dependencies.pbbin");
+    assert!(parse_dependency_paths("other.pbbin: root.proto", target).is_err());
+    assert!(parse_dependency_paths("dependencies.pbbin:", target).is_err());
+    assert!(parse_dependency_paths("dependencies.pbbin: ", target).is_err());
+    assert!(parse_dependency_paths("", target).is_err());
+}
+
+#[test]
+fn dependency_manifest_supports_real_protoc_imports_and_paths_with_spaces() {
+    let source_dir = tempfile::TempDir::new().unwrap();
+    let include_dir = source_dir.path().join("proto sources");
+    fs::create_dir(&include_dir).unwrap();
+    let child = include_dir.join("child.proto");
+    fs::write(
+        &child,
+        "syntax = \"proto3\"; package build_test; message Child {}",
+    )
+    .unwrap();
+    let root = include_dir.join("root.proto");
+    fs::write(
+        &root,
+        "syntax = \"proto3\"; package build_test; import \"child.proto\"; message Root { Child child = 1; }",
+    )
+    .unwrap();
+    let protoc = find_protoc::find_protoc().unwrap();
+    XaiProtoBuilder::emit_rerun_if_changed(
+        protoc.as_deref(),
+        None,
+        [root.as_path()],
+        [include_dir.as_path()],
+    )
+    .unwrap();
+
+    // 缺失导入必须继续失败，不能为了跨平台构建绕过依赖验证。
+    fs::remove_file(&child).unwrap();
+    assert!(
+        XaiProtoBuilder::emit_rerun_if_changed(
+            protoc.as_deref(),
+            None,
+            [root.as_path()],
+            [include_dir.as_path()],
+        )
+        .is_err()
+    );
+}
