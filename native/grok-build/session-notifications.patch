+    #[cfg(unix)]
+    {
+        bridge.journal = File::open(directory.path().join("receipts.jsonl")).unwrap();
+    }
+    #[cfg(windows)]
+    let restore_directory_acl = {
+        use crate::app::terminal_bridge_windows::UserIdentity;
+        use std::os::windows::ffi::OsStrExt;
+        use windows_sys::Win32::Security::{
+            DACL_SECURITY_INFORMATION, PROTECTED_DACL_SECURITY_INFORMATION, SetFileSecurityW,
+        };
+
+        let owner = UserIdentity::current().unwrap();
+        let invalid_acl = owner.security(false).unwrap();
+        let restore = owner.security(true).unwrap();
+        let path: Vec<u16> = directory
+            .path()
+            .as_os_str()
+            .encode_wide()
+            .chain(Some(0))
+            .collect();
+        // 只撤销本测试私有目录的继承标记，让生产 Journal 在真实写入前拒绝权限变化。
+        assert_ne!(
+            unsafe {
+                SetFileSecurityW(
+                    path.as_ptr(),
+                    DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+                    invalid_acl.attributes().lpSecurityDescriptor,
+                )
+            },
+            0
+        );
+        move || {
+            assert_ne!(
+                unsafe {
+                    SetFileSecurityW(
+                        path.as_ptr(),
+                        DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+                        restore.attributes().lpSecurityDescriptor,
+                    )
+                },
+                0
+            );
+        }
+    };
+    let request = submission(&lease, "不得发送");
+    let (response, effects) = bridge.handle(request.clone(), &mut app);
+    assert_eq!(receipt(response).state, ReceiptState::Unknown);
+    assert!(effects.is_empty());
+    let (response, effects) = bridge.handle(request, &mut app);
+    assert_eq!(receipt(response).state, ReceiptState::Unknown);
+    assert!(effects.is_empty());
+    assert!(bridge.journal_failed);
+    #[cfg(windows)]
+    restore_directory_acl();
+}
