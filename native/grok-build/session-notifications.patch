+use super::*;
+use std::future::{Future, poll_fn};
+use std::pin::Pin;
+use std::task::Poll;
+use xai_acp_lib::AcpAgentMessage;
+use xai_grok_shell::session::notification_plugin::NotificationPlugin;
+
+async fn poll_once<F: Future>(mut future: Pin<&mut F>) -> Poll<F::Output> {
+    poll_fn(|ctx| Poll::Ready(future.as_mut().poll(ctx))).await
+}
+
+fn request() -> OwnedExitRequest {
+    let sid = uuid::Uuid::new_v4().to_string();
+    OwnedExitRequest {
+        protocol_version: 1,
+        session_id: sid.clone(),
+        meta: None,
+        notification_binding: NotificationPlugin {
+            version: 1,
+            session_id: sid,
+            cwd: std::env::temp_dir(),
+            plugin_dir: std::env::temp_dir().join("synthetic-plugin"),
+            files: Default::default(),
+        },
+    }
+}
+
+fn response(sid: &str, outcome: &str) -> acp::ExtResponse {
+    acp::ExtResponse::new(
+        serde_json::value::to_raw_value(&serde_json::json!({
+            "result":{"protocolVersion":1,"sessionId":sid,"outcome":outcome}
+        }))
+        .unwrap()
+        .into(),
+    )
+}
+
+#[tokio::test]
+async fn owned_exit_waits_for_exact_native_ack_before_returning() {
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let req = request();
+    let sid = req.session_id.clone();
+    let mut exit = std::pin::pin!(request_exit(&tx, req, Duration::from_secs(1)));
+    assert!(matches!(poll_once(exit.as_mut()).await, Poll::Pending));
+    let Some(AcpAgentMessage::ExtMethod(call)) = rx.recv().await else {
+        panic!("必须使用原生扩展请求");
+    };
+    assert_eq!(call.request.method.as_ref(), OWNED_EXIT_METHOD);
+    let params: OwnedExitRequest = serde_json::from_str(call.request.params.get()).unwrap();
+    assert_eq!(params.session_id, sid);
+    assert!(params.meta.is_none());
+    assert!(matches!(poll_once(exit.as_mut()).await, Poll::Pending));
+    call.response_tx.send(Ok(response(&sid, "closed"))).unwrap();
+    exit.await.unwrap();
+    assert!(rx.try_recv().is_err(), "退出不得重试或提交输入");
+}
+
+#[tokio::test]
+async fn owned_exit_busy_ack_keeps_detach_semantics() {
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let req = request();
+    let sid = req.session_id.clone();
+    let mut exit = std::pin::pin!(request_exit(&tx, req, Duration::from_secs(1)));
+    assert!(matches!(poll_once(exit.as_mut()).await, Poll::Pending));
+    let Some(AcpAgentMessage::ExtMethod(call)) = rx.recv().await else {
+        panic!("缺少退出请求");
+    };
+    call.response_tx.send(Ok(response(&sid, "busy"))).unwrap();
+    exit.await.unwrap();
+    assert!(rx.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn owned_exit_wrong_session_and_unsupported_leader_are_not_success() {
+    for unsupported in [false, true] {
+        let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+        let mut exit = std::pin::pin!(request_exit(&tx, request(), Duration::from_secs(1)));
+        assert!(matches!(poll_once(exit.as_mut()).await, Poll::Pending));
+        let Some(AcpAgentMessage::ExtMethod(call)) = rx.recv().await else {
+            panic!("缺少退出请求");
+        };
+        let reply = if unsupported {
+            Err(acp::Error::method_not_found())
+        } else {
+            Ok(response("wrong", "closed"))
+        };
+        call.response_tx.send(reply).unwrap();
+        assert!(exit.await.is_err());
+        assert!(rx.try_recv().is_err());
+    }
+}
+
+#[tokio::test]
+async fn owned_exit_missing_ack_is_bounded_without_retry() {
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let mut exit = std::pin::pin!(request_exit(&tx, request(), Duration::from_millis(20)));
+    assert!(matches!(poll_once(exit.as_mut()).await, Poll::Pending));
+    let Some(AcpAgentMessage::ExtMethod(call)) = rx.recv().await else {
+        panic!("缺少退出请求");
+    };
+    assert!(exit.await.is_err());
+    assert!(call.response_tx.is_closed());
+    assert!(rx.try_recv().is_err());
+}
