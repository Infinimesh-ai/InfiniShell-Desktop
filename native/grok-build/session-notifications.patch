+#[test]
+fn terminal_bridge_windows_reparse_directory_and_its_descendant_are_rejected() {
+    use windows_sys::Win32::System::IO::DeviceIoControl;
+    let temporary = private_test_directory();
+    let owner = UserIdentity::current().unwrap();
+    let root = Directory::open(temporary.path(), &owner).unwrap();
+    let target = root.create_child("target").unwrap();
+    let nested = target.create_child("nested").unwrap();
+    let alias = root.create_child("junction").unwrap();
+    let canonical = target.path().canonicalize().unwrap();
+    let target_text = canonical.to_string_lossy();
+    let target_text = target_text.strip_prefix(r"\\?\").unwrap_or(&target_text);
+    let substitute: Vec<u16> = format!(r"\??\{target_text}").encode_utf16().collect();
+    let display: Vec<u16> = target_text.encode_utf16().collect();
+    let substitute_bytes = (substitute.len() * 2) as u16;
+    let display_bytes = (display.len() * 2) as u16;
+    let mut buffer = Vec::new();
+    // Mount-point reparse buffer；只指向本次夹具内的普通目录，不需要符号链接特权。
+    buffer.extend_from_slice(&0xa000_0003u32.to_le_bytes());
+    buffer.extend_from_slice(&(8 + substitute_bytes + 2 + display_bytes + 2).to_le_bytes());
+    buffer.extend_from_slice(&0u16.to_le_bytes());
+    for value in [0, substitute_bytes, substitute_bytes + 2, display_bytes] {
+        buffer.extend_from_slice(&value.to_le_bytes());
+    }
+    for value in substitute
+        .into_iter()
+        .chain(Some(0))
+        .chain(display)
+        .chain(Some(0))
+    {
+        buffer.extend_from_slice(&value.to_le_bytes());
+    }
+    let file = open(
+        alias.path(),
+        true,
+        FILE_GENERIC_WRITE,
+        FILE_SHARE_READ | FILE_SHARE_WRITE,
+    )
+    .unwrap();
+    let mut returned = 0;
+    assert_ne!(
+        unsafe {
+            DeviceIoControl(
+                file.as_raw_handle(),
+                0x0009_00a4,
+                buffer.as_ptr().cast(),
+                buffer.len() as u32,
+                ptr::null_mut(),
+                0,
+                &mut returned,
+                ptr::null_mut(),
+            )
+        },
+        0,
+        "{}",
+        io::Error::last_os_error()
+    );
+    assert!(Directory::open(alias.path(), &owner).is_err());
+    assert!(Directory::open(&alias.path().join("nested"), &owner).is_err());
+    assert!(alias.validate().is_err());
+    nested.validate().unwrap();
+}
