+#[test]
+fn pending_route_is_not_active_until_successful_attach() {
+    let mut state = SessionRoute::default();
+    reserve_verified(&mut state, route(1, "first")).unwrap();
+    assert!(state.active.is_none());
+    activate_verified(&mut state, "first", |_| Ok(()), || Ok(())).unwrap();
+    assert_eq!(state.active.as_ref().unwrap().generation, "first");
+    assert!(state.pending.is_none());
+}
