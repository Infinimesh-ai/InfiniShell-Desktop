+//! 自有 PTY、真实 actor 和实际 hook 子进程验证正常退出顺序；不调用模型。
+use super::support::*;
+use super::*;
+use crate::session::notification_route::{OwnedExitGuard, owned_identity_fixture::Fixture};
+use std::path::PathBuf;
+use std::sync::atomic::Ordering;
+use xai_grok_hooks::config::{HandlerType, HookProvenance, HookSpec};
+use xai_grok_hooks::event::HookEventName;
+
+async fn actor(
+    fixture: &Fixture,
+) -> (
+    Arc<SessionActor>,
+    mpsc::UnboundedReceiver<SessionEvent>,
+    Arc<std::sync::Mutex<Vec<serde_json::Value>>>,
+) {
+    let (gateway_tx, gateway_rx) = mpsc::unbounded_channel();
+    let (_, updates) = spawn_capturing_gateway_loop(gateway_rx);
+    let (persistence_tx, persistence_rx) = mpsc::unbounded_channel();
+    drain_persistence(persistence_rx);
+    let (mut actor, events) =
+        create_test_actor_ex(0, 256_000, 85, gateway_tx, persistence_tx).await;
+    actor.session_info.id = acp::SessionId::new(fixture.binding().session_id.clone());
+    actor.session_info.cwd = fixture.binding().cwd.to_string_lossy().into_owned();
+    actor.hook_resolved_workspace_root = actor.session_info.cwd.clone();
+    actor.tool_context.process_scope = Some(xai_grok_tools::util::ProcessScope::new());
+    let mut registry = xai_grok_hooks::discovery::HookRegistry::default();
+    let (specs, warnings) = xai_grok_agent::plugins::hooks_adapter::parse_plugin_hooks(
+        &fixture.binding().plugin_dir.join("hooks/hooks.json"),
+        "infinishell-grok",
+        fixture.binding().plugin_dir.to_str().unwrap(),
+        fixture.binding().cwd.to_str().unwrap(),
+    );
+    assert!(warnings.is_empty());
+    registry.append_specs(
+        specs
+            .into_iter()
+            .filter(|spec| matches!(spec.event, HookEventName::SessionEnd | HookEventName::Stop))
+            .collect(),
+    );
+    for event in [HookEventName::SessionEnd, HookEventName::Stop] {
+        registry.append_specs(vec![HookSpec {
+            name: format!("owned-exit/global-{event}"),
+            event,
+            handler_type: HandlerType::Command,
+            configured_matcher: None,
+            matcher: None,
+            enabled: true,
+            command: Some("/usr/bin/true".into()),
+            command_raw: Some("/usr/bin/true".into()),
+            url: None,
+            url_raw: None,
+            timeout_ms: 5000,
+            source_dir: fixture.binding().cwd.clone(),
+            extra_env: Default::default(),
+            layer: HookProvenance::File,
+        }]);
+    }
+    *actor.hook_registry.borrow_mut() = Some(Arc::new(registry));
+    (Arc::new(actor), events, updates)
+}
+
+fn start(
+    actor: Arc<SessionActor>,
+    events: mpsc::UnboundedReceiver<SessionEvent>,
+) -> (
+    mpsc::UnboundedSender<SessionCommand>,
+    mpsc::UnboundedSender<xai_chat_state::ChatStateEvent>,
+    tokio::task::JoinHandle<()>,
+) {
+    let (tx, rx) = mpsc::unbounded_channel();
+    let (chat_tx, chat_rx) = mpsc::unbounded_channel();
+    let cwd = PathBuf::from(&actor.session_info.cwd);
+    let task = tokio::task::spawn_local(super::run_session(
+        actor,
+        rx,
+        chat_rx,
+        events,
+        None,
+        Arc::new(parking_lot::Mutex::new(
+            xai_grok_workspace::file_system::CodebaseIndexManager::new(),
+        )),
+        cwd,
+        crate::session::fs_watch::FsWatchCapabilities::none(),
+    ));
+    (tx, chat_tx, task)
+}
+
+async fn request(
+    tx: &mpsc::UnboundedSender<SessionCommand>,
+    guard: &OwnedExitGuard,
+) -> acp::Result<bool> {
+    let (reply, rx) = oneshot::channel();
+    tx.send(SessionCommand::PrepareOwnedExit {
+        token: guard.token(),
+        respond_to: reply,
+    })
+    .unwrap();
+    tokio::time::timeout(std::time::Duration::from_secs(5), rx)
+        .await
+        .unwrap()
+        .unwrap()
+}
