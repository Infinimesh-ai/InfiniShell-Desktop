+#[test]
+#[ignore = "仅由精确控制台测试派生"]
+fn console_broker_fixture() {
+    if std::env::var(FIXTURE_ENV).as_deref() != Ok("1") {
+        return;
+    }
+    // 无窗口不等于未附着；必须从真实内核状态证明 broker 尚无控制台。
+    let mut members = [0u32; 1];
+    let count = unsafe { GetConsoleProcessList(&mut members) };
+    let error = unsafe { GetLastError() };
+    assert_eq!(count, 0, "broker 启动时已附着到控制台");
+    assert_eq!(error, ERROR_INVALID_HANDLE, "无法确认 broker 未附着状态");
+    // AttachConsole/FreeConsole 可改变标准句柄；诊断必须保留原父测试管道。
+    let mut diagnostic = duplicate_standard_handle(STD_ERROR_HANDLE).unwrap();
+    let code = match run_broker() {
+        Ok(code) => code,
+        Err(error) => {
+            writeln!(diagnostic, "notification broker failed: {error:?}").unwrap();
+            1
+        }
+    };
+    std::process::exit(code);
+}
