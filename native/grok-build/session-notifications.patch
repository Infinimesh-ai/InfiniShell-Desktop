+use super::*;
+
+use std::fs;
+use std::mem::size_of_val;
+use std::time::Duration;
+
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+pub(crate) fn enable_credentials(stream: &UnixStream) {
+    let enabled: libc::c_int = 1;
+    assert_eq!(
+        unsafe {
+            libc::setsockopt(
+                stream.as_raw_fd(),
+                libc::SOL_SOCKET,
+                libc::SO_PASSCRED,
+                (&enabled as *const libc::c_int).cast(),
+                size_of::<libc::c_int>() as libc::socklen_t,
+            )
+        },
+        0
+    );
+}
+
+pub(crate) async fn receive_identity(stream: &UnixStream) -> OwnedFd {
+    let (descriptor, credentials) = tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            stream.readable().await.unwrap();
+            match stream.try_io(Interest::READABLE, || receive_identity_once(stream)) {
+                Ok(value) => return value,
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => continue,
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+                Err(error) => panic!("身份前导接收失败：{error}"),
+            }
+        }
+    })
+    .await
+    .unwrap();
+    assert_eq!(credentials.pid, unsafe { libc::getpid() });
+    assert_eq!(credentials.uid, unsafe { libc::geteuid() });
+    assert_eq!(credentials.gid, unsafe { libc::getegid() });
+    let info = fs::read_to_string(format!("/proc/self/fdinfo/{}", descriptor.as_raw_fd())).unwrap();
+    assert!(
+        info.lines()
+            .any(|line| line == format!("Pid:\t{}", credentials.pid))
+    );
+    assert_eq!(
+        unsafe { libc::fcntl(descriptor.as_raw_fd(), libc::F_GETFD) } & libc::FD_CLOEXEC,
+        libc::FD_CLOEXEC
+    );
+    assert_eq!(
+        unsafe {
+            libc::syscall(
+                libc::SYS_pidfd_send_signal,
+                descriptor.as_raw_fd(),
+                0,
+                ptr::null::<libc::siginfo_t>(),
+                0,
+            )
+        },
+        0
+    );
+    descriptor
+}
+
+fn receive_identity_once(stream: &UnixStream) -> io::Result<(OwnedFd, libc::ucred)> {
+    let mut marker = [0u8; 1];
+    let mut control = [0usize; 16];
+    let mut vector = libc::iovec {
+        iov_base: marker.as_mut_ptr().cast(),
+        iov_len: marker.len(),
+    };
+    let mut message: libc::msghdr = unsafe { zeroed() };
+    message.msg_iov = &mut vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.as_mut_ptr().cast();
+    message.msg_controllen = size_of_val(&control);
+    let received = unsafe {
+        libc::recvmsg(
+            stream.as_raw_fd(),
+            &mut message,
+            libc::MSG_CMSG_CLOEXEC | libc::MSG_DONTWAIT,
+        )
+    };
+    if received < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut descriptors = Vec::new();
+    let mut credentials = Vec::new();
+    let mut unknown = false;
+    unsafe {
+        let mut header = libc::CMSG_FIRSTHDR(&message);
+        while !header.is_null() {
+            let body = (*header).cmsg_len - libc::CMSG_LEN(0) as usize;
+            match ((*header).cmsg_level, (*header).cmsg_type) {
+                (libc::SOL_SOCKET, libc::SCM_RIGHTS) => {
+                    assert_eq!(body % size_of::<RawFd>(), 0);
+                    for index in 0..body / size_of::<RawFd>() {
+                        descriptors.push(OwnedFd::from_raw_fd(ptr::read_unaligned(
+                            libc::CMSG_DATA(header).cast::<RawFd>().add(index),
+                        )));
+                    }
+                }
+                (libc::SOL_SOCKET, libc::SCM_CREDENTIALS) => {
+                    assert_eq!(body, size_of::<libc::ucred>());
+                    credentials.push(ptr::read_unaligned(
+                        libc::CMSG_DATA(header).cast::<libc::ucred>(),
+                    ));
+                }
+                _ => unknown = true,
+            }
+            header = libc::CMSG_NXTHDR(&message, header);
+        }
+    }
+    assert_eq!(received, 1);
+    assert_eq!(marker, [0x01]);
+    assert_eq!(message.msg_flags & (libc::MSG_CTRUNC | libc::MSG_TRUNC), 0);
+    assert!(!unknown);
+    assert_eq!(descriptors.len(), 1);
+    assert_eq!(credentials.len(), 1);
+    Ok((descriptors.pop().unwrap(), credentials.pop().unwrap()))
+}
+
+#[tokio::test]
+async fn terminal_bridge_linux_identity_retains_one_self_pidfd_after_socket_close() {
+    let (client, server) = UnixStream::pair().unwrap();
+    enable_credentials(&client);
+    send_identity(&server).await.unwrap();
+    let descriptor = receive_identity(&client).await;
+    drop(server);
+    drop(client);
+    let mut poll = libc::pollfd {
+        fd: descriptor.as_raw_fd(),
+        events: libc::POLLIN,
+        revents: 0,
+    };
+    assert_eq!(unsafe { libc::poll(&mut poll, 1, 0) }, 0);
+}
+
+#[tokio::test]
+async fn terminal_bridge_linux_identity_preserves_the_following_response_frame() {
+    let (mut client, mut server) = UnixStream::pair().unwrap();
+    enable_credentials(&client);
+    send_identity(&server).await.unwrap();
+    let body = b"{\"status\":\"not_ready\"}";
+    server.write_u32(body.len() as u32).await.unwrap();
+    server.write_all(body).await.unwrap();
+    drop(server);
+    let _descriptor = receive_identity(&client).await;
+    assert_eq!(client.read_u32().await.unwrap() as usize, body.len());
+    let mut received = Vec::new();
+    client.read_to_end(&mut received).await.unwrap();
+    assert_eq!(received, body);
+}
+
+#[tokio::test]
+async fn terminal_bridge_linux_identity_rejects_closed_peer_without_sigpipe() {
+    let (client, server) = UnixStream::pair().unwrap();
+    drop(client);
+    let error = tokio::time::timeout(Duration::from_secs(5), send_identity(&server))
+        .await
+        .unwrap()
+        .unwrap_err();
+    assert!(matches!(
+        error.kind(),
+        io::ErrorKind::BrokenPipe | io::ErrorKind::ConnectionReset
+    ));
+}
+
+#[tokio::test(start_paused = true)]
+async fn terminal_bridge_linux_identity_backpressure_respects_the_outer_deadline() {
+    let (_client, server) = UnixStream::pair().unwrap();
+    server.writable().await.unwrap();
+    // 填满单字节写入也无法通过的真实 socket 缓冲区，不伪造 EAGAIN。
+    let mut written = 0usize;
+    loop {
+        match server.try_write(&[0x55]) {
+            Ok(1) => {
+                written += 1;
+                assert!(written < 1024 * 1024);
+            }
+            Ok(count) => panic!("缓冲区填充返回非单字节长度：{count}"),
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => break,
+            Err(error) => panic!("缓冲区填充失败：{error}"),
+        }
+    }
+    assert!(written > 0);
+    assert!(
+        tokio::time::timeout(Duration::from_millis(20), send_identity(&server))
+            .await
+            .is_err()
+    );
+}
