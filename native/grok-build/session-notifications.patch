+async fn test_broker(peer: &ConsolePeer) -> PreparedConsoleHook {
+    let mut hook =
+        fixture_command("runner::notification_console_windows::tests::console_hook_fixture");
+    hook.env(
+        "GROK_NOTIFICATION_TEST_EXPECTED_PEER",
+        peer.identity.pid.to_string(),
+    )
+    .current_dir(std::env::temp_dir());
+    let mut broker =
+        fixture_command("runner::notification_console_windows::tests::console_broker_fixture");
+    broker.creation_flags(DETACHED_PROCESS.0);
+    prepare_child(
+        broker.spawn().unwrap(),
+        CommandPlan::capture(&hook).unwrap(),
+        peer,
+    )
+    .await
+    .unwrap()
+}
+
+fn group(child: &tokio::process::Child, scope: &ProcessScope) -> Arc<ProcessGroup> {
+    let mut group = ProcessGroup::new().unwrap();
+    group.attach(child).unwrap();
+    let group = Arc::new(group);
+    assert!(scope.register(&group));
+    group
+}
+
+#[tokio::test]
+async fn console_broker_binds_real_console_and_cancellation_preserves_both_peers() {
+    let mut target_command =
+        fixture_command("runner::notification_console_windows::tests::console_target_fixture");
+    target_command.creation_flags(CREATE_NEW_CONSOLE.0);
+    let mut target = target_command.spawn().unwrap();
+    let mut other = target_command.spawn().unwrap();
+    wait_for_console_ready(&mut target).await;
+    wait_for_console_ready(&mut other).await;
+    let peer = retained_child_peer(&target);
+    let other_peer = retained_child_peer(&other);
+
+    let mut prepared = test_broker(&peer).await;
+    let scope = ProcessScope::new();
+    let job = group(&prepared.child, &scope);
+    let mut input = prepared.child.stdin.take().unwrap();
+    input.write_all(&prepared.startup_frame).await.unwrap();
+    input.write_all(b"exact-hook-envelope").await.unwrap();
+    drop(input);
+    let result = tokio::time::timeout(Duration::from_secs(15), prepared.child.wait_with_output())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        result.status.success(),
+        "broker status: {}; stderr: {}; stdout: {}",
+        result.status,
+        String::from_utf8_lossy(&result.stderr),
+        String::from_utf8_lossy(&result.stdout)
+    );
+    assert!(String::from_utf8_lossy(&result.stdout).contains("console-bound-envelope-ok"));
+    drop(job);
+    peer.verify().unwrap();
+    other_peer.verify().unwrap();
+
+    // 另一个真实控制台的身份不能配上第一实例的稳定 HANDLE。
+    let mut prepared = test_broker(&peer).await;
+    let mut frame = read_frame(&mut prepared.startup_frame.as_slice()).unwrap();
+    frame.peer = other_peer.identity.clone();
+    let scope = ProcessScope::new();
+    let job = group(&prepared.child, &scope);
+    let mut input = prepared.child.stdin.take().unwrap();
+    input
+        .write_all(&encode_frame(&frame).unwrap())
+        .await
+        .unwrap();
+    drop(input);
+    let result = tokio::time::timeout(Duration::from_secs(15), prepared.child.wait_with_output())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(!result.status.success());
+    assert!(!String::from_utf8_lossy(&result.stdout).contains("console-bound-envelope-ok"));
+    drop(job);
+
+    // 首帧尚未放行时断开路由，Job 只结束 broker，不得结束两边的普通 CLI。
+    let prepared = test_broker(&peer).await;
+    let scope = ProcessScope::new();
+    let job = group(&prepared.child, &scope);
+    scope.kill_all();
+    let result = tokio::time::timeout(Duration::from_secs(15), prepared.child.wait_with_output())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(!result.status.success());
+    assert!(!String::from_utf8_lossy(&result.stdout).contains("console-bound-envelope-ok"));
+    drop(job);
+    peer.verify().unwrap();
+    other_peer.verify().unwrap();
+    assert!(target.try_wait().unwrap().is_none());
+    assert!(other.try_wait().unwrap().is_none());
+    drop(target.stdin.take());
+    drop(other.stdin.take());
+    assert!(
+        tokio::time::timeout(Duration::from_secs(15), target.wait())
+            .await
+            .unwrap()
+            .unwrap()
+            .success()
+    );
+    assert!(
+        tokio::time::timeout(Duration::from_secs(15), other.wait())
+            .await
+            .unwrap()
+            .unwrap()
+            .success()
+    );
+    assert!(peer.verify().is_err());
+    assert!(other_peer.verify().is_err());
+}
