+/// 仅单个诊断用例启用；只输出固定阶段、次数和耗时，不输出 hook 正文或错误内容。
+pub(crate) struct PermissionPromptTrace {
+    started: std::time::Instant,
+    counts: std::sync::Mutex<std::collections::BTreeMap<&'static str, usize>>,
+}
+
+impl PermissionPromptTrace {
+    pub(crate) fn new() -> Self {
+        Self {
+            started: std::time::Instant::now(),
+            counts: std::sync::Mutex::new(std::collections::BTreeMap::new()),
+        }
+    }
+
+    pub(crate) fn record(&self, stage: &'static str, detail: serde_json::Value) {
+        let count = {
+            let mut counts = self.counts.lock().unwrap();
+            let count = counts.entry(stage).or_default();
+            *count += 1;
+            *count
+        };
+        let row = serde_json::json!({
+            "stage": stage,
+            "count": count,
+            "elapsed_ms": self.started.elapsed().as_millis(),
+            "detail": detail,
+        });
+        eprintln!("permission_prompt_test {row}");
+    }
+
+    fn hook_update(&self, update: &serde_json::Value) {
+        if update["event_name"] != "pre_tool_use" {
+            return;
+        }
+        match update["sessionUpdate"].as_str() {
+            Some("hook_run_started") => self.record(
+                "hook_run_started",
+                serde_json::json!({"hook_count": update["count"].as_u64()}),
+            ),
+            Some("hook_execution") => {
+                for run in update["runs"].as_array().into_iter().flatten() {
+                    if run["name"] != "test/ask" {
+                        continue;
+                    }
+                    let status = match run["status"]["status"].as_str() {
+                        Some("success") => "success",
+                        Some("failed") => "failed",
+                        Some("skipped") => "skipped",
+                        _ => "unrecognized",
+                    };
