+use super::*;
+use crate::session::{OwnedSessionIdentity, OwnedSessionInfo};
+use acp::Agent as _;
+
+async fn query(agent: &MvpAgent, params: serde_json::Value) -> acp::Result<acp::ExtResponse> {
+    agent
+        .ext_method(acp::ExtRequest::new(
+            "x.ai/session/info",
+            std::sync::Arc::from(serde_json::value::to_raw_value(&params).unwrap()),
+        ))
+        .await
+}
