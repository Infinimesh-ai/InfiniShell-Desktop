+use super::*;
+
+use std::process::Stdio;
+use std::time::Duration;
+
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::windows::named_pipe::{ClientOptions, ServerOptions};
+use windows::Win32::System::Threading::CREATE_NO_WINDOW;
+
+#[tokio::test]
+async fn notification_pipe_binds_real_sender_until_its_exit() {
+    let name = format!(
+        r"\\.\pipe\grok-notification-peer-test-{}",
+        uuid::Uuid::new_v4()
+    );
+    let mut server = ServerOptions::new()
+        .first_pipe_instance(true)
+        .create(&name)
+        .unwrap();
+    let mut child = tokio::process::Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "session::notification_route_windows::tests::notification_pipe_child_fixture",
+            "--ignored",
+            "--nocapture",
+        ])
+        .env("GROK_NOTIFICATION_TEST_PIPE", &name)
+        .creation_flags(CREATE_NO_WINDOW.0)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .kill_on_drop(true)
+        .spawn()
+        .unwrap();
+    let peer = tokio::time::timeout(Duration::from_secs(10), async {
+        server.connect().await.unwrap();
+        assert_eq!(server.read_u8().await.unwrap(), 1);
+        VerifiedPeer::capture(&server).unwrap()
+    })
+    .await
+    .unwrap();
+    peer.verify().unwrap();
+    let retained = peer.console_peer();
+    drop(server);
+    drop(peer);
+    // 关闭注册连接和 leader 的一个引用不会结束普通 CLI。
+    retained.verify().unwrap();
+    assert!(child.try_wait().unwrap().is_none());
+    drop(child.stdin.take());
+    assert!(
+        tokio::time::timeout(Duration::from_secs(10), child.wait())
+            .await
+            .unwrap()
+            .unwrap()
+            .success()
+    );
+    assert!(retained.verify().is_err());
+}
+
+#[test]
+#[ignore = "仅由精确 Windows 管道身份测试派生"]
+fn notification_pipe_child_fixture() {
+    let Ok(name) = std::env::var("GROK_NOTIFICATION_TEST_PIPE") else {
+        return;
+    };
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap();
+    runtime.block_on(async {
+        let mut pipe = ClientOptions::new().open(name).unwrap();
+        pipe.write_all(&[1]).await.unwrap();
+        pipe.flush().await.unwrap();
+        // 持续保留管道和进程直到父测试关闭它独占的 stdin。
+        let mut input = tokio::io::stdin();
+        let mut byte = [0u8; 1];
+        assert_eq!(input.read(&mut byte).await.unwrap(), 0);
+        drop(pipe);
+    });
+}
