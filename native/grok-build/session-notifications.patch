+//! 普通 Windows TUI 的私有 named pipe；事务仍由同一个事件循环串行处理。
+
+use std::fs::File;
+use std::io::{self, Read, Write};
+use std::os::windows::io::AsRawHandle;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::Duration;
+
+use serde::{Deserialize, Serialize};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::windows::named_pipe::{NamedPipeServer, ServerOptions};
+use tokio::sync::{Semaphore, mpsc, oneshot};
+use tokio::task::{JoinHandle, JoinSet};
+use uuid::Uuid;
+
+use super::terminal_bridge::{Request, Response};
+use super::terminal_bridge_windows::{Directory, FileIdentity, UserIdentity, identity, invalid};
+
+pub(crate) const BRIDGE_DIR_ENV: &str = "GROK_TERMINAL_BRIDGE_DIR";
+const MAX_FRAME_BYTES: usize = 256 * 1024;
+const MAX_CONNECTIONS: usize = 8;
+const READ_TIMEOUT: Duration = Duration::from_secs(5);
+const REPLY_TIMEOUT: Duration = Duration::from_secs(30);
+
+pub(crate) struct BridgeRequest {
+    pub(crate) request: Request,
+    pub(crate) reply: oneshot::Sender<Response>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {
+    token: String,
+    request: Request,
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Manifest {
+    protocol_version: u32,
+    native_pid: u32,
+    instance_id: String,
+    socket: PathBuf,
+    token: String,
+}
+
+struct Endpoint {
+    owner: UserIdentity,
+    root: Directory,
+    directory: Directory,
+    manifest: Option<File>,
+    manifest_identity: FileIdentity,
+    manifest_bytes: Vec<u8>,
+    pipe: PathBuf,
+}
+
+impl Endpoint {
+    fn validate(&self) -> io::Result<()> {
+        self.root.validate()?;
+        self.directory.validate()?;
+        let file = self.manifest.as_ref().ok_or_else(invalid)?;
+        if self.directory.validate_file(file)? != self.manifest_identity {
+            return Err(invalid());
+        }
+        let reopened = self.directory.read_file("manifest.json")?;
+        if identity(&reopened, false)? != self.manifest_identity
+            || reopened.metadata()?.len() != self.manifest_bytes.len() as u64
+        {
+            return Err(invalid());
+        }
+        let mut bytes = Vec::new();
+        reopened
+            .take(self.manifest_bytes.len() as u64 + 1)
+            .read_to_end(&mut bytes)?;
+        if bytes != self.manifest_bytes {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+
+    fn listener(&self, first: bool) -> io::Result<NamedPipeServer> {
+        self.validate()?;
+        let security = self.owner.security(false)?;
+        let mut attributes = security.attributes();
+        // 新 listener 在旧连接释放之前建立，名称不会出现无服务器的可抢占窗口。
+        unsafe {
+            ServerOptions::new()
+                .first_pipe_instance(first)
+                .reject_remote_clients(true)
+                // 新旧 listener 短暂并存；超过八条连接仍立即拒绝，不关闭整个入口。
+                .max_instances(MAX_CONNECTIONS + 2)
+                .create_with_security_attributes_raw(
+                    &self.pipe,
+                    std::ptr::addr_of_mut!(attributes).cast(),
+                )
+        }
+    }
+}
+
+impl Drop for Endpoint {
+    fn drop(&mut self) {
+        // 先核身份，再通过同一文件句柄删除；占用、替换或 ACL 变化时保守保留。
+        // receipts.jsonl 与实例目录始终保留，不把退出解释为可以丢弃未知投递。
+        if self.validate().is_err() {
+            return;
+        }
+        drop(self.manifest.take());
+        let _ = self.directory.remove_manifest(self.manifest_identity);
+    }
+}
+
+pub(crate) struct BridgeIo {
+    pub(crate) instance_id: String,
+    pub(crate) instance_dir: PathBuf,
+    pub(crate) requests: mpsc::Receiver<BridgeRequest>,
+    listener_task: JoinHandle<()>,
+}
+
+impl BridgeIo {
+    pub(crate) fn start_from_env() -> io::Result<Option<Self>> {
+        let Some(root) = std::env::var_os(BRIDGE_DIR_ENV) else {
+            return Ok(None);
+        };
+        Self::start(Path::new(&root)).map(Some)
+    }
+
+    fn start(root: &Path) -> io::Result<Self> {
+        let owner = UserIdentity::current()?;
+        let root = Directory::open(root, &owner)?;
+        let instance = Uuid::new_v4();
+        let instance_id = instance.to_string();
+        let directory = root.create_child(&format!("t-{}", instance.simple()))?;
+        let instance_dir = directory.path().to_owned();
+        let pipe = PathBuf::from(format!(
+            r"\\.\pipe\infinishell-grok-terminal-bridge-v1-{}",
+            instance.simple()
+        ));
+        let token = format!("{}{}", Uuid::new_v4().simple(), Uuid::new_v4().simple());
+        let manifest = Manifest {
+            protocol_version: 1,
+            native_pid: std::process::id(),
+            instance_id: instance_id.clone(),
+            socket: pipe.clone(),
+            token: token.clone(),
+        };
+        let manifest_bytes = serde_json::to_vec(&manifest)?;
+        let mut output = directory.create_file("manifest.json")?;
+        let manifest_identity = identity(&output, false)?;
+        output.write_all(&manifest_bytes)?;
+        output.sync_all()?;
+        drop(output);
+        // 发布后只持有读句柄，允许宿主只读发现，但阻止并发写入、改名或替换。
+        let file = directory.read_file("manifest.json")?;
+        if identity(&file, false)? != manifest_identity {
+            return Err(invalid());
+        }
+        let endpoint = Arc::new(Endpoint {
+            owner,
+            root,
+            directory,
+            manifest: Some(file),
+            manifest_identity,
+            manifest_bytes,
+            pipe,
+        });
+        let listener = endpoint.listener(true)?;
+        let (sender, requests) = mpsc::channel(MAX_CONNECTIONS);
+        let listener_task = tokio::spawn(serve(listener, endpoint, token, sender));
+        Ok(Self {
+            instance_id,
+            instance_dir,
+            requests,
+            listener_task,
+        })
+    }
+}
+
+impl Drop for BridgeIo {
+    fn drop(&mut self) {
+        self.listener_task.abort();
+    }
+}
+
+async fn serve(
+    mut listener: NamedPipeServer,
+    endpoint: Arc<Endpoint>,
+    token: String,
+    sender: mpsc::Sender<BridgeRequest>,
+) {
+    let permits = Arc::new(Semaphore::new(MAX_CONNECTIONS));
+    let mut connections = JoinSet::new();
+    loop {
+        tokio::select! {
+            result = listener.connect() => {
+                if result.is_err() { break; }
+                let next = match endpoint.listener(false) { Ok(next) => next, Err(_) => break };
+                let stream = std::mem::replace(&mut listener, next);
+                let Ok(permit) = permits.clone().try_acquire_owned() else { continue; };
+                let endpoint = endpoint.clone();
+                let token = token.clone();
+                let sender = sender.clone();
+                connections.spawn(async move {
+                    let _permit = permit;
+                    // 错误不输出 token、正文或认证材料。
+                    let _ = exchange(stream, endpoint, token, sender).await;
+                });
+            }
+            _ = connections.join_next(), if !connections.is_empty() => {}
+        }
+    }
+}
+
+async fn exchange(
+    mut stream: NamedPipeServer,
+    endpoint: Arc<Endpoint>,
+    token: String,
+    sender: mpsc::Sender<BridgeRequest>,
+) -> io::Result<()> {
+    endpoint.validate()?;
+    let envelope = tokio::time::timeout(READ_TIMEOUT, read_envelope(&mut stream))
+        .await
+        .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "bridge frame timed out"))??;
+    endpoint.owner.verify_pipe_client(stream.as_raw_handle())?;
+    if !token_matches(&token, &envelope.token) {
+        return Err(invalid());
+    }
+    endpoint.validate()?;
+    let (reply, response) = oneshot::channel();
+    sender
+        .try_send(BridgeRequest {
+            request: envelope.request,
+            reply,
+        })
+        .map_err(|_| invalid())?;
+    // 断连或超时都不能让宿主生成第二个消息 ID；原事务只能查询。
+    let response = tokio::time::timeout(REPLY_TIMEOUT, response)
+        .await
+        .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "bridge reply timed out"))?
+        .map_err(|_| invalid())?;
+    endpoint.validate()?;
+    let bytes = serde_json::to_vec(&response)?;
+    if bytes.is_empty() || bytes.len() > MAX_FRAME_BYTES {
+        return Err(invalid());
+    }
+    write_response(&mut stream, &bytes, READ_TIMEOUT).await
+}
+
+async fn write_response(
+    stream: &mut NamedPipeServer,
+    bytes: &[u8],
+    timeout: Duration,
+) -> io::Result<()> {
+    tokio::time::timeout(timeout, async {
+        stream.write_u32(bytes.len() as u32).await?;
+        stream.write_all(bytes).await?;
+        // Windows 关闭服务端管道会丢弃未读响应。等待宿主读完整帧后的单字节确认，
+        // 仍受同一期限约束；此确认只管传输收尾，不能作为事务或原生提示词的 ACK。
+        if stream.read_u8().await? != 1 {
+            return Err(invalid());
+        }
+        Ok(())
+    })
+    .await
+    .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "bridge response timed out"))?
+}
+
+async fn read_envelope(stream: &mut NamedPipeServer) -> io::Result<Envelope> {
+    let length = stream.read_u32().await? as usize;
+    if length == 0 || length > MAX_FRAME_BYTES {
+        return Err(invalid());
+    }
+    let mut bytes = vec![0; length];
+    stream.read_exact(&mut bytes).await?;
+    serde_json::from_slice(&bytes).map_err(|_| invalid())
+}
+
+fn token_matches(expected: &str, actual: &str) -> bool {
+    expected.len() == actual.len()
+        && expected
+            .bytes()
+            .zip(actual.bytes())
+            .fold(0, |difference, (left, right)| difference | (left ^ right))
+            == 0
+}
+
