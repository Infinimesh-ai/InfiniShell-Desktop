+#[test]
+fn notification_resource_reads_owned_file_and_rejects_a_hard_link() {
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("resource.json");
+    std::fs::write(&path, b"synthetic-resource").unwrap();
+    open_read(&path, false).unwrap();
+    open_read(directory.path(), true).unwrap();
+    std::fs::hard_link(&path, directory.path().join("other-name.json")).unwrap();
+    assert!(open_read(&path, false).is_err());
+}
+
+#[test]
+fn notification_resource_rejects_real_world_writable_acl() {
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("resource.json");
+    std::fs::write(&path, b"synthetic-resource").unwrap();
+    open_read(&path, false).unwrap();
+    let file = OpenOptions::new()
+        .access_mode(FILE_GENERIC_READ.0 | WRITE_DAC.0)
+        .open(&path)
+        .unwrap();
+    let mut descriptor = PSECURITY_DESCRIPTOR::default();
+    unsafe {
+        ConvertStringSecurityDescriptorToSecurityDescriptorW(
+            w!("D:(A;;FA;;;WD)"),
+            SDDL_REVISION_1,
+            &mut descriptor,
+            None,
+        )
+        .unwrap();
+    }
+    let _descriptor = Descriptor(descriptor);
+    let mut present = BOOL::default();
+    let mut defaulted = BOOL::default();
+    let mut acl = std::ptr::null_mut();
+    unsafe {
+        GetSecurityDescriptorDacl(descriptor, &mut present, &mut acl, &mut defaulted).unwrap();
+        assert!(present.as_bool() && !acl.is_null());
+        SetSecurityInfo(
+            HANDLE(file.as_raw_handle()),
+            SE_FILE_OBJECT,
+            DACL_SECURITY_INFORMATION,
+            None,
+            None,
+            Some(acl),
+            None,
+        )
+        .ok()
+        .unwrap();
+    }
+    assert!(verify_file(&file, false).is_err());
+    drop(file);
+    assert!(open_read(&path, false).is_err());
+}
+
+#[test]
+fn notification_directory_accepts_real_inherit_only_creator_owner_acl() {
+    let directory = tempfile::tempdir().unwrap();
+    let resource = directory.path().join("resource.json");
+    std::fs::write(&resource, b"synthetic-resource").unwrap();
+    let file = OpenOptions::new()
+        .access_mode(FILE_GENERIC_READ.0 | WRITE_DAC.0)
+        .custom_flags(FILE_FLAG_BACKUP_SEMANTICS.0)
+        .open(directory.path())
+        .unwrap();
+    let mut original_acl = std::ptr::null_mut();
+    let mut original_descriptor = PSECURITY_DESCRIPTOR::default();
+    unsafe {
+        GetSecurityInfo(
+            HANDLE(file.as_raw_handle()),
+            SE_FILE_OBJECT,
+            DACL_SECURITY_INFORMATION,
+            None,
+            None,
+            Some(&mut original_acl),
+            None,
+            Some(&mut original_descriptor),
+        )
+        .ok()
+        .unwrap();
+    }
+    let _original_descriptor = Descriptor(original_descriptor);
+    let mut descriptor = PSECURITY_DESCRIPTOR::default();
+    unsafe {
+        ConvertStringSecurityDescriptorToSecurityDescriptorW(
+            w!("D:(A;;FA;;;SY)(A;;FA;;;BA)(A;;FR;;;WD)(A;OICIIO;FA;;;CO)"),
+            SDDL_REVISION_1,
+            &mut descriptor,
+            None,
+        )
+        .unwrap();
+    }
+    let _descriptor = Descriptor(descriptor);
+    let mut present = BOOL::default();
+    let mut defaulted = BOOL::default();
+    let mut acl = std::ptr::null_mut();
+    unsafe {
+        GetSecurityDescriptorDacl(descriptor, &mut present, &mut acl, &mut defaulted).unwrap();
+        assert!(present.as_bool() && !acl.is_null());
+        SetSecurityInfo(
+            HANDLE(file.as_raw_handle()),
+            SE_FILE_OBJECT,
+            DACL_SECURITY_INFORMATION,
+            None,
+            None,
+            Some(acl),
+            None,
+        )
+        .ok()
+        .unwrap();
+    }
+    // 实际目录必须接受只继承的 CREATOR OWNER；子资源仍验证自己的有效 ACL。
+    let directory_result = verify_file(&file, true);
+    let resource_result = open_read(&resource, false);
+    // 先恢复此测试独占目录的原始 ACL，断言失败也不留下改变权限的临时目录。
+    unsafe {
+        SetSecurityInfo(
+            HANDLE(file.as_raw_handle()),
+            SE_FILE_OBJECT,
+            DACL_SECURITY_INFORMATION,
+            None,
+            None,
+            Some(original_acl),
+            None,
+        )
+        .ok()
+        .unwrap();
+    }
+    directory_result.unwrap();
+    resource_result.unwrap();
+}
