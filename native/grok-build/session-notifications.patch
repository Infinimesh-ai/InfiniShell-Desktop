+#[test]
+fn retained_peer_rejects_creation_logon_sid_and_session_changes() {
+    let peer = self_peer();
+    peer.verify().unwrap();
+    for change in 0..5 {
+        let mut forged = peer.clone();
+        match change {
+            0 => forged.identity.created_at ^= 1,
+            1 => forged.identity.user.logon_low ^= 1,
+            2 => forged.identity.user.logon_high ^= 1,
+            3 => forged.identity.user.sid.push(0),
+            4 => forged.identity.user.session ^= 1,
+            _ => unreachable!(),
+        }
+        assert!(forged.verify().is_err());
+    }
+    peer.verify().unwrap();
+}
