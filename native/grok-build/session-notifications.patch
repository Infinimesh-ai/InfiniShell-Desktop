+#[test]
+fn stale_generation_cannot_activate_or_replace_current_route() {
+    let mut state = SessionRoute::default();
+    reserve_verified(&mut state, route(1, "first")).unwrap();
+    assert!(
+        activate_verified(
+            &mut state,
+            "stale",
+            |_| panic!("不应验证旧代际"),
+            || panic!("旧代际不得入队")
+        )
+        .is_err()
+    );
+    assert!(state.active.is_none());
+    assert_eq!(state.pending.as_ref().unwrap().generation, "first");
