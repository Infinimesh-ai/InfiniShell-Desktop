+//! handler 必须等待原 actor 线程退出，之后才关闭工具 scope；busy 不触发 Shutdown。
+use super::*;
+use crate::session::notification_route::owned_identity_fixture::Fixture;
+use futures::poll;
+use std::task::Poll;
+
+async fn close_owned(
+    agent: &MvpAgent,
+    request: &crate::session::notification_route::OwnedExitRequest,
+) -> acp::Result<String> {
+    use acp::Agent as _;
+    let response = agent
+        .ext_method(acp::ExtRequest::new(
+            crate::session::notification_route::OWNED_EXIT_METHOD,
+            serde_json::value::to_raw_value(request).unwrap().into(),
+        ))
+        .await?;
+    let reply: serde_json::Value = serde_json::from_str(response.0.get()).unwrap();
+    assert_eq!(reply["result"]["sessionId"], request.session_id);
+    assert_eq!(reply["result"]["protocolVersion"], 1);
+    Ok(reply["result"]["outcome"].as_str().unwrap().to_owned())
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn owned_exit_handler_waits_for_original_thread_before_closing_scope() {
+    let fixture = Fixture::new().await;
+    let request = fixture.reserve_exit();
+    let sid = acp::SessionId::new(request.session_id.clone());
+    let agent = build_minimal_agent_for_tests();
+    let (mut handle, _, mut rx) = make_live_session_handle(&sid, None);
+    let scope = xai_grok_tools::util::ProcessScope::new();
+    handle.tool_context.process_scope = Some(scope.clone());
+    agent.insert_resident(&sid, handle);
+    let (release, wait) = std::sync::mpsc::channel::<()>();
+    agent.session_registry.set_thread(
+        &sid,
+        crate::session::SessionThread::from_handle(std::thread::spawn(move || {
+            let _ = wait.recv_timeout(std::time::Duration::from_secs(5));
+        })),
+    );
+    let mut close = std::pin::pin!(close_owned(&agent, &request));
+    assert!(matches!(poll!(&mut close), Poll::Pending));
+    let Some(TestSessionCommand::PrepareOwnedExit { respond_to, .. }) = rx.recv().await else {
+        panic!("只应派发 idle 原子接收，不应取消正在运行的回合");
+    };
+    rx.close();
+    respond_to.send(Ok(true)).unwrap();
+    assert!(matches!(poll!(&mut close), Poll::Pending));
+    agent.sweep_dead_sessions();
+    assert!(!scope.is_closed());
+    assert!(agent.is_resident(&sid));
+    assert!(
+        crate::session::notification_route::provider(&sid.0)
+            .environment(fixture.binding().plugin_dir.to_str().unwrap())
+            .is_some()
+    );
+    release.send(()).unwrap();
+    assert_eq!(
+        tokio::time::timeout(std::time::Duration::from_secs(2), close)
+            .await
+            .unwrap()
+            .unwrap(),
+        "closed"
+    );
+    assert!(scope.is_closed());
+    assert!(!agent.is_resident(&sid));
+    agent.sweep_dead_sessions();
+    assert!(!agent.session_registry.has_thread(&sid));
+    fixture.close().await;
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn owned_exit_handler_busy_preserves_original_scope_and_residency() {
+    let fixture = Fixture::new().await;
+    let request = fixture.reserve_exit();
+    let sid = acp::SessionId::new(request.session_id.clone());
+    let agent = build_minimal_agent_for_tests();
+    let (mut handle, _, mut rx) = make_live_session_handle(&sid, Some("live-turn"));
+    let scope = xai_grok_tools::util::ProcessScope::new();
+    handle.tool_context.process_scope = Some(scope.clone());
+    agent.insert_resident(&sid, handle);
+    let mut close = std::pin::pin!(close_owned(&agent, &request));
+    assert!(matches!(poll!(&mut close), Poll::Pending));
+    let Some(TestSessionCommand::PrepareOwnedExit { respond_to, .. }) = rx.recv().await else {
+        panic!("缺少原子接收请求");
+    };
+    respond_to.send(Ok(false)).unwrap();
+    assert_eq!(close.await.unwrap(), "busy");
+    assert!(!scope.is_closed());
+    assert!(agent.is_resident(&sid));
+    assert!(rx.try_recv().is_err(), "busy 不应收到 Cancel 或 Shutdown");
+    assert!(
+        crate::session::notification_route::owned_binding(&sid.0, &fixture.binding().cwd).is_ok()
+    );
+    agent.take_session(&sid);
+    fixture.close().await;
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn owned_exit_old_handler_cannot_close_replacement_actor() {
+    let fixture = Fixture::new().await;
+    let request = fixture.reserve_exit();
+    let sid = acp::SessionId::new(request.session_id.clone());
+    let agent = build_minimal_agent_for_tests();
+    let (mut original, _, mut rx) = make_live_session_handle(&sid, None);
+    let original_scope = xai_grok_tools::util::ProcessScope::new();
+    original.tool_context.process_scope = Some(original_scope.clone());
+    agent.insert_resident(&sid, original);
+    let mut close = std::pin::pin!(close_owned(&agent, &request));
+    assert!(matches!(poll!(&mut close), Poll::Pending));
+    let Some(TestSessionCommand::PrepareOwnedExit { respond_to, .. }) = rx.recv().await else {
+        panic!("缺少退出请求");
+    };
+    rx.close();
+    respond_to.send(Ok(true)).unwrap();
+    let (mut replacement, _, replacement_rx) = make_live_session_handle(&sid, None);
+    let replacement_scope = xai_grok_tools::util::ProcessScope::new();
+    replacement.tool_context.process_scope = Some(replacement_scope.clone());
+    agent.insert_resident(&sid, replacement);
+    assert!(close.await.is_err());
+    assert!(original_scope.is_closed());
+    assert!(!replacement_scope.is_closed());
+    assert!(agent.is_resident(&sid));
+    assert!(!replacement_rx.is_closed());
+    agent.take_session(&sid);
+    fixture.close().await;
+}
