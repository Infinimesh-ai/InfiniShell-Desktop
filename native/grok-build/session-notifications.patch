+//! Linux 连接身份前导：传递自有 pidfd，不要求宿主通过数字 PID 重建身份。
+
+use std::io;
+use std::mem::{size_of, zeroed};
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd, RawFd};
+use std::ptr;
+
+use tokio::io::Interest;
+use tokio::net::UnixStream;
+
+pub(super) async fn send_identity(stream: &UnixStream) -> io::Result<()> {
+    // 当前线程组在此调用期间仍存活；只为本进程打开 pidfd，不采信外部 PID。
+    let credentials = libc::ucred {
+        pid: unsafe { libc::getpid() },
+        uid: unsafe { libc::geteuid() },
+        gid: unsafe { libc::getegid() },
+    };
+    let descriptor = unsafe { libc::syscall(libc::SYS_pidfd_open, credentials.pid, 0) };
+    if descriptor < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let descriptor = unsafe { OwnedFd::from_raw_fd(descriptor as RawFd) };
+    loop {
+        stream.writable().await?;
+        match stream.try_io(Interest::WRITABLE, || {
+            send_identity_once(stream, &descriptor, &credentials)
+        }) {
+            Ok(()) => return Ok(()),
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => continue,
+            // 仅发送一个字节；Linux 已发送时返回 1，EINTR 表示尚未发出前导。
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+            Err(error) => return Err(error),
+        }
+    }
+}
+
+fn send_identity_once(
+    stream: &UnixStream,
+    descriptor: &OwnedFd,
+    credentials: &libc::ucred,
+) -> io::Result<()> {
+    let control_length = unsafe {
+        libc::CMSG_SPACE(size_of::<RawFd>() as u32) as usize
+            + libc::CMSG_SPACE(size_of::<libc::ucred>() as u32) as usize
+    };
+    // usize 存储保证 cmsghdr 对齐；msg_controllen 只公布两个控制消息的实际容量。
+    let mut control = vec![0usize; control_length.div_ceil(size_of::<usize>())];
+    let mut marker = [0x01u8];
+    let mut vector = libc::iovec {
+        iov_base: marker.as_mut_ptr().cast(),
+        iov_len: marker.len(),
+    };
+    let mut message: libc::msghdr = unsafe { zeroed() };
+    message.msg_iov = &mut vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.as_mut_ptr().cast();
+    message.msg_controllen = control_length;
+    unsafe {
+        let rights = libc::CMSG_FIRSTHDR(&message);
+        if rights.is_null() {
+            return Err(io::Error::other("Linux 身份前导缺少描述符空间"));
+        }
+        (*rights).cmsg_level = libc::SOL_SOCKET;
+        (*rights).cmsg_type = libc::SCM_RIGHTS;
+        (*rights).cmsg_len = libc::CMSG_LEN(size_of::<RawFd>() as u32) as usize;
+        ptr::write_unaligned(
+            libc::CMSG_DATA(rights).cast::<RawFd>(),
+            descriptor.as_raw_fd(),
+        );
+        let sender = libc::CMSG_NXTHDR(&message, rights);
+        if sender.is_null() {
+            return Err(io::Error::other("Linux 身份前导缺少凭据空间"));
+        }
+        (*sender).cmsg_level = libc::SOL_SOCKET;
+        (*sender).cmsg_type = libc::SCM_CREDENTIALS;
+        (*sender).cmsg_len = libc::CMSG_LEN(size_of::<libc::ucred>() as u32) as usize;
+        ptr::write_unaligned(libc::CMSG_DATA(sender).cast::<libc::ucred>(), *credentials);
+        let sent = libc::sendmsg(
+            stream.as_raw_fd(),
+            &message,
+            libc::MSG_DONTWAIT | libc::MSG_NOSIGNAL,
+        );
+        if sent < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        if sent != 1 {
+            return Err(io::Error::new(
+                io::ErrorKind::WriteZero,
+                "Linux 身份前导未完整发送",
+            ));
+        }
+    }
+    Ok(())
+}
