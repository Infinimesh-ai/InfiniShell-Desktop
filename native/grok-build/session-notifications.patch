+//! 只在自有 PTY 上构造真实通知 peer；不替换产品的身份校验。
+
+use super::*;
+use std::fs::File;
+use std::os::fd::{FromRawFd, RawFd};
+use std::process::Stdio;
+use tokio::process::{Child, Command};
+
+pub(crate) struct Fixture {
+    plugin: super::super::notification_plugin::tests::Fixture,
+    master: Option<File>,
+    child: Child,
+}
+
+impl Fixture {
+    pub(crate) async fn new() -> Self {
+        let plugin = super::super::notification_plugin::tests::Fixture::new();
+        plugin.binding.validate().unwrap();
+        let mut master: RawFd = -1;
+        let mut slave: RawFd = -1;
+        assert_eq!(
+            unsafe {
+                libc::openpty(
+                    &mut master,
+                    &mut slave,
+                    std::ptr::null_mut(),
+                    std::ptr::null_mut(),
+                    std::ptr::null_mut(),
+                )
+            },
+            0
+        );
+        assert_eq!(
+            unsafe { libc::fcntl(master, libc::F_SETFD, libc::FD_CLOEXEC) },
+            0
+        );
+        assert_eq!(
+            unsafe { libc::fcntl(slave, libc::F_SETFD, libc::FD_CLOEXEC) },
+            0
+        );
+        let master = unsafe { File::from_raw_fd(master) };
+        let slave = unsafe { File::from_raw_fd(slave) };
+        let mut path = vec![0_u8; 1024];
+        use std::os::fd::AsRawFd;
+        assert_eq!(
+            unsafe { libc::ttyname_r(slave.as_raw_fd(), path.as_mut_ptr().cast(), path.len()) },
+            0
+        );
+        let end = path.iter().position(|value| *value == 0).unwrap();
+        let tty =
+            dunce::canonicalize(Path::new(std::str::from_utf8(&path[..end]).unwrap())).unwrap();
+        let mut command = Command::new("/bin/sh");
+        command
+            .args(["-c", "read -r line"])
+            .current_dir(&plugin.root)
+            .stdin(Stdio::from(slave))
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .kill_on_drop(true);
+        unsafe {
+            command.pre_exec(|| {
+                if libc::setsid() == -1 || libc::ioctl(libc::STDIN_FILENO, libc::TIOCSCTTY as _, 0) == -1
+                {
+                    return Err(std::io::Error::last_os_error());
+                }
+                Ok(())
+            });
+        }
+        let child = command.spawn().unwrap();
+        let pid = i32::try_from(child.id().unwrap()).unwrap();
+        let peer = PeerIdentity::capture(pid, unsafe { libc::geteuid() }).unwrap();
+        let candidate = RouteCandidate {
+            tty,
+            tmux: None,
+            tmux_pane: None,
+        };
+        peer.verify(&candidate).unwrap();
+        let route = Route {
+            exit: None,
+            process_scope: xai_grok_tools::util::ProcessScope::new(),
+            client: u64::from(pid as u32),
+            generation: uuid::Uuid::new_v4().to_string(),
+            peer,
+            candidate,
+            binding: plugin.binding.clone(),
+            request: serde_json::json!("fixture"),
+        };
+        assert!(
+            routes()
+                .lock()
+                .unwrap()
+                .insert(
+                    plugin.binding.session_id.clone(),
+                    SessionRoute {
+                        active: Some(route),
+                        pending: None,
+                    }
+                )
+                .is_none()
+        );
+        Self {
+            plugin,
+            master: Some(master),
+            child,
+        }
+    }
+
+    pub(crate) fn reserve_exit(&self) -> super::OwnedExitRequest {
+        let (client, peer) = {
+            let routes = routes().lock().unwrap();
+            let route = routes
+                .get(&self.plugin.binding.session_id)
+                .unwrap()
+                .active
+                .as_ref()
+                .unwrap();
+            (route.client, route.peer.clone())
+        };
+        let mut frame = serde_json::json!({
+            "jsonrpc":"2.0", "id":uuid::Uuid::new_v4().to_string(),
+            "method":"_x.ai/session/owned_exit", "params":{
+                "protocolVersion":1, "sessionId":self.plugin.binding.session_id,
+                "notificationBinding":self.plugin.binding
+            }
+        });
+        super::owned_exit::reserve_exit(&mut frame, client, Some(&peer)).unwrap();
+        serde_json::from_value(frame["params"].clone()).unwrap()
+    }
+
+    pub(crate) fn binding(&self) -> &NotificationPlugin {
+        &self.plugin.binding
+    }
+
+    pub(crate) async fn close(mut self) {
+        self.master.take();
+        let result = tokio::time::timeout(Duration::from_secs(2), self.child.wait()).await;
+        assert!(result.is_ok(), "自有 PTY 关闭后子进程必须退出");
+        assert!(result.unwrap().is_ok());
+    }
+}
+
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        routes()
+            .lock()
+            .unwrap()
+            .remove(&self.plugin.binding.session_id);
+        self.master.take();
+        // Tokio 的 kill_on_drop 只兜底此夹具拥有的 Child；正常路径已通过 close 等待退出。
+    }
+}
