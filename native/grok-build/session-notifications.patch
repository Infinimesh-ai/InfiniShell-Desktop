+#[tokio::test(flavor = "current_thread")]
+async fn owned_exit_idle_actor_finishes_global_and_plugin_hooks_before_scope_closes() {
+    tokio::task::LocalSet::new()
+        .run_until(async {
+            let fixture = Fixture::new().await;
+            let (actor, events, updates) = actor(&fixture).await;
+            let scope = actor.tool_context.process_scope.as_ref().unwrap().clone();
+            let (tx, _chat, task) = start(actor, events);
+            // 产品对已驻留 actor 退出；夹具初始化不应预先消耗退出握手的预算。
+            let (ready_tx, ready_rx) = oneshot::channel();
+            tx.send(SessionCommand::IsBusy {
+                respond_to: ready_tx,
+            })
+            .unwrap();
+            assert!(
+                !tokio::time::timeout(std::time::Duration::from_secs(8), ready_rx)
+                    .await
+                    .unwrap()
+                    .unwrap()
+            );
+            let guard = OwnedExitGuard::claim(&fixture.reserve_exit()).unwrap();
+            assert!(
+                crate::session::notification_route::verify_exit(
+                    &guard.token(),
