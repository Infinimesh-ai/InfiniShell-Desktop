index 0000000000000000000000000000000000000000..7b2b5c6ad3ece92a25b0a4def0828c0105b3ed7d
--- /dev/null
+++ b/crates/codegen/xai-grok-shell/src/session/notification_exit.rs
@@ -0,0 +1,275 @@
+//! 正常 owned 退出在原连接仍存活时结束闲置 actor；断连仍立即撤销路由。
+use super::*;
+
+pub const OWNED_EXIT_METHOD: &str = "x.ai/session/owned_exit";
+pub(super) const OWNED_EXIT_WIRE_METHOD: &str = "_x.ai/session/owned_exit";
+pub const OWNED_EXIT_BUDGET: Duration = Duration::from_secs(8);
+const EXIT_KEY: &str = "infinishell/verifiedOwnedExit";
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct OwnedExitRequest {
+    pub protocol_version: u32,
+    pub session_id: String,
+    pub notification_binding: NotificationPlugin,
+    #[serde(default, rename = "_meta", skip_serializing_if = "Option::is_none")]
+    pub meta: Option<acp::Meta>,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct OwnedExitToken {
+    session_id: String,
+    generation: String,
+    nonce: String,
+}
+
+#[derive(Clone)]
+pub(super) struct ExitReservation {
+    token: OwnedExitToken,
+    deadline: std::time::Instant,
+}
+
+pub(super) fn reserve_exit(
+    json: &mut serde_json::Value,
+    client: u64,
+    peer: Option<&PeerIdentity>,
+) -> Result<bool> {
+    let params = json.get("params").context("missing owned exit params")?;
+    let request: OwnedExitRequest = serde_json::from_value(params.clone())?;
+    ensure!(
+        request.protocol_version == 1 && request.meta.is_none(),
+        "invalid owned exit request"
+    );
+    ensure!(
+        request.session_id == request.notification_binding.session_id,
+        "owned exit session mismatch"
+    );
+    let peer = peer.context("owned exit requires a verified peer")?;
+    let mut routes = routes()
+        .lock()
+        .map_err(|_| anyhow::anyhow!("notification route unavailable"))?;
+    expire_exit(&mut routes, &request.session_id);
+    let state = routes
+        .get_mut(&request.session_id)
+        .context("notification route unavailable")?;
+    ensure!(state.pending.is_none(), "notification attach is pending");
+    let route = state
+        .active
+        .as_mut()
+        .context("notification route unavailable")?;
+    ensure!(
+        route.client == client && route.exit.is_none(),
+        "owned exit is not current or is already pending"
+    );
+    ensure!(
+        route.binding == request.notification_binding,
+        "owned exit descriptor mismatch"
+    );
+    route
+        .binding
+        .validate_target(&request.session_id, &route.binding.cwd)?;
+    route.peer.verify(&route.candidate)?;
+    peer.verify(&route.candidate)?;
+    let token = OwnedExitToken {
+        session_id: request.session_id,
+        generation: route.generation.clone(),
+        nonce: uuid::Uuid::new_v4().to_string(),
+    };
+    let meta = serde_json::json!({EXIT_KEY: token});
+    json.get_mut("params")
+        .and_then(serde_json::Value::as_object_mut)
+        .context("invalid owned exit params")?
+        .insert("_meta".into(), meta);
+    // 同一锁内禁止新 owned 输入和新 attach；只有 actor 的闲置分支能领取关闭权。
+    route.exit = Some(ExitReservation {
+        token,
+        deadline: std::time::Instant::now() + OWNED_EXIT_BUDGET,
+    });
+    Ok(true)
+}
+
+/// 所有使用点都在同一锁内回收过期代际；分发前取消不能留下永久 fence。
+pub(super) fn expire_exit(routes: &mut HashMap<String, SessionRoute>, session_id: &str) {
+    if let Some(state) = routes.get_mut(session_id)
+        && state.active.as_ref().is_some_and(|route| {
+            route
+                .exit
+                .as_ref()
+                .is_some_and(|exit| std::time::Instant::now() >= exit.deadline)
+        })
+        && let Some(route) = state.active.take()
+    {
+        route.process_scope.kill_all();
+    }
+    routes.retain(|_, state| state.active.is_some() || state.pending.is_some());
+}
+
+fn matching(route: &Route, token: &OwnedExitToken) -> bool {
+    route.binding.session_id == token.session_id
+        && route.generation == token.generation
+        && route
+            .exit
+            .as_ref()
+            .is_some_and(|exit| exit.token.nonce == token.nonce)
+}
+
+pub(crate) struct OwnedExitGuard {
+    token: OwnedExitToken,
+    detach_busy: bool,
+}
+
+impl OwnedExitGuard {
+    pub(crate) fn claim(request: &OwnedExitRequest) -> Result<Self> {
+        ensure!(
+            request.protocol_version == 1
+                && request.session_id == request.notification_binding.session_id,
+            "invalid owned exit identity"
+        );
+        let token: OwnedExitToken = serde_json::from_value(
+            request
+                .meta
+                .as_ref()
+                .and_then(|meta| meta.get(EXIT_KEY))
+                .context("owned exit was not authorized by the leader")?
+                .clone(),
+        )?;
+        ensure!(
+            token.session_id == request.session_id,
+            "owned exit session mismatch"
+        );
+        {
+            let mut routes = routes()
+                .lock()
+                .map_err(|_| anyhow::anyhow!("notification route unavailable"))?;
+            expire_exit(&mut routes, &token.session_id);
+            let route = routes
+                .get(&token.session_id)
+                .and_then(|state| state.active.as_ref())
+                .context("notification route unavailable")?;
+            ensure!(
+                matching(route, &token) && route.binding == request.notification_binding,
+                "stale owned exit"
+            );
+        }
+        Ok(Self {
+            token,
+            detach_busy: false,
+        })
+    }
+
+    pub(crate) fn token(&self) -> OwnedExitToken {
+        self.token.clone()
+    }
+    pub(crate) fn detach_busy(&mut self) {
+        self.detach_busy = true;
+    }
+}
+
+impl Drop for OwnedExitGuard {
+    fn drop(&mut self) {
+        let Ok(mut routes) = routes().lock() else {
+            return;
+        };
+        let Some(state) = routes.get_mut(&self.token.session_id) else {
+            return;
+        };
+        if !state
+            .active
+            .as_ref()
+            .is_some_and(|route| matching(route, &self.token))
+        {
+            return;
+        }
+        if self.detach_busy {
+            if let Some(route) = state.active.as_mut() {
+                route.exit = None;
+            }
+        } else if let Some(route) = state.active.take() {
+            // 完成、超时、取消均只撤销请求携带的原代际，不接触后来附着的路由。
+            route.process_scope.kill_all();
+        }
+        routes.retain(|_, state| state.active.is_some() || state.pending.is_some());
+    }
+}
+
+pub(crate) fn verify_exit(
+    token: &OwnedExitToken,
+    session_id: &str,
+    cwd: &Path,
+) -> Result<OwnedBindingGuard> {
+    let mut routes = routes()
+        .lock()
+        .map_err(|_| anyhow::anyhow!("notification route unavailable"))?;
+    ensure!(
+        token.session_id == session_id,
+        "owned exit session mismatch"
+    );
+    expire_exit(&mut routes, session_id);
+    let route = routes
+        .get(session_id)
+        .and_then(|state| state.active.as_ref())
+        .context("notification route unavailable")?;
+    ensure!(matching(route, token), "stale owned exit");
+    ensure!(
+        route
+            .exit
+            .as_ref()
+            .is_some_and(|exit| std::time::Instant::now() < exit.deadline),
+        "owned exit expired"
+    );
+    ensure!(
+        !route.process_scope.is_closed(),
+        "notification route closed"
+    );
+    route.binding.validate_target(session_id, cwd)?;
+    route.peer.verify(&route.candidate)?;
+    Ok(OwnedBindingGuard { _routes: routes })
+}
+
+pub(crate) fn exit_pending(session_id: &str) -> bool {
+    let Ok(mut routes) = routes().lock() else {
+        return false;
+    };
+    expire_exit(&mut routes, session_id);
+    routes
+        .get(session_id)
+        .and_then(|state| state.active.as_ref())
+        .is_some_and(|route| route.exit.is_some())
+}
+
+pub(crate) fn session_open_guard(session_id: &str) -> Result<OwnedBindingGuard> {
+    let mut routes = routes()
+        .lock()
+        .map_err(|_| anyhow::anyhow!("notification route unavailable"))?;
+    expire_exit(&mut routes, session_id);
+    ensure!(
+        routes
+            .get(session_id)
+            .and_then(|state| state.active.as_ref())
+            .is_none_or(|route| route.exit.is_none()),
+        "notification owner is exiting"
+    );
+    Ok(OwnedBindingGuard { _routes: routes })
+}
+
+pub(crate) fn provider_for_exit(token: &OwnedExitToken) -> Arc<dyn SessionNotificationRoute> {
+    Arc::new(ExitProvider(token.clone()))
+}
+
+struct ExitProvider(OwnedExitToken);
+impl SessionNotificationRoute for ExitProvider {
+    fn environment(&self, plugin_root: &str) -> Option<NotificationEnvironment> {
+        let mut routes = routes().lock().ok()?;
+        expire_exit(&mut routes, &self.0.session_id);
+        let route = routes.get(&self.0.session_id)?.active.as_ref()?;
+        if !matching(route, &self.0) {
+            return None;
+        }
+        environment_for_route(route, plugin_root)
+    }
+}
+
+#[cfg(test)]
+#[path = "notification_exit_tests.rs"]
+mod tests;
