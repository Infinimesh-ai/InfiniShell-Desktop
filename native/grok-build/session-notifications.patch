+#[tokio::test]
+async fn terminal_bridge_windows_concurrent_instances_are_independent_and_names_cannot_be_taken() {
+    let root = private_test_directory();
+    let mut first = BridgeIo::start(root.path()).unwrap();
+    let mut second = BridgeIo::start(root.path()).unwrap();
+    let first_manifest = manifest(&first);
+    let second_manifest = manifest(&second);
+    assert_ne!(first_manifest.socket, second_manifest.socket);
+    assert!(
+        ServerOptions::new()
+            .first_pipe_instance(true)
+            .create(&first_manifest.socket)
+            .is_err()
+    );
+    let mut client = ClientOptions::new().open(&first_manifest.socket).unwrap();
+    send(&mut client, state(&first_manifest, &second_manifest.token)).await;
+    assert_no_delivery(&mut first).await;
+    let mut client = ClientOptions::new().open(&second_manifest.socket).unwrap();
+    send(&mut client, state(&second_manifest, &second_manifest.token)).await;
+    let call = tokio::time::timeout(Duration::from_secs(2), second.requests.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        matches!(call.request, Request::State { instance_id } if instance_id == second.instance_id)
+    );
+}
+
+#[tokio::test]
+async fn terminal_bridge_windows_manifest_is_readable_but_cannot_be_replaced_while_live() {
+    let root = private_test_directory();
+    let bridge = BridgeIo::start(root.path()).unwrap();
+    let path = bridge.instance_dir.join("manifest.json");
+    let before = std::fs::read(&path).unwrap();
+    assert!(std::fs::write(&path, b"{}").is_err());
+    assert!(std::fs::rename(&path, bridge.instance_dir.join("old.json")).is_err());
+    assert_eq!(std::fs::read(&path).unwrap(), before);
+    let directory = bridge.instance_dir.clone();
+    std::fs::write(
+        directory.join("receipts.jsonl"),
+        b"preserve unknown receipt",
+    )
+    .unwrap();
+    drop(bridge);
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    assert!(!path.exists());
+    assert_eq!(
+        std::fs::read(directory.join("receipts.jsonl")).unwrap(),
+        b"preserve unknown receipt"
+    );
+}
