@@ -0,0 +1,247 @@
+use super::*;
+use crate::app::acp_handler::apply_session_event_for_test;
+use crate::app::dispatch::prompt::dispatch_terminal_bridge_prompt;
+use xai_acp_lib::{AcpArgs, AcpClientMessage};
+use xai_grok_shell::extensions::notification::{RetryState, SessionUpdate as XaiSessionUpdate};
+
+const PROMPT_ID: &str = "72912484-76c6-46df-931c-38db2f552c4e";
+const BODY: &str = "/compact 这是必须保留为字面的桥接正文";
+
+fn adopted_bridge(own: bool) -> AppView {
+    let mut app = test_app_with_agent();
+    if own {
+        let effects = dispatch_terminal_bridge_prompt(
+            &mut app,
+            BODY.into(),
+            vec![],
+            PROMPT_ID.into(),
+            PROMPT_ID.into(),
+        );
+        assert!(matches!(
+            effects.as_slice(),
+            [Effect::SendTerminalBridgePrompt { prompt_id, message_id, text, .. }]
+                if prompt_id == PROMPT_ID && message_id == PROMPT_ID && text == BODY
+        ));
+        let echo = app.shared_prompt_queue("test-session").unwrap();
+        assert_eq!(echo.len(), 1);
+        assert_eq!(echo[0].kind, "terminal_bridge");
+    }
+    // 经生产 ACP 通知入口接管，覆盖发起端与另一订阅 TUI，不能直接伪造无缓存状态。
+    let params = serde_json::json!({
+        "sessionId": "test-session",
+        "entries": [],
+        "runningPromptId": PROMPT_ID,
+        "runningText": BODY,
+        "runningKind": "terminal_bridge",
+    });
+    let (response_tx, _rx) = tokio::sync::oneshot::channel();
+    crate::app::acp_handler::handle(
+        AcpClientMessage::ExtNotification(AcpArgs {
+            request: acp::ExtNotification::new(
+                "x.ai/queue/changed",
+                Arc::from(serde_json::value::to_raw_value(&params).unwrap()),
+            ),
+            response_tx,
+        }),
+        &mut app,
+    );
+    let agent = test_agent(&app, AgentId(0));
+    assert_eq!(agent.session.current_prompt_id.as_deref(), Some(PROMPT_ID));
+    assert!(agent.session.state.is_turn_running());
+    assert_eq!(agent.attached_as_viewer, !own);
+    assert_literal_user_block(&app);
+    assert_no_retry_state(&app);
+    app
+}
+
+fn assert_literal_user_block(app: &AppView) {
+    let agent = test_agent(app, AgentId(0));
+    assert_eq!(
+        (0..agent.scrollback.len())
+            .filter(|&i| matches!(
+                agent.scrollback.entry(i).map(|entry| &entry.block),
+                Some(RenderBlock::UserPrompt(block)) if block.text == BODY
+            ))
+            .count(),
+        1
+    );
+}
+
+fn assert_no_retry_state(app: &AppView) {
+    let agent = test_agent(app, AgentId(0));
+    assert!(agent.session.in_flight_prompt.is_none());
+    assert!(agent.session.compact_held_prompt.is_none());
+    assert!(agent.reauth_stashed_prompt.is_none());
+    assert!(agent.credit_limit_stashed_prompt.is_none());
+    assert!(agent.session.pending_prompts.is_empty());
+    assert!(agent.shared_queue.is_empty());
+    assert!(
+        agent
+            .session
+            .current_prompt_id
+            .as_deref()
+            .is_none_or(|id| id == PROMPT_ID)
+    );
+}
+
+fn assert_no_submit(effects: &[Effect]) {
+    assert!(
+        !effects.iter().any(|effect| matches!(
+            effect,
+            Effect::SendPrompt { .. }
+                | Effect::SendPromptBlocks { .. }
+                | Effect::SendPromptNow { .. }
+                | Effect::SendTerminalBridgePrompt { .. }
+                | Effect::SendBashCommand { .. }
+                | Effect::ExecutePlan { .. }
+        )),
+        "桥接正文不得通过新身份或普通发送路径重投：{effects:?}"
+    );
+}
+
+fn bridge_response(
+    app: &mut AppView,
+    result: Result<acp::PromptResponse, String>,
+    http_status: Option<u16>,
+) -> Vec<Effect> {
+    dispatch(
+        Action::TaskComplete(TaskResult::TerminalBridgeResponse {
+            agent_id: AgentId(0),
+            session_id: "test-session".into(),
+            message_id: PROMPT_ID.into(),
+            result,
+            http_status,
+            prompt_id: Some(PROMPT_ID.into()),
+            native_rejected: false,
+        }),
+        app,
+    )
+}
+
+fn session_event(app: &mut AppView, event: XaiSessionUpdate) {
+    let agent = test_agent_mut(app, AgentId(0));
+    apply_session_event_for_test(&event, &mut agent.session, &mut agent.scrollback);
+}
+
+#[test]
+fn adopted_bridge_auth_and_compact_failure_never_resubmit_after_login() {
+    for own in [true, false] {
+        for compact in [false, true] {
+            let mut app = adopted_bridge(own);
+            if compact {
+                session_event(
+                    &mut app,
+                    XaiSessionUpdate::AutoCompactStarted {
+                        tokens_used: 180_000,
+                        context_window: 200_000,
+                        percentage: 90,
+                        reason: "threshold".into(),
+                    },
+                );
+                assert_no_retry_state(&app);
+                session_event(
+                    &mut app,
+                    XaiSessionUpdate::AutoCompactFailed {
+                        error: "Unauthorized (401)".into(),
+                    },
+                );
+            }
+            session_event(
+                &mut app,
+                XaiSessionUpdate::RetryState(RetryState::Failed {
+                    error_type: "auth".into(),
+                    message: "Unauthorized (401)".into(),
+                }),
+            );
+            assert_no_submit(&bridge_response(
+                &mut app,
+                Err("Unauthorized (401)".into()),
+                Some(401),
+            ));
+            assert_no_retry_state(&app);
+            assert_no_submit(&dispatch(Action::Login, &mut app));
+            let request_seq = authenticating_seq(&app);
+            assert_no_submit(&dispatch(
+                Action::TaskComplete(TaskResult::AuthComplete {
+                    request_seq,
+                    meta: None,
+                }),
+                &mut app,
+            ));
+            assert_no_retry_state(&app);
+            assert_literal_user_block(&app);
+        }
+    }
+}
