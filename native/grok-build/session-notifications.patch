+
+fn retained_child_peer(child: &tokio::process::Child) -> ConsolePeer {
+    let raw = HANDLE(child.raw_handle().unwrap());
+    let identity = process_identity(raw).unwrap();
+    let mut handle = HANDLE::default();
+    unsafe {
+        DuplicateHandle(
+            GetCurrentProcess(),
+            raw,
+            GetCurrentProcess(),
+            &mut handle,
+            (PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_SYNCHRONIZE).0,
+            false,
+            DUPLICATE_HANDLE_OPTIONS(0),
+        )
+        .unwrap();
+    }
+    ConsolePeer::from_transferred_handle(handle.0 as usize as u64, identity).unwrap()
+}
+
+async fn wait_for_console_ready(child: &mut tokio::process::Child) {
+    let expected = format!("console-target-ready:{}", child.id().unwrap());
+    let mut output = BufReader::new(child.stdout.take().unwrap());
+    tokio::time::timeout(Duration::from_secs(15), async {
+        loop {
+            let mut line = String::new();
+            if output.read_line(&mut line).await.unwrap() == 0 {
+                let mut error = String::new();
+                child
+                    .stderr
+                    .as_mut()
+                    .unwrap()
+                    .read_to_string(&mut error)
+                    .await
+                    .unwrap();
+                panic!("控制台夹具在完成内核成员验证前退出: {error}");
+            }
+            if line.trim_end() == expected {
+                break;
+            }
+        }
+    })
+    .await
+    .expect("控制台夹具未发出就绪确认");
+    // 保留管道，避免夹具退出时 libtest 写入已关闭的 stdout。
+    child.stdout = Some(output.into_inner());
+}
