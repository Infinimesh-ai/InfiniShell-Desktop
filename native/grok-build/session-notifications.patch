+#[tokio::test]
+async fn terminal_bridge_scheduler_spawn_waits_for_idle_lease_and_is_not_lost_on_release() {
+    let mut harness = harness(false, Duration::from_secs(10));
+    let sender = harness.backend.sender();
+    let (respond_to, response) = oneshot::channel();
+    sender
+        .send(SubagentEvent::IdleAdmissionCheck {
+            parent_session_id: "parent".to_owned(),
+            respond_to,
+        })
+        .unwrap();
+    let lease = response.await.unwrap().unwrap();
+    let mut scheduled = request("scheduled", true);
+    scheduled.parent_prompt_id = None;
+    scheduled.runtime_overrides.loop_task_id = Some("loop".to_owned());
+    scheduled.resume_from = Some("prior-iteration".to_owned());
+    let (result_tx, _result_rx) = oneshot::channel();
+    let (registered_tx, mut registered_rx) = oneshot::channel();
+    sender
+        .send(SubagentEvent::Spawn(SubagentSpawnRequest {
+            request: Box::new(scheduled),
+            result_tx,
+            registered_tx: Some(registered_tx),
+        }))
+        .unwrap();
+    // 同一通道上的查询是屏障，证明 Spawn 已经被协调器处理，而非尚未被调度。
+    let counts = harness.backend.registry_counts().await;
+    assert_eq!(counts.pending + counts.active + counts.queued, 0);
+    assert!(harness.started.try_recv().is_err());
+    assert!(registered_rx.try_recv().is_err());
+    drop(lease);
+    let started = tokio::time::timeout(Duration::from_secs(1), harness.started.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(started, "scheduled");
+    let admitted = harness.requests.recv().await.unwrap();
+    assert_eq!(
+        admitted.runtime_overrides.loop_task_id.as_deref(),
+        Some("loop")
+    );
+    assert_eq!(admitted.resume_from.as_deref(), Some("prior-iteration"));
+    registered_rx.await.unwrap();
+    harness.actor.abort();
+}
