+                    &fixture.binding().cwd
+                )
+                .is_ok()
+            );
+            assert!(request(&tx, &guard).await.unwrap());
+            tokio::time::timeout(std::time::Duration::from_secs(7), task)
+                .await
+                .unwrap()
+                .unwrap();
+            assert!(tx.is_closed());
+            assert!(
+                !scope.is_closed(),
+                "正常 actor 收尾不应提前关闭普通 hook scope"
+            );
+            let batches: Vec<_> = updates
+                .lock()
+                .unwrap()
+                .iter()
+                .filter(|update| update["sessionUpdate"] == "hook_execution")
+                .cloned()
+                .collect();
+            assert_eq!(batches.len(), 2, "{batches:?}");
+            assert_eq!(batches[0]["event_name"], "session_end");
+            assert_eq!(batches[1]["event_name"], "stop");
+            for batch in batches {
+                let runs = batch["runs"].as_array().unwrap();
+                assert_eq!(runs.len(), 2, "原全局 hook 和冻结插件均须真正执行");
+                for run in runs {
+                    assert_eq!(run["status"]["status"], "success", "{run:?}");
+                }
+            }
+            scope.kill_all();
+            drop(guard);
+            fixture.close().await;
+        })
+        .await;
+}
