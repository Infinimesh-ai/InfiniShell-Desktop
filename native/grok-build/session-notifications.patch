+use super::DeferredStart;
+
+#[tokio::test]
+async fn notification_start_does_not_abort_the_ordinary_start_task() {
+    let mut start = DeferredStart::new();
+    let (ordinary_release, ordinary_wait) = tokio::sync::oneshot::channel();
+    let (ordinary_done, ordinary_result) = tokio::sync::oneshot::channel();
+    let (notification_release, notification_wait) = tokio::sync::oneshot::channel();
+    let (notification_done, notification_result) = tokio::sync::oneshot::channel();
+    start.arm(
+        tokio::spawn(async move {
+            ordinary_wait.await.unwrap();
+            ordinary_done.send(()).unwrap();
+        }),
+        false,
+    );
+    start.arm(
+        tokio::spawn(async move {
+            notification_wait.await.unwrap();
+            notification_done.send(()).unwrap();
+        }),
+        true,
+    );
+    ordinary_release.send(()).unwrap();
+    notification_release.send(()).unwrap();
+    ordinary_result.await.unwrap();
+    notification_result.await.unwrap();
+    start.seal_and_join().await;
+}
+
+#[tokio::test]
+async fn session_end_joins_both_notification_and_ordinary_start_tasks() {
+    let mut start = DeferredStart::new();
+    let (ordinary_done, ordinary_result) = tokio::sync::oneshot::channel();
+    let (notification_done, notification_result) = tokio::sync::oneshot::channel();
+    let ordinary_cancel = start.cancel.clone();
+    let notification_cancel = start.cancel.clone();
+    start.arm(
+        tokio::spawn(async move {
+            ordinary_cancel.cancelled().await;
+            ordinary_done.send(()).unwrap();
+        }),
+        false,
+    );
+    start.arm(
+        tokio::spawn(async move {
+            notification_cancel.cancelled().await;
+            notification_done.send(()).unwrap();
+        }),
+        true,
+    );
+    start.seal_and_join().await;
+    ordinary_result.await.unwrap();
+    notification_result.await.unwrap();
+    assert!(start.task.is_none());
+    assert!(start.notification_task.is_none());
+}
