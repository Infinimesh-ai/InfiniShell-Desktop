+//! 仅当前驻留 actor 可以返回 owned 身份；本查询没有启动、投递或通知副作用。
+
+use super::*;
+use std::path::Path;
+
+pub(super) struct OwnedInputGuard<'a> {
+    _route: crate::session::notification_route::OwnedBindingGuard,
+    _permissions: parking_lot::MutexGuard<'a, ()>,
+    _plan: parking_lot::MutexGuard<'a, crate::session::plan_mode::PlanModeTracker>,
+}
+
+impl SessionActor {
+    pub(super) fn owned_input_guard(
+        &self,
+        condition: &OwnedInputPrecondition,
+    ) -> acp::Result<OwnedInputGuard<'_>> {
+        let reject = || {
+            crate::extensions::owned_identity::rejected(
+                self.session_info.id.0.as_ref(),
+                &condition.request_id,
+                "precondition_changed",
+            )
+        };
+        // 固定顺序：queue state（调用方已持有）→ plan → permission mode → route。
+        // 持锁直到同步队列修改结束；所有通知与异步工作必须在释放后执行。
+        let plan = self.plan_mode.lock();
+        if plan.is_active()
+            || condition.protocol_version != 1
+            || !condition.require_default_permissions
+        {
+            return Err(reject());
+        }
+        let permissions = self.permissions.default_mode_guard().ok_or_else(reject)?;
+        let route = crate::session::notification_route::owned_binding_guard(
+            self.session_info.id.0.as_ref(),
+            Path::new(&self.session_info.cwd),
+            &condition.notification_binding,
+        )
+        .map_err(|_| reject())?;
+        Ok(OwnedInputGuard {
+            _route: route,
+            _permissions: permissions,
+            _plan: plan,
+        })
+    }
+
+    pub(super) fn owned_identity(&self) -> acp::Result<OwnedSessionInfo> {
+        let binding = crate::session::notification_route::owned_binding(
+            self.session_info.id.0.as_ref(),
+            Path::new(&self.session_info.cwd),
+        )
+        .map_err(|_| acp::Error::invalid_params().data("owned notification binding unavailable"))?;
+        Ok(OwnedSessionInfo {
+            session_id: self.session_info.id.to_string(),
+            cwd: self.session_info.cwd.clone(),
+            infinishell_owned_identity: OwnedSessionIdentity {
+                protocol_version: 1,
+                permission_mode: self.permission_mode_label().to_owned(),
+                notification_binding: binding,
+            },
+        })
+    }
+}
