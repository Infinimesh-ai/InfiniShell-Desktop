+#[test]
+fn concurrent_or_retry_create_cannot_replace_original_identity() {
+    let fixture = Fixture::new();
+    let dir = fixture.session_dir();
+    verify_binding(&dir, Some(&fixture.binding), true, false).unwrap();
+    verify_binding(&dir, Some(&fixture.binding), true, false).unwrap();
+    let mut replacement = fixture.binding.clone();
+    replacement.plugin_dir = fixture.root.clone();
+    assert!(verify_binding(&dir, Some(&replacement), true, false).is_err());
+}
