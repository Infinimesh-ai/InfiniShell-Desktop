{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/scripts/on-session-start.sh\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/scripts/on-stop.sh\"",
